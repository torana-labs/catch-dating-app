VITE_GTM_ID=GTM-K7KLNQXP
VITE_WEBSITE_APPCHECK_SITE_KEY=
# Store links are not configured here: packages/brand/brand.json owns them.

# Required for production claim submission. Local dev falls back to the checked-in
# dev web app config when these are unset.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Next.js runtime only. ADC should be a dedicated Firestore read-only identity.
# Never use a downloaded service-account key in the build context or browser env.
CATCH_PUBLIC_FIRESTORE_PROJECT=
# Exact additional preview hostname; leave empty outside a controlled preview.
CATCH_PREVIEW_HOST=
# Local acceptance only: FIRESTORE_EMULATOR_HOST=127.0.0.1:8765,
# CATCH_PUBLIC_FIRESTORE_PROJECT=demo-catch-nextjs.

# Defaults to a non-indexable preview. Set production only at approved cutover.
CATCH_WEBSITE_STAGE=preview
