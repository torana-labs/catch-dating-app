    {
      "type": "hero",
      "id": "top",
      "ground": "sky",
      "status": "built",
      "kicker": "Product · reports and payouts",
      "title": "Know what worked. Get paid. Do it better next time.",
      "lead": "A report after every event, with what guests said in it. Money straight into your own Razorpay account. And one simple bill from us, after the month.",
      "actions": [
        {
          "label": "Start free trial",
          "to": {
            "route": "host_start"
          },
          "emphasis": "primary"
        },
        {
          "label": "See your last event as a report",
          "to": {
