              "value": "−₹150"
            },
            {
              "title": "{{brand.name}} fee this month",
              "value": "₹4,050"
            }
          ]
        }
      },
      "status": "built"
    },
    {
      "type": "split",
      "id": "try",
      "ground": "paper",
      "status": "tryIt",
      "statusNote": "Command: import past sales and produce a report with a fee comparison. Show this when the command ships.",
      "kicker": "Try it with your last event",
      "title": "See your last event as a {{brand.name}} report.",
      "lead": "Upload the sales export from your ticketing tool, or just enter what you sold, the price and how many came. {{brand.name}} builds the report you’d have had after the event, and shows what {{brand.name}} would have charged next to what you paid.",
      "ticks": [
        "Works with exports from Luma, District, Eventbrite or a spreadsheet",
        "First-timers and repeat guests, if the export has names",
        "{{brand.name}}’s fee next to your current tool’s",
        "Your history comes with you when you claim it"
      ],
      "media": {
        "kind": "excerpt",
        "card": {
          "label": "Try it",
          "title": "Build a report",
          "fields": [
            {
              "label": "Tickets sold",
              "placeholder": "52"
            },
            {
              "label": "Ticket price (₹)",
              "placeholder": "400"
            },
            {
              "label": "How many came",
              "placeholder": "46"
            }
          ],
          "actions": [
            "Build my report",
            "Upload an export"
          ],
          "note": "Numbers alone need no sign-in. Exports with names need your phone number first."
        }
      }
    },
    {
      "type": "faq",
      "id": "questions",
      "ground": "white",
      "kicker": "Questions",
      "title": "About reports and payouts.",
      "items": [
        {
          "question": "When is my report ready?",
          "answer": "After the event, in {{brand.stores.hostAppName}}. Open the event to see who came, who was new, what you sold and what guests said."
        },
        {
          "question": "Do I need a Razorpay account?",
          "answer": "To sell tickets, yes, and we’ll help you set it up. Razorpay’s KYC check usually takes 1 to 2 working days. Free events don’t need one."
        },
        {
          "question": "When do I get my money?",
          "answer": "By default, guests pay into your Razorpay account, and Razorpay sends it to your bank on its usual schedule for your account. {{brand.name}} doesn’t hold it."
        },
        {
          "question": "How does {{brand.name}} charge me?",
          "answer": "One bill a month: 5% of ticket sales, memberships and form fees, net of refunds, never more than ₹10,000 a month. Nothing during your trial."
        },
        {
          "question": "Can I export my numbers?",
          "answer": "Yes. Each event’s report downloads its guest list, check-ins, bookings and payments as CSV files, and you can export your guest contacts any time."
        }
      ],
      "status": "built"
    },
