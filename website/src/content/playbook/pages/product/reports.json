          },
          "emphasis": "secondary",
          "status": "tryIt"
        },
        {
          "label": "See pricing",
          "to": {
            "route": "pricing"
          },
          "emphasis": "secondary"
        }
      ],
      "media": {
        "kind": "excerpt",
        "card": {
          "title": "Report · Sunday social run, 24 Nov",
          "subtitle": "Ready in {{brand.stores.hostAppName}} after the event",
          "stats": [
            {
              "value": "46/52",
              "label": "came"
            },
            {
              "value": "11",
              "label": "new to you"
            },
            {
              "value": "4.8",
              "label": "rating"
            }
          ],
          "rows": [
            {
              "title": "Ticket sales",
              "detail": "From 46 payments",
              "value": "₹13,800"
            },
            {
              "title": "What guests said",
              "detail": "21 reviews",
              "value": "Read"
            },
            {
              "title": "Bring these 46 back",
              "detail": "Next Sunday · 40 places",
              "value": "Invite"
            }
          ]
        }
      }
    },
    {
      "type": "split",
      "id": "report",
      "ground": "white",
      "kicker": "After every event",
      "title": "A report you’ll actually read.",
      "lead": "After the event, your report is ready in {{brand.stores.hostAppName}}, with the night in one place: who came, who was new, what you sold and what guests said. Then invite everyone who came to the next one.",
      "ticks": [
        "Who came, out of who booked",
        "First-timers, and who came back",
        "Ticket sales, and ratings and reviews from guests",
        "The guest list, check-ins, bookings and payments, as CSV files"
      ],
      "media": {
        "kind": "capture",
        "slot": "host-post-event-report"
      },
      "status": "built"
    },
    {
      "type": "split",
      "id": "feedback",
      "ground": "paper",
      "status": "partly",
      "statusNote": "Ratings and reviews from guests are built. The feedback summary with a would-come-back share and private notes summed up across events are not. Show this when they ship.",
      "kicker": "Feedback",
      "title": "Ask how it went, while it’s fresh.",
      "lead": "A short form goes out the morning after: a rating, what to change, and whether they’d come back. Public reviews can go on your page. Private notes come only to you.",
      "ticks": [
        "A rating and two questions, sent for you",
        "Public reviews and private notes, kept apart",
        "What people asked for, summed up across events"
      ],
      "media": {
        "kind": "excerpt",
        "card": {
          "title": "Feedback · Long Table Supper",
          "stats": [
            {
              "value": "4.8",
              "label": "average"
            },
            {
              "value": "38",
              "label": "responses"
            },
            {
              "value": "82%",
              "label": "would come back"
            }
          ],
          "rows": [
            {
              "title": "“Loved the dessert swap. More of that.”",
              "detail": "Public review",
              "tag": "On your page"
            },
            {
              "title": "“Table 4 was a bit cramped.”",
              "detail": "Private note",
              "tag": "Only you"
            }
          ]
        }
      }
    },
    {
      "type": "tiles",
      "id": "payouts",
      "ground": "ink",
      "kicker": "Payouts",
      "title": "Your money goes to you, not through us.",
      "lead": "Connect your Razorpay account once. By default, guests pay into it directly, and Razorpay sends it to your bank on its usual schedule. {{brand.name}} doesn’t hold your ticket money.",
      "align": "start",
      "columns": 4,
      "items": [
        {
          "figure": "1",
          "figureNote": "Booking",
          "title": "Guest pays by UPI or card",
          "ground": "ink",
          "body": "Straight into your Razorpay account."
        },
        {
          "figure": "2",
          "figureNote": "Settlement",
          "title": "Razorpay pays your bank",
          "ground": "ink",
          "body": "On Razorpay’s usual schedule for your account."
        },
        {
          "figure": "3",
          "figureNote": "Refunds",
          "title": "By your policy",
          "ground": "ink",
          "body": "Refunds follow the cancellation policy you set."
        },
        {
          "figure": "4",
          "figureNote": "{{brand.name}}’s fee",
          "title": "Billed afterwards",
          "ground": "ink",
          "body": "5% of net sales, never more than ₹10,000, in one bill a month."
        }
      ],
      "status": "built"
    },
    {
      "type": "split",
      "id": "bill",
      "ground": "white",
      "kicker": "One bill, in arrears",
      "title": "No surprises from us.",
      "lead": "Your first bill comes after your free trial ends. Each one shows what you sold, what was refunded, and the 5%, never more than ₹10,000 a month.",
      "ticks": [
        "Nothing to pay during your trial",
        "Free events never appear on a bill",
        "Memberships and form fees count toward the same cap"
      ],
      "media": {
        "kind": "excerpt",
        "card": {
          "title": "{{brand.name}} bill · one month",
          "rows": [
            {
              "title": "Sunday social runs × 4",
              "value": "₹0"
            },
            {
              "title": "Coached 10K × 2 · ₹48,000",
