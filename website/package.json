{
  "name": "catch-marketing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:organizer-listings": "node scripts/generateOrganizerListings.mjs",
    "generate:organizer-listings:demo": "node scripts/generateOrganizerListings.mjs --include-demo --output src/generated/hostListings.demo.json",
    "materialize:organizer-listings:deploy": "node scripts/generateOrganizerListings.mjs --firestore-project catch-dating-app-64e51 && node scripts/generateOrganizerListings.mjs --firestore-project catch-dating-app-64e51 --include-demo --output src/generated/hostListings.demo.json && npm run check:organizer-listings",
    "check:organizer-listings": "node scripts/generateOrganizerListings.mjs --check && node scripts/generateOrganizerListings.mjs --include-demo --output src/generated/hostListings.demo.json --check",
    "check:routes": "node ../tool/marketing/check_website_routes.mjs --check",
    "check:components": "node ../tool/marketing/check_website_components.mjs --check",
    "check:architecture": "node ../tool/web/check_react_architecture_boundaries.mjs --check --surface website",
    "check:copy": "node ../tool/web/check_website_copy_ownership.mjs --check",
    "check:preview-cards": "node scripts/renderPreviewCards.mjs --check",
    "check:css-tokens": "stylelint \"src/**/*.css\" \"app/**/*.css\" && node ../packages/web-config/lint/check-stylelint-suppressions.mjs \"src/**/*.css\" \"app/**/*.css\" && node --test scripts/cssTokenDebt.test.mjs",
    "check:analytics-contract": "node --experimental-strip-types --test scripts/analyticsContract.test.mjs",
    "check:app-check-provider": "node --test scripts/firebaseAppCheckProvider.test.mjs",
    "check:a11y-debt": "node scripts/checkStorybookA11yDebt.mjs",
    "check:event-eligibility": "node --experimental-strip-types --test scripts/homeEventEligibility.test.mjs",
    "check:market-pack": "node --experimental-strip-types --test scripts/marketPack.test.mjs",
    "check:published-legal-content": "node --experimental-strip-types --test scripts/ownerGatedContent.test.mjs",
    "check:deploy-contract": "node --test scripts/marketingDeployWorkflow.test.mjs scripts/probeProduction.test.mjs",
    "check:postbuild-contract": "node --test scripts/postbuild.test.mjs",
    "check:storybook-config": "node --experimental-strip-types --test scripts/storybookConfig.test.mjs",
    "check:import-boundaries": "node ../tool/web/check_website_import_boundaries.mjs",
    "check:query-state": "node ../tool/web/check_react_query_state.mjs --check --surface website",
    "check:ui-primitives": "node ../tool/web/check_react_ui_primitives.mjs --check --surface website",
    "check:class-names": "node ../tool/web/check_react_classname_boundaries.mjs --check --surface website",
    "check:ui-components": "node ../tool/web/check_react_component_governance.mjs --check --surface website",
    "pretypecheck": "npm run check:organizer-listings && npm run check:routes && npm run check:components && npm run check:architecture && npm run check:copy && npm run check:preview-cards && npm run check:css-tokens && npm run check:market-pack && npm run check:event-eligibility && npm run check:analytics-contract && npm run check:app-check-provider && npm run check:a11y-debt && npm run check:published-legal-content && npm run check:deploy-contract && npm run check:postbuild-contract && npm run check:storybook-config && npm run check:import-boundaries && npm run check:ui-primitives && npm run check:class-names && npm run check:ui-components && npm run check:query-state && npm run check:rsvp-capture && npm run test:next-policy",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && node scripts/postbuild.mjs && npm run build:next",
    "preview": "vite preview --host 127.0.0.1",
    "storybook": "HOME=/tmp/catch-storybook-home STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 --host 127.0.0.1 --disable-telemetry",
    "build:storybook": "HOME=/tmp/catch-storybook-home STORYBOOK_DISABLE_TELEMETRY=1 storybook build --disable-telemetry",
    "test:visual": "node ../tool/web/check_storybook_visuals.mjs --surface website --check && node ../tool/web/check_storybook_visuals.mjs --surface webui --check",
    "test:storybook:a11y": "STORYBOOK_DISABLE_TELEMETRY=1 vitest run --project=storybook",
    "test:unit": "vitest run --project=unit",
    "test:unit:coverage": "vitest run --project=unit --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
    "capture:rsvp": "node scripts/rsvpPublicFormSyntheticCapture.mjs",
    "check:rsvp-capture": "node --test scripts/rsvpPublicFormSyntheticCapture.test.mjs",
    "dev:next": "next dev --webpack --hostname 127.0.0.1",
    "build:next": "node scripts/next/buildPrivateShell.mjs && next build --webpack",
    "start:next": "node scripts/next/start.mjs",
    "typecheck:next": "tsc -p tsconfig.next.json --noEmit --pretty false",
    "test:next-policy": "node --experimental-strip-types --test scripts/next/*.test.mjs",
    "test:next-runtime": "node scripts/next/runtimeAcceptance.mjs",
    "test:next-lifecycle": "node scripts/next/lifecycleAcceptance.mjs",
    "audit:next-browser": "node scripts/next/browserAudit.mjs",
    "test:next-failure": "node scripts/next/failureAcceptance.mjs"
  },
  "dependencies": {
    "@catch/web-config": "0.1.0",
    "@catch/web-ui": "0.1.0",
    "@tanstack/react-query": "^5.104.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "firebase": "^12.19.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.64.0",
    "storybook": "^10.6.2",
    "stylelint": "17.16.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
