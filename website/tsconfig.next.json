{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "proxy.ts",
    "instrumentation.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.test.*",
    "src/**/*.stories.*",
    "src/stories"
  ]
}
