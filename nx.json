{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "analytics": false,
  "defaultBase": "main",
  "namedInputs": {
    "sharedGlobals": [],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)",
      "!{projectRoot}/**/?(*.)+(spec|test).?(c|m)[jt]s",
      "!{projectRoot}/**/*.stories.[jt]s?(x)",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/vitest.config.*"
    ]
  },
  "targetDefaults": {
    "analyze": {"cache": true, "inputs": ["default", "^production"]},
    "lint": {"cache": true, "inputs": ["default", "^production"]},
    "test": {"cache": true, "inputs": ["default", "^production"]},
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/.next", "{projectRoot}/lib"]
    }
  },
  "plugins": [
    {
      "plugin": "./tool/nx/catch_projects.mjs",
      "options": {
        "sourceProjects": [
          {
            "name": "contracts",
            "root": "contracts",
            "targets": {
              "check": {
                "command": "node tool/contracts/generate_schema_contracts.mjs --check",
                "cache": false,
                "inputs": [
                  "{projectRoot}/**/*",
                  "{workspaceRoot}/tool/contracts/**/*",
                  "{workspaceRoot}/functions/src/**/*",
                  "{workspaceRoot}/lib/**/*",
                  "{workspaceRoot}/admin/src/generated/**/*",
                  "{workspaceRoot}/website/src/shared/contracts/generated/**/*"
                ]
              },
              "conformance": {
                "command": "node tool/contracts/validate_schema_contracts.mjs && node tool/contracts/check_schema_type_boundaries.mjs && node tool/run.mjs check audit:dependency-direction && node tool/contracts/check_schema_path_literals.mjs && node tool/contracts/check_schema_fixtures.mjs && node tool/contracts/check_firestore_rules_semantics.mjs",
                "inputs": [
                  "{projectRoot}/**/*",
                  "{workspaceRoot}/tool/contracts/**/*",
                  "{workspaceRoot}/functions/src/**/*",
                  "{workspaceRoot}/functions/package-lock.json",
                  "{workspaceRoot}/lib/**/*",
                  "{workspaceRoot}/firestore.rules"
                ]
              }
            }
          },
          {
            "name": "design-tokens",
            "root": "design/tokens",
            "targets": {
              "check": {
                "command": "node tool/design_tokens.mjs --check",
                "cache": false,
                "inputs": [
                  "{projectRoot}/**/*",
                  "{workspaceRoot}/tool/design_tokens.mjs",
                  "{workspaceRoot}/tool/design_tokens/**/*",
                  "{workspaceRoot}/packages/web-config/generated/**/*",
                  "{workspaceRoot}/packages/catch_tokens/lib/generated/**/*"
                ]
              }
            }
          }
        ],
        "implicitDependencies": {
          "catch_dating_app": ["contracts", "@catch/brand"],
          "functions": ["contracts", "@catch/brand"],
          "catch-admin": ["contracts"],
          "catch-marketing": ["contracts"],
          "@catch/operations": ["contracts", "@catch/brand"],
          "catch_tokens": ["design-tokens"],
          "@catch/web-config": ["design-tokens"]
        }
      }
    }
  ]
}
