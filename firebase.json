{
  "extensions": {
    "bq-event-success-feedback": "firebase/firestore-bigquery-export@0.3.2",
    "bq-event-success-scorecards": "firebase/firestore-bigquery-export@0.3.2",
    "bq-host-clubs": "firebase/firestore-bigquery-export@0.3.2",
    "bq-host-event-invite-links": "firebase/firestore-bigquery-export@0.3.2",
    "bq-host-event-participations": "firebase/firestore-bigquery-export@0.3.2",
    "bq-host-events": "firebase/firestore-bigquery-export@0.3.2",
    "bq-host-matches": "firebase/firestore-bigquery-export@0.3.2",
    "bq-host-payments": "firebase/firestore-bigquery-export@0.3.2",
    "bq-host-reviews": "firebase/firestore-bigquery-export@0.3.2",
    "bq-host-saved-events": "firebase/firestore-bigquery-export@0.3.2",
    "bq-participant-marketplace-metrics": "firebase/firestore-bigquery-export@0.3.2",
    "bq-participant-metric-counters": "firebase/firestore-bigquery-export@0.3.2",
    "bq-participant-momentum": "firebase/firestore-bigquery-export@0.3.2",
    "bq-participant-signal-facts": "firebase/firestore-bigquery-export@0.3.2"
  },
  "hosting": [
    {
      "target": "marketing",
      "public": "website/dist",
      "ignore": [
        "firebase.json",
        "**/.git/**",
        "**/.DS_Store",
        "**/node_modules/**"
      ],
      "predeploy": [
        "node tool/env/check_web_hosting_env.mjs marketing",
        "npm run web:marketing:build"
      ],
      "headers": [
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        {
          "source": "/demo/**",
          "headers": [
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/events/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/host/preview",
          "destination": "/host/",
          "type": 301
        },
        {
          "source": "/host/preview/**",
          "destination": "/host/",
          "type": 301
        },
        {
          "source": "/host/overview",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/host/overview/**",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/host/platform",
          "destination": "/host/#features",
          "type": 301
        },
        {
          "source": "/host/platform/**",
          "destination": "/host/#features",
          "type": 301
        },
        {
          "source": "/host/workflows",
          "destination": "/host/#how-it-works",
          "type": 301
        },
        {
          "source": "/host/workflows/**",
          "destination": "/host/#how-it-works",
          "type": 301
        },
        {
          "source": "/host/planners",
          "destination": "/host/#use-cases",
          "type": 301
        },
        {
          "source": "/host/planners/**",
          "destination": "/host/#use-cases",
          "type": 301
        },
        {
          "source": "/host/mixers",
          "destination": "/host/#use-cases",
          "type": 301
        },
        {
          "source": "/host/mixers/**",
          "destination": "/host/#use-cases",
          "type": 301
        },
        {
          "source": "/host/clubs",
          "destination": "/host/#use-cases",
          "type": 301
        },
        {
          "source": "/host/clubs/**",
          "destination": "/host/#use-cases",
          "type": 301
        },
        {
          "source": "/host/stack",
          "destination": "/host/#existing-tools",
          "type": 301
        },
        {
          "source": "/host/stack/**",
          "destination": "/host/#existing-tools",
          "type": 301
        },
        {
          "source": "/host/directory",
          "destination": "/organizers/",
          "type": 301
        },
        {
          "source": "/host/directory/**",
          "destination": "/organizers/",
          "type": 301
        },
        {
          "source": "/host/claim",
          "destination": "/claim/",
          "type": 301
        },
        {
          "source": "/host/claim/**",
          "destination": "/claim/",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/host/apply/**",
          "destination": "/host/apply/index.html"
        },
        {
          "source": "/events/**",
          "destination": "/events/index.html"
        },
        {
          "source": "/demo/**",
          "destination": "/demo/index.html"
        },
        {
          "source": "/booking/**",
          "destination": "/booking/index.html"
        },
        {
          "source": "/offer/**",
          "destination": "/offer/index.html"
        },
        {
          "source": "/offer",
          "destination": "/offer/index.html"
        },
        {
          "source": "/api/form-domain",
          "function": {
            "functionId": "resolvePublicFormDomain",
            "region": "asia-south1"
          }
        },
        {
          "source": "/api/join-waitlist",
          "function": {
            "functionId": "joinWaitlist",
            "region": "asia-south1"
          }
        },
        {
          "source": "/api/host-acquisition-consent",
          "function": {
            "functionId": "hostAcquisitionConsent",
            "region": "asia-south1"
          }
        },
        {
          "source": "/host",
          "destination": "/host/index.html"
        },
        {
          "source": "/claim/**",
          "destination": "/claim/index.html"
        },
        {
          "source": "/join/**",
          "destination": "/join/index.html"
        },
        {
          "source": "/event-update/**",
          "destination": "/event-update/index.html"
        },
        {
          "source": "/rehearse/**",
          "destination": "/rehearse/index.html"
        },
        {
          "source": "/invite/**",
          "destination": "/invite/index.html"
        },
        {
          "source": "/rsvp/**",
          "destination": "/rsvp/index.html"
        },
        {
          "source": "/f/**",
          "destination": "/f/index.html"
        }
      ]
    },
    {
      "target": "app",
      "public": "apps/consumer/build/web",
      "ignore": [
        "firebase.json",
        "**/.git/**",
        "**/.DS_Store"
      ],
      "predeploy": [
        "./tool/flutter_with_env.sh prod --role consumer build web --release"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": []
    },
    {
      "target": "host",
      "public": "apps/host/build/web",
      "ignore": [
        "firebase.json",
        "**/.git/**",
        "**/.DS_Store"
      ],
      "predeploy": [
        "./tool/flutter_with_env.sh prod --role host build web --release"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "admin",
      "public": "admin/dist",
      "ignore": [
        "firebase.json",
        "**/.git/**",
        "**/.DS_Store",
        "**/node_modules/**"
      ],
      "predeploy": [
        "node tool/env/check_web_hosting_env.mjs admin",
        "npm run web:admin:build"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": [
      "npm --prefix functions ci",
      "npm --prefix functions test",
      "firebase emulators:exec --project demo-catch-rules --only firestore,storage \"npm --prefix functions run test:rules\""
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true,
    "hosting": {
      "port": 5050
    }
  },
  "functions": {
    "codebase": "default",
    "disallowLegacyRuntimeConfig": true,
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint",
      "npm --prefix \"$RESOURCE_DIR\" run build",
      "node functions/scripts/copy-operations-runtime.cjs --check"
    ],
    "source": "functions"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "remoteconfig": {
    "template": "firebase/remote_config.template.json"
  }
}
