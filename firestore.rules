rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function hasField(data, field) {
      return data.keys().hasAny([field]);
    }

    function optionalString(data, field) {
      return !hasField(data, field)
        || data[field] == null
        || data[field] is string;
    }

    function optionalNumber(data, field) {
      return !hasField(data, field)
        || data[field] == null
        || data[field] is number;
    }

    function optionalHeightCm(data, field) {
      return !hasField(data, field)
        || data[field] == null
        || (
          data[field] is number
          && data[field] >= 120
          && data[field] <= 220
        );
    }

    function optionalBool(data, field) {
      return !hasField(data, field)
        || data[field] == null
        || data[field] is bool;
    }

    function optionalTimestamp(data, field) {
      return !hasField(data, field)
        || data[field] == null
        || data[field] is timestamp;
    }

    function optionalIn(data, field, values) {
      return !hasField(data, field)
        || data[field] == null
        || data[field] in values;
    }

    function isDefaultCity(city) {
      return city in [
        'in-mh-mumbai',
        'in-mp-indore'
      ];
    }

    function isConfiguredCity(city) {
      return exists(/databases/$(database)/documents/config/cities)
        && get(/databases/$(database)/documents/config/cities)
            .data.keys().hasAny(['launchMarketIds'])
        && get(/databases/$(database)/documents/config/cities)
            .data.launchMarketIds is list
        && city in get(/databases/$(database)/documents/config/cities)
            .data.launchMarketIds;
    }

    function isValidCity(city) {
      return city is string
        && (isDefaultCity(city) || isConfiguredCity(city));
    }

    function blockDocId(blockerUid, blockedUid) {
      return blockerUid + '__' + blockedUid;
    }

    function eventParticipationDocId(eventId, uid) {
      return eventId + '_' + uid;
    }

    function eventRuntimeParticipantDocId(eventId, uid) {
      return eventId + '_' + uid;
    }

    function savedEventDocId(uid, eventId) {
      return uid + '_' + eventId;
    }

    function eventSuccessFeedbackDocId(eventId, uid) {
      return eventId + '_' + uid;
    }

    function eventSuccessConversationGraphDocId(eventId, uid) {
      return eventId + '_' + uid;
    }

    function eventSuccessPreferenceDocId(eventId, uid) {
      return eventId + '_' + uid;
    }

    function eventSuccessWingmanRequestDocId(eventId, uid) {
      return eventId + '_' + uid;
    }

    function eventSuccessArrivalMissionDocId(eventId, uid) {
      return eventId + '_' + uid;
    }

    function eventSuccessCompatibilityResponseDocId(eventId, uid) {
      return eventId + '_' + uid;
    }

    function eventSuccessAssignmentDocId(eventId, moduleId, uid) {
      return eventId + '_' + moduleId + '_' + uid;
    }

    function eventSuccessLateArrivalDocId(eventId, uid) {
      return eventId + '_' + uid;
    }

    function hasBlockBetween(uidA, uidB) {
      return exists(/databases/$(database)/documents/blocks/$(blockDocId(uidA, uidB)))
        || exists(/databases/$(database)/documents/blocks/$(blockDocId(uidB, uidA)));
    }

    function hasParticipantId(matchData, uid) {
      return matchData.participantIds is list
        && uid in matchData.participantIds;
    }

    function isMatchParticipant(matchData, uid) {
      return hasParticipantId(matchData, uid)
        || matchData.user1Id == uid
        || matchData.user2Id == uid;
    }

    function isDeletedUser(uid) {
      return exists(/databases/$(database)/documents/deletedUsers/$(uid));
    }

    function isClubHostData(clubData) {
      return clubData.hostUserId == request.auth.uid
        || (
          clubData.keys().hasAny(['ownerUserId'])
          && clubData.ownerUserId == request.auth.uid
        )
        || (
          clubData.keys().hasAny(['hostUserIds'])
          && request.auth.uid in clubData.hostUserIds
        );
    }

    function isClubHostForEvent(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId))
        && get(/databases/$(database)/documents/events/$(eventId))
          .data.keys().hasAny(['organizerId'])
        && exists(/databases/$(database)/documents/organizers/$(
          get(/databases/$(database)/documents/events/$(eventId))
            .data.organizerId
        ))
        && isClubHostData(get(
          /databases/$(database)/documents/organizers/$(
            get(/databases/$(database)/documents/events/$(eventId))
              .data.organizerId
          )
        ).data);
    }

    function eventStaffGrantDocId(eventId, uid) {
      return eventId + '__' + uid;
    }

    function programStaffGrantDocId(programId, uid) {
      return programId + '__' + uid;
    }

    function hasActiveEventOperatorGrant(eventId, permission) {
      let grantId = eventStaffGrantDocId(eventId, request.auth.uid);
      return isAuthed()
        && exists(/databases/$(database)/documents/eventStaffGrants/$(grantId))
        && get(/databases/$(database)/documents/eventStaffGrants/$(grantId)).data.eventId == eventId
        && get(/databases/$(database)/documents/eventStaffGrants/$(grantId)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/eventStaffGrants/$(grantId)).data.organizerId == (
          get(/databases/$(database)/documents/events/$(eventId)).data.keys().hasAny(['organizerId'])
            ? get(/databases/$(database)/documents/events/$(eventId)).data.organizerId
            : get(/databases/$(database)/documents/events/$(eventId)).data.clubId
        )
        && get(/databases/$(database)/documents/eventStaffGrants/$(grantId)).data.status == 'active'
        && get(/databases/$(database)/documents/eventStaffGrants/$(grantId)).data.expiresAt > request.time
        && permission in get(/databases/$(database)/documents/eventStaffGrants/$(grantId)).data.permissions;
    }

    function hasEventParticipationStatus(eventId, uid, statuses) {
      return exists(/databases/$(database)/documents/eventParticipations/$(eventParticipationDocId(eventId, uid)))
        && get(/databases/$(database)/documents/eventParticipations/$(eventParticipationDocId(eventId, uid)))
        .data.status in statuses;
    }

    function hasAttendedEvent(eventId, uid) {
      return exists(/databases/$(database)/documents/eventParticipations/$(eventParticipationDocId(eventId, uid)))
        && get(/databases/$(database)/documents/eventParticipations/$(eventParticipationDocId(eventId, uid)))
        .data.status == 'attended';
    }

    function hasReadyEventRuntimeParticipant(eventId, uid) {
      let runtimeId = eventRuntimeParticipantDocId(eventId, uid);
      return exists(/databases/$(database)/documents/eventRuntimeParticipants/$(runtimeId))
        && get(/databases/$(database)/documents/eventRuntimeParticipants/$(runtimeId)).data.eventId == eventId
        && get(/databases/$(database)/documents/eventRuntimeParticipants/$(runtimeId)).data.uid == uid
        && get(/databases/$(database)/documents/eventRuntimeParticipants/$(runtimeId)).data.accessStatus == 'ready';
    }

    function hasEventSuccessParticipantAccess(eventId, uid) {
      return hasEventParticipationStatus(eventId, uid, [
          'signedUp', 'attended'
        ])
        || hasReadyEventRuntimeParticipant(eventId, uid);
    }

    function hasCheckedInEventSuccessAccess(eventId, uid) {
      let runtimeId = eventRuntimeParticipantDocId(eventId, uid);
      return hasAttendedEvent(eventId, uid)
        || (
          hasReadyEventRuntimeParticipant(eventId, uid)
          && get(/databases/$(database)/documents/eventRuntimeParticipants/$(runtimeId)).data.eventAttendeeId is string
          && exists(/databases/$(database)/documents/eventAttendees/$(
            get(/databases/$(database)/documents/eventRuntimeParticipants/$(runtimeId)).data.eventAttendeeId
          ))
          && get(/databases/$(database)/documents/eventAttendees/$(
            get(/databases/$(database)/documents/eventRuntimeParticipants/$(runtimeId)).data.eventAttendeeId
          )).data.eventId == eventId
          && get(/databases/$(database)/documents/eventAttendees/$(
            get(/databases/$(database)/documents/eventRuntimeParticipants/$(runtimeId)).data.eventAttendeeId
          )).data.linkedUid == uid
          && get(/databases/$(database)/documents/eventAttendees/$(
            get(/databases/$(database)/documents/eventRuntimeParticipants/$(runtimeId)).data.eventAttendeeId
          )).data.status == 'checkedIn'
        );
    }

    function canReadEventSuccess(eventId) {
      return isAuthed()
        && (
          isClubHostForEvent(eventId)
          || hasEventParticipationStatus(eventId, request.auth.uid, [
            'signedUp', 'waitlisted', 'attended'
          ])
          || hasReadyEventRuntimeParticipant(eventId, request.auth.uid)
        );
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    function hasValidUserShape(data) {
      return data.keys().hasOnly([
          // Core
          'name', 'firstName', 'lastName', 'displayName', 'email',
          'profilePrompts',
	          'instagramHandle', 'phoneNumber', 'countryCode', 'dateOfBirth',
          'gender', 'profileComplete',
          // Photos
          'profilePhotos',
          // Location
          'city',
          'latitude',
          'longitude',
          // Matching
          'interestedInGenders',
          'minAgePreference', 'maxAgePreference',
          // Background
          'height', 'occupation', 'company', 'education', 'religion',
          'languages',
          // Intentions
          'relationshipGoal',
          // Lifestyle
          'drinking', 'smoking', 'workout', 'diet', 'children',
          // Activity preferences
          'activityPreferences',
          // Notification / discovery preferences
          'prefsNewCatches', 'prefsMessages', 'prefsEventReminders',
          'prefsRunStatusUpdates', 'prefsClubUpdates',
          'prefsWeeklyDigest', 'prefsShowOnMap', 'prefsShowInCrossPaths',
          'prefsCrossPathsInvitations',
          // Runtime fields
          'fcmToken',
          // Server-owned lifecycle fields. These must be tolerated on existing
          // retained docs, but clients cannot create or change them.
          'deleted',
          'deletedAt', 'profileRevision', 'profileClaimedAt'
        ])
        && data.keys().hasAll([
          'name', 'displayName', 'email', 'phoneNumber',
          'profileComplete', 'profilePrompts',
          'firstName', 'lastName',
          'profilePhotos',
          'interestedInGenders', 'minAgePreference', 'maxAgePreference',
          'languages', 'activityPreferences',
          'prefsNewCatches', 'prefsMessages', 'prefsEventReminders',
          'prefsRunStatusUpdates', 'prefsClubUpdates',
          'prefsWeeklyDigest', 'prefsShowOnMap'
        ])
        // Core
        && data.name is string
        && data.firstName is string
        && data.firstName.size() <= 80
        && data.lastName is string
        && data.lastName.size() <= 80
        && data.displayName is string
        && data.displayName.size() <= 80
        && data.displayName.matches('.*\\S.*')
        && data.email is string
        && data.profilePrompts is list
        && data.profilePrompts.size() <= 3
	        && optionalString(data, 'instagramHandle')
	        && data.phoneNumber == request.auth.token.phone_number
	        && optionalString(data, 'countryCode')
	        && (!('dateOfBirth' in data) || data.dateOfBirth is timestamp)
        && (!('gender' in data) ||
          data.gender in ['man', 'woman', 'nonBinary', 'other'])
        && data.profileComplete is bool
        // Photos
        && data.profilePhotos is list
        && data.profilePhotos.size() <= 6
        // Location
        && (!hasField(data, 'city') || data.city == null || isValidCity(data.city))
        && optionalNumber(data, 'latitude')
        && optionalNumber(data, 'longitude')
        // Matching
        && data.interestedInGenders is list
        && data.interestedInGenders.size() <= 8
        && data.minAgePreference is number
        && data.minAgePreference >= 18
        && data.minAgePreference <= 99
        && data.maxAgePreference is number
        && data.maxAgePreference >= 18
        && data.maxAgePreference <= 99
        // Background
        && optionalHeightCm(data, 'height')
        && optionalString(data, 'occupation')
        && optionalString(data, 'company')
        && optionalIn(data, 'education', [
          'highSchool', 'someCollege', 'bachelors', 'masters', 'phd',
          'tradeSchool', 'other'
        ])
        && optionalIn(data, 'religion', [
          'hindu', 'muslim', 'christian', 'sikh', 'jain', 'buddhist',
          'other', 'nonReligious'
        ])
        && data.languages is list
        && data.languages.size() <= 20
        // Intentions
        && optionalIn(data, 'relationshipGoal', [
          'relationship', 'casual', 'marriage', 'friendship', 'unsure'
        ])
        // Lifestyle
        && optionalIn(data, 'drinking', [
          'never', 'socially', 'often'
        ])
        && optionalIn(data, 'smoking', [
          'never', 'occasionally', 'often'
        ])
        && optionalIn(data, 'workout', [
          'never', 'sometimes', 'often', 'everyday'
        ])
        && optionalIn(data, 'diet', [
          'omnivore', 'vegetarian', 'vegan', 'jain', 'other'
        ])
        && optionalIn(data, 'children', [
          'dontHave', 'haveWantMore', 'haveNoMore', 'wantSomeday', 'dontWant'
        ])
        // Activity preferences
        && hasValidActivityPreferences(data.activityPreferences)
        // Notification / discovery preferences
        && data.prefsNewCatches is bool
        && data.prefsMessages is bool
        && data.prefsEventReminders is bool
        && data.prefsRunStatusUpdates is bool
        && data.prefsClubUpdates is bool
        && data.prefsWeeklyDigest is bool
        && data.prefsShowOnMap is bool
        && optionalBool(data, 'prefsShowInCrossPaths')
        && optionalBool(data, 'prefsCrossPathsInvitations')
        // Runtime fields (optional)
        && optionalString(data, 'fcmToken')
        && optionalBool(data, 'deleted')
        && optionalTimestamp(data, 'deletedAt');
    }

    function hasValidActivityPreferences(preferences) {
      return preferences is map
        && preferences.keys().hasOnly(['running'])
        && preferences.running is map
        && preferences.running.keys().hasOnly([
          'paceMinSecsPerKm', 'paceMaxSecsPerKm',
          'preferredDistances', 'runningReasons', 'preferredRunTimes',
          'version'
        ])
        && preferences.running.keys().hasAll([
          'paceMinSecsPerKm', 'paceMaxSecsPerKm',
          'preferredDistances', 'runningReasons', 'preferredRunTimes',
          'version'
        ])
        && preferences.running.paceMinSecsPerKm is number
        && preferences.running.paceMinSecsPerKm > 0
        && preferences.running.paceMaxSecsPerKm is number
        && preferences.running.paceMaxSecsPerKm > 0
        && preferences.running.preferredDistances is list
        && preferences.running.preferredDistances.size() <= 12
        && preferences.running.runningReasons is list
        && preferences.running.runningReasons.size() <= 12
        && preferences.running.preferredRunTimes is list
        && preferences.running.preferredRunTimes.size() <= 8
        && preferences.running.version is number
        && preferences.running.version >= 0;
    }

    function isValidUserCreate(uid) {
      return isAuthed()
        && request.auth.uid == uid
        && !isDeletedUser(uid)
        && hasValidUserShape(request.resource.data)
        && !request.resource.data.keys().hasAny([
          'deleted', 'deletedAt', 'profileRevision', 'profileClaimedAt'
        ]);
    }

    function userChangedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isValidFcmTokenUpdate() {
      return userChangedKeys().hasOnly(['fcmToken'])
        && optionalString(request.resource.data, 'fcmToken');
    }

    function isValidPushInstallation(data) {
      return data.keys().hasOnly([
          'token',
          'appRole',
          'environment',
          'platform',
          'appVersion',
          'buildNumber',
          'locale',
          'timeZone',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'token',
          'appRole',
          'environment',
          'platform',
          'updatedAt'
        ])
        && data.token is string
        && data.token.size() > 0
        && data.appRole in ['consumer', 'host']
        && data.environment in ['dev', 'staging', 'prod']
        && data.platform in [
          'android', 'ios', 'web', 'macos', 'windows', 'linux', 'fuchsia'
        ]
        && optionalString(data, 'appVersion')
        && optionalString(data, 'buildNumber')
        && optionalString(data, 'locale')
        && optionalString(data, 'timeZone')
        && data.updatedAt is timestamp;
    }

    function isValidHostProfile(data) {
      return data.keys().hasOnly([
          'displayName',
          'avatarUrl',
          'roleTitle',
          'bio',
          'status',
          'verified',
          'linkedClubIds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'displayName',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && optionalString(data, 'avatarUrl')
        && optionalString(data, 'roleTitle')
        && optionalString(data, 'bio')
        && data.status in ['active', 'pending', 'suspended']
        && (!hasField(data, 'verified') || data.verified is bool)
        && (!hasField(data, 'linkedClubIds') ||
          (data.linkedClubIds is list && data.linkedClubIds.size() <= 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserUpdate(uid) {
      return isAuthed()
        && request.auth.uid == uid
        && !isDeletedUser(uid)
        && isValidFcmTokenUpdate();
    }

    function hasValidOnboardingDraftShape(data) {
      // Private owner-only draft state changes faster than shared production
      // documents. Keep this intentionally forward-compatible and validate
      // only the routing-critical invariant.
      return data.keys().hasAll(['step'])
        && data.step is int
        && data.step >= 0;
    }

    function hasValidLaunchAccessApplicationShape(data) {
      return data.keys().hasOnly([
          'applicationVersion', 'status', 'city', 'role', 'eventTypes',
          'availabilityWindows', 'wantsToHost', 'inviteCode',
          'instagramHandle', 'referralSource', 'whyCatch', 'cohortId',
          'hostUserId', 'reviewerUid', 'reviewNote', 'submissionCount',
          'createdAt', 'submittedAt', 'updatedAt', 'reviewedAt'
        ])
        && data.keys().hasAll([
          'applicationVersion', 'status', 'city', 'role', 'eventTypes',
          'availabilityWindows', 'wantsToHost', 'submissionCount',
          'createdAt', 'submittedAt', 'updatedAt'
        ])
        && data.applicationVersion is int
        && data.applicationVersion >= 1
        && data.status in [
          'pending', 'waitlisted', 'invited', 'approvedForProfile',
          'activeMember', 'paused', 'notSelectedYet'
        ]
        && isValidCity(data.city)
        && data.role in ['member', 'host', 'both']
        && data.eventTypes is list
        && data.eventTypes.size() >= 1
        && data.eventTypes.size() <= 7
        && data.eventTypes.hasOnly([
          'runClub', 'walkingSocial', 'coffee', 'boardGames',
          'fitnessClass', 'food', 'culture'
        ])
        && data.availabilityWindows is list
        && data.availabilityWindows.size() >= 1
        && data.availabilityWindows.size() <= 6
        && data.availabilityWindows.hasOnly([
          'weekdayMornings', 'weekdayEvenings', 'saturdayMornings',
          'saturdayEvenings', 'sundayMornings', 'sundayEvenings'
        ])
        && data.wantsToHost is bool
        && optionalString(data, 'inviteCode')
        && (!hasField(data, 'inviteCode') || data.inviteCode == null || (
          data.inviteCode.size() <= 64
          && data.inviteCode.matches('^[A-Za-z0-9_-]*$')
        ))
        && optionalString(data, 'instagramHandle')
        && (!hasField(data, 'instagramHandle')
          || data.instagramHandle == null || (
            data.instagramHandle.size() <= 30
            && data.instagramHandle.matches('^[A-Za-z0-9._]*$')
          ))
        && optionalString(data, 'referralSource')
        && (!hasField(data, 'referralSource')
          || data.referralSource == null
          || data.referralSource.size() <= 240)
        && optionalString(data, 'whyCatch')
        && (!hasField(data, 'whyCatch') || data.whyCatch == null || (
          data.whyCatch.size() >= 12 && data.whyCatch.size() <= 1000
        ))
        && optionalString(data, 'cohortId')
        && (!hasField(data, 'cohortId') || data.cohortId == null
          || data.cohortId.size() <= 120)
        && optionalString(data, 'hostUserId')
        && optionalString(data, 'reviewerUid')
        && optionalString(data, 'reviewNote')
        && (!hasField(data, 'reviewNote') || data.reviewNote == null
          || data.reviewNote.size() <= 1000)
        && data.submissionCount is int
        && data.submissionCount >= 1
        && data.createdAt is timestamp
        && data.submittedAt is timestamp
        && data.updatedAt is timestamp
        && optionalTimestamp(data, 'reviewedAt');
    }

    function isValidLaunchAccessApplicationCreate(uid) {
      return isAuthed()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'applicationVersion', 'status', 'city', 'role', 'eventTypes',
          'availabilityWindows', 'wantsToHost', 'inviteCode',
          'instagramHandle', 'referralSource', 'whyCatch', 'submissionCount',
          'createdAt', 'submittedAt', 'updatedAt'
        ])
        && hasValidLaunchAccessApplicationShape(request.resource.data)
        && request.resource.data.applicationVersion == 1
        && request.resource.data.status == 'pending'
        && request.resource.data.whyCatch is string
        && request.resource.data.submissionCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidLaunchAccessApplicationUpdate(uid) {
      return isAuthed()
        && request.auth.uid == uid
        && resource.data.status in ['pending', 'waitlisted', 'notSelectedYet']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'applicationVersion', 'city', 'role', 'eventTypes',
          'availabilityWindows', 'wantsToHost', 'inviteCode',
          'instagramHandle', 'referralSource', 'whyCatch', 'submissionCount',
          'submittedAt', 'updatedAt'
        ])
        && hasValidLaunchAccessApplicationShape(request.resource.data)
        && request.resource.data.status == resource.data.status
        && request.resource.data.whyCatch is string
        && request.resource.data.submissionCount == resource.data.submissionCount + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidNotificationReadUpdate(uid) {
      return isAuthed()
        && request.auth.uid == uid
        && resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readAt'])
        && request.resource.data.uid == uid
        && request.resource.data.readAt is timestamp;
    }

    // ── Public config ──────────────────────────────────────────────────────────
    match /config/cities {
      allow read: if true;
      allow write: if false;
    }

    match /config/{docId} {
      allow read, write: if false;
    }

    // Private profile/account documents are owner-only. User discovery,
    // matches, chats, reviews, and notifications must read publicProfiles.
    match /users/{uid} {
      allow read: if isAuthed()
        && request.auth.uid == uid
        && !isDeletedUser(uid)
        && !hasBlockBetween(request.auth.uid, uid);

      // Owners create their initial profile directly with full shape validation.
      // Profile edits go through updateUserProfile so complex field validation
      // stays in Zod instead of Firestore rules. Direct updates here are limited
      // to narrow runtime fields that rules can validate cheaply.
      allow create: if isValidUserCreate(uid);
      allow update: if isValidUserUpdate(uid);

      // Client-side deletes are blocked — account deletion is handled
      // exclusively by the requestAccountDeletion Cloud Function, which
      // uses the admin SDK to anonymize the document in place.
      allow delete: if false;

      match /pushInstallations/{installationId} {
        allow read: if isAuthed() && request.auth.uid == uid;
        allow create, update: if isAuthed()
          && request.auth.uid == uid
          && isValidPushInstallation(request.resource.data);
        allow delete: if isAuthed() && request.auth.uid == uid;
      }
    }

    // Professional host identity. This is intentionally separate from
    // users/{uid} dating profile data and publicProfiles/{uid}.
    match /hostProfiles/{uid} {
      allow read: if true;
      allow create, update: if isAuthed()
        && request.auth.uid == uid
        && isValidHostProfile(request.resource.data);
      allow delete: if false;
    }

    // ── Onboarding drafts ─────────────────────────────────────────────────────
    // Drafts contain pre-profile onboarding state. Only the signed-in owner can
    // read/write/delete their draft.
    match /onboarding_drafts/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow create, update: if isAuthed()
        && request.auth.uid == uid
        && hasValidOnboardingDraftShape(request.resource.data);
      allow delete: if isAuthed() && request.auth.uid == uid;
    }

    // Owners submit and revise only their own editable application fields.
    // Status, cohort, review, and activation fields remain Admin-SDK-owned.
    match /accessApplications/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow create: if isValidLaunchAccessApplicationCreate(uid);
      allow update: if isValidLaunchAccessApplicationUpdate(uid);
      allow delete: if false;
    }

    // ── Blocks ───────────────────────────────────────────────────────────────
    // Clients can read only block edges involving themselves. Mutations go
    // through Cloud Functions so existing matches can be closed atomically.
    match /blocks/{blockId} {
      allow read: if isAuthed() && (
        resource.data.blockerUserId == request.auth.uid
        || resource.data.blockedUserId == request.auth.uid
      );
      allow write: if false;
    }

    // Written exclusively by the reportUser Cloud Function.
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // Written exclusively by the rate-limit middleware in Cloud Functions.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Fifteen-minute callable response cache. Only the Admin SDK may access it.
    match /hostAnalyticsSnapshots/{snapshotId} {
      allow read, write: if false;
    }

    // Written exclusively by idempotent Cloud Function trigger handlers.
    match /functionEventReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Durable business-workflow state. Trusted operations workers use the
    // Admin SDK; browser and mobile clients never access these records directly.
    match /eventAssistanceSmsSenders/{senderId} {
      allow read, write: if false;
    }

    match /eventAssistanceSmsPermissions/{permissionId} {
      allow read, write: if false;
    }

    match /eventAssistanceWhatsappWithdrawalGrants/{linkId} {
      allow read, write: if false;
    }

    match /eventAssistanceSmsWithdrawalGrants/{linkId} {
      allow read, write: if false;
    }

    match /eventAssistanceSmsConsentReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /eventAssistanceSmsBudgets/{budgetId} {
      allow read, write: if false;
    }

    match /eventAssistanceSmsDispatches/{attemptId} {
      allow read, write: if false;
    }

    match /eventAssistanceMemberships/{membershipId} {
      allow read, write: if false;
    }

    match /eventAssistanceMembershipReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /eventAssistanceStaffReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /eventAssistanceParticipationReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /eventAssistanceAccountabilityReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /eventAssistanceSettings/{settingId} {
      allow read, write: if false;
    }

    match /eventAssistanceRuntimeConfigs/{runtimeId} {
      allow read, write: if false;
    }

    match /eventAssistanceRuntimeConfigReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /eventAssistanceSettingReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /eventAssistanceCheckpoints/{reportId} {
      allow read, write: if false;
    }

    match /eventAssistanceCheckpointReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /eventAssistanceDepartureRosters/{rosterId} {
      allow read, write: if false;
    }

    match /eventAssistanceProgressReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /eventAssistanceGroupProgress/{progressId} {
      allow read, write: if false;
    }

    match /eventAssistanceGuests/{guestId} {
      allow read, write: if false;
    }

    match /eventAssistanceThreads/{threadId} {
      allow read, write: if false;
    }

    match /eventAssistanceGuestGrants/{linkId} {
      allow read, write: if false;
    }

    match /eventAssistanceCaseReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /eventAssistanceDeliveryRepairs/{receiptId} {
      allow read, write: if false;
    }

    match /eventAssistanceRcsCallbacks/{callbackId} {
      allow read, write: if false;
    }

    match /eventAssistanceRcsSubscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /eventAssistanceRcsSenders/{senderId} {
      allow read, write: if false;
    }

    match /eventAssistanceRcsBudgets/{budgetId} {
      allow read, write: if false;
    }

    match /eventAssistanceRcsCallbackReceipts/{callbackId} {
      allow read, write: if false;
    }

    match /eventAssistanceRcsDispatches/{attemptId} {
      allow read, write: if false;
    }

    match /eventAssistanceRcsWithdrawalGrants/{linkId} {
      allow read, write: if false;
    }

    match /eventAssistanceRcsPermissions/{permissionId} {
      allow read, write: if false;
    }

    match /eventAssistanceRcsConsentReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /eventAssistanceRcsCallbackIdentities/{receiptKey} {
      allow read, write: if false;
    }

    match /eventAssistanceCases/{caseId} {
      allow read, write: if false;
    }

    match /eventAssistanceWhatsappReplyBindings/{attemptId} {
      allow read, write: if false;
    }

    match /eventAssistanceWhatsappPermissions/{permissionId} {
      allow read, write: if false;
    }

    match /eventAssistanceWhatsappConsentReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /eventAssistanceWhatsappBudgets/{budgetId} {
      allow read, write: if false;
    }

    match /eventAssistanceWhatsappDispatches/{attemptId} {
      allow read, write: if false;
    }

    match /organizerWhatsappEndpointStops/{stopId} {
      allow read, write: if false;
    }

    match /eventAssistanceWhatsappPolicies/{senderId} {
      allow read, write: if false;
    }

    match /eventAssistanceMessages/{messageId} {
      allow read, write: if false;
    }

    match /eventAssistanceOperationalNoticeQuotas/{quotaId} {
      allow read, write: if false;
    }

    match /eventAssistanceOperationalNoticePublications/{publicationId} {
      allow read, write: if false;
    }

    match /eventPlanChanges/{sourceId} {
      allow read, write: if false;
    }

    match /operationRuns/{runId} {
      allow read, write: if false;
    }

    match /operationWorkItems/{workItemId} {
      allow read, write: if false;
    }

    match /operationActionReceipts/{actionId} {
      allow read, write: if false;
    }

    match /operationDecisions/{decisionId} {
      allow read, write: if false;
    }

    match /operationLeases/{leaseId} {
      allow read, write: if false;
    }

    match /operationPublicationPlans/{publicationPlanId} {
      allow read, write: if false;
    }

    match /operationRuleProposals/{ruleProposalId} {
      allow read, write: if false;
    }

    match /operationRuleEvaluations/{ruleEvaluationId} {
      allow read, write: if false;
    }

    // Supply Intake requests and the monthly page-fetch ledger belong to
    // the trusted worker; front doors write requests through callables.
    match /supplyIntakeRequests/{requestId} {
      allow read, write: if false;
    }

    match /supplyIntakeUsage/{monthKey} {
      allow read, write: if false;
    }

    // Remote monitor receipts for authenticated admin CLI executions. Only
    // role-gated Admin SDK callables may create, advance, or list them.
    match /adminActionExecutions/{executionId} {
      allow read, write: if false;
    }

    // Finance review receipts for event messaging ceilings. A decision is not
    // a dispatch budget; only the role-gated callable may write or read it.
    match /eventMessagingBudgetDecisions/{decisionId} {
      allow read, write: if false;
    }

    match /eventMessagingBudgetDecisionReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Immutable evidence that an approved decision updated the two
    // server-owned channel ceilings. It is never direct dispatch authority.
    match /eventMessagingBudgetApplicationReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Written exclusively by admin organizer publishing callables to reserve
    // public website routes before pages become indexable.
    match /publicRouteReservations/{routeKey} {
      allow read, write: if false;
    }

    // Written exclusively by demo-data tooling to track synthetic-data cleanup.
    match /seedEvents/{manifestId} {
      allow read, write: if false;
    }

    // Backend-owned allowlist for seeded beta users who can ask Suvbot for
    // self-scoped demo refreshes.
    match /demoSelfServiceAccess/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow write: if false;
    }

    // Backend-owned request audit trail for Suvbot demo operations.
    match /demoOpsRequests/{requestId} {
      allow read, write: if false;
    }

    // Backend-owned temporary confirmation tokens for destructive Suvbot
    // operations.
    match /demoOpsConfirmations/{confirmationId} {
      allow read, write: if false;
    }

    match /userEventScheduleLocks/{lockId} {
      allow read, write: if false;
    }

    // Server-owned durable activity timeline. Users can read their own timeline
    // and mark items as read, but cannot create, delete, or edit notification
    // content.
    match /notifications/{uid}/items/{notificationId} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow update: if isValidNotificationReadUpdate(uid);
      allow create, delete: if false;
    }

    // Written exclusively by the moderation Cloud Functions.
    match /moderationFlags/{flagId} {
      allow read, write: if false;
    }

    // Written exclusively by the account-deletion Cloud Function.
    match /deletedUsers/{uid} {
      allow read, write: if false;
    }

    // ── Public profiles ───────────────────────────────────────────────────────
    // Synced by the syncPublicProfile Cloud Function trigger. No client writes.
    match /publicProfiles/{uid} {
      allow read: if isAuthed()
        && !isDeletedUser(uid)
        && !hasBlockBetween(request.auth.uid, uid);
      allow write: if false;
    }

    // Canonical organizer authority. All mutations remain callable-owned so
    // type audits, relationship projections, and compatibility shadows stay
    // atomic during the released-client migration window.
    // Private configuration is exposed only through current-manager callables.
    // Immutable admission/payment evidence has no direct client access.
    match /publicEventPayments/{documentId} {
      allow read, write: if false;
    }
    match /publicEventAdmissionReceipts/{documentId} {
      allow read, write: if false;
    }
    match /eventRegistrationReceipts/{documentId} {
      allow read, write: if false;
    }
    match /organizerEventOfferPayments/{documentId} {
      allow read, write: if false;
    }
    match /organizerEventOfferRecipients/{documentId} {
      allow read, write: if false;
    }
    match /organizerFormAdmissions/{documentId} {
      allow read, write: if false;
    }
    match /organizerFormAdmissionReceipts/{documentId} {
      allow read, write: if false;
    }
    match /organizerEventOffers/{documentId} {
      allow read, write: if false;
    }
    match /organizerEventOfferActionReceipts/{documentId} {
      allow read, write: if false;
    }
    match /organizerEventOfferBatchReceipts/{documentId} {
      allow read, write: if false;
    }
    match /organizerEventOfferAudits/{documentId} {
      allow read, write: if false;
    }
    match /eventOfferConfigurationReceipts/{receiptId} {
      allow read, write: if false;
    }
    match /eventSetupPreferences/{eventId} {
      allow read, write: if false;
    }
    match /eventSetupReceipts/{receiptId} {
      allow read, write: if false;
    }
    match /organizerTrackingSettings/{organizerId} {
      allow read, write: if false;
    }
    match /organizerEventSetupDefaults/{organizerId} {
      allow read, write: if false;
    }
    match /organizerEventSetupDefaultReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizers/{organizerId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /organizers/{organizerId}/posts/{postId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    match /organizerTeamMemberships/{membershipId} {
      allow read: if isAuthed()
        && (
          resource.data.uid == request.auth.uid
          || (
            exists(/databases/$(database)/documents/organizers/$(
              resource.data.organizerId
            ))
            && isClubHostData(get(
              /databases/$(database)/documents/organizers/$(
                resource.data.organizerId
              )
            ).data)
          )
        );
      allow write: if false;
    }

    // Reusable Event Success layouts are organizer-owned operational assets.
    // Hosts can list/select them directly, while all mutations stay behind the
    // validated callable so unit geometry and document identity remain atomic.
    match /organizerEventSuccessLayouts/{layoutDocumentId} {
      allow get, list: if isAuthed()
        && resource.data.organizerId is string
        && exists(/databases/$(database)/documents/organizers/$(
          resource.data.organizerId
        ))
        && isClubHostData(get(
          /databases/$(database)/documents/organizers/$(
            resource.data.organizerId
          )
        ).data);
      allow create, update, delete: if false;
    }

    // Saved event venues are organizer-team operational assets. Managers can
    // select them directly; validated callables own every mutation.
    match /organizerEventVenues/{venueDocumentId} {
      allow get, list: if isAuthed()
        && resource.data.organizerId is string
        && exists(/databases/$(database)/documents/organizers/$(
          resource.data.organizerId
        ))
        && isClubHostData(get(
          /databases/$(database)/documents/organizers/$(
            resource.data.organizerId
          )
        ).data);
      allow create, update, delete: if false;
    }

    match /organizerFollows/{followId} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Organizer-scoped WhatsApp/SMS grants are server-owned. Hosts receive
    // only aggregate reachability counts; attendee self-service will use a
    // callable rather than exposing this cross-organizer consent ledger.
    // Catch platform permission is independent of organizer grants. All
    // identity-bound decisions go through participant callables.
    match /catchCommunicationPreferences/{uid} {
      allow read, write: if false;
    }
    match /catchCommunicationPermissionReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizerCommunicationPreferences/{preferenceId} {
      allow read, write: if false;
    }

    // Immutable participant permission evidence is server-only. Neither a
    // manager nor a client may manufacture, rewrite, or delete consent history.
    match /organizerCommunicationPermissionReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Host list views contain only the explicitly allowlisted presentation DTO.
    // Authority always comes from the current organizer, never from the view.
    function isHostSummaryManager(organizerId) {
      return isAuthed() && !isDeletedUser(request.auth.uid)
        && organizerId is string
        && exists(/databases/$(database)/documents/organizers/$(organizerId))
        && isClubHostData(get(
          /databases/$(database)/documents/organizers/$(organizerId)).data);
    }
    match /hostDirectorySummaries/{organizerId} {
      // A missing migration marker is readable as missing by its manager.
      allow get: if isHostSummaryManager(organizerId);
      allow list: if isHostSummaryManager(resource.data.organizerId);
      allow write: if false;
    }
    match /hostFormSummaries/{formId} {
      allow get, list: if isHostSummaryManager(resource.data.organizerId);
      allow write: if false;
    }
    match /hostEventSummaries/{eventId} {
      allow get, list: if isHostSummaryManager(resource.data.organizerId)
        && get(/databases/$(database)/documents/organizers/$(
          resource.data.organizerId)).data.status == 'active'
        && !get(/databases/$(database)/documents/organizers/$(
          resource.data.organizerId)).data.archived;
      allow write: if false;
    }
    match /hostGroupSummaries/{audienceId} {
      allow get, list: if isHostSummaryManager(resource.data.organizerId);
      allow write: if false;
    }
    match /hostGroupDetails/{audienceId} {
      allow get: if isHostSummaryManager(resource.data.organizerId);
      allow list, write: if false;
    }
    match /hostResponseSummaries/{summaryId} {
      allow get, list: if isHostSummaryManager(resource.data.organizerId);
      allow write: if false;
    }
    match /hostContactSummaries/{contactId} {
      allow get, list: if isHostSummaryManager(resource.data.organizerId);
      allow write: if false;
    }

    // Organizer Audience/CRM projections contain restricted operational PII,
    // identity candidates, and business traits. All client access is through
    // manager-authorized, purpose-built callable projections.
    match /organizerContacts/{contactId} {
      allow read, write: if false;
    }

    // Contact source facts are server-owned and move between contact identities
    // only through a receipt-backed merge or unmerge.
    match /organizerContactOrigins/{originId} {
      allow read, write: if false;
    }

    match /organizerContactNotes/{noteId} {
      allow read, write: if false;
    }

    // Manager-asserted outreach attempts are append-only facts written and
    // read only through manager-authorized callables.
    match /organizerContactOutreach/{outreachId} {
      allow read, write: if false;
    }

    match /organizerContactTagVocabularies/{organizerId} {
      allow read, write: if false;
    }

    // Reusable CRM audiences are authored and resolved only through bounded,
    // manager-authorized callables. Definitions and preview metadata are not a
    // client-side Firestore query language.
    match /organizerSavedAudiences/{audienceId} {
      allow read, write: if false;
    }

    // Manual-send tasks contain endpoint and prefill snapshots. Only
    // manager-authorized callables may prepare, inspect, or advance them; an
    // external-app launch is never a delivery receipt.
    match /organizerManualSendTasks/{taskId} {
      allow read, write: if false;
    }

    // Today attention rows are evaluated server projections, not client task
    // definitions. Managers receive a bounded sanitized callable response.
    match /organizerAttentionItems/{attentionId} {
      allow read, write: if false;
    }

    // Entitlement grants and meters are billing state. Only admin-authorized
    // callables write them; managers receive a bounded callable projection.
    match /organizerEntitlements/{organizerId} {
      allow read, write: if false;
    }

    // Mutation receipts are idempotency records for admin callables and are
    // never client-visible.
    match /organizerEntitlementReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizerContactIdentityLinks/{identityLinkId} {
      allow read, write: if false;
    }

    match /organizerContactIdentityClaims/{identityClaimId} {
      allow read, write: if false;
    }

    match /organizerContactEventEdges/{edgeId} {
      allow read, write: if false;
    }

    match /organizerContactTraits/{contactId} {
      allow read, write: if false;
    }

    match /organizerAudienceSummaries/{organizerId} {
      allow read, write: if false;
    }

    match /organizerAudienceProjectionReceipts/{eventId} {
      allow read, write: if false;
    }

    match /organizerContactMergeReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /organizerContactMergeReviewDecisions/{decisionId} {
      allow read, write: if false;
    }

    // Cross-event CRM campaigns, recipient endpoint snapshots, sender health,
    // provider receipts, and suppression state are callable/trigger-only. The
    // Host client receives only purpose-built sanitized projections.
    match /organizerSenderConnections/{connectionId} {
      allow read, write: if false;
    }

    match /organizerProviderConnections/{connectionId} {
      allow read, write: if false;
    }

    // Application forms, answer snapshots, assets, review state, import
    // receipts, and participant consent ledgers contain cross-organizer PII.
    // Clients receive only purpose-built callable projections; even a manager
    // cannot enumerate another organizer's raw documents by direct query.
    match /organizerApplicationForms/{formId} {
      allow read, write: if false;
    }

    match /organizerApplicationFormVersions/{versionId} {
      allow read, write: if false;
    }

    match /organizerApplications/{applicationId} {
      allow read, write: if false;
    }

    match /organizerApplicationResponses/{responseId} {
      allow read, write: if false;
    }

    match /organizerApplicationAssets/{assetId} {
      allow read, write: if false;
    }

    match /organizerApplicationSourceMappings/{mappingId} {
      allow read, write: if false;
    }

    match /organizerApplicationImportReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Generic Forms metadata, mutable drafts, and immutable versions are
    // callable-owned. Host clients receive only manager-authorized bounded
    // projections and public respondents receive a separate safe projection.
    match /organizerForms/{formId} {
      allow read, write: if false;
    }

    match /organizerFormDomains/{hostname} {
      allow read, write: if false;
    }

    match /organizerFormDrafts/{formId} {
      allow read, write: if false;
    }

    match /organizerFormVersions/{versionId} {
      allow read, write: if false;
    }

    match /organizerFormResponseDrafts/{draftId} {
      allow read, write: if false;
    }

    // Only server payment operations can access merchant bindings, OAuth
    // state, financial ledgers and signed webhook receipts.
    match /paymentRoutingPolicies/{policyId} {
      allow read, write: if false;
    }
    match /organizerPaymentConnections/{connectionId} {
      allow read, write: if false;
    }
    match /organizerPaymentOauthStates/{stateId} {
      allow read, write: if false;
    }
    match /organizerFormPayments/{paymentId} {
      allow read, write: if false;
    }
    match /organizerFormPaymentWebhooks/{receiptId} {
      allow read, write: if false;
    }

    match /organizerFormResponses/{responseId} {
      allow read, write: if false;
    }

    match /organizerFormAssets/{assetId} {
      allow read, write: if false;
    }

    match /organizerFormShareLinks/{linkId} {
      allow read, write: if false;
    }

    match /organizerFormAggregates/{aggregateId} {
      allow read, write: if false;
    }

    match /organizerFormAggregateEvents/{eventId} {
      allow read, write: if false;
    }

    match /organizerFormExports/{exportId} {
      allow read, write: if false;
    }

    match /organizerFormAutomationRules/{ruleId} {
      allow read, write: if false;
    }

    match /organizerFormAutomationRuns/{runId} {
      allow read, write: if false;
    }

    match /organizerFormConversionReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Form submission prepares private review pointers, never a public profile.
    match /participantFormProfileProposals/{responseId} {
      allow read, write: if false;
    }

    // Event chat admission, membership and replay evidence are server-owned.
    match /eventChatMessages/{id} {
      allow read, write: if false;
    }
    match /eventChatReactions/{id} {
      allow read, write: if false;
    }
    match /eventChatProfileShares/{shareId} {
      allow read, write: if false;
    }
    match /eventChatPresence/{id} {
      allow read, write: if false;
    }
    match /eventChatRooms/{eventId} {
      allow read, write: if false;
    }
    match /eventChatMemberships/{membershipId} {
      allow read, write: if false;
    }
    match /eventChatAccessReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /participantOrganizerCards/{responseId} {
      allow read, write: if false;
    }

    match /participantProfileClaimReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /participantIntakeProfiles/{uid} {
      allow read, write: if false;
    }

    match /participantOrganizerDataGrants/{grantId} {
      allow read, write: if false;
    }

    match /externalEventMappings/{mappingId} {
      allow read, write: if false;
    }

    match /providerSyncRuns/{runId} {
      allow read, write: if false;
    }

    match /organizerMessageTemplates/{templateId} {
      allow read, write: if false;
    }

    match /organizerContactChannelStates/{stateId} {
      allow read, write: if false;
    }

    match /organizerCampaigns/{campaignId} {
      allow read, write: if false;
    }

    // Moments are authored, armed, and fired only through manager/duty-
    // authorized callables and the scheduled sweep; run and send records are
    // engine-internal execution journals.
    match /organizerMoments/{momentId} {
      allow read, write: if false;
    }

    match /organizerMomentRuns/{runId} {
      allow read, write: if false;
    }

    match /organizerMomentSends/{sendId} {
      allow read, write: if false;
    }

    match /organizerMomentSweepState/{sweepId} {
      allow read, write: if false;
    }

    match /organizerBroadcastSummaries/{broadcastId} {
      allow read, write: if false;
    }

    match /organizerCampaignRecipients/{recipientId} {
      allow read, write: if false;
    }

    match /organizerCampaignWebhookReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /campaignDeliveryMessages/{messageId} {
      allow read, write: if false;
    }

    match /campaignWhatsappDispatches/{attemptId} {
      allow read, write: if false;
    }

    match /automationDeliveryMessages/{messageId} {
      allow read, write: if false;
    }

    // Approval notification authority and contact evidence are server-only.
    match /eventApprovalNotificationMessages/{id} {
      allow read, write: if false;
    }
    match /eventApprovalNotificationDispatches/{id} {
      allow read, write: if false;
    }
    match /eventApprovalNotificationPreferences/{id} {
      allow read, write: if false;
    }
    match /eventApprovalNotificationReceipts/{id} {
      allow read, write: if false;
    }
    match /eventApprovalNotificationSettings/{id} {
      allow read, write: if false;
    }
    match /eventApprovalNotificationBudgets/{id} {
      allow read, write: if false;
    }

    match /automationWhatsappDispatches/{attemptId} {
      allow read, write: if false;
    }

    // Source-only permanent setup state and immutable phase/dispatch receipts.
    match /catchWhatsappOperatorSetupOperations/{operationId} {
      allow read, write: if false;
    }

    match /catchWhatsappOperatorSetupAudits/{auditId} {
      allow read, write: if false;
    }

    match /catchWhatsappReplyOperations/{operationId} {
      allow read, write: if false;
    }

    match /catchWhatsappEndpointStops/{stopId} {
      allow read, write: if false;
    }

    match /catchWhatsappReadinessApprovals/{approvalId} {
      allow read, write: if false;
    }

    match /catchWhatsappReadinessIngress/{ingressId} {
      allow read, write: if false;
    }

    match /catchWhatsappReadinessAudits/{auditId} {
      allow read, write: if false;
    }

    match /catchWhatsappReplyReadiness/{readinessId} {
      allow read, write: if false;
    }

    match /catchWhatsappWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /organizerMessagingWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /organizerWhatsappThreads/{threadId} {
      allow read, write: if false;
    }

    match /organizerWhatsappMessages/{messageId} {
      allow read, write: if false;
    }

    match /organizerWhatsappReplyOperations/{operationId} {
      allow read, write: if false;
    }

    match /organizerClaimRequests/{requestId} {
      allow read, write: if false;
    }

    match /organizerScheduleLocks/{lockId} {
      allow read, write: if false;
    }

    // ── Swipes helper ─────────────────────────────────────────────────────────
    function optionalSwipeText(data, field, maxSize) {
      return !hasField(data, field)
        || (data[field] is string && data[field].size() <= maxSize);
    }

    function hasValidSwipeCreate(userId, targetId) {
      return isAuthed()
        && request.auth.uid == userId
        && userId != targetId
        && request.resource.data.keys().hasOnly([
          'swiperId',
          'targetId',
          'eventId',
          'direction',
          'reactionTargetId',
          'reactionTargetType',
          'reactionTargetLabel',
          'reactionTargetPreview',
          'comment',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'swiperId',
          'targetId',
          'eventId',
          'direction',
          'createdAt'
        ])
        && request.resource.data.swiperId == userId
        && request.resource.data.targetId == targetId
        && request.resource.data.eventId is string
        && request.resource.data.direction in ['like', 'pass']
        && optionalSwipeText(request.resource.data, 'reactionTargetId', 80)
        && optionalSwipeText(request.resource.data, 'reactionTargetLabel', 80)
        && optionalSwipeText(
          request.resource.data,
          'reactionTargetPreview',
          240
        )
        && optionalSwipeText(request.resource.data, 'comment', 240)
        && (
          !hasField(request.resource.data, 'reactionTargetType')
          || request.resource.data.reactionTargetType in [
            'heroPhoto',
            'photo',
            'profilePrompt',
            'compatibility',
            'running',
            'details',
            'lifestyle'
          ]
        )
        && (
          request.resource.data.direction == 'like'
          || (
            !hasField(request.resource.data, 'reactionTargetId')
            && !hasField(request.resource.data, 'reactionTargetType')
            && !hasField(request.resource.data, 'reactionTargetLabel')
            && !hasField(request.resource.data, 'reactionTargetPreview')
            && !hasField(request.resource.data, 'comment')
          )
        )
        && request.resource.data.createdAt is timestamp
        && !isDeletedUser(userId)
        && !isDeletedUser(targetId)
        && exists(/databases/$(database)/documents/publicProfiles/$(targetId))
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && hasAttendedEvent(request.resource.data.eventId, userId)
        && hasAttendedEvent(request.resource.data.eventId, targetId)
        && !hasBlockBetween(userId, targetId);
    }

    // ── Events ──────────────────────────────────────────────────────────────────
    // Operational attendee rows may contain imported contact data. Only an
    // authorized organizer manager may enumerate them; attendee-facing lookup
    // and every write remain server-owned.
    match /eventAttendees/{attendeeId} {
      allow read: if isAuthed()
        && resource.data.eventId is string
        && (
          isClubHostForEvent(resource.data.eventId)
          || hasActiveEventOperatorGrant(resource.data.eventId, 'viewRoster')
        );
      allow write: if false;
    }

    match /eventAttendeeImports/{importId} {
      allow read: if isAuthed()
        && resource.data.eventId is string
        && isClubHostForEvent(resource.data.eventId);
      allow write: if false;
    }

    // Upload evidence and reviewed payloads contain private guest contact data.
    // Managers use the scoped callable; no SDK client reads or writes them.
    match /hostRosterIntakeSessions/{sessionId} {
      allow read, write: if false;
    }

    match /hostRosterIntakeSessions/{sessionId}/receipts/{receiptId} {
      allow read, write: if false;
    }

    // Idempotency receipts reveal actor and operational state; the callable
    // returns the bounded result and no client reads or writes this ledger.
    match /eventAttendeeAttendanceReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Live venue-session authority and redemption receipts are callable-only.
    // Printable join links never read or write either collection.
    match /eventVenueSessions/{sessionId} {
      allow read, write: if false;
    }

    match /eventVenueSessionRedemptions/{redemptionId} {
      allow read, write: if false;
    }

    // The no-download identity edge is private to the authenticated owner.
    // It is not a roster-list surface and every mutation is callable-owned.
    match /eventRuntimeParticipants/{participantId} {
      allow get: if isAuthed()
        && resource.data.eventId is string
        && resource.data.uid == request.auth.uid
        && participantId == eventRuntimeParticipantDocId(
          resource.data.eventId,
          request.auth.uid
        );
      allow list: if false;
      allow write: if false;
    }

    // Required-data automation is projected through bounded runtime/Host
    // callables. Current requests and immutable command receipts are private.
    match /eventRuntimeDataRequests/{requestId} {
      allow read, write: if false;
    }

    match /eventRuntimeDataRequestReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Dress rehearsal is a separate callable-only product domain. Hosts and
    // anonymous guests receive bounded projections from Functions; no client
    // can use rehearsal state as a path into live event or attendee data.
    match /eventRehearsalMilestones/{organizerId} {
      allow read, write: if false;
    }

    match /eventRehearsals/{sessionId} {
      allow read, write: if false;
    }

    match /eventRehearsalActors/{actorId} {
      allow read, write: if false;
    }

    match /eventRehearsalActions/{actionId} {
      allow read, write: if false;
    }

    match /eventAttendanceDispositions/{dispositionId} {
      allow read, write: if false;
    }

    match /eventAttendanceDispositionReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /eventRehearsalMovements/{movementId} {
      allow read, write: if false;
    }

    match /eventRehearsalRouteDecisions/{decisionDocumentId} {
      allow read, write: if false;
    }

    match /eventRehearsalCases/{caseId} {
      allow read, write: if false;
    }

    match /eventRehearsalMessages/{messageDocumentId} {
      allow read, write: if false;
    }

    match /eventRehearsalGuestViews/{viewId} {
      allow read, write: if false;
    }

    // Hosts review only the claim queue for events they manage. Claimants get
    // their sanitized state through the bootstrap callable, not roster clues.
    match /eventRuntimeClaimRequests/{requestId} {
      allow read: if isAuthed()
        && resource.data.eventId is string
        && (
          isClubHostForEvent(resource.data.eventId)
          || hasActiveEventOperatorGrant(
            resource.data.eventId,
            'reviewRuntimeClaims'
          )
        );
      allow write: if false;
    }

    match /eventStaffGrants/{grantId} {
      allow get: if isAuthed()
        && resource.data.uid == request.auth.uid
        && grantId == eventStaffGrantDocId(resource.data.eventId, request.auth.uid);
      allow list, write: if false;
    }

    // Private wedding/corporate programs. Every document in this family is
    // private operational data: no direct client list/read, all access goes
    // through scoped callables that apply duty and field redaction.
    match /organizerPrograms/{programId} {
      allow read, write: if false;
    }

    match /programFunctions/{functionId} {
      allow read, write: if false;
    }

    // Relationship acquisition and membership authority are server-owned.
    match /programLodgingProposals/{proposalId} {
      allow read, write: if false;
    }
    match /programLodgingWorkflows/{programId} {
      allow read, write: if false;
    }
    match /programLodgingConfigs/{programId} {
      allow read, write: if false;
    }
    match /programLodgingSourceVersions/{programId} {
      allow read, write: if false;
    }
    match /programLodgingReceipts/{receiptId} {
      allow read, write: if false;
    }
    match /workspaceMembershipAssertions/{assertionId} {
      allow read, write: if false;
    }
    match /workspaceMembershipDecisions/{decisionId} {
      allow read, write: if false;
    }
    match /workspaceFieldAssertions/{assertionId} {
      allow read, write: if false;
    }
    match /workspaceFieldDecisions/{decisionId} {
      allow read, write: if false;
    }
    match /organizerCommunityMemberships/{membershipId} {
      allow read, write: if false;
    }
    match /organizerCommunityMembershipDecisions/{decisionId} {
      allow read, write: if false;
    }

    match /programGuests/{guestId} {
      allow read, write: if false;
    }

    match /programGuestGroups/{groupId} {
      allow read, write: if false;
    }

    match /programFunctionGuests/{functionGuestId} {
      allow read, write: if false;
    }

    match /programDoorJournal/{journalId} {
      allow read, write: if false;
    }
    match /programHouseholds/{householdId} {
      allow read, write: if false;
    }

    // Staff may read only their own grant so the restricted work shell can
    // discover duties without a callable round-trip; grant ids are derived.
    match /programStaffGrants/{grantId} {
      allow get: if isAuthed()
        && resource.data.uid == request.auth.uid
        && grantId == programStaffGrantDocId(resource.data.programId, request.auth.uid);
      allow list, write: if false;
    }

    match /programStaffInvites/{inviteId} {
      allow read, write: if false;
    }

    match /programPickupPoints/{pickupPointId} {
      allow read, write: if false;
    }

    match /programHotels/{hotelId} {
      allow read, write: if false;
    }

    match /programTravelLegs/{legId} {
      allow read, write: if false;
    }

    match /programTravelParties/{partyId} {
      allow read, write: if false;
    }

    // Archive-anonymization journal; written only by the retention sweep.
    match /programRetentionRuns/{programId} {
      allow read, write: if false;
    }

    match /programDeliveryMessages/{messageId} {
      allow read, write: if false;
    }

    match /programWhatsappDispatches/{attemptId} {
      allow read, write: if false;
    }

    match /transportVendors/{vendorId} {
      allow read, write: if false;
    }

    match /transportTrips/{tripId} {
      allow read, write: if false;
    }

    match /transportActiveAssignments/{assignmentId} {
      allow read, write: if false;
    }

    match /transportVehicleAssignments/{assignmentId} {
      allow read, write: if false;
    }

    match /transportOperationReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /eventParticipations/{participationId} {
      allow read: if isAuthed()
        && (
          resource.data.uid == request.auth.uid
          || isClubHostForEvent(resource.data.eventId)
        );
      allow write: if false;
    }

    // Cross Paths consent is private to the caller. Server callables own all
    // writes so eligibility and terms-version checks cannot be bypassed.
    match /eventCrossPathsConsents/{consentId} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Reviewed showcase eligibility is server-only. Suggestions receive only
    // a sanitized callable projection after consent and safety checks.
    match /crossPathsShowcaseEligibility/{uid} {
      allow read, write: if false;
    }

    // Exposure receipts are server-only ranking/fatigue inputs. A consumer
    // must never infer who was eligible or who attends which event from them.
    match /crossPathsSuggestionExposures/{exposureId} {
      allow read, write: if false;
    }

    // Invitations expose only their two participants. Clients may query their
    // incoming or outgoing rows, but all lifecycle writes remain callable-owned.
    match /crossPathsInvitations/{invitationId} {
      allow get: if isAuthed()
        && request.auth.uid in resource.data.participantIds
        && !hasBlockBetween(resource.data.senderUid, resource.data.recipientUid);
      allow list: if isAuthed()
        && resource.data.senderUid == request.auth.uid;
      allow list: if isAuthed()
        && resource.data.recipientUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Pair holds reveal the same event-scoped relationship as invitations.
    // Only the two participants can read the exact hold; server transactions
    // exclusively own reservation, confirmation, expiry, and release writes.
    match /crossPathsPairHolds/{holdId} {
      allow get: if isAuthed()
        && request.auth.uid in resource.data.participantIds
        && !hasBlockBetween(
          resource.data.requesterUid,
          resource.data.attendeeUid
        );
      allow list, create, update, delete: if false;
    }

    // Server-owned event-announcement receipts contain frozen recipient and
    // per-delivery evidence. V1 exposes only the sanitized callable response.
    match /organizerPostDeliveryOperations/{postId} {
      allow read, write: if false;
    }

    match /organizerPostDeliveryRecipients/{receiptId} {
      allow read, write: if false;
    }

    match /eventBroadcasts/{broadcastId} {
      allow read, write: if false;
    }

    match /eventWaitlistOffers/{offerId} {
      allow read: if isAuthed()
        && resource.data.eventId is string
        && resource.data.uid is string
        && (
          resource.data.uid == request.auth.uid
          || isClubHostForEvent(resource.data.eventId)
        );
      allow write: if false;
    }

    match /eventInviteLinks/{inviteLinkId} {
      allow read: if isAuthed()
        && resource.data.eventId is string
        && isClubHostForEvent(resource.data.eventId);
      allow write: if false;
    }

    match /eventInviteLinkSecrets/{inviteLinkId} {
      allow read, write: if false;
    }

    match /eventInviteTouches/{touchId} {
      allow read, write: if false;
    }

    match /eventShareIntents/{intentId} {
      allow read, write: if false;
    }

    match /eventInviteAttributions/{attributionId} {
      allow read, write: if false;
    }

    match /savedEvents/{savedEventId} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid;
      allow create: if isAuthed()
        && request.resource.data.keys().hasOnly(['uid', 'eventId', 'savedAt'])
        && request.resource.data.keys().hasAll(['uid', 'eventId', 'savedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventId is string
        && request.resource.data.savedAt is timestamp
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && isPublicEventData(get(/databases/$(database)/documents/events/$(
          request.resource.data.eventId
        )).data)
        && savedEventId == savedEventDocId(request.auth.uid, request.resource.data.eventId);
      allow delete: if isAuthed() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Legacy documents predate progressive setup. A record carrying any new
    // setup marker must explicitly be published before public reads work.
    function isPublicEventData(data) {
      return data.get('publicationState', '') == 'published'
        || !data.keys().hasAny(['publicationState', 'setupRevision']);
    }

    function canReadPrivateEvent(eventId, data) {
      return isAuthed()
        && !isDeletedUser(request.auth.uid)
        && data.get('publicationState', '') == 'private'
        && data.get('organizerId', '') is string
        && data.get('organizerId', '') == data.get('clubId', '')
        && (
          isClubHostForEvent(eventId)
          || hasActiveEventOperatorGrant(eventId, 'viewRoster')
        );
    }

    match /events/{eventId} {
      allow get: if isPublicEventData(resource.data)
        || canReadPrivateEvent(eventId, resource.data);
      // Deploy only after the reviewed legacy backfill and compatible client
      // release. Manager draft inventory uses its authorized callable.
      // Client filtering and Remote Config cannot enforce draft privacy.
      allow list: if resource.data.publicationState == 'published';

      // Event creation is callable-owned so host authority and server-owned
      // booking fields stay in one backend contract.
      allow create: if false;

      // Booking, waitlist, attendance, cancellation, and host edits are all
      // callable-owned so canonical event projections cannot be mutated directly.
      allow update: if false;

      // Event deletion needs backend cleanup/refunds before it can be safely
      // exposed.
      allow delete: if false;
    }

    match /externalEvents/{eventId} {
      allow get, list: if resource.data.publicationStatus == 'public'
        && resource.data.status == 'active';
      allow write: if false;
    }

    match /eventPrivateAccess/{eventId} {
      allow read: if isAuthed()
        && resource.data.eventId == eventId
        && isClubHostForEvent(eventId);
      allow write: if false;
    }

    function isValidEventSuccessPlan(eventId, data) {
      return data.keys().hasOnly([
          'eventId', 'clubId', 'playbookId', 'selectedModuleIds',
          'targetAttendeeCount', 'structureConfig', 'hostGoal', 'wingmanRequestsEnabled',
          'contextualOpenersEnabled', 'compatibilityAffectsRanking',
          'questionnaireConfig', 'conversationGraphConsentMode',
          'activeStepIndex', 'liveControlRevision',
          'assignmentDraftRevision', 'publishedRotationRoundIndex',
          'publishedRevealRoundIndex', 'status',
          'revealStatus', 'activeRevealRoundIndex', 'revealStartedAt',
          'attendeePrompt', 'createdAt', 'updatedAt', 'frozenAt',
          'completedAt'
        ])
        && data.keys().hasAll([
          'eventId', 'clubId', 'playbookId', 'selectedModuleIds',
          'targetAttendeeCount', 'hostGoal', 'wingmanRequestsEnabled',
          'contextualOpenersEnabled', 'activeStepIndex', 'status',
          'createdAt', 'updatedAt'
        ])
        && exists(/databases/$(database)/documents/events/$(eventId))
        && data.eventId == eventId
        && data.clubId == get(/databases/$(database)/documents/events/$(eventId)).data.clubId
        && data.playbookId is string
        && data.playbookId.size() > 0
        && data.playbookId.size() <= 120
        && data.selectedModuleIds is list
        && data.selectedModuleIds.size() <= 24
        && data.targetAttendeeCount is number
        && data.targetAttendeeCount >= 1
        && data.targetAttendeeCount <= 1000
        && (
          !hasField(data, 'structureConfig')
          || isValidEventSuccessStructureConfig(data.structureConfig)
        )
        && data.hostGoal is string
        && data.hostGoal.size() <= 300
        && data.wingmanRequestsEnabled is bool
        && data.contextualOpenersEnabled is bool
        && optionalBool(data, 'compatibilityAffectsRanking')
        && (
          !hasField(data, 'conversationGraphConsentMode')
          || data.conversationGraphConsentMode in ['optIn', 'optOut']
        )
        && (
          !hasField(data, 'questionnaireConfig')
          || isValidEventSuccessQuestionnaireConfig(data.questionnaireConfig)
        )
        && data.activeStepIndex is number
        && data.activeStepIndex >= 0
        && data.activeStepIndex <= 100
        && data.status in ['setup', 'live', 'complete']
        && (
          !hasField(data, 'revealStatus')
          || data.revealStatus in ['idle', 'countingDown', 'revealed']
        )
        && optionalNumber(data, 'activeRevealRoundIndex')
        && (
          !hasField(data, 'activeRevealRoundIndex')
          || (
            data.activeRevealRoundIndex >= 0
            && data.activeRevealRoundIndex <= 100
          )
        )
        && optionalTimestamp(data, 'revealStartedAt')
        && optionalString(data, 'attendeePrompt')
        && (!hasField(data, 'attendeePrompt') || data.attendeePrompt == null || data.attendeePrompt.size() <= 300)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && optionalTimestamp(data, 'frozenAt')
        && optionalTimestamp(data, 'completedAt');
    }

    function isValidEventSuccessStructureConfig(data) {
      return data is map
        && data.keys().hasOnly([
          'unitKind',
          'unitSize',
          'unitCount',
          'rotationIntervalMinutes',
          'topology',
          'resourceCapacity',
          'revealCountdownSeconds',
          'rotationRepeatStrategy',
          'maxPairMeetings',
          'balanceActivityAttributes',
          'clusterActivityAttributes'
        ])
        && data.keys().hasAll(['unitKind', 'unitSize', 'revealCountdownSeconds'])
        && data.unitKind in ['wholeGroup', 'pods', 'pairs', 'teams', 'tables']
        && data.unitSize is number
        && data.unitSize >= 1
        && data.unitSize <= 1000
        && optionalNumber(data, 'unitCount')
        && (
          !hasField(data, 'unitCount')
          || data.unitCount == null
          || (data.unitCount >= 1 && data.unitCount <= 200)
        )
        && optionalNumber(data, 'rotationIntervalMinutes')
        && (
          !hasField(data, 'rotationIntervalMinutes')
          || data.rotationIntervalMinutes == null
          || (
            data.rotationIntervalMinutes >= 5
            && data.rotationIntervalMinutes <= 180
          )
        )
        && (
          !hasField(data, 'topology')
          || data.topology in ['set', 'sequence', 'adjacency']
        )
        && (
          !hasField(data, 'resourceCapacity')
          || data.resourceCapacity == null
          || (
            isValidEventSuccessResourceCapacity(data.resourceCapacity)
            && (
              data.resourceCapacity.seatsPerUnit == null
              || data.topology == 'adjacency'
            )
          )
        )
        && data.revealCountdownSeconds is number
        && data.revealCountdownSeconds >= 0
        && data.revealCountdownSeconds <= 60
        && optionalString(data, 'rotationRepeatStrategy')
        && optionalNumber(data, 'maxPairMeetings');
    }

    function isValidEventSuccessResourceCapacity(data) {
      return data is map
        && data.keys().hasOnly([
          'concurrentUnits',
          'resourceLabelId',
          'seatsPerUnit'
        ])
        && data.keys().hasAll([
          'concurrentUnits',
          'resourceLabelId',
          'seatsPerUnit'
        ])
        && (
          data.concurrentUnits == null
          || (
            data.concurrentUnits is number
            && data.concurrentUnits >= 1
            && data.concurrentUnits <= 200
          )
        )
        && data.resourceLabelId in ['court', 'table', 'lane', 'board']
        && (
          data.seatsPerUnit == null
          || (
            data.seatsPerUnit is number
            && data.seatsPerUnit >= 1
            && data.seatsPerUnit <= 1000
          )
        );
    }

    function isValidEventSuccessQuestionnaireConfig(data) {
      return data is map
        && data.keys().hasOnly([
          'templateId',
          'customTitle',
          'customQuestions'
        ])
        && data.keys().hasAll(['templateId'])
        && data.templateId is string
        && data.templateId.size() > 0
        && data.templateId.size() <= 120
        && optionalString(data, 'customTitle')
        && (
          !hasField(data, 'customTitle')
          || data.customTitle == null
          || data.customTitle.size() <= 80
        )
        && (
          !hasField(data, 'customQuestions')
          || (
            data.customQuestions is list
            && data.customQuestions.size() <= 8
          )
        );
    }

    function eventCountPositive(data, field) {
      return data.keys().hasAny([field])
        && data[field] is number
        && data[field] > 0;
    }

    function eventSuccessSetupBlockedByEvent(eventId) {
      let eventData = get(/databases/$(database)/documents/events/$(eventId)).data;
      return eventData.startTime <= request.time
        || eventCountPositive(eventData, 'bookedCount')
        || eventCountPositive(eventData, 'waitlistedCount')
        || eventCountPositive(eventData, 'checkedInCount');
    }

    function eventSuccessPlanSetupFrozen() {
      return resource.data.status != 'setup'
        || (
          resource.data.keys().hasAny(['frozenAt'])
          && resource.data.frozenAt != null
        );
    }

    function eventSuccessPlanChangedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function eventSuccessPlanImmutableFieldsUnchanged() {
      return request.resource.data.eventId == resource.data.eventId
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isEventSuccessPlanCreateAllowed(eventId) {
      return isValidEventSuccessPlan(eventId, request.resource.data)
        && !eventSuccessSetupBlockedByEvent(eventId)
        && request.resource.data.status == 'setup'
        && request.resource.data.activeStepIndex == 0
        && !request.resource.data.keys().hasAny([
          'liveControlRevision', 'assignmentDraftRevision',
          'publishedRotationRoundIndex', 'publishedRevealRoundIndex'
        ])
        && (
          !request.resource.data.keys().hasAny(['revealStatus'])
          || request.resource.data.revealStatus == 'idle'
        )
        && (
          !request.resource.data.keys().hasAny(['activeRevealRoundIndex'])
          || request.resource.data.activeRevealRoundIndex == 0
        )
        && (
          !request.resource.data.keys().hasAny(['revealStartedAt'])
          || request.resource.data.revealStartedAt == null
        )
        && (
          !request.resource.data.keys().hasAny(['frozenAt'])
          || request.resource.data.frozenAt == null
        )
        && (
          !request.resource.data.keys().hasAny(['completedAt'])
          || request.resource.data.completedAt == null
        );
    }

    function isEventSuccessSetupUpdate() {
      return eventSuccessPlanChangedKeys().hasOnly([
        'playbookId', 'selectedModuleIds', 'targetAttendeeCount',
        'structureConfig', 'hostGoal', 'wingmanRequestsEnabled',
        'contextualOpenersEnabled', 'compatibilityAffectsRanking',
        'questionnaireConfig', 'conversationGraphConsentMode',
        'attendeePrompt', 'updatedAt'
      ]);
    }

    function isEventSuccessPlanUpdateAllowed(eventId) {
      return eventSuccessPlanImmutableFieldsUnchanged()
        && !eventSuccessSetupBlockedByEvent(eventId)
        && !eventSuccessPlanSetupFrozen()
        && isEventSuccessSetupUpdate()
        && isValidEventSuccessPlan(eventId, request.resource.data);
    }

    function isValidEventSuccessFeedback(feedbackId, data) {
      return data.keys().hasOnly([
          'eventId', 'clubId', 'uid', 'welcomeRating', 'structureRating',
          'metNewPeopleCount', 'safetyConcern',
          'privateNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'eventId', 'clubId', 'uid', 'welcomeRating', 'structureRating',
          'metNewPeopleCount', 'safetyConcern',
          'createdAt', 'updatedAt'
        ])
        && exists(/databases/$(database)/documents/events/$(data.eventId))
        && feedbackId == eventSuccessFeedbackDocId(data.eventId, data.uid)
        && data.uid == request.auth.uid
        && data.clubId == get(/databases/$(database)/documents/events/$(data.eventId)).data.clubId
        && get(/databases/$(database)/documents/events/$(data.eventId)).data.endTime <= request.time
        && hasCheckedInEventSuccessAccess(data.eventId, data.uid)
        && data.welcomeRating is number
        && data.welcomeRating >= 1
        && data.welcomeRating <= 5
        && data.structureRating is number
        && data.structureRating >= 1
        && data.structureRating <= 5
        && data.metNewPeopleCount is number
        && data.metNewPeopleCount >= 0
        && data.metNewPeopleCount <= 100
        && data.safetyConcern is bool
        && optionalString(data, 'privateNote')
        && (!hasField(data, 'privateNote') || data.privateNote == null || data.privateNote.size() <= 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEventSuccessPreference(preferenceId, data) {
      return data.keys().hasOnly([
          'eventId', 'clubId', 'uid', 'microPodsOptedOut',
          'guidedRotationsOptedOut',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'eventId', 'clubId', 'uid', 'microPodsOptedOut',
          'guidedRotationsOptedOut',
          'createdAt', 'updatedAt'
        ])
        && exists(/databases/$(database)/documents/events/$(data.eventId))
        && preferenceId == eventSuccessPreferenceDocId(data.eventId, data.uid)
        && data.uid == request.auth.uid
        && data.clubId == get(/databases/$(database)/documents/events/$(data.eventId)).data.clubId
        && hasEventSuccessParticipantAccess(data.eventId, data.uid)
        && data.microPodsOptedOut is bool
        && data.guidedRotationsOptedOut is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEventSuccessCompatibilityResponse(responseId, data) {
      return data.keys().hasOnly([
          'eventId', 'clubId', 'uid', 'answerIds', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'eventId', 'clubId', 'uid', 'answerIds', 'createdAt', 'updatedAt'
        ])
        && exists(/databases/$(database)/documents/events/$(data.eventId))
        && responseId == eventSuccessCompatibilityResponseDocId(
          data.eventId,
          data.uid
        )
        && data.uid == request.auth.uid
        && data.clubId == get(/databases/$(database)/documents/events/$(data.eventId)).data.clubId
        && hasEventSuccessParticipantAccess(data.eventId, data.uid)
        && data.answerIds is list
        && data.answerIds.size() >= 1
        && data.answerIds.size() <= 8
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /eventSuccessPlans/{eventId} {
      allow read: if canReadEventSuccess(eventId);
      allow create: if isAuthed()
        && isClubHostForEvent(eventId)
        && isEventSuccessPlanCreateAllowed(eventId);
      allow update: if isAuthed()
        && isClubHostForEvent(eventId)
        && isEventSuccessPlanUpdateAllowed(eventId);
      allow delete: if false;
    }

    match /eventSuccessFeedback/{feedbackId} {
      allow read: if isAuthed()
        && resource.data.uid == request.auth.uid;
      allow create, update: if isAuthed()
        && isValidEventSuccessFeedback(feedbackId, request.resource.data);
      allow delete: if false;
    }

    match /eventSuccessConversationGraphs/{graphId} {
      allow get: if isAuthed()
        && resource.data.keys().hasAll(['eventId', 'uid'])
        && resource.data.eventId is string
        && resource.data.uid == request.auth.uid
        && graphId == eventSuccessConversationGraphDocId(
          resource.data.eventId,
          request.auth.uid
        )
        && hasCheckedInEventSuccessAccess(
          resource.data.eventId,
          request.auth.uid
        );
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /eventSafetyReports/{reportId} {
      allow read, write: if false;
    }

    match /eventSuccessPreferences/{preferenceId} {
      allow read: if isAuthed()
        && (
          resource.data.uid == request.auth.uid
          || isClubHostForEvent(resource.data.eventId)
        );
      allow create, update: if isAuthed()
        && isValidEventSuccessPreference(preferenceId, request.resource.data);
      allow delete: if false;
    }

    match /eventSuccessCompatibilityResponses/{responseId} {
      allow get: if isAuthed()
        && resource.data.keys().hasAll(['eventId', 'uid'])
        && resource.data.eventId is string
        && resource.data.uid == request.auth.uid
        && responseId == eventSuccessCompatibilityResponseDocId(
          resource.data.eventId,
          request.auth.uid
        )
        && hasEventSuccessParticipantAccess(
          resource.data.eventId,
          request.auth.uid
        );
      allow list: if false;
      allow create, update: if isAuthed()
        && isValidEventSuccessCompatibilityResponse(
          responseId,
          request.resource.data
        );
      allow delete: if false;
    }

    match /eventSuccessWingmanRequests/{requestId} {
      allow get: if isAuthed()
        && resource.data.keys().hasAll([
          'eventId', 'requesterUid', 'status', 'hostVisibleConsent'
        ])
        && resource.data.eventId is string
        && resource.data.requesterUid is string
        && resource.data.status is string
        && resource.data.hostVisibleConsent is bool
        && (
          resource.data.requesterUid == request.auth.uid
          || (
            resource.data.status == 'active'
            && resource.data.hostVisibleConsent == true
            && isClubHostForEvent(resource.data.eventId)
          )
        );
      allow list: if isAuthed()
        && resource.data.eventId is string
        && resource.data.status == 'active'
        && resource.data.hostVisibleConsent == true
        && isClubHostForEvent(resource.data.eventId);
      allow create, update: if false;
      allow delete: if false;
    }

    match /eventSuccessArrivalMissions/{missionId} {
      allow get: if isAuthed()
        && resource.data.keys().hasAll(['eventId', 'observerUid'])
        && resource.data.eventId is string
        && resource.data.observerUid == request.auth.uid
        && missionId == eventSuccessArrivalMissionDocId(
          resource.data.eventId,
          request.auth.uid
        )
        && hasEventSuccessParticipantAccess(
          resource.data.eventId,
          request.auth.uid
        );
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /eventSuccessAssignments/{assignmentId} {
      allow get: if isAuthed()
        && resource.data.eventId is string
        && resource.data.moduleId is string
        && resource.data.uid is string
        && assignmentId == eventSuccessAssignmentDocId(
          resource.data.eventId,
          resource.data.moduleId,
          resource.data.uid
        )
        && (
          isClubHostForEvent(resource.data.eventId)
          || (
            resource.data.uid == request.auth.uid
            && hasEventSuccessParticipantAccess(
              resource.data.eventId,
              request.auth.uid
            )
          )
        );
      allow list: if isAuthed()
        && resource.data.eventId is string
        && resource.data.moduleId is string
        && isClubHostForEvent(resource.data.eventId);
      allow write: if false;
    }

    match /eventSuccessAssignmentDrafts/{assignmentDraftId} {
      allow get, list: if isAuthed()
        && resource.data.eventId is string
        && resource.data.moduleId == 'guided_rotations'
        && isClubHostForEvent(resource.data.eventId);
      allow write: if false;
    }

    match /eventAssignmentFeatureConsents/{consentId} {
      allow read, write: if false;
    }

    match /eventSuccessPresence/{presenceId} {
      allow read, write: if false;
    }

    match /eventLivePositions/{positionId} {
      allow read, write: if false;
    }

    match /eventSuccessLateArrivals/{resolutionId} {
      allow get: if isAuthed()
        && resource.data.eventId is string
        && resource.data.uid is string
        && resolutionId == eventSuccessLateArrivalDocId(
          resource.data.eventId,
          resource.data.uid
        )
        && (
          isClubHostForEvent(resource.data.eventId)
          || (
            resource.data.uid == request.auth.uid
            && hasEventSuccessParticipantAccess(
              resource.data.eventId,
              request.auth.uid
            )
          )
        );
      allow list, write: if false;
    }

    match /eventSuccessUnitOutcomes/{eventId} {
      allow get: if isAuthed()
        && resource.data.eventId == eventId
        && isClubHostForEvent(eventId);
      allow list: if false;
      allow write: if false;
    }

    match /eventSuccessStandings/{eventId} {
      allow get: if isAuthed()
        && resource.data.eventId == eventId
        && (
          isClubHostForEvent(eventId)
          || hasEventSuccessParticipantAccess(eventId, request.auth.uid)
        );
      allow list: if false;
      allow write: if false;
    }

    match /eventSuccessScorecards/{eventId} {
      allow read: if isAuthed() && isClubHostForEvent(eventId);
      allow write: if false;
    }

    // ── Participant success / marketplace metrics ───────────────────────────
    // Raw signals and absolute marketplace metrics are server-owned. User-facing
    // participant momentum should be materialized separately and read only by
    // the subject user.
    match /participantSignalFacts/{factId} {
      allow read, write: if false;
    }

    match /participantMetricCounters/{uid} {
      allow read, write: if false;
    }

    match /participantMarketplaceMetrics/{uid} {
      allow read, write: if false;
    }

    match /participantMomentum/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Payments ──────────────────────────────────────────────────────────────
    // Written exclusively by Cloud Functions (verifyRazorpayPayment).
    // Users can only read their own payment records.
    match /payments/{paymentId} {
      allow read: if isAuthed() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Server-owned tracking docs for created-but-unfulfilled Razorpay orders.
    // Written by createRazorpayOrder/razorpayWebhook and the reconciliation
    // sweep only; clients never touch them.
    match /razorpayPendingOrders/{orderId} {
      allow read, write: if false;
    }

    // Server-owned Stripe Connect and Razorpay Route account state. New ids are
    // {uid}_{provider}; resource ownership keeps both direct reads and the
    // host's provider-list query scoped to the signed-in user. Legacy Stripe
    // documents keyed by uid remain readable during migration.
    match /hostPaymentAccounts/{accountId} {
      allow read: if isAuthed() &&
        (resource.data.userId == request.auth.uid ||
          accountId == request.auth.uid);
      allow write: if false;
    }

    // ── Reviews ───────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAuthed();
      // Review create/update/delete is callable-owned so attendance checks,
      // public reviewer naming, and aggregate recomputation stay server-side.
      allow write: if false;
    }

    // ── Profile decisions ───────────────────────────────────────────────────
    // Each user owns their outgoing decisions subcollection.
    match /profileDecisions/{userId}/outgoing/{targetId} {
      allow read: if request.auth.uid == userId;
      allow create: if hasValidSwipeCreate(userId, targetId);
    }

    // ── Matches ───────────────────────────────────────────────────────────────
    // Created by the onSwipeCreated Cloud Function. Participants can read.
    function isValidMatchUnreadReset() {
      return isAuthed()
        && isMatchParticipant(resource.data, request.auth.uid)
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['unreadCounts'])
        && resource.data.unreadCounts is map
        && request.resource.data.unreadCounts is map
        && request.resource.data.unreadCounts.diff(resource.data.unreadCounts)
            .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.unreadCounts[request.auth.uid] == 0;
    }

    match /matches/{matchId} {
      allow get: if isAuthed()
        && isMatchParticipant(resource.data, request.auth.uid)
        && resource.data.status != 'blocked'
        && !hasBlockBetween(resource.data.user1Id, resource.data.user2Id);
      allow list: if isAuthed()
        && resource.data.user1Id == request.auth.uid
        && resource.data.status == 'active';
      allow list: if isAuthed()
        && resource.data.user2Id == request.auth.uid
        && resource.data.status == 'active';
      allow update: if isValidMatchUnreadReset();
      allow create, delete: if false;
    }

    // ── Chat messages ─────────────────────────────────────────────────────────
    function hasValidChatMessageCreate(matchId) {
      return request.resource.data.keys().hasOnly([
          'senderId',
          'text',
          'imageUrl',
          'sentAt'
        ])
        && request.resource.data.keys().hasAll(['senderId', 'text', 'sentAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && optionalString(request.resource.data, 'imageUrl')
        && (
          request.resource.data.text.size() > 0
          || (
            hasField(request.resource.data, 'imageUrl')
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() > 0
            && request.resource.data.imageUrl.size() <= 2048
          )
        )
        && request.resource.data.sentAt is timestamp
        && isMatchParticipant(
          get(/databases/$(database)/documents/matches/$(matchId)).data,
          request.auth.uid
        )
        && isOpenConversationForMessage(
          get(/databases/$(database)/documents/matches/$(matchId)).data
        );
    }

    function isOpenConversationForMessage(data) {
      return data.status == 'active'
        && (
          !hasField(data, 'conversationType')
          || data.conversationType != 'crossPathsEventPlan'
          || (
            hasField(data, 'eventPlanExpiresAt')
            && data.eventPlanExpiresAt is timestamp
            && data.eventPlanExpiresAt > request.time
          )
        )
        && !hasBlockBetween(data.user1Id, data.user2Id);
    }

    match /matches/{matchId}/messages/{messageId} {
      allow read: if isAuthed()
        && isMatchParticipant(
          get(/databases/$(database)/documents/matches/$(matchId)).data,
          request.auth.uid
        )
        && get(/databases/$(database)/documents/matches/$(matchId))
            .data.status != 'blocked';
      allow create: if isAuthed()
        && hasValidChatMessageCreate(matchId);
      allow update, delete: if false;
    }

    match /salesPartnerMemberships/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesPartnerAssignments/{privateDocument=**} {
      allow read, write: if false;
    }
    // Private Sales authority is available only through scoped server APIs.
    match /organizerSalesAccounts/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesContacts/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesContactRelationships/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesEvidence/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesEvidenceProposals/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesTasks/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesOpportunities/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesActivities/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesCustomFields/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesSettings/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesActionReceipts/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesImportJobs/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesImportRows/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesSuppressionDecisions/{privateDocument=**} {
      allow read, write: if false;
    }
    match /hostOperatorAlerts/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesInboundIntents/{privateDocument=**} {
      allow read, write: if false;
    }
    match /assistantClients/{privateDocument=**} {
      allow read, write: if false;
    }
    match /assistantDelegations/{privateDocument=**} {
      allow read, write: if false;
    }
    match /assistantGatewayBudgets/{privateDocument=**} {
      allow read, write: if false;
    }
    match /assistantManagementReceipts/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesDemoBlueprints/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesDemoCapabilities/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesDemoInvitations/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesFitQueueEntries/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesFitQueueMeta/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesFitQueueReceipts/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesImportHistoryRows/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesImportHistoryRecords/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesPrivacyRestrictions/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesPrivacyPolicies/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesPrivacyPlans/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesPrivacyBatchReceipts/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesImportCompensations/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesDemoContinuations/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesDemoSetups/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesDemoSessions/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesDemoReceipts/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesPilotPlans/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesQuotes/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesQuoteVersions/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesCommercialDecisions/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesOpportunityStageHistory/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesIntelligencePolicies/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesIntelligenceAssessments/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesIntelligenceClauses/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesIntelligenceReceipts/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesIntelligenceScoreSnapshots/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesOutreachDrafts/{privateDocument=**} {
      allow read, write: if false;
    }

    match /salesHostSettlementAttestations/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesHostSettlementEvidenceUses/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesHostSettlementIdentities/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesIntakeLinks/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesProviderAttempts/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesProviderBudgets/{privateDocument=**} {
      allow read, write: if false;
    }
    match /salesOutreachJobs/{privateDocument=**} {
      allow read, write: if false;
    }

  }
}
