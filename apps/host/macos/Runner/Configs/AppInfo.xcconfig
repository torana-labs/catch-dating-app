// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = catch_host_app

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.catchdates.host

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Catch Dates. All rights reserved.

// The Firebase config the "Copy Firebase Environment Config" phase bundles.
// Unflavored builds (`flutter build macos`, `flutter test -d macos`) carry the
// production Host identity above; the host-dev and host-prod configurations
// set their own values (tool/platform/configure_apple_flavors.rb).
FIREBASE_ENV = prod
FIREBASE_ROLE = host
FIREBASE_ROLE_PATH = host/
