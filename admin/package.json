{
  "name": "catch-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node ../tool/admin/generate_admin_action_catalog.mjs && node scripts/generateCallableValidators.mjs",
    "predev": "npm run generate",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run generate",
    "build": "npm run check:boundaries && npm run typecheck && vite build && npm run check:bundle-budget",
    "check:boundaries": "node ../tool/admin/check_import_boundaries.mjs",
    "check:bundle-budget": "node scripts/checkBundleBudget.mjs --check",
    "check:storybook-bundle-budget": "node scripts/checkStorybookBundleBudget.mjs --check",
    "check:query-state": "node ../tool/web/check_react_query_state.mjs --check --surface admin",
    "check:ui-components": "node ../tool/web/check_react_component_governance.mjs --check --surface admin",
    "check:component-registry": "node ../tool/web/check_admin_components.mjs --check",
    "check:feature-ui-size": "node ../tool/web/check_admin_feature_ui_size.mjs --check",
    "preview": "vite preview --host 127.0.0.1",
    "prestorybook": "npm run generate",
    "storybook": "HOME=/tmp/catch-admin-storybook-home STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6007 --host 127.0.0.1 --disable-telemetry",
    "prebuild:storybook": "npm run generate",
    "build:storybook": "HOME=/tmp/catch-admin-storybook-home STORYBOOK_DISABLE_TELEMETRY=1 storybook build --disable-telemetry && npm run check:storybook-bundle-budget",
    "pretest:visual": "npm run generate",
    "test:visual": "node ../tool/web/check_storybook_visuals.mjs --surface admin --check",
    "pretest": "npm run generate",
    "test": "vitest run --project=unit",
    "pretest:coverage": "npm run generate",
    "test:coverage": "vitest run --project=unit --coverage",
    "pretest:storybook:a11y": "npm run generate",
    "test:storybook:a11y": "STORYBOOK_DISABLE_TELEMETRY=1 vitest run --project=storybook",
    "pretest:watch": "npm run generate",
    "test:watch": "vitest --project=unit",
    "check:brand": "npm --workspace @catch/brand run check && npm --workspace @catch/brand test",
    "pretypecheck": "npm run check:brand && npm run generate",
    "typecheck": "npm run check:css-tokens && npm run check:ui && npm run check:ui-components && npm run check:feature-exports && npm run check:component-registry && npm run check:feature-ui-size && npm run check:query-state && tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
    "check:feature-exports": "node ../tool/web/check_admin_feature_exports.mjs --check",
    "check:css-tokens": "stylelint \"src/**/*.css\" && node ../packages/web-config/lint/check-stylelint-suppressions.mjs \"src/**/*.css\" && node --test ../packages/web-config/lint/stylelint.test.mjs",
    "check:ui": "node ../tool/web/check_react_ui.mjs --surface admin"
  },
  "dependencies": {
    "@catch/brand": "0.1.0",
    "@catch/web-config": "0.1.0",
    "@catch/web-ui": "0.1.0",
    "@tanstack/react-query": "^5.104.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^4.1.12",
    "jsdom": "^28.1.0",
    "playwright": "^1.64.1",
    "storybook": "^10.6.2",
    "stylelint": "17.16.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
