      "example": {}
    },
    {
      "actionId": "discovery.settings.update",
      "callable": "adminUpdateDiscoverySettings",
      "workflowIds": [
        "discovery"
      ],
      "guiPath": "/settings/discovery",
      "kind": "mutation",
      "risk": "high",
      "roles": [
        "adminOwner"
      ],
      "confirmation": "action-and-target",
      "targetField": "homeClaimAction",
      "requestSchema": "contracts/callables/admin_update_discovery_settings_payload.schema.json",
      "responseSchema": "contracts/callable_responses/admin_get_discovery_settings_response.schema.json",
      "summary": "Owner-only: replace the discovery rules; every city's plans rebuild.",
      "example": {
        "surfaces": {
          "homeOrganizers": {
            "onCatch": true,
            "notOnCatch": false
          },
          "cityOrganizers": {
            "onCatch": true,
            "notOnCatch": false
          },
          "plans": {
            "onCatch": true,
            "notOnCatch": false
          },
          "totals": {
            "onCatch": true,
            "notOnCatch": false
          }
        },
        "homeOrganizersMinimum": 1,
        "homeClaimAction": false
      }
    }
  ]
