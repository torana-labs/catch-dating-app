{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/admin_update_takedown_request_payload.schema.json",
  "title": "AdminUpdateTakedownRequestCallablePayload",
  "description": "One fixed step on a listing request: acknowledge it, ask for more with a fixed template, action it with a fixed outcome (with the takedown case id when the organiser takedown tool ran), decline it with a fixed reason, record its one appeal, decide that appeal, or close it. Audited.",
  "type": "object",
  "additionalProperties": false,
  "x-owner": "Catch operators (Admin)",
  "required": [
    "requestId",
    "action"
  ],
  "properties": {
    "requestId": {
      "$ref": "../shared/takedown_request_common.schema.json#/definitions/requestId"
    },
    "action": {
      "type": "string",
      "enum": [
        "acknowledge",
        "requestInfo",
        "action",
        "decline",
        "recordAppeal",
        "decideAppeal",
        "close"
      ]
    },
    "infoTemplate": {
      "$ref": "../shared/takedown_request_common.schema.json#/definitions/infoTemplate"
    },
    "outcome": {
      "$ref": "../shared/takedown_request_common.schema.json#/definitions/outcome"
    },
    "caseId": {
      "$ref": "../shared/takedown_request_common.schema.json#/definitions/caseId"
    },
    "declineReason": {
      "$ref": "../shared/takedown_request_common.schema.json#/definitions/declineReason"
    },
    "appealDecision": {
      "$ref": "../shared/takedown_request_common.schema.json#/definitions/appealDecision"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "An optional staff note for the history; never sent."
    }
  }
}
