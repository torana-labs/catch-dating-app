{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/create_program_asset_upload_payload.schema.json",
  "title": "CreateProgramAssetUploadCallablePayload",
  "description": "Sign one upload of a programme file. guestId uploads authenticate with the household RSVP link token; hamper uploads with a signed-in hotel desk account (programId + hotelId) or a porter link token; photo and cover uploads with a signed-in manager or communications account (programId). The same requestId signs the same object path. Nothing is written until the command that uses the file verifies the stored object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contentType",
    "sizeBytes",
    "requestId"
  ],
  "properties": {
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "hotelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "kind": {
      "type": "string",
      "enum": [
        "guestId",
        "hamper",
        "photo",
        "cover"
      ]
    },
    "token": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "contentType": {
      "type": "string",
      "enum": [
        "image/jpeg",
        "image/png",
        "image/webp",
        "application/pdf"
      ]
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    }
  }
}
