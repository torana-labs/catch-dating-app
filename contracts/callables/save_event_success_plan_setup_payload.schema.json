{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/save_event_success_plan_setup_payload.schema.json",
  "title": "SaveEventSuccessPlanSetupCallablePayload",
  "description": "saveEventSuccessPlanSetup: an organizer host saves the setup fields of an event's live event guide (eventSuccessPlans/{eventId}) while it is still in setup. The write is fenced on the plan's updatedAt, given in microseconds since the epoch, so a save from another device is refused. It is refused once the event has started, has bookings, a waitlist or check-ins, or the plan is live, complete or frozen. Every field is written as given; fields not listed here are never touched.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "expectedUpdatedAtMicros", "setup"],
  "properties": {
    "eventId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "expectedUpdatedAtMicros": {"type": "integer", "minimum": 0, "maximum": 9007199254740991,
      "description": "The plan's updatedAt as the host last read it, in microseconds since the epoch."},
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playbookId", "selectedModuleIds", "targetAttendeeCount", "structureConfig", "hostGoal",
        "wingmanRequestsEnabled", "contextualOpenersEnabled", "compatibilityAffectsRanking", "questionnaireConfig",
        "conversationGraphConsentMode", "attendeePrompt"],
      "properties": {
        "playbookId": {"type": "string", "minLength": 1, "maxLength": 120},
        "selectedModuleIds": {"type": "array", "maxItems": 24, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
        "targetAttendeeCount": {"type": "integer", "minimum": 1, "maximum": 1000},
        "structureConfig": {"$ref": "../shared/event_common.schema.json#/definitions/eventSuccessStructureConfig"},
        "hostGoal": {"type": "string", "maxLength": 300},
        "wingmanRequestsEnabled": {"type": "boolean"},
        "contextualOpenersEnabled": {"type": "boolean"},
        "compatibilityAffectsRanking": {"type": "boolean"},
        "questionnaireConfig": {"$ref": "../shared/event_common.schema.json#/definitions/eventSuccessQuestionnaireConfig"},
        "conversationGraphConsentMode": {"type": "string", "enum": ["optIn", "optOut"]},
        "attendeePrompt": {"type": ["string", "null"], "maxLength": 300}
      }
    }
  }
}
