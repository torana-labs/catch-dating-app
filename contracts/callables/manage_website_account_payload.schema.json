{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/manage_website_account_payload.schema.json",
  "title": "ManageWebsiteAccountCallablePayload",
  "description": "Read or complete the authenticated account with minimal identity, and read the account page sections. Phone ownership comes from Firebase Auth, never payload data.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "const": "read"
        },
        "organizerId": {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        },
        "eventId": {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        },
        "sections": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "plans",
              "following",
              "reviews",
              "messages"
            ]
          },
          "description": "Optional account page sections to read. Omission reads identity only; each section reads only the authenticated UID’s own records."
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "displayName",
        "expectedProfileRevision",
        "expectedUid"
      ],
      "properties": {
        "action": {
          "const": "complete"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": ".*\\S.*"
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "description": "Optional real birth date. Omission preserves existing data; no placeholder is synthesized."
        },
        "expectedProfileRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "organizerId": {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        },
        "eventId": {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        },
        "expectedUid": {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        }
      }
    }
  ]
}
