{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/upsert_program_photo_payload.schema.json",
  "title": "UpsertProgramPhotoCallablePayload",
  "description": "Add a programme photo (photoId = the assetId of an upload made with createProgramAssetUpload, kind photo, expectedRevision 0) or change one: the function it is filed under (null for none), its caption (null to clear) or whether it is shown. Managers and communications staff. expectedRevision fences concurrent edits; replays of the same requestId return the stored result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programId",
    "photoId",
    "expectedRevision",
    "requestId"
  ],
  "properties": {
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "photoId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z]+_[a-f0-9]{40}$"
    },
    "functionId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 180
    },
    "caption": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "visible",
        "hidden"
      ]
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    }
  }
}
