{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/upsert_program_whatsapp_canned_reply_payload.schema.json",
  "title": "UpsertProgramWhatsappCannedReplyCallablePayload",
  "description": "Add a saved reply (expectedRevision 0) or change one. Replays of the same requestId return the stored result. Managers and communications staff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programId",
    "cannedReplyId",
    "label",
    "variants",
    "expectedRevision",
    "requestId"
  ],
  "properties": {
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "cannedReplyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "text"
        ],
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "en",
              "hi",
              "gu",
              "mr",
              "ta"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "sortOrder": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "archived": {
      "type": "boolean"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    }
  }
}
