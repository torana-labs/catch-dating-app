{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/update_organizer_program_payload.schema.json",
  "title": "UpdateOrganizerProgramCallablePayload",
  "description": "Patch program fields. Omitted fields are unchanged; expectedRevision fences concurrent edits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programId",
    "expectedRevision"
  ],
  "properties": {
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "startsAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "endsAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rsvpDeadlineAtMillis": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "RSVP deadline anchor for Moments; null clears it."
    },
    "status": {
      "$ref": "../shared/program_common.schema.json#/definitions/programStatus"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "../shared/program_common.schema.json#/definitions/programCapability"
      }
    },
    "transportSettings": {
      "$ref": "../shared/program_common.schema.json#/definitions/programTransportSettings"
    },
    "branding": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "color",
        "coverImagePath",
        "creditLine"
      ],
      "properties": {
        "color": {
          "type": "string",
          "enum": [
            "rani",
            "marigold",
            "mehendi",
            "rose",
            "haldi"
          ],
          "description": "The guest pages accent colour."
        },
        "coverImagePath": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300,
          "pattern": "^programs/[A-Za-z0-9_-]{1,180}/branding/[A-Za-z0-9._-]{1,100}$",
          "description": "Storage path of the cover photo under the programme branding folder, or null for none."
        },
        "creditLine": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "The planner credit on guest pages, or null to hide it."
        }
      },
      "description": "Replace how guest pages look, or null to clear it. Omitted keeps it."
    },
    "whatsappSenderConnectionId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 180,
      "description": "Bind the wedding's own WhatsApp number (an organizerSenderConnections id of the same organiser), or null to fall back to the organiser's first active number. Omitted keeps it."
    }
  }
}
