{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/get_program_vendor_run_sheet_payload.schema.json",
  "title": "GetProgramVendorRunSheetCallablePayload",
  "description": "Read a vendor's run sheet through their signed link; no sign-in.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token"
  ],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    }
  }
}
