{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/get_program_driver_trip_payload.schema.json",
  "title": "GetProgramDriverTripCallablePayload",
  "description": "Read one trip through a driver's signed link; no sign-in.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token"
  ],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    }
  }
}
