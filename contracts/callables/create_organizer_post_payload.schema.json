{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/create_organizer_post_payload.schema.json",
  "title": "CreateOrganizerPostCallablePayload",
  "description": "Callable payload accepted by createOrganizerPost.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizerId",
    "requestId",
    "text"
  ],
  "properties": {
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "requestId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "photoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "contains": {"const": "app"},
      "items": {"type": "string", "enum": ["app", "whatsapp"]},
      "description": "Where the update goes. Absent means [\"app\"]. whatsapp also sends it to followers who ticked WhatsApp updates, through the organiser's own number and approved organizer_follower_update template; it counts against the same weekly allowance."
    }
  }
}
