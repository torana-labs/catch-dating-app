{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/decide_program_guest_id_payload.schema.json",
  "title": "DecideProgramGuestIdCallablePayload",
  "description": "Guest relations accept a submitted ID or ask the household for a clearer one (with an optional note the household sees). expectedRevision fences concurrent decisions; replays of the same requestId return the stored result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programId",
    "guestId",
    "decision",
    "expectedRevision",
    "requestId"
  ],
  "properties": {
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "guestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "decision": {
      "type": "string",
      "enum": [
        "accept",
        "askAgain"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    }
  }
}
