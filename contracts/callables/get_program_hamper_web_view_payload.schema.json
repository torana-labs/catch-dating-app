{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/get_program_hamper_web_view_payload.schema.json",
  "title": "GetProgramHamperWebViewCallablePayload",
  "description": "The porters' hamper list for one hotel, through a hamperPorter web link token (issueProgramWebLink). No sign-in.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token"
  ],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    }
  }
}
