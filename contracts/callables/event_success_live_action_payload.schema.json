{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/event_success_live_action_payload.schema.json",
  "title": "EventSuccessLiveActionCallablePayload",
  "description": "Revision-fenced live control action accepted by controlEventSuccessLive. pauseActiveStep and resumeActiveStep freeze and restart the active step's clock; repeating either is a replay.",
  "x-callable-aliases": ["controlEventSuccessLive"],
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "expectedRevision", "action"],
  "properties": {
    "eventId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "action": {
      "type": "string",
      "enum": [
        "setActiveStep",
        "startRevealCountdown",
        "cancelRevealCountdown",
        "publishReveal",
        "complete",
        "pauseActiveStep",
        "resumeActiveStep"
      ]
    },
    "activeStepIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "roundIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "confirmed": {"type": "boolean"},
    "accountabilityAcknowledged": {
      "type": "boolean",
      "description": "Explicit Host acknowledgement that a sweep still has unresolved checked-in attendees."
    }
  }
}
