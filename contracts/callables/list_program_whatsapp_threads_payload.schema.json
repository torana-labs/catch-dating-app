{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/list_program_whatsapp_threads_payload.schema.json",
  "title": "ListProgramWhatsappThreadsCallablePayload",
  "description": "List one programme's guest WhatsApp threads, newest first. Managers and communications staff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programId",
    "filter"
  ],
  "properties": {
