{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/submit_program_guest_id_payload.schema.json",
  "title": "SubmitProgramGuestIdCallablePayload",
  "description": "A household saves one member's ID for the hotel through its RSVP link token. The images were uploaded first with createProgramAssetUpload (kind guestId). A new submission replaces the last one and waits for a check again. Only the last four characters of the number are accepted. Replays of the same requestId return the stored result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token",
    "guestId",
    "idKind",
    "frontAssetId",
    "requestId"
  ],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "guestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "idKind": {
      "type": "string",
      "enum": [
        "aadhaar",
        "passport",
        "licence",
        "voterId"
      ]
    },
    "numberLast4": {
      "type": "string",
      "pattern": "^[0-9A-Za-z]{4}$"
    },
    "frontAssetId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z]+_[a-f0-9]{40}$"
    },
    "backAssetId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z]+_[a-f0-9]{40}$"
    },
    "visaAssetId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z]+_[a-f0-9]{40}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    }
  }
}
