{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/update_event_payload.schema.json",
  "title": "UpdateEventCallablePayload",
  "description": "Callable payload accepted by updateEvent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "fields"],
  "properties": {
    "eventId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "mediaRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizerId", "requestId", "expectedMediaHash"],
      "description": "Media-only attachment for an already committed create. Replays its eventSetupReceipts media receipt; never edits schedule or setup fields.",
      "properties": {
        "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "requestId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,119}$"},
        "expectedMediaHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "expectedSetupRevision": {
      "type": "integer", "minimum": 1, "maximum": 2147483647,
      "description": "Required for published progressive events; rejects stale Host edits."
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "startTimeMillis": {"type": "integer"},
        "endTimeMillis": {"type": "integer"},
        "meetingPoint": {"type": "string", "minLength": 1, "maxLength": 240},
        "meetingLocation": {
          "$ref": "../shared/event_common.schema.json#/definitions/eventMeetingLocation"
        },
        "startingPointLat": {
          "$ref": "../shared/profile_common.schema.json#/definitions/strictLatitude"
        },
        "startingPointLng": {
          "$ref": "../shared/profile_common.schema.json#/definitions/strictLongitude"
        },
        "locationDetails": {"type": ["string", "null"], "maxLength": 1000},
        "itinerary": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "../shared/event_common.schema.json#/definitions/eventItineraryItem"
          }
        },
        "eventFormat": {
          "$ref": "../shared/event_common.schema.json#/definitions/eventFormatSnapshot"
        },
        "photoUrl": {"$ref": "../shared/event_common.schema.json#/definitions/urlOrNull"},
        "eventPhotos": {
          "type": "array",
          "items": {"$ref": "../embedded/uploaded_photo.schema.json"}
        },
        "distanceKm": {"type": "number", "minimum": 0, "maximum": 100},
        "pace": {"$ref": "../shared/event_common.schema.json#/definitions/paceLevel"},
        "description": {"type": "string", "maxLength": 2000},
        "publicRegistrationEnabled": {
          "type": "boolean",
          "description": "Host-controlled website OTP registration switch. The event must belong to a published organizer before the public registration callable accepts users."
        },
        "womenLed": {
          "type": ["boolean", "null"],
          "description": "Owner or manager override of the organizer's women-led default for this event: true or false overrides it, null follows the organizer again. Informational and filterable only; attendance limits stay in constraints and eventPolicy. Declaring true is refused while an admin lock is in place on the event or its organizer."
        },
        "capacityLimit": {"type": "integer", "minimum": 1, "maximum": 1000},
        "priceInPaise": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minAge": {"type": "integer", "minimum": 0, "maximum": 120},
            "maxAge": {"type": "integer", "minimum": 0, "maximum": 120},
            "maxMen": {"type": ["integer", "null"], "minimum": 0},
            "maxWomen": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "eventPolicy": {
          "$ref": "../shared/event_common.schema.json#/definitions/eventPolicyBundle"
        },
        "privateAccess": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inviteCode": {
              "type": ["string", "null"],
              "minLength": 4,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["mediaRecovery"]},
      "then": {
        "not": {"required": ["expectedSetupRevision"]},
        "properties": {
          "fields": {
            "required": ["photoUrl", "eventPhotos"],
            "propertyNames": {"enum": ["photoUrl", "eventPhotos"]},
            "properties": {"eventPhotos": {"minItems": 1}}
          }
        }
      }
    }
  ]
}
