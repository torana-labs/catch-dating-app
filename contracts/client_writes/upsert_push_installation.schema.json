{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/client_writes/upsert_push_installation.schema.json",
  "title": "UpsertPushInstallationClientWrite",
  "description": "Client-owned Firestore merge set of one app installation's push address at users/{uid}/pushInstallations/{installationId} (PushInstallationStore.save), stamping updatedAt with the server time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "data"
  ],
  "properties": {
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "installationId"
      ],
      "properties": {
        "uid": {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        },
        "installationId": {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        }
      }
    },
    "data": {
      "$ref": "../firestore/push_installations.schema.json"
    }
  },
  "x-firestore-operation": [
    "create",
    "update"
  ],
  "x-firestore-path": "users/{uid}/pushInstallations/{installationId}",
  "x-owner": "authenticated owner direct push installation save"
}
