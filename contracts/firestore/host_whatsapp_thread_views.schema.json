{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/host_whatsapp_thread_views.schema.json",
  "title": "HostWhatsappThreadViewDocument",
  "description": "Server-maintained manager read view of one retained organizer WhatsApp thread for the Host inbox: exactly the summary the retired listOrganizerWhatsappThreads callable returned for it, without the time-dependent service-window flag, plus the retention instant so a client hides a thread whose retention has passed before its source is deleted. Written by triggers on organizerWhatsappThreads and organizerContacts. Holds the latest message body and the contact's display name, which are personal data: only the organizer's current managers read it. Never the phone number, its hash, the sender connection or provider evidence, and never identity, permission or mutation authority.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "hostWhatsappThreadViews",
  "x-firestore-path": "hostWhatsappThreadViews/{threadId}",
  "x-document-id-field": "threadId",
  "x-owner": "Host read model projector (hostReadModels WhatsApp thread view triggers)",
  "required": [
    "organizerId",
    "threadId",
    "contactId",
    "linkedUid",
    "displayName",
    "eventIds",
    "lastMessageBody",
    "lastMessageDirection",
    "lastMessageAtMillis",
    "lastInboundAtMillis",
    "serviceWindowExpiresAtMillis",
    "expiresAtMillis",
    "version"
  ],
  "properties": {
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "threadId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "contactId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "linkedUid": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128,
      "description": "Verified current account identity for the thread's contact; null for unresolved, merged, hidden or deleted identities.",
      "x-catch-ownership": "server-only"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "x-catch-ownership": "server-only"
    },
    "eventIds": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "../shared/event_common.schema.json#/definitions/documentId"
      },
      "x-catch-ownership": "server-only"
    },
    "lastMessageBody": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-catch-ownership": "server-only"
    },
    "lastMessageDirection": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "x-catch-ownership": "server-only"
    },
    "lastMessageAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    },
    "lastInboundAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    },
    "serviceWindowExpiresAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    },
    "expiresAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "The source thread's rolling 12-month retention instant. The view is deleted with the source.",
      "x-catch-ownership": "server-only"
    },
    "version": {
      "const": 1,
      "x-catch-ownership": "server-only"
    }
  }
}
