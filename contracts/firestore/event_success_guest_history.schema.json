{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/event_success_guest_history.schema.json",
  "title": "EventSuccessGuestHistoryDocument",
  "description": "One guest's game history for one night, projected from eventSuccessStandings by trigger: each recorded round with the guest's team or pair and where it stood after that round, and the final standing. The guest reads only their own; nothing else writes it.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "eventSuccessGuestHistory",
  "x-firestore-path": "eventSuccessGuestHistory/{eventId_uid}",
  "x-owner": "onEventSuccessStandingsWritten trigger; the guest reads their own",
  "required": ["eventId", "organizerId", "uid", "unitOutcome", "standingsRevision", "rounds", "finalStanding", "updatedAtMs"],
  "properties": {
    "eventId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId", "x-catch-ownership": "trigger-owned"},
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId", "x-catch-ownership": "trigger-owned"},
    "uid": {"$ref": "../shared/event_common.schema.json#/definitions/documentId", "x-catch-ownership": "trigger-owned"},
    "unitOutcome": {"type": "string", "enum": ["score", "rank"], "x-catch-ownership": "trigger-owned"},
    "standingsRevision": {"type": "integer", "minimum": 0, "maximum": 2147483647, "x-catch-ownership": "trigger-owned"},
    "rounds": {
      "type": "array",
      "maxItems": 101,
      "items": {"$ref": "#/definitions/guestStanding"},
      "x-catch-ownership": "trigger-owned"
    },
    "finalStanding": {
      "oneOf": [{"type": "null"}, {"$ref": "#/definitions/guestStanding"}],
      "x-catch-ownership": "trigger-owned"
    },
    "updatedAtMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991, "x-catch-ownership": "trigger-owned"}
  },
  "definitions": {
    "guestStanding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roundIndex", "unitId", "unitLabel", "position", "value", "first"],
      "properties": {
        "roundIndex": {"type": "integer", "minimum": 0, "maximum": 100},
        "unitId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"},
        "unitLabel": {"type": "string", "minLength": 1, "maxLength": 80},
        "position": {"type": "integer", "minimum": 1, "maximum": 200},
        "value": {"type": "number", "minimum": -100000000, "maximum": 100000000},
        "first": {"type": "boolean", "description": "The guest's unit was in first place after this round."}
      }
    }
  }
}
