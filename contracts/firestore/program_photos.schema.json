{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/program_photos.schema.json",
  "title": "ProgramPhotoDocument",
  "description": "One programme photo, at programPhotos/{programId}_{photoId} (photoId is the upload's asset id), optionally filed under a function. The file lives in private Storage under programs/{programId}/photos/ and leaves the server only as a short-lived signed URL. Server-only; deleted with its file by the archive retention sweep.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "programPhotos",
  "x-firestore-path": "programPhotos/{programPhotoId}",
  "x-owner": "upsertProgramPhoto callable",
  "required": [
    "programId",
    "organizerId",
    "photoId",
    "functionId",
    "storagePath",
    "contentType",
    "sizeBytes",
    "caption",
    "status",
    "uploadedByUid",
    "createdAtMillis",
    "updatedAtMillis",
    "revision",
    "lastRequestId",
    "lastRequestHash"
  ],
  "properties": {
    "programId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "callable-owned"
    },
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "callable-owned"
    },
    "photoId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z]+_[a-f0-9]{40}$",
      "x-catch-ownership": "callable-owned"
    },
    "functionId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180,
      "x-catch-ownership": "callable-owned"
    },
    "storagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^programs/[^/]+/[A-Za-z]+/[A-Za-z0-9_-]+$",
      "x-catch-ownership": "callable-owned"
    },
    "contentType": {
      "type": "string",
      "enum": [
        "image/jpeg",
        "image/png",
        "image/webp"
      ],
      "x-catch-ownership": "callable-owned"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760,
      "x-catch-ownership": "callable-owned"
    },
    "caption": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200,
      "x-catch-ownership": "callable-owned"
    },
    "status": {
      "type": "string",
      "enum": [
        "visible",
        "hidden"
      ],
      "x-catch-ownership": "callable-owned"
    },
    "uploadedByUid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "x-catch-ownership": "callable-owned"
    },
    "createdAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "callable-owned"
    },
    "updatedAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "callable-owned"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-catch-ownership": "callable-owned"
    },
    "lastRequestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "x-catch-ownership": "callable-owned"
    },
    "lastRequestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "x-catch-ownership": "callable-owned"
    }
  }
}
