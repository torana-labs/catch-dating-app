{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/program_vendor_bills.schema.json",
  "title": "ProgramVendorBillDocument",
  "description": "One transport vendor's bill for a programme, at programVendorBills/{programId}_{vendorId}, checked line by line against the vendor's recorded trips (the rate frozen on each trip at dispatch). Commercial record with no guest data. Server-only; written by reconcileProgramVendorBill. The archive retention sweep clears its note and line references.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "programVendorBills",
  "x-firestore-path": "programVendorBills/{programVendorBillId}",
  "x-owner": "reconcileProgramVendorBill callable",
  "required": [
    "programId",
    "organizerId",
    "vendorId",
    "invoiceNumber",
    "receivedAtMillis",
    "currency",
    "lines",
    "totals",
    "status",
    "note",
    "approvedMinor",
    "approvedAtMillis",
    "approvedByUid",
    "updatedAtMillis",
    "revision",
    "lastRequestId",
    "lastRequestHash"
  ],
  "properties": {
    "programId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "callable-owned"
    },
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "callable-owned"
    },
    "vendorId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "callable-owned"
    },
    "invoiceNumber": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80,
      "x-catch-ownership": "callable-owned"
    },
    "receivedAtMillis": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "callable-owned"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "x-catch-ownership": "callable-owned"
    },
    "lines": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lineId",
          "reference",
          "tripId",
          "billedMinor",
          "recordedMinor",
          "check"
        ],
        "properties": {
          "lineId": {
            "type": "string",
            "pattern": "^line-[0-9]{1,4}$"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "tripId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 180
          },
          "billedMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "recordedMinor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "check": {
            "type": "string",
            "enum": [
              "matches",
              "amountDiffers",
              "noRate",
              "noTrip",
              "voided",
              "duplicate"
            ]
          }
        }
      },
      "x-catch-ownership": "callable-owned"
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "billedMinor",
        "recordedMinor",
        "questionMinor",
        "billedTrips",
        "recordedTrips",
        "unbilledTrips"
      ],
      "properties": {
        "billedMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recordedMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "questionMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "billedTrips": {
          "type": "integer",
          "minimum": 0
        },
        "recordedTrips": {
          "type": "integer",
          "minimum": 0
        },
        "unbilledTrips": {
          "type": "integer",
          "minimum": 0
        }
      },
      "x-catch-ownership": "callable-owned"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "questioned",
        "approved"
      ],
      "x-catch-ownership": "callable-owned"
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000,
      "x-catch-ownership": "callable-owned"
    },
    "approvedMinor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "callable-owned"
    },
    "approvedAtMillis": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "callable-owned"
    },
    "approvedByUid": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180,
      "x-catch-ownership": "callable-owned"
    },
    "updatedAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "callable-owned"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-catch-ownership": "callable-owned"
    },
    "lastRequestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "x-catch-ownership": "callable-owned"
    },
    "lastRequestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "x-catch-ownership": "callable-owned"
    },
    "anonymizedAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp",
      "x-catch-ownership": "callable-owned"
    }
  }
}
