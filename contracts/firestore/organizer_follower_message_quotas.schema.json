{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/organizer_follower_message_quotas.schema.json",
  "title": "OrganizerFollowerMessageQuotaDocument",
  "x-firestore-collection": "organizerFollowerMessageQuotas",
  "x-firestore-path": "organizerFollowerMessageQuotas/{quotaId}",
  "description": "Server-only monthly allowance for the website owner view's Message followers: the request ids that used it in one calendar month (Asia/Kolkata). Document id: {organizerId}_{yyyymm}. At most two per month; a replayed request id reuses its slot.",
  "type": "object",
  "additionalProperties": false,
  "required": ["organizerId", "month", "requestIds", "updatedAtMillis"],
  "properties": {
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "requestIds": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"}
    },
    "updatedAtMillis": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
