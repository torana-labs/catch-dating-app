{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/event_seat_migration_plans.schema.json",
  "title": "EventSeatMigrationPlanDocument",
  "description": "Frozen output of a seat-ledger bootstrap plan: the ledger to write and every reservation, alias and phone proof to create, bound by hash. Capped at 750 KB.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "eventSeatMigrationPlans",
  "x-firestore-path": "eventSeatMigrationPlans/{eventId}",
  "x-document-id-field": "id",
  "x-owner": "Seat migration bootstrap (functions/src/events/seatMigrationPaged.ts)",
  "required": [
    "eventId",
    "organizerId",
    "migrationRevision",
    "hash",
    "ledger",
    "outputs"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "x-catch-ownership": "server-only"
    },
    "organizerId": {
      "type": "string",
      "minLength": 1,
      "x-catch-ownership": "server-only"
    },
    "migrationRevision": {
      "type": "integer",
      "minimum": 1,
      "x-catch-ownership": "server-only"
    },
    "hash": {
      "type": "string",
      "minLength": 1,
      "x-catch-ownership": "server-only"
    },
    "ledger": {
      "type": "object",
      "description": "The seat ledger the plan writes (see EventSeatLedgerDocument).",
      "x-catch-ownership": "server-only"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collection",
          "id",
          "value"
        ],
        "properties": {
          "collection": {
            "type": "string",
            "enum": [
              "eventSeatReservations",
              "eventSeatIdentityAliases",
              "eventSeatVerifiedPhones"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "object"
          }
        }
      },
      "x-catch-ownership": "server-only"
    }
  }
}
