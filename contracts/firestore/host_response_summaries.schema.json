{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/host_response_summaries.schema.json",
  "title": "HostResponseSummaryDocument",
  "description": "Server-maintained response inbox metadata. No answer snapshots or asset URLs. Withdrawal atomically redacts a verified view or deletes an invalid view.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "hostResponseSummaries",
  "x-firestore-path": "hostResponseSummaries/{summaryId}",
  "x-owner": "Host read model projector",
  "required": [
    "organizerId",
    "summaryId",
    "kind",
    "formId",
    "submittedAtMillis",
    "row",
    "version"
  ],
  "properties": {
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "summaryId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "kind": {
      "enum": [
        "response",
        "application"
      ],
      "x-catch-ownership": "server-only"
    },
    "formId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "submittedAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    },
    "row": {
      "$ref": "../callable_responses/list_organizer_form_responses_response.schema.json#/properties/entries/items",
      "x-catch-ownership": "server-only"
    },
    "version": {
      "const": 1,
      "x-catch-ownership": "server-only"
    },
    "reviewStatus": {
      "description": "Optional query copy of row.application.reviewStatus for the per-status filters and counts. Absent (read as none) on older views and on responses without an application.",
      "$ref": "../callable_responses/list_organizer_applications_response.schema.json#/definitions/application/properties/reviewStatus",
      "x-catch-ownership": "server-only"
    },
    "offer": {
      "description": "Optional derived state of the latest non-draft event offer made from this entry's application (organizerEventOffers.applicationId), recomputed when the offer changes. Absent or null reads as no offer.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "eventId",
            "offeredAtMillis"
          ],
          "properties": {
            "status": {
              "enum": [
                "offered",
                "withdrawn",
                "expired"
              ]
            },
            "eventId": {
              "$ref": "../shared/event_common.schema.json#/definitions/documentId"
            },
            "offeredAtMillis": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "x-catch-ownership": "server-only"
    }
  }
}
