{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/program_assistant_budgets.schema.json",
  "title": "ProgramAssistantBudgetDocument",
  "description": "One programme's wedding assistant token ledger for one programme-local day (id {programId}_{YYYY-MM-DD}). A run reserves its upper bound here in the same transaction that writes its intent, and settles to the tokens actually used afterwards; a run that does not fit under the cap is passed to the planner without a model call. Counts only. Server-only.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "programAssistantBudgets",
  "x-firestore-path": "programAssistantBudgets/{budgetId}",
  "x-owner": "programs/assistant budget ledger",
  "required": [
    "programId",
    "organizerId",
    "day",
    "tokenCap",
    "reservedTokens",
    "consumedTokens",
    "runCount",
    "updatedAtMillis"
  ],
  "properties": {
    "programId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "x-catch-ownership": "server-only"
    },
    "tokenCap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000,
      "x-catch-ownership": "server-only",
      "description": "The programme's dailyTokenBudget when the last run reserved."
    },
    "reservedTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000,
      "x-catch-ownership": "server-only",
      "description": "Upper bounds held by runs still in flight."
    },
    "consumedTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000,
      "x-catch-ownership": "server-only",
      "description": "Input plus output tokens of settled runs."
    },
    "runCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000,
      "x-catch-ownership": "server-only"
    },
    "updatedAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    }
  }
}
