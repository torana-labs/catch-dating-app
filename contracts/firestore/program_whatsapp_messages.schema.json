{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/program_whatsapp_messages.schema.json",
  "title": "ProgramWhatsappMessageDocument",
  "description": "One message in a programme WhatsApp thread, at programWhatsappMessages/{messageId}. Inbound ids derive from the provider message id; outbound ids from the reply operation. Text is at most 4096 characters; media is recorded by reference only. Server-only; scrubbed by the programme retention sweep.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "programWhatsappMessages",
  "x-firestore-path": "programWhatsappMessages/{programWhatsappMessageId}",
  "x-owner": "programme WhatsApp inbound router and reply callables",
  "required": [
    "schemaVersion",
    "messageId",
    "threadId",
    "programId",
    "organizerId",
    "householdId",
    "direction",
    "kind",
    "text",
    "author",
    "authorUid",
    "runId",
    "cannedReplyId",
    "providerMessageId",
    "status",
    "createdAtMillis",
    "statusUpdatedAtMillis"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "x-catch-ownership": "server-only"
    },
    "messageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "x-catch-ownership": "server-only"
    },
    "threadId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 260,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "x-catch-ownership": "server-only"
    },
    "programId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "householdId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180,
      "x-catch-ownership": "server-only"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "x-catch-ownership": "server-only"
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "template",
        "mediaRef",
        "system"
      ],
      "x-catch-ownership": "server-only"
    },
    "text": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4096,
      "x-catch-ownership": "server-only"
    },
    "author": {
      "type": "string",
      "enum": [
        "guest",
        "assistant",
        "planner",
        "system"
      ],
      "x-catch-ownership": "server-only"
    },
    "authorUid": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180,
      "description": "The staff member who wrote a planner reply.",
      "x-catch-ownership": "server-only"
    },
    "runId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200,
      "description": "programAssistantRuns id for an assistant reply.",
      "x-catch-ownership": "server-only"
    },
    "cannedReplyId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 48,
      "x-catch-ownership": "server-only"
    },
    "providerMessageId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512,
      "x-catch-ownership": "server-only"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "pending",
        "sent",
        "delivered",
        "read",
        "failed",
        "unknown"
      ],
      "x-catch-ownership": "server-only"
    },
    "createdAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    },
    "statusUpdatedAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    }
  }
}
