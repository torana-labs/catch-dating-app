{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/city_plans.schema.json",
  "title": "CityPlansDocument",
  "description": "Read model holding what the website shows for one city, stored at cityPlans/{citySlug}: the plans starting in the next 14 days, how many there are of each format, the organisers behind them, whether the city is live or launching soon, whether it has any plan in the next 30 days (the header's What's on rule), and the counts and indexing decision of each city-by-format page (/<city>/<format>/). Functions build it from the published organizer page read models (and, for cities that have not launched, from published organizers), so it adds no publication rule of its own. It never holds contact details, owner identities, rosters or dating fields; the 30-day and format page fields are counts only. Only the Admin SDK reads it.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "cityPlans",
  "x-firestore-path": "cityPlans/{citySlug}",
  "x-document-id-field": "citySlug",
  "x-catch-ownership": "trigger-owned",
  "x-owner": "functions/src/cityPlans: the organizer page trigger and the hourly rebuild. No client reads or writes.",
  "required": [
    "schemaVersion",
    "citySlug",
    "cityLabel",
    "marketStatus",
    "status",
    "builtAt",
    "windowStart",
    "windowEnd",
    "planCount",
    "formatCounts",
    "monthWindowEnd",
    "upcomingEvents30d",
    "hasUpcomingMonth",
    "monthCountsComplete",
    "formatPages",
    "plans",
    "organizers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "citySlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 60
    },
    "cityLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "marketStatus": {
      "type": "string",
      "description": "The market's launch status in functions/src/locations/marketConfig.ts.",
      "enum": ["launched", "planned"]
    },
    "status": {
      "type": "string",
      "description": "live when the market has launched, however few plans it has: the page shows the honest count. launchingSoon only for a market that has not launched.",
      "enum": ["live", "launchingSoon"]
    },
    "builtAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp"
    },
    "windowStart": {
      "type": "string",
      "format": "date-time",
      "description": "When the build read its sources. Plans that ended before this are left out."
    },
    "windowEnd": {
      "type": "string",
      "format": "date-time",
      "description": "Fourteen days after windowStart. Plans starting at or after this are left out."
    },
    "planCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Every plan in the window, which may be more than plans holds."
    },
    "formatCounts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Plans in the window by format.",
      "required": ["run", "dinner", "games", "courts", "nightsOut", "other"],
      "properties": {
        "run": {"type": "integer", "minimum": 0},
        "dinner": {"type": "integer", "minimum": 0},
        "games": {"type": "integer", "minimum": 0},
        "courts": {"type": "integer", "minimum": 0},
        "nightsOut": {"type": "integer", "minimum": 0},
        "other": {"type": "integer", "minimum": 0}
      }
    },
    "monthWindowEnd": {
      "type": "string",
      "format": "date-time",
      "description": "Thirty days after windowStart. The 30-day count and every format page count take plans starting before this."
    },
    "upcomingEvents30d": {
      "type": "integer",
      "minimum": 0,
      "description": "Every listed plan in the city that starts before monthWindowEnd and has not ended, in any format. Not capped by plans."
    },
    "hasUpcomingMonth": {
      "type": "boolean",
      "description": "upcomingEvents30d is above zero. The website hides What's on for a city where this is false."
    },
    "monthCountsComplete": {
      "type": "boolean",
      "description": "False when an organiser's page lists as many upcoming plans as it holds and the last of them starts before monthWindowEnd: that organiser may have more plans in the window, so the 30-day and format page event counts are a floor."
    },
    "formatPages": {
      "type": "object",
      "additionalProperties": false,
      "description": "One entry per city-by-format page, keyed by format. Counts only: no plan or organiser is named here.",
      "required": ["runClubs", "racketSports", "pickleball", "padel", "tennis", "badminton", "supperClubs", "quizNights", "nightlife", "studios", "workshops", "bookClubs", "outdoors"],
      "properties": {
        "runClubs": {"$ref": "#/definitions/formatPage"},
        "racketSports": {"$ref": "#/definitions/formatPage"},
        "pickleball": {"$ref": "#/definitions/formatPage"},
        "padel": {"$ref": "#/definitions/formatPage"},
        "tennis": {"$ref": "#/definitions/formatPage"},
        "badminton": {"$ref": "#/definitions/formatPage"},
        "supperClubs": {"$ref": "#/definitions/formatPage"},
        "quizNights": {"$ref": "#/definitions/formatPage"},
        "nightlife": {"$ref": "#/definitions/formatPage"},
        "studios": {"$ref": "#/definitions/formatPage"},
        "workshops": {"$ref": "#/definitions/formatPage"},
        "bookClubs": {"$ref": "#/definitions/formatPage"},
        "outdoors": {"$ref": "#/definitions/formatPage"}
      }
    },
    "plans": {
      "type": "array",
      "description": "Plans in the window, soonest first.",
      "maxItems": 120,
      "items": {
        "$ref": "#/definitions/cityPlan"
      }
    },
    "organizers": {
      "type": "array",
      "description": "Organisers in the city: those with a plan in the window first, soonest plan first, then by followers.",
      "maxItems": 24,
      "items": {
        "$ref": "#/definitions/cityOrganizer"
      }
    }
  },
  "definitions": {
    "format": {
      "type": "string",
      "description": "The homepage format a plan's activity belongs to.",
      "enum": ["run", "dinner", "games", "courts", "nightsOut", "other"]
    },
    "discoveryFormat": {
      "type": "string",
      "description": "A city-by-format page's format, from discoveryFormats in functions/src/cityPlans/discoveryFormats.ts. A plan counts toward the formats of its activity kind or, for an open activity, the formats its organiser lists; a racket sport counts toward racketSports and its own sport.",
      "enum": ["runClubs", "racketSports", "pickleball", "padel", "tennis", "badminton", "supperClubs", "quizNights", "nightlife", "studios", "workshops", "bookClubs", "outdoors"]
    },
    "discoveryFormats": {
      "type": "array",
      "maxItems": 13,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/discoveryFormat"}
    },
    "formatPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "organizerCount", "upcomingEventCount", "freeEventCount", "indexing"],
      "properties": {
        "slug": {
          "type": "string",
          "description": "The page's URL segment: /<citySlug>/<slug>/.",
          "enum": ["run-clubs", "racket-sports", "pickleball", "padel", "tennis", "badminton", "supper-clubs", "quiz-nights", "nightlife", "studios", "workshops", "book-clubs", "outdoors"]
        },
        "organizerCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Organisers in the city that run the format, from their upcoming plans or their listed category and formats. Not capped by organizers. In a city that has not launched, the published organisers joining it."
        },
        "upcomingEventCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Listed plans in the format that start before monthWindowEnd and have not ended."
        },
        "freeEventCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Those plans that are free: a Catch plan priced at zero whose price is not hidden, or an imported plan whose price reads Free."
        },
        "indexing": {
          "type": "string",
          "description": "index, follow when the city has launched and has 3 or more organisers or 5 or more upcoming plans in the format (owner decision, 16 Nov 2026); otherwise noindex, follow.",
          "enum": ["index, follow", "noindex, follow"]
        }
      }
    },
    "cityPlan": {
      "type": "object",
      "additionalProperties": false,
      "description": "One plan as a city page lists it. Live booking terms are rechecked on its event page, never trusted from this snapshot.",
      "required": [
        "source",
        "eventId",
        "path",
        "title",
        "format",
        "activityKind",
        "startTime",
        "endTime",
        "date",
        "location",
        "priceLabel",
        "photoUrl",
        "spotsLeft",
        "organizer",
        "discoveryFormats"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["catch", "external"]
        },
        "eventId": {
          "$ref": "../shared/public_page_common.schema.json#/definitions/publicDocumentId"
        },
        "path": {
          "$ref": "../shared/public_page_common.schema.json#/definitions/eventPath"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "$ref": "#/definitions/format"
        },
        "activityKind": {
          "type": "string",
          "minLength": 1,
          "not": {"const": "singlesMixer"}
        },
        "startTime": {
          "type": "string",
          "format": "date-time"
        },
        "endTime": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "priceLabel": {
          "type": "string",
          "minLength": 1
        },
        "photoUrl": {
          "anyOf": [
            {"$ref": "../shared/public_page_common.schema.json#/definitions/httpsUrl"},
            {"type": "null"}
          ]
        },
        "spotsLeft": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Places left on a Catch plan; null for an imported plan, which books on its source."
        },
        "discoveryFormats": {
          "$ref": "#/definitions/discoveryFormats",
          "description": "The city-by-format pages the plan counts toward."
        },
        "organizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["organizerId", "name", "path"],
          "properties": {
            "organizerId": {
              "$ref": "../shared/public_page_common.schema.json#/definitions/publicDocumentId"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "$ref": "../shared/public_page_common.schema.json#/definitions/organizerPath"
            }
          }
        }
      }
    },
    "cityOrganizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organizerId",
        "name",
        "path",
        "category",
        "logo",
        "formats",
        "followerCount",
        "claimState",
        "upcomingPlanCount",
        "nextPlan",
        "discoveryFormats"
      ],
      "properties": {
        "organizerId": {
          "$ref": "../shared/public_page_common.schema.json#/definitions/publicDocumentId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "description": "The organiser page, or null while the city has not launched and the organiser has no public page yet.",
          "anyOf": [
            {"$ref": "../shared/public_page_common.schema.json#/definitions/organizerPath"},
            {"type": "null"}
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "logo": {
          "$ref": "../public/website_host_listing_projection.schema.json#/definitions/logo"
        },
        "formats": {
          "type": "array",
          "description": "Formats the organiser runs, from its plans and its listed formats.",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/format"
          }
        },
        "followerCount": {
          "type": "integer",
          "minimum": 0
        },
        "claimState": {
          "type": "string",
          "enum": ["unclaimed", "claimPending", "claimed", "verified"]
        },
        "upcomingPlanCount": {
          "type": "integer",
          "minimum": 0,
          "description": "The organiser's plans in the window."
        },
        "discoveryFormats": {
          "$ref": "#/definitions/discoveryFormats",
          "description": "The city-by-format pages the organiser counts toward, from its upcoming plans and its listed category and formats."
        },
        "nextPlan": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["eventId", "path", "title", "startTime", "date"],
              "properties": {
                "eventId": {
                  "$ref": "../shared/public_page_common.schema.json#/definitions/publicDocumentId"
                },
                "path": {
                  "$ref": "../shared/public_page_common.schema.json#/definitions/eventPath"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "startTime": {
                  "type": "string",
                  "format": "date-time"
                },
                "date": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {"type": "null"}
          ]
        }
      }
    }
  }
}
