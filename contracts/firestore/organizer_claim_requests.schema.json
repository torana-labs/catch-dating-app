{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/organizer_claim_requests.schema.json",
  "title": "OrganizerClaimRequestDocument",
  "description": "Server-owned organizer listing claim request stored at organizerClaimRequests/{requestId}.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "organizerClaimRequests",
  "x-firestore-path": "organizerClaimRequests/{requestId}",
  "x-document-id-field": "requestId",
  "x-owner": "requestOrganizerClaim, adminRecommendOrganizerClaim and adminDecideOrganizerClaim callables",
  "required": ["requestId", "organizerId", "requesterUid", "requesterName", "requesterRole", "businessEmail", "businessPhone", "proofUrls", "message", "status", "createdAt", "updatedAt", "decidedAt", "decidedByUid", "decisionReason", "previousRequestId"],
  "properties": {
    "requestId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId", "x-catch-ownership": "callable-owned"},
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId", "x-catch-ownership": "callable-owned"},
    "requesterUid": {"$ref": "../shared/event_common.schema.json#/definitions/documentId", "x-catch-ownership": "callable-owned"},
    "requesterName": {"type": "string", "minLength": 1, "maxLength": 120, "x-catch-ownership": "callable-owned"},
    "requesterRole": {"type": "string", "enum": ["owner", "founder", "manager", "marketer", "venueManager", "other"], "x-catch-ownership": "callable-owned"},
    "businessEmail": {"type": ["string", "null"], "maxLength": 320, "x-catch-ownership": "callable-owned"},
    "businessPhone": {"type": ["string", "null"], "maxLength": 32, "x-catch-ownership": "callable-owned"},
    "proofUrls": {"type": "array", "maxItems": 8, "items": {"$ref": "../shared/profile_common.schema.json#/definitions/url"}, "uniqueItems": true, "x-catch-ownership": "callable-owned"},
    "message": {"type": ["string", "null"], "maxLength": 1000, "x-catch-ownership": "callable-owned"},
    "status": {"type": "string", "enum": ["pending", "approved", "rejected", "withdrawn", "superseded"], "x-catch-ownership": "callable-owned"},
    "createdAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp", "x-catch-ownership": "callable-owned"},
    "updatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp", "x-catch-ownership": "callable-owned"},
    "decidedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp", "x-catch-ownership": "callable-owned"},
    "decidedByUid": {"anyOf": [{"$ref": "../shared/event_common.schema.json#/definitions/documentId"}, {"type": "null"}], "x-catch-ownership": "callable-owned"},
    "decisionReason": {"type": ["string", "null"], "maxLength": 1000, "x-catch-ownership": "callable-owned"},
    "previousRequestId": {"anyOf": [{"$ref": "../shared/event_common.schema.json#/definitions/documentId"}, {"type": "null"}], "x-catch-ownership": "callable-owned"},
    "recommendation": {"description": "What ops recommend for a pending claim, set by adminRecommendOrganizerClaim. The owner decides the claim; a later recommendation replaces this one. Absent until someone recommends.", "anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["decision", "byUid", "at", "note"], "properties": {"decision": {"type": "string", "enum": ["approve", "reject"]}, "byUid": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"}, "at": {"type": "string", "format": "date-time"}, "note": {"type": "string", "minLength": 1, "maxLength": 1000}}}], "x-catch-ownership": "callable-owned"}
  }
}
