{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/event_rehearsals.schema.json",
  "title": "EventRehearsalDocument",
  "description": "Server-owned isolated Host rehearsal session stored at eventRehearsals/{sessionId}.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "eventRehearsals",
  "x-firestore-path": "eventRehearsals/{sessionId}",
  "x-document-id-field": "id",
  "x-owner": "event rehearsal callables",
  "required": [
    "organizerId",
    "ownerUid",
    "sourceEventId",
    "sourceEventRevision",
    "publicRehearsalId",
    "viewerTokenHash",
    "scenarioId",
    "seed",
    "actorCount",
    "actionCount",
    "status",
    "setup",
    "setupRevision",
    "runtimeRevision",
    "activeStepIndex",
    "virtualStartedAt",
    "virtualNow",
    "faultId",
    "faultConsumed",
    "createdAt",
    "updatedAt",
    "expiresAt",
    "completedAt"
  ],
  "properties": {
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "callable-owned"
    },
    "ownerUid": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "callable-owned"
    },
    "sourceEventId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180,
      "x-catch-ownership": "callable-owned"
    },
    "sourceEventRevision": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180,
      "x-catch-ownership": "callable-owned"
    },
    "publicRehearsalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{20,80}$",
      "x-catch-ownership": "callable-owned"
    },
    "viewerTokenHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "x-catch-ownership": "callable-owned"
    },
    "scenarioId": {
      "$ref": "../shared/event_rehearsal_common.schema.json#/definitions/scenarioId",
      "x-catch-ownership": "callable-owned"
    },
    "seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "x-catch-ownership": "callable-owned"
    },
    "actorCount": {
      "type": "integer",
      "minimum": 2,
      "maximum": 50,
      "x-catch-ownership": "callable-owned"
    },
    "actionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500,
      "x-catch-ownership": "callable-owned"
    },
    "status": {
      "$ref": "../shared/event_rehearsal_common.schema.json#/definitions/status",
      "x-catch-ownership": "callable-owned"
    },
    "setup": {
      "$ref": "../shared/event_rehearsal_common.schema.json#/definitions/safeSetup",
      "x-catch-ownership": "callable-owned"
    },
    "setupRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "x-catch-ownership": "callable-owned"
    },
    "runtimeRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "x-catch-ownership": "callable-owned"
    },
    "activeStepIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8,
      "x-catch-ownership": "callable-owned"
    },
    "virtualStartedAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp",
      "x-catch-ownership": "callable-owned"
    },
    "virtualNow": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp",
      "x-catch-ownership": "callable-owned"
    },
    "faultId": {
      "$ref": "../shared/event_rehearsal_common.schema.json#/definitions/faultId",
      "x-catch-ownership": "callable-owned"
    },
    "faultConsumed": {
      "type": "boolean",
      "x-catch-ownership": "callable-owned"
    },
    "createdAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp",
      "x-catch-ownership": "callable-owned"
    },
    "updatedAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp",
      "x-catch-ownership": "callable-owned"
    },
    "expiresAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp",
      "x-catch-ownership": "callable-owned"
    },
    "completedAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp",
      "x-catch-ownership": "callable-owned"
    },
    "staff": {
      "$ref": "../shared/event_rehearsal_staff.schema.json#/definitions/State",
      "x-catch-ownership": "callable-owned"
    },
    "assistanceSettings": {
      "$ref": "../shared/event_rehearsal_settings.schema.json#/definitions/State",
      "x-catch-ownership": "callable-owned"
    },
    "unitOutcomes": {
      "$ref": "../shared/event_rehearsal_outcomes.schema.json#/definitions/State",
      "x-catch-ownership": "callable-owned"
    },
    "revealControl": {
      "$ref": "../shared/event_rehearsal_reveal.schema.json#/definitions/State",
      "x-catch-ownership": "callable-owned"
    },
    "allocationState": {
      "$ref": "../shared/event_rehearsal_allocation.schema.json#/definitions/State",
      "x-catch-ownership": "callable-owned"
    },
    "rosterReconciliation": {
      "$ref": "../shared/event_rehearsal_roster_reconciliation.schema.json#/definitions/State",
      "x-catch-ownership": "callable-owned"
    },
    "guestSource": {
      "$ref": "../shared/event_rehearsal_common.schema.json#/definitions/guestSource",
      "x-catch-ownership": "callable-owned"
    },
    "rosterSnapshot": {
      "$ref": "../shared/event_rehearsal_common.schema.json#/definitions/rosterSnapshot",
      "x-catch-ownership": "callable-owned"
    }
  }
}
