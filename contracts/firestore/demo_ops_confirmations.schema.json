{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/demo_ops_confirmations.schema.json",
  "title": "DemoOpsConfirmationDocument",
  "description": "A pending confirmation for a destructive Suvbot demo operation; tapping the same chip again within two minutes confirms it.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "demoOpsConfirmations",
  "x-firestore-path": "demoOpsConfirmations/{confirmationId}",
  "x-document-id-field": "id",
  "x-owner": "Suvbot demo operations",
  "required": [
    "uid",
    "action",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "uid": {
      "type": "string",
      "x-catch-ownership": "server-only"
    },
    "action": {
      "type": "string",
      "x-catch-ownership": "server-only"
    },
    "createdAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp",
      "x-catch-ownership": "server-only"
    },
    "expiresAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp",
      "x-catch-ownership": "server-only"
    }
  }
}
