{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/catch_whatsapp_auto_replies.schema.json",
  "title": "CatchWhatsappAutoReplyDocument",
  "description": "One automatic reply from Catch's WhatsApp number to someone who just messaged it, claimed before sending so a redelivered message never sends twice. Keeps no message text, only which reply it was, the inbound receipt it answers, the sender's endpoint hash and the outcome. An uncertain send stays consumed. Expires after 30 days.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "catchWhatsappAutoReplies",
  "x-firestore-path": "catchWhatsappAutoReplies/{replyId}",
  "x-document-id-field": "replyId",
  "x-owner": "Catch WhatsApp inbound router",
  "required": ["schemaVersion", "replyId", "kind", "sourceEventId", "endpointHash", "state", "providerMessageId",
    "createdAtMillis", "updatedAtMillis", "expiresAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "replyId": {"type": "string", "pattern": "^cwauto_[a-f0-9]{64}$"},
    "kind": {"type": "string", "enum": ["nomination_queued", "nomination_without_links", "nomination_rate_limited",
      "clarification_question", "support_acknowledged", "listing_ready"]},
    "sourceEventId": {"type": "string", "pattern": "^cwhe_[a-f0-9]{64}$"},
    "endpointHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state": {"type": "string", "enum": ["claimed", "sent", "unknown", "skipped_stop", "skipped_unavailable"]},
    "providerMessageId": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
    "createdAtMillis": {"type": "integer", "minimum": 0},
    "updatedAtMillis": {"type": "integer", "minimum": 0},
    "expiresAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp", "x-firestore-ttl": true}
  }
}
