{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/event_attendees.schema.json",
  "title": "EventAttendeeDocument",
  "description": "Private event-scoped operational attendee stored at eventAttendees/{attendeeId}.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "eventAttendees",
  "x-firestore-path": "eventAttendees/{attendeeId}",
  "x-document-id-field": "id",
  "x-owner": "standalone Host roster, Catch-booking projection, public registration, and attendance callables",
  "required": [
    "eventId",
    "organizerId",
    "displayName",
    "searchName",
    "source",
    "status",
    "linkedUid",
    "phoneE164",
    "email",
    "externalReference",
    "arrivalGroup",
    "ticketType",
    "importId",
    "sourceRowId",
    "createdAt",
    "updatedAt",
    "registeredAt",
    "waitlistedAt",
    "checkedInAt",
    "cancelledAt",
    "checkedInBy",
    "linkedAt"
  ],
  "properties": {
    "eventId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "displayName": {"type": "string", "minLength": 1, "maxLength": 120},
    "searchName": {"type": "string", "minLength": 1, "maxLength": 120},
    "source": {
      "type": "string",
      "enum": ["catchBooking", "hostImport", "hostManual", "webOtp", "providerSync"]
    },
    "status": {
      "type": "string",
      "enum": ["invited", "registered", "waitlisted", "checkedIn", "cancelled"]
    },
    "linkedUid": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 180
    },
    "phoneE164": {
      "type": ["string", "null"],
      "pattern": "^\\+[1-9][0-9]{7,14}$"
    },
    "email": {
      "type": ["string", "null"],
      "format": "email",
      "maxLength": 320
    },
    "cityMarketId": {
      "description": "Private organizer-reported roster city; never a verified participant profile or eligibility input.",
      "anyOf": [{"$ref": "../shared/profile_common.schema.json#/definitions/marketId"}, {"type": "null"}]
    },
    "citySource": {
      "type": ["string", "null"],
      "enum": ["hostImport", "hostManual", null]
    },
    "externalReference": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 180
    },
    "arrivalGroup": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 180,
      "description": "Provider or import-supplied booking/arrival group shared by guests who are expected to arrive together."
    },
    "ticketType": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 120
    },
    "partySize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Places this guest-list row holds at the door: the guest and anyone arriving on the same booking. Written only by Host roster import and walk-ins; Catch bookings hold one place. Missing values read as 1."
    },
    "revenueAmountMinor": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Revenue allocated to this attendee in minor currency units. Organizer-reported and estimated values are not payment verification."
    },
    "revenueCurrency": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{3}$"
    },
    "revenueSource": {
      "type": ["string", "null"],
      "enum": ["hostImport", "hostEstimate", "providerOrder", "hostAttested", null]
    },
    "revenueAllocation": {
      "type": ["string", "null"],
      "enum": ["perAttendee", "sharedOrder", null]
    },
    "revenueOrderReference": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 180
    },
    "revenueOrderAmountMinor": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Original shared-order total before deterministic attendee allocation."
    },
    "importId": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 240
    },
    "sourceRowId": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 120
    },
    "createdAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "updatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "registeredAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "waitlistedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "checkedInAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "cancelledAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "checkedInBy": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 180
    },
    "linkedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"}
    ,
    "inviteLinkId": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 180,
      "description": "First eligible opaque invitation link preserved on this operational attendee."
    },
    "inviteCapturedAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"
    },
    "accountabilityRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Monotonic revision shared by all accountability writers. Missing legacy values read as zero."
    },
    "attendanceRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Monotonic revision for absolute Host attendance operations. Missing legacy values read as zero."
    },
    "preCheckInStatus": {
      "type": ["string", "null"],
      "enum": ["invited", "registered", "waitlisted", null],
      "description": "Operational status restored by an absolute undo. Null outside checked-in state."
    },
    "accountabilityResolution": {
      "type": ["string", "null"],
      "enum": ["returned", "departed", null],
      "description": "Host-recorded sweep result. It is current only when accountabilityResolvedForCheckInAt equals checkedInAt."
    },
    "accountabilityResolvedForCheckInAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"
    },
    "accountabilityResolvedAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"
    },
    "accountabilityResolvedBy": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 180
    },
    "booking": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "The Catch booking held by the account linked to this row: its own lifecycle status and times, payment, signup cohort, host approval and waitlist offer state. Null or absent when no Catch booking is linked.",
      "x-catch-ownership": "callable-owned",
      "required": ["status", "createdAt", "signedUpAt", "waitlistedAt", "attendedAt", "cancelledAt", "paymentId", "genderAtSignup", "deletedAt"],
      "properties": {
        "status": {"$ref": "../shared/event_common.schema.json#/definitions/eventParticipationStatus", "description": "Catch booking lifecycle. The row status is the roster state, which a Host-supplied row owns; this is the booking's own state."},
        "createdAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
        "signedUpAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
        "waitlistedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
        "attendedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
        "cancelledAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
        "inviteLinkId": {"type": ["string", "null"], "minLength": 1, "maxLength": 180, "description": "Named host invite link that first attributed this participation, when present."},
        "inviteCapturedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp", "description": "Server time when invite attribution was first attached to the roster edge."},
        "paymentId": {"type": ["string", "null"], "minLength": 1, "maxLength": 180},
        "genderAtSignup": {"$ref": "../shared/event_common.schema.json#/definitions/genderAtSignup"},
        "cohortAtSignup": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "communityMembershipAtSignup": {"type": "object", "additionalProperties": false, "description": "Historical pointer to the active community decision checked by the admission transaction; later revocation does not rewrite this booking evidence.", "required": ["membershipId", "revision", "decisionId"], "properties": {"membershipId": {"type": "string", "pattern": "^ocm_[a-f0-9]{64}$"}, "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740990}, "decisionId": {"type": "string", "pattern": "^ocmd_[a-f0-9]{64}$"}}},
        "hostApprovalStatus": {"type": ["string", "null"], "enum": ["pending", "approved", "declined", null], "description": "Manual-approval request state for request-to-join events. Null for regular waitlist edges."},
        "hostApprovalDecidedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
        "hostApprovalDecidedBy": {"type": ["string", "null"], "minLength": 1, "maxLength": 180},
        "waitlistOfferStatus": {"anyOf": [{"$ref": "../shared/event_common.schema.json#/definitions/eventWaitlistOfferStatus"}, {"type": "null"}], "description": "Mirror of the current waitlist offer state for cheap roster and attendee CTA reads."},
        "waitlistOfferedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
        "waitlistOfferExpiresAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
        "waitlistOfferAcceptedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
        "waitlistOfferId": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
        "inviteSource": {"type": ["string", "null"], "minLength": 1, "maxLength": 80, "description": "Host-facing source label copied from the invite link for durable reporting."},
        "deletedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp", "description": "Set when the guest's account was deleted; the row status is then cancelled."}
      }
    },
    "provider": {
      "type": ["string", "null"],
      "enum": ["luma", "eventbrite", "partiful", "posh", "bookmyshow", "district", "sortmyscene", "airbnb", null],
      "description": "External source that most recently supplied provider-authoritative fields, independent of row creation source."
    },
    "providerConnectionId": {"type": ["string", "null"], "minLength": 1, "maxLength": 180},
    "providerGuestId": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
    "providerSyncedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "providerDataRevision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
