{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/nominator_credits.schema.json",
  "title": "NominatorCreditDocument",
  "description": "One credit a nominator earned from one paid organizer bill, keyed by the bill. Written when a bill is paid, under the nominator credit rule in moneySettings: the first nominator of the organizer, if their role earns credit and the organizer claimed within the lapse window, earns the rate on what the organizer paid Catch before GST, for the set number of months from the organizer's first paid bill. Owed credit is approved monthly per nominator once it reaches the minimum (less rolls over), then marked paid with partner payouts.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "nominatorCredits",
  "x-firestore-path": "nominatorCredits/{creditId}",
  "x-document-id-field": "creditId",
  "x-owner": "Functions organizer billing (bill paid) and adminManageNominatorCredits",
  "required": ["schemaVersion", "creditId", "billId", "organizerId", "organizerName", "nominatorUid", "nominatorRole",
    "billMonth", "monthIndex", "billPaidMinor", "rateBasisPoints", "creditMinor", "status", "approvedAtMillis",
    "approvedByUid", "paidAtMillis", "paidByUid", "createdAtMillis", "updatedAtMillis"],
  "properties": {
    "schemaVersion": {"const": 1},
    "creditId": {"type": "string", "minLength": 1, "maxLength": 200},
    "billId": {"type": "string", "minLength": 1, "maxLength": 200},
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "organizerName": {"type": "string", "maxLength": 160},
    "nominatorUid": {"type": "string", "minLength": 1, "maxLength": 128},
    "nominatorRole": {"enum": ["associate", "partner", "guest", "organizer"]},
    "billMonth": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "monthIndex": {"type": "integer", "minimum": 1, "maximum": 60, "description": "Which month of credit this is, counted from the organizer's first paid bill."},
    "billPaidMinor": {"type": "integer", "minimum": 0, "maximum": 100000000000},
    "rateBasisPoints": {"type": "integer", "minimum": 0, "maximum": 10000},
    "creditMinor": {"type": "integer", "minimum": 0, "maximum": 100000000000},
    "status": {"enum": ["owed", "approved", "paid"]},
    "approvedAtMillis": {"type": ["integer", "null"], "minimum": 0},
    "approvedByUid": {"type": ["string", "null"], "maxLength": 128},
    "paidAtMillis": {"type": ["integer", "null"], "minimum": 0},
    "paidByUid": {"type": ["string", "null"], "maxLength": 128},
    "createdAtMillis": {"type": "integer", "minimum": 1},
    "updatedAtMillis": {"type": "integer", "minimum": 1}
  }
}
