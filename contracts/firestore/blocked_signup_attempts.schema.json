{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/blocked_signup_attempts.schema.json",
  "title": "BlockedSignupAttemptDocument",
  "description": "A new account that used a banned phone or device. The account is disabled and the attempt is shown on the ban in Safety.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "blockedSignupAttempts",
  "x-firestore-path": "blockedSignupAttempts/{attemptId}",
  "x-document-id-field": "attemptId",
  "x-owner": "Banned identity screening triggers",
  "required": ["schemaVersion", "attemptId", "attemptedUid", "identityId", "kind", "bannedUid", "actionId", "outcome", "at", "retainUntil"],
  "properties": {
    "schemaVersion": {"const": 1},
    "attemptId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attemptedUid": {"type": "string", "minLength": 1, "maxLength": 128},
    "identityId": {"type": "string", "pattern": "^(phone|installation|pushToken)-[a-f0-9]{64}$"},
    "kind": {"type": "string", "enum": ["phone", "installation", "pushToken"]},
    "bannedUid": {"type": "string", "minLength": 1, "maxLength": 128},
    "actionId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$"},
    "outcome": {"type": "string", "enum": ["disabled"]},
    "at": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "retainUntil": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"}
  }
}
