{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/organizer_communication_preferences.schema.json",
  "title": "OrganizerCommunicationPreferenceDocument",
  "description": "Server-owned, organizer-scoped channel consent stored at organizerCommunicationPreferences/{organizerId_uid}.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "organizerCommunicationPreferences",
  "x-firestore-path": "organizerCommunicationPreferences/{organizerId_uid}",
  "x-document-id-field": "id",
  "x-owner": "public registration and future self-service preference callables",
  "required": [
    "organizerId",
    "uid",
    "whatsapp",
    "sms",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "uid": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "whatsapp": {"$ref": "#/definitions/channelPreference"},
    "whatsappPurposes": {"$ref": "#/definitions/whatsappPurposes"},
    "sms": {"$ref": "#/definitions/channelPreference"},
    "createdAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp",
      "x-catch-ownership": "server-only"
    },
    "updatedAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp",
      "x-catch-ownership": "server-only"
    }
  },
  "definitions": {
    "whatsappPurposes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventOperations": {"$ref": "#/definitions/channelPreference"},
        "marketing": {"$ref": "#/definitions/channelPreference"},
        "followerUpdates": {
          "$ref": "#/definitions/channelPreference",
          "description": "Organiser follower updates on WhatsApp (route organizerFollowerWhatsapp). Granted only by an explicit WhatsApp tick on follow-by-phone, bound to the verified phone in endpointE164. Absent reads as unknown."
        }
      }
    },
    "channelPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidenceStatus",
        "currentReceiptId",
        "termsVersion",
        "source",
        "sourceEventId",
        "updatedAt"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unknown", "optedIn", "optedOut"],
          "x-catch-ownership": "server-only"
        },
        "evidenceStatus": {
          "type": "string",
          "enum": ["notApplicable", "complete", "incomplete"],
          "description": "Only complete evidence may make an opted-in channel eligible for managed delivery.",
          "x-catch-ownership": "server-only"
        },
        "currentReceiptId": {
          "anyOf": [
            {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
            {"type": "null"}
          ],
          "x-catch-ownership": "server-only"
        },
        "endpointE164": {"type": "string", "pattern": "^\\+[1-9][0-9]{6,14}$"},
        "sourceResponseId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "termsVersion": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 80,
          "x-catch-ownership": "server-only"
        },
        "source": {
          "type": ["string", "null"],
          "enum": [null, "publicEventRegistration", "hostFormResponse", "participantSettings", "unsubscribeLink", "inboundStop", "providerWebhook", "legacyIncomplete", "organizerFollowByPhone"],
          "x-catch-ownership": "server-only"
        },
        "sourceEventId": {
          "anyOf": [
            {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
            {"type": "null"}
          ],
          "x-catch-ownership": "server-only"
        },
        "updatedAt": {
          "$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp",
          "x-catch-ownership": "server-only"
        }
      }
    }
  }
}
