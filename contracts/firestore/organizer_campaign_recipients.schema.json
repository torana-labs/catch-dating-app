{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/organizer_campaign_recipients.schema.json",
  "title": "OrganizerCampaignRecipientDocument",
  "description": "Frozen recipient eligibility and monotonic delivery receipt for one organizer campaign contact.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "organizerCampaignRecipients",
  "x-firestore-path": "organizerCampaignRecipients/{recipientId}",
  "x-document-id-field": "recipientId",
  "x-owner": "campaign approval, dispatcher and provider webhook",
  "required": ["organizerId", "campaignId", "contactId", "channel", "eligibility", "exclusionReason", "endpointE164", "endpointHash", "permissionTermsVersion", "permissionUpdatedAt", "renderedVariablesHash", "inviteLinkId", "status", "providerMessageId", "providerErrorCategory", "retryEligible", "attemptCount", "leaseOwner", "leaseExpiresAt", "acceptedAt", "sentAt", "deliveredAt", "readAt", "failedAt", "repliedAt", "optedOutAt", "createdAt", "updatedAt"],
  "properties": {
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "campaignId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "contactId": {"anyOf": [{"$ref": "../shared/event_common.schema.json#/definitions/documentId"}, {"type": "null"}], "description": "CRM contact for saved-audience recipients; null on programSelection rows — program identity lives in programRecipient."},
    "programRecipient": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["programId", "recipientKey", "guestIds", "householdId", "endpointGuestId", "messagingConsent"],
      "description": "Program-native recipient identity for recipientSource=programSelection campaigns. One doc per resolved recipientKey (guest:{id} or household:{id}); contactId is null on these rows.",
      "properties": {
        "programId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "recipientKey": {"type": "string", "minLength": 1, "maxLength": 220, "description": "guest:{guestId} or household:{householdId}; hashed into the document id in place of contactId."},
        "guestIds": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"}, "description": "Program guests covered by this recipient; one for guest recipients, household members for deduped rows."},
        "householdId": {"anyOf": [{"$ref": "../shared/event_common.schema.json#/definitions/documentId"}, {"type": "null"}], "description": "Household carrying messaging consent for this recipient — the dedupe household for household:{id} rows or the guest's household otherwise."},
        "endpointGuestId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "messagingConsent": {"type": ["object", "null"], "additionalProperties": false, "required": ["granted", "grantedAt", "source"], "properties": {"granted": {"type": "boolean"}, "grantedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"}, "source": {"type": ["string", "null"], "enum": ["householdRsvpLink", "staff", "import", "whatsappStop", null]}}, "description": "Snapshot of the household's explicit messaging consent at approve time; grant decisions re-read live at dispatch."}
      }
    },
    "followerRecipient": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["uid", "postId", "permissionReceiptId"],
      "description": "Follower identity for recipientSource=organizerFollowers rows (route organizerFollowerWhatsapp); contactId is null on these rows. Send time re-reads the active follow, the followerUpdates consent bound to endpointE164 and any STOP for the endpoint.",
      "properties": {
        "uid": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "postId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "permissionReceiptId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"}
      }
    },
    "channel": {"const": "whatsapp"},
    "eligibility": {"type": "string", "enum": ["eligible", "excluded"]},
    "exclusionReason": {"type": ["string", "null"], "enum": [null, "optedOut", "noVerifiedEndpoint", "duplicateEndpoint", "frequencyCapped", "providerBlocked", "invalidEndpoint", "unknownPermission", "identityUnresolved", "deleted"]},
    "endpointE164": {"type": ["string", "null"], "pattern": "^\\+[1-9][0-9]{7,14}$"},
    "endpointHash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "permissionTermsVersion": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
    "permissionUpdatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "renderedVariablesHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "inviteLinkId": {"type": ["string", "null"], "minLength": 1, "maxLength": 180},
    "status": {"type": "string", "enum": ["pending", "sending", "suppressed", "accepted", "sent", "delivered", "read", "failed", "replied", "optedOut"]},
    "providerMessageId": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
    "providerErrorCategory": {"type": ["string", "null"], "enum": [null, "authentication", "template", "quality", "rateLimit", "invalidRecipient", "policy", "provider", "unknown"]},
    "retryEligible": {"type": "boolean"},
    "attemptCount": {"type": "integer", "minimum": 0, "maximum": 20},
    "leaseOwner": {"type": ["string", "null"], "minLength": 1, "maxLength": 180},
    "leaseExpiresAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "acceptedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "sentAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "deliveredAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "readAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "failedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "repliedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "optedOutAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "createdAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "updatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"}
  }
}
