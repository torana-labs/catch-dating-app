{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/demo_ops_events.schema.json",
  "title": "DemoOpsEventDocument",
  "description": "Manifest of one demo operation: every document path it wrote, so cleanup and audit can find them later. Suvbot (functions/src/demoOps/suvbotState.ts) writes one per chat operation, and world starts also record the world, its events and its cast. The demo ops CLI (tool/demo/demo_ops_core.mjs) merges one per applied operation.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "demoOpsEvents",
  "x-firestore-path": "demoOpsEvents/{operationId}",
  "x-document-id-field": "operationId",
  "x-owner": "Suvbot demo operations and the demo ops CLI",
  "required": [
    "command",
    "operationId",
    "applied",
    "createdAt",
    "users",
    "phones",
    "paths",
    "pathCount"
  ],
  "definitions": {
    "documentId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "documentPath": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[^/]+/[^/]+(/[^/]+/[^/]+)*$"
    }
  },
  "properties": {
    "command": {
      "type": "string",
      "minLength": 1,
      "x-catch-ownership": "server-only"
    },
    "operationId": {
      "$ref": "#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "applied": {
      "type": "boolean",
      "description": "False for a CLI dry run; such manifests are returned, not stored, so stored manifests are true.",
      "x-catch-ownership": "server-only"
    },
    "createdAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp",
      "x-catch-ownership": "server-only"
    },
    "users": {
      "type": "array",
      "items": {"$ref": "#/definitions/documentId"},
      "x-catch-ownership": "server-only"
    },
    "phones": {
      "type": "array",
      "items": {"type": "string"},
      "x-catch-ownership": "server-only"
    },
    "paths": {
      "type": "array",
      "items": {"$ref": "#/definitions/documentPath"},
      "x-catch-ownership": "server-only"
    },
    "pathCount": {
      "type": "integer",
      "minimum": 0,
      "x-catch-ownership": "server-only"
    },
    "demoOps": {
      "const": true,
      "description": "Suvbot manifests only.",
      "x-catch-ownership": "server-only"
    },
    "demoOpsId": {
      "$ref": "#/definitions/documentId",
      "description": "Suvbot manifests only; equals operationId.",
      "x-catch-ownership": "server-only"
    },
    "demoOpsCommand": {
      "type": "string",
      "description": "Suvbot manifests only; equals command.",
      "x-catch-ownership": "server-only"
    },
    "seedPrefix": {
      "type": "string",
      "description": "Suvbot manifests only: the tester's world prefix, or the default demo prefix.",
      "x-catch-ownership": "server-only"
    },
    "matchId": {
      "type": ["string", "null"],
      "description": "CLI manifests only.",
      "x-catch-ownership": "server-only"
    },
    "eventId": {
      "type": ["string", "null"],
      "description": "CLI manifests only.",
      "x-catch-ownership": "server-only"
    },
    "worldId": {
      "type": "string",
      "description": "Suvbot world starts only.",
      "x-catch-ownership": "server-only"
    },
    "moment": {
      "type": "string",
      "description": "Suvbot world starts only.",
      "x-catch-ownership": "server-only"
    },
    "primaryEventId": {
      "type": "string",
      "description": "Suvbot world starts only.",
      "x-catch-ownership": "server-only"
    },
    "worldEventIds": {
      "type": "array",
      "items": {"$ref": "#/definitions/documentId"},
      "description": "Suvbot world starts only.",
      "x-catch-ownership": "server-only"
    },
    "castUids": {
      "type": "array",
      "items": {"$ref": "#/definitions/documentId"},
      "description": "Suvbot world starts only.",
      "x-catch-ownership": "server-only"
    }
  }
}
