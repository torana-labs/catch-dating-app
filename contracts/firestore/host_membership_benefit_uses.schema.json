{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/host_membership_benefit_uses.schema.json",
  "title": "HostMembershipBenefitUseDocument",
  "description": "One booking made at a member price, keyed {eventId}_{uid}. Source of the member's savings total and of the upcoming member-priced booking cap. Readable by the member only.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "hostMembershipBenefitUses",
  "x-firestore-path": "hostMembershipBenefitUses/{benefitUseId}",
  "x-document-id-field": "benefitUseId",
  "x-owner": "member-priced booking paths (signUpForFreeEvent, public paid admission)",
  "required": ["schemaVersion", "membershipId", "organizerId", "uid", "eventId", "planId", "listPriceInPaise", "paidPriceInPaise", "savingsInPaise", "eventStartMillis", "state", "createdAtMillis"],
  "properties": {
    "schemaVersion": {"const": 1, "x-catch-ownership": "server-only"},
    "membershipId": {"$ref": "../shared/host_membership_common.schema.json#/definitions/membershipId", "x-catch-ownership": "server-only"},
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId", "x-catch-ownership": "server-only"},
    "uid": {"$ref": "../shared/event_common.schema.json#/definitions/documentId", "x-catch-ownership": "server-only"},
    "eventId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId", "x-catch-ownership": "server-only"},
    "planId": {"$ref": "../shared/host_membership_common.schema.json#/definitions/planId", "x-catch-ownership": "server-only"},
    "listPriceInPaise": {"$ref": "../shared/host_membership_common.schema.json#/definitions/eventPriceInPaise", "x-catch-ownership": "server-only"},
    "paidPriceInPaise": {"$ref": "../shared/host_membership_common.schema.json#/definitions/eventPriceInPaise", "x-catch-ownership": "server-only"},
    "savingsInPaise": {"$ref": "../shared/host_membership_common.schema.json#/definitions/eventPriceInPaise", "x-catch-ownership": "server-only"},
    "eventStartMillis": {"$ref": "../shared/host_membership_common.schema.json#/definitions/positiveMillis", "x-catch-ownership": "server-only"},
    "state": {"enum": ["booked", "released"], "x-catch-ownership": "server-only"},
    "createdAtMillis": {"$ref": "../shared/host_membership_common.schema.json#/definitions/positiveMillis", "x-catch-ownership": "server-only"}
  }
}
