{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/admin_inbox_journey.schema.json",
  "title": "AdminInboxJourneyStepDocument",
  "description": "One step in an inbox item's journey, shown on the item's timeline. Dates are ISO strings.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "adminInboxJourney",
  "x-firestore-path": "adminInboxJourney/{stepId}",
  "x-document-id-field": "id",
  "x-owner": "Admin inbox projection",
  "required": [
    "actorUid",
    "detail",
    "itemId",
    "occurredAt",
    "schemaVersion",
    "stepId",
    "title",
    "tone"
  ],
  "properties": {
    "actorUid": {
      "type": [
        "string",
        "null"
      ],
      "x-catch-ownership": "server-only"
    },
    "detail": {
      "type": [
        "string",
        "null"
      ],
      "x-catch-ownership": "server-only"
    },
    "itemId": {
      "type": "string",
      "x-catch-ownership": "server-only"
    },
    "occurredAt": {
      "type": "string",
      "x-catch-ownership": "server-only"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number",
      "x-catch-ownership": "server-only"
    },
    "stepId": {
      "type": "string",
      "x-catch-ownership": "server-only"
    },
    "title": {
      "type": "string",
      "x-catch-ownership": "server-only"
    },
    "tone": {
      "enum": [
        "ink",
        "success",
        "warning",
        "danger",
        "muted"
      ],
      "type": "string",
      "x-catch-ownership": "server-only"
    }
  }
}
