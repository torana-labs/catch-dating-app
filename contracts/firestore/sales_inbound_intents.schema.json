{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/sales_inbound_intents.schema.json",
  "title": "SalesInboundIntentDocument",
  "description": "Private self-reported host submission, immutable at capture and linked only after identity review.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "salesInboundIntents",
  "x-firestore-path": "salesInboundIntents/{intentId}",
  "x-document-id-field": "intentId",
  "x-owner": "joinWaitlist and adminLinkSalesInboundIntent",
  "required": [
    "schemaVersion",
    "revision",
    "classification",
    "intentId",
    "source",
    "submissionId",
    "requestHash",
    "waitlistId",
    "status",
    "organizerId",
    "evidenceStatus",
    "fullName",
    "email",
    "city",
    "entryRoute",
    "alreadyJoined",
    "hostApplication",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "classification": {
      "const": "sales_private"
    },
    "intentId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "enum": [
        "website",
        "partner"
      ]
    },
    "submissionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "requestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "waitlistId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "status": {
      "enum": [
        "needs_identity_review",
        "linked",
        "dismissed"
      ]
    },
    "organizerId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceStatus": {
      "const": "self_reported"
    },
    "fullName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "email": {
      "anyOf": [
        {
          "type": "string",
          "format": "email",
          "maxLength": 320
        },
        {
          "type": "null"
        }
      ]
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{7,14}$",
      "description": "Optional E.164 number the applicant gave. Absent on older intents (read as none). A website intent without an email carries one."
    },
    "city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "entryRoute": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "alreadyJoined": {
      "type": "boolean"
    },
    "hostApplication": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "organizationName": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 140
                },
                {
                  "type": "null"
                }
              ]
            },
            "organizationType": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "operatingCity": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "communityLink": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "formats": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 80
              }
            },
            "eventCadence": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "nextEventName": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 160
                },
                {
                  "type": "null"
                }
              ]
            },
            "nextEventDate": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "eventLocation": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 180
                },
                {
                  "type": "null"
                }
              ]
            },
            "expectedCapacity": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "bookingPlatform": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "guestListFormat": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "priceRange": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "admissionModel": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "waitlistPlan": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "paymentReadiness": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "eventSuccessModules": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 120
              }
            },
            "hostGoals": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1000
                },
                {
                  "type": "null"
                }
              ]
            },
            "operatingNotes": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1000
                },
                {
                  "type": "null"
                }
              ]
            },
            "eventPricing": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "paid",
                    "free",
                    "mixed",
                    "undecided"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "programme": {
      "enum": [
        "weddings"
      ],
      "description": "Optional programme product the application is for. Absent (read as none) for events Host applications."
    },
    "programmeApplication": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The weddings pilot application from /weddings/apply/. Every field is optional; the page sends what the planner answered.",
          "properties": {
            "planningCompany": {
              "type": "string",
              "maxLength": 140
            },
            "city": {
              "type": "string",
              "maxLength": 80
            },
            "weddingDate": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "First day of the next wedding, yyyy-mm-dd."
            },
            "headcount": {
              "type": "string",
              "maxLength": 40
            },
            "tools": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 80
              }
            },
            "functions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            },
            "hotels": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            },
            "teamSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "flyingInShare": {
              "type": "string",
              "maxLength": 40
            },
            "wants": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 120
              }
            },
            "freeText": {
              "type": "string",
              "maxLength": 1000
            },
            "source": {
              "type": "string",
              "maxLength": 80
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp"
    },
    "updatedAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp"
    },
    "linkedAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp"
    },
    "linkedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "linkRequestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "partnerUid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "hostLead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "isNew"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "pattern": "^host_lead_[0-9]{13}_[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "isNew": {
          "type": "boolean"
        }
      }
    },
    "acquisitionAttribution": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional first-party campaign snapshot captured with the new Host receipt under current analytics permission. Erased on withdrawal or original-choice expiry; never used without a current consent/privacy check.",
      "required": [
        "version",
        "consentId",
        "acceptedAt",
        "expiresAt",
        "firstTouch",
        "lastTouch"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "consentId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "acceptedAt": {
          "type": "integer",
          "minimum": 1
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1
        },
        "firstTouch": {
          "anyOf": [
            {
              "$ref": "#/definitions/hostAttributionTouch"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastTouch": {
          "anyOf": [
            {
              "$ref": "#/definitions/hostAttributionTouch"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "linked"
          }
        }
      },
      "then": {
        "required": [
          "linkedAt",
          "linkedBy",
          "linkRequestId"
        ],
        "properties": {
          "organizerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "else": {
        "properties": {
          "organizerId": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "partner"
          }
        }
      },
      "then": {
        "required": [
          "partnerUid"
        ],
        "properties": {
          "email": {
            "type": "null"
          },
          "entryRoute": {
            "const": "/partners/"
          }
        }
      },
      "else": {
        "properties": {
          "partnerUid": false
        },
        "anyOf": [
          {
            "properties": {
              "email": {
                "type": "string",
                "format": "email"
              }
            }
          },
          {
            "required": [
              "phone"
            ],
            "properties": {
              "email": {
                "type": "null"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "programme"
        ]
      },
      "then": {
        "required": [
          "programmeApplication"
        ]
      }
    }
  ],
  "definitions": {
    "hostAttributionTouch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturedAt",
        "landingPath",
        "values"
      ],
      "properties": {
        "capturedAt": {
          "type": "integer",
          "minimum": 1
        },
        "landingPath": {
          "enum": [
            "/host/",
            "/host/overview/",
            "/host/platform/",
            "/host/planners/",
            "/host/clubs/",
            "/host/directory/",
            "/claim/",
            "/host/claim/",
            "/host/apply/",
            "/host/stack/",
            "/host/workflows/"
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "utm_source": {
              "enum": [
                "google",
                "meta",
                "newsletter",
                "catch",
                "partner"
              ]
            },
            "utm_medium": {
              "enum": [
                "cpc",
                "paid_social",
                "email",
                "organic",
                "referral"
              ]
            },
            "utm_campaign": {
              "enum": [
                "launch",
                "launch_2026",
                "planner_launch",
                "host_acquisition_2026",
                "synthetic_launch"
              ]
            },
            "utm_content": {
              "enum": [
                "host_hero",
                "host_footer",
                "claim_cta",
                "application_cta"
              ]
            }
          }
        }
      }
    }
  }
}
