{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/sales_inbound_intents.schema.json",
  "title": "SalesInboundIntentDocument",
  "description": "Private self-reported host submission or website lead, immutable at capture and linked only after identity review.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "salesInboundIntents",
  "x-firestore-path": "salesInboundIntents/{intentId}",
  "x-document-id-field": "intentId",
  "x-owner": "joinWaitlist (Host applications and website leads), partner nominations and adminLinkSalesInboundIntent",
  "required": [
    "schemaVersion",
    "revision",
    "classification",
    "intentId",
    "source",
    "submissionId",
    "requestHash",
    "waitlistId",
    "status",
    "organizerId",
    "evidenceStatus",
    "fullName",
    "email",
    "city",
    "entryRoute",
    "alreadyJoined",
    "hostApplication",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "classification": {
      "const": "sales_private"
    },
    "intentId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "enum": [
        "website",
        "partner"
      ]
    },
    "submissionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "requestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "waitlistId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "status": {
      "enum": [
        "needs_identity_review",
        "linked",
        "dismissed"
      ]
    },
    "organizerId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceStatus": {
      "const": "self_reported"
    },
    "fullName": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ],
      "description": "The applicant's name. Null only on a website lead whose form does not ask for one."
    },
    "email": {
      "anyOf": [
        {
          "type": "string",
          "format": "email",
          "maxLength": 320
        },
        {
          "type": "null"
        }
      ]
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{7,14}$",
      "description": "Optional E.164 number the applicant gave. Absent on older intents (read as none). A website intent without an email carries one."
    },
    "city": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ],
      "description": "The city as submitted. Null only on a website lead sent without one."
    },
    "entryRoute": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "alreadyJoined": {
      "type": "boolean"
    },
    "hostApplication": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "organizationName": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 140
                },
                {
                  "type": "null"
                }
              ]
            },
            "organizationType": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "operatingCity": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "communityLink": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "formats": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 80
              }
            },
            "eventCadence": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "nextEventName": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 160
                },
                {
                  "type": "null"
                }
              ]
            },
            "nextEventDate": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "eventLocation": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 180
                },
                {
                  "type": "null"
                }
              ]
            },
            "expectedCapacity": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "bookingPlatform": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "guestListFormat": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "priceRange": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "admissionModel": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "waitlistPlan": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "paymentReadiness": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "eventSuccessModules": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 120
              }
            },
            "hostGoals": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1000
                },
                {
                  "type": "null"
                }
              ]
            },
            "operatingNotes": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1000
                },
                {
                  "type": "null"
                }
              ]
            },
            "eventPricing": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "paid",
                    "free",
                    "mixed",
                    "undecided"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "leadKind": {
      "enum": [
        "guide",
        "walkthrough",
        "demo",
        "venue",
        "story",
        "referral",
        "org_contact",
        "city_alerts"
      ],
      "description": "Present on a website lead (joinWaitlist requestKind); absent on Host applications and partner nominations. Staff reply on WhatsApp; nothing is sent automatically."
    },
    "lead": {
      "$ref": "#/definitions/lead"
    },
    "programme": {
      "enum": [
        "weddings"
      ],
      "description": "Optional programme product the application is for. Absent (read as none) for events Host applications."
    },
    "programmeApplication": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The weddings pilot application from /weddings/apply/. Every field is optional; the page sends what the planner answered.",
          "properties": {
            "applicantRole": {
              "type": "string",
              "maxLength": 80
            },
            "programmeKind": {
              "type": "string",
              "maxLength": 80
            },
            "planningCompany": {
              "type": "string",
              "maxLength": 140
            },
            "city": {
              "type": "string",
              "maxLength": 80
            },
            "weddingDate": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "First day of the next wedding, yyyy-mm-dd."
            },
            "headcount": {
              "type": "string",
              "maxLength": 40
            },
            "tools": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 80
              }
            },
            "functions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            },
            "hotels": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            },
            "teamSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "flyingInShare": {
              "type": "string",
              "maxLength": 40
            },
            "wants": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 120
              }
            },
            "freeText": {
              "type": "string",
              "maxLength": 1000
            },
            "source": {
              "type": "string",
              "maxLength": 80
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp"
    },
    "updatedAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp"
    },
    "linkedAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp"
    },
    "linkedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "linkRequestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "partnerUid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "hostLead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "isNew"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "pattern": "^host_lead_[0-9]{13}_[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "isNew": {
          "type": "boolean"
        }
      }
    },
    "acquisitionAttribution": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional first-party campaign snapshot captured with the new Host receipt under current analytics permission. Erased on withdrawal or original-choice expiry; never used without a current consent/privacy check.",
      "required": [
        "version",
        "consentId",
        "acceptedAt",
        "expiresAt",
        "firstTouch",
        "lastTouch"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "consentId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "acceptedAt": {
          "type": "integer",
          "minimum": 1
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1
        },
        "firstTouch": {
          "anyOf": [
            {
              "$ref": "#/definitions/hostAttributionTouch"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastTouch": {
          "anyOf": [
            {
              "$ref": "#/definitions/hostAttributionTouch"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "linked"
          }
        }
      },
      "then": {
        "required": [
          "linkedAt",
          "linkedBy",
          "linkRequestId"
        ],
        "properties": {
          "organizerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "else": {
        "properties": {
          "organizerId": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "partner"
          }
        }
      },
      "then": {
        "required": [
          "partnerUid"
        ],
        "properties": {
          "email": {
            "type": "null"
          },
          "entryRoute": {
            "const": "/partners/"
          }
        }
      },
      "else": {
        "properties": {
          "partnerUid": false
        },
        "anyOf": [
          {
            "properties": {
              "email": {
                "type": "string",
                "format": "email"
              }
            }
          },
          {
            "required": [
              "phone"
            ],
            "properties": {
              "email": {
                "type": "null"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "programme"
        ]
      },
      "then": {
        "required": [
          "programmeApplication"
        ]
      }
    },
    {
      "if": {
        "required": [
          "leadKind"
        ]
      },
      "then": {
        "required": [
          "lead",
          "phone"
        ],
        "properties": {
          "source": {
            "const": "website"
          },
          "email": {
            "type": "null"
          },
          "programme": false,
          "programmeApplication": false,
          "hostLead": false,
          "acquisitionAttribution": false
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "leadKind": {
                  "const": "guide"
                }
              }
            },
            "then": {
              "properties": {
                "lead": {
                  "required": [
                    "guide"
                  ],
                  "properties": {
                    "consent": {
                      "properties": {
                        "purpose": {
                          "const": "leadFollowUp"
                        }
                      }
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "walkthrough"
                        ]
                      },
                      {
                        "required": [
                          "demo"
                        ]
                      },
                      {
                        "required": [
                          "venue"
                        ]
                      },
                      {
                        "required": [
                          "story"
                        ]
                      },
                      {
                        "required": [
                          "referral"
                        ]
                      },
                      {
                        "required": [
                          "orgContact"
                        ]
                      },
                      {
                        "required": [
                          "cityAlerts"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "leadKind": {
                  "const": "walkthrough"
                }
              }
            },
            "then": {
              "properties": {
                "lead": {
                  "required": [
                    "walkthrough"
                  ],
                  "properties": {
                    "consent": {
                      "properties": {
                        "purpose": {
                          "const": "leadFollowUp"
                        }
                      }
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "guide"
                        ]
                      },
                      {
                        "required": [
                          "demo"
                        ]
                      },
                      {
                        "required": [
                          "venue"
                        ]
                      },
                      {
                        "required": [
                          "story"
                        ]
                      },
                      {
                        "required": [
                          "referral"
                        ]
                      },
                      {
                        "required": [
                          "orgContact"
                        ]
                      },
                      {
                        "required": [
                          "cityAlerts"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "leadKind": {
                  "const": "demo"
                }
              }
            },
            "then": {
              "properties": {
                "lead": {
                  "required": [
                    "demo"
                  ],
                  "properties": {
                    "consent": {
                      "properties": {
                        "purpose": {
                          "const": "leadFollowUp"
                        }
                      }
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "guide"
                        ]
                      },
                      {
                        "required": [
                          "walkthrough"
                        ]
                      },
                      {
                        "required": [
                          "venue"
                        ]
                      },
                      {
                        "required": [
                          "story"
                        ]
                      },
                      {
                        "required": [
                          "referral"
                        ]
                      },
                      {
                        "required": [
                          "orgContact"
                        ]
                      },
                      {
                        "required": [
                          "cityAlerts"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "leadKind": {
                  "const": "venue"
                }
              }
            },
            "then": {
              "properties": {
                "lead": {
                  "required": [
                    "venue"
                  ],
                  "properties": {
                    "consent": {
                      "properties": {
                        "purpose": {
                          "const": "leadFollowUp"
                        }
                      }
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "guide"
                        ]
                      },
                      {
                        "required": [
                          "walkthrough"
                        ]
                      },
                      {
                        "required": [
                          "demo"
                        ]
                      },
                      {
                        "required": [
                          "story"
                        ]
                      },
                      {
                        "required": [
                          "referral"
                        ]
                      },
                      {
                        "required": [
                          "orgContact"
                        ]
                      },
                      {
                        "required": [
                          "cityAlerts"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "leadKind": {
                  "const": "story"
                }
              }
            },
            "then": {
              "properties": {
                "lead": {
                  "required": [
                    "story"
                  ],
                  "properties": {
                    "consent": {
                      "properties": {
                        "purpose": {
                          "const": "leadFollowUp"
                        }
                      }
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "guide"
                        ]
                      },
                      {
                        "required": [
                          "walkthrough"
                        ]
                      },
                      {
                        "required": [
                          "demo"
                        ]
                      },
                      {
                        "required": [
                          "venue"
                        ]
                      },
                      {
                        "required": [
                          "referral"
                        ]
                      },
                      {
                        "required": [
                          "orgContact"
                        ]
                      },
                      {
                        "required": [
                          "cityAlerts"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "leadKind": {
                  "const": "referral"
                }
              }
            },
            "then": {
              "properties": {
                "lead": {
                  "required": [
                    "referral",
                    "referralCredit"
                  ],
                  "properties": {
                    "consent": {
                      "properties": {
                        "purpose": {
                          "const": "leadFollowUp"
                        }
                      }
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "guide"
                        ]
                      },
                      {
                        "required": [
                          "walkthrough"
                        ]
                      },
                      {
                        "required": [
                          "demo"
                        ]
                      },
                      {
                        "required": [
                          "venue"
                        ]
                      },
                      {
                        "required": [
                          "story"
                        ]
                      },
                      {
                        "required": [
                          "orgContact"
                        ]
                      },
                      {
                        "required": [
                          "cityAlerts"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "leadKind": {
                  "const": "org_contact"
                }
              }
            },
            "then": {
              "properties": {
                "lead": {
                  "required": [
                    "orgContact"
                  ],
                  "properties": {
                    "consent": {
                      "properties": {
                        "purpose": {
                          "const": "leadFollowUp"
                        }
                      }
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "guide"
                        ]
                      },
                      {
                        "required": [
                          "walkthrough"
                        ]
                      },
                      {
                        "required": [
                          "demo"
                        ]
                      },
                      {
                        "required": [
                          "venue"
                        ]
                      },
                      {
                        "required": [
                          "story"
                        ]
                      },
                      {
                        "required": [
                          "referral"
                        ]
                      },
                      {
                        "required": [
                          "cityAlerts"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "leadKind": {
                  "const": "city_alerts"
                }
              }
            },
            "then": {
              "properties": {
                "lead": {
                  "required": [
                    "cityAlerts"
                  ],
                  "properties": {
                    "consent": {
                      "properties": {
                        "purpose": {
                          "const": "cityNewPlans"
                        }
                      }
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "guide"
                        ]
                      },
                      {
                        "required": [
                          "walkthrough"
                        ]
                      },
                      {
                        "required": [
                          "demo"
                        ]
                      },
                      {
                        "required": [
                          "venue"
                        ]
                      },
                      {
                        "required": [
                          "story"
                        ]
                      },
                      {
                        "required": [
                          "referral"
                        ]
                      },
                      {
                        "required": [
                          "orgContact"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "not": {
                "properties": {
                  "leadKind": {
                    "const": "referral"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "hostApplication": {
                  "type": "null"
                },
                "lead": {
                  "not": {
                    "required": [
                      "referralCredit"
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "fullName": {
            "type": "string"
          },
          "city": {
            "type": "string"
          }
        },
        "not": {
          "required": [
            "lead"
          ]
        }
      }
    }
  ],
  "definitions": {
    "hostAttributionTouch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturedAt",
        "landingPath",
        "values"
      ],
      "properties": {
        "capturedAt": {
          "type": "integer",
          "minimum": 1
        },
        "landingPath": {
          "enum": [
            "/host/",
            "/host/overview/",
            "/host/platform/",
            "/host/planners/",
            "/host/clubs/",
            "/host/directory/",
            "/claim/",
            "/host/claim/",
            "/host/apply/",
            "/host/stack/",
            "/host/workflows/"
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "utm_source": {
              "enum": [
                "google",
                "meta",
                "newsletter",
                "catch",
                "partner"
              ]
            },
            "utm_medium": {
              "enum": [
                "cpc",
                "paid_social",
                "email",
                "organic",
                "referral"
              ]
            },
            "utm_campaign": {
              "enum": [
                "launch",
                "launch_2026",
                "planner_launch",
                "host_acquisition_2026",
                "synthetic_launch"
              ]
            },
            "utm_content": {
              "enum": [
                "host_hero",
                "host_footer",
                "claim_cta",
                "application_cta"
              ]
            }
          }
        }
      }
    },
    "lead": {
      "type": "object",
      "additionalProperties": false,
      "description": "What a website lead said, normalized: the consent it was given under, where it came from, the payload for its kind and, for a referral, whether the referrer can be credited.",
      "required": [
        "consent",
        "sourcePage",
        "entry"
      ],
      "properties": {
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "version",
            "decidedAt"
          ],
          "description": "leadFollowUp: staff may message the number about this request. cityNewPlans: the standalone city new-plans purpose (city_alerts), recorded only; nothing is sent until approved templates exist.",
          "properties": {
            "purpose": {
              "enum": [
                "leadFollowUp",
                "cityNewPlans"
              ]
            },
            "version": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,40}$"
            },
            "decidedAt": {
              "$ref": "../shared/event_common.schema.json#/definitions/timestamp"
            }
          }
        },
        "sourcePage": {
          "type": "string",
          "pattern": "^/[^\\s?#]*$",
          "maxLength": 512
        },
        "entry": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
        },
        "cityId": {
          "type": "string",
          "pattern": "^[a-z]{2}-[a-z0-9]{1,3}-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64,
          "description": "The market catalog id when the city was attributed."
        },
        "countryIsoCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "guide": {
          "$ref": "#/definitions/leadGuide"
        },
        "walkthrough": {
          "$ref": "#/definitions/leadWalkthrough"
        },
        "demo": {
          "$ref": "#/definitions/leadDemo"
        },
        "venue": {
          "$ref": "#/definitions/leadVenue"
        },
        "story": {
          "$ref": "#/definitions/leadStory"
        },
        "referral": {
          "$ref": "#/definitions/leadReferral"
        },
        "orgContact": {
          "$ref": "#/definitions/leadOrgContact"
        },
        "cityAlerts": {
          "$ref": "#/definitions/leadCityAlerts"
        },
        "referralCredit": {
          "$ref": "#/definitions/leadReferralCredit"
        }
      }
    },
    "leadGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,39}$",
          "description": "Which setup guide, as a slug: run_club, supper_club, quiz_night, social_night, racket_social, outdoor_group, studio, workshop, facility, venue, community, creator, society or team_social."
        }
      }
    },
    "leadWalkthrough": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferredTime"
      ],
      "properties": {
        "preferredTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "The time the person asked for, as shown to them (Tue 18 · 16:00 IST). A request, not a booking: staff confirm on WhatsApp."
        },
        "organisation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "whatYouRun": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "leadDemo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "whatYouHost"
      ],
      "properties": {
        "whatYouHost": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "currentQuestions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "What they ask guests now: pasted questions or a link to their form."
        }
      }
    },
    "leadVenue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceName",
        "capacity",
        "nights"
      ],
      "properties": {
        "spaceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Area and city, as typed (Lower Parel, Mumbai)."
        },
        "capacity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "How many people fit, as typed (60 standing, 30 seated)."
        },
        "nights": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Nights they'd like to fill, as typed (Tuesdays and Wednesdays)."
        }
      }
    },
    "leadStory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "communityName",
        "cadence"
      ],
      "properties": {
        "communityName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "cadence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "What they host, and how often (A monthly supper club for 24)."
        }
      }
    },
    "leadReferral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostName",
        "hostLink",
        "relationship"
      ],
      "properties": {
        "hostName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "The host or club being referred."
        },
        "hostLink": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Their Instagram handle or website as typed; hostApplication.communityLink carries it as an https link when it reads as one."
        },
        "relationship": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "How the referrer knows them."
        }
      }
    },
    "leadOrgContact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orgType",
        "orgName"
      ],
      "properties": {
        "orgType": {
          "type": "string",
          "enum": [
            "college",
            "team",
            "brand"
          ]
        },
        "orgName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "The society, college, company or brand."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "leadCityAlerts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interests"
      ],
      "properties": {
        "interests": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "description": "The format chips they picked; may be empty when the form has none.",
          "items": {
            "type": "string",
            "enum": [
              "runs",
              "courts",
              "dinners",
              "quizzes",
              "nights_out",
              "fitness",
              "workshops",
              "books"
            ]
          }
        }
      }
    },
    "leadReferralCredit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "referrerUid",
        "referrerRole"
      ],
      "description": "Whether the nominator credit path can credit the referrer. The organizer listing this referral seeds names the referrer as its first nominator only with a signed-in Catch account. missing_referrer_account: the form was sent signed out, so only the typed name and number are known and no credit can be earned until staff record the referrer another way.",
      "properties": {
        "status": {
          "enum": [
            "referrer_account",
            "missing_referrer_account"
          ]
        },
        "referrerUid": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "referrerRole": {
          "anyOf": [
            {
              "enum": [
                "guest",
                "partner"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "referrer_account"
          }
        }
      },
      "then": {
        "properties": {
          "referrerUid": {
            "type": "string"
          },
          "referrerRole": {
            "enum": [
              "guest",
              "partner"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "referrerUid": {
            "type": "null"
          },
          "referrerRole": {
            "type": "null"
          }
        }
      }
    }
  }
}
