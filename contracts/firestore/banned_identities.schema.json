{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/banned_identities.schema.json",
  "title": "BannedIdentityDocument",
  "description": "A phone number or device that a Catch-wide ban stops from making a new account. Only a SHA-256 hash of the value is stored. It stays after the banned account is deleted so the ban keeps holding; lifting the ban sets active to false.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "bannedIdentities",
  "x-firestore-path": "bannedIdentities/{identityId}",
  "x-document-id-field": "identityId",
  "x-owner": "Account safety action service",
  "required": ["schemaVersion", "identityId", "kind", "valueHash", "uid", "actionId", "active", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "identityId": {"type": "string", "pattern": "^(phone|installation|pushToken)-[a-f0-9]{64}$"},
    "kind": {"type": "string", "enum": ["phone", "installation", "pushToken"]},
    "valueHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "uid": {"type": "string", "minLength": 1, "maxLength": 128},
    "actionId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$"},
    "active": {"type": "boolean"},
    "createdAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "updatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"}
  }
}
