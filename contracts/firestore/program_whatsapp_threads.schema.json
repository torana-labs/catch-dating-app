{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/program_whatsapp_threads.schema.json",
  "title": "ProgramWhatsappThreadDocument",
  "description": "One wedding household's WhatsApp conversation with the programme's number, at programWhatsappThreads/{programId}_{householdId} (unknown senders: {programId}_u-{first 32 hex of the endpoint hash}). The 24-hour service window is the last inbound message plus 24 hours. handledBy says whether the assistant or the planner answers; state says whether it needs the planner. Server-only; scrubbed by the programme retention sweep.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "programWhatsappThreads",
  "x-firestore-path": "programWhatsappThreads/{programWhatsappThreadId}",
  "x-owner": "programme WhatsApp inbound router and reply callables",
  "required": [
    "schemaVersion",
    "threadId",
    "programId",
    "organizerId",
    "householdId",
    "guestId",
    "connectionId",
    "endpointHash",
    "unknownSender",
    "handledBy",
    "state",
    "language",
    "escalationReason",
    "lastMessagePreview",
    "lastMessageDirection",
    "lastMessageAuthor",
    "lastMessageAtMillis",
    "lastInboundAtMillis",
    "lastInboundMessageId",
    "serviceWindowExpiresAtMillis",
    "unreadCount",
    "messageCount",
    "unknownSenderReplySentAtMillis",
    "takenOverByUid",
    "createdAtMillis",
    "updatedAtMillis",
    "revision"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "x-catch-ownership": "server-only"
    },
    "threadId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 260,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "x-catch-ownership": "server-only"
    },
    "programId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "householdId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180,
      "description": "Null for an unknown sender.",
      "x-catch-ownership": "server-only"
    },
    "guestId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180,
      "description": "The guest whose own phone wrote in, when known.",
      "x-catch-ownership": "server-only"
    },
    "connectionId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "description": "organizerSenderConnections id of the wedding's number.",
      "x-catch-ownership": "server-only"
    },
    "endpointHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "x-catch-ownership": "server-only"
    },
    "unknownSender": {
      "type": "boolean",
      "x-catch-ownership": "server-only"
    },
    "handledBy": {
      "type": "string",
      "enum": [
        "assistant",
        "planner"
      ],
      "x-catch-ownership": "server-only"
    },
    "state": {
      "type": "string",
      "enum": [
        "needsYou",
        "handled"
      ],
      "x-catch-ownership": "server-only"
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "en",
        "hi",
        "gu",
        "mr",
        "ta",
        null
      ],
      "description": "The guest's language when known (set by the assistant).",
      "x-catch-ownership": "server-only"
    },
    "escalationReason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "assistantOff",
        "plannerHandling",
        "outsideWindow",
        "media",
        "askedForPerson",
        "distress",
        "giftsOrMoney",
        "changeRequest",
        "notInFacts",
        "budgetExhausted",
        "providerError",
        "unsafeAnswer",
        "factsUnavailable",
        "uncertainRetry",
        "unknownSender",
        null
      ],
      "description": "Why the thread was passed to the planner: the assistant's reasons (functions/src/programs/assistant/policy.ts ESCALATION_REASONS) plus unknownSender.",
      "x-catch-ownership": "server-only"
    },
    "lastMessagePreview": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "x-catch-ownership": "server-only"
    },
    "lastMessageDirection": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "x-catch-ownership": "server-only"
    },
    "lastMessageAuthor": {
      "type": "string",
      "enum": [
        "guest",
        "assistant",
        "planner",
        "system"
      ],
      "x-catch-ownership": "server-only"
    },
    "lastMessageAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    },
    "lastInboundAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    },
    "lastInboundMessageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "x-catch-ownership": "server-only"
    },
    "serviceWindowExpiresAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    },
    "unreadCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000,
      "x-catch-ownership": "server-only"
    },
    "messageCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "x-catch-ownership": "server-only"
    },
    "unknownSenderReplySentAtMillis": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    },
    "takenOverByUid": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180,
      "x-catch-ownership": "server-only"
    },
    "createdAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    },
    "updatedAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    }
  }
}
