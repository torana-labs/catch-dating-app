{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/account_safety_actions.schema.json",
  "title": "AccountSafetyActionDocument",
  "description": "One step Catch took against an account: warn, restrict (no messages or group chats), suspend (signed out, future bookings cancelled) or ban (Catch-wide, phone and device blocked from new accounts). Ops may warn and restrict; suspend and ban are owner-only; a severe report restricts automatically. The person may appeal once, and someone other than the decider reviews it. Kept 180 days after the account is deleted (retainUntil).",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "accountSafetyActions",
  "x-firestore-path": "accountSafetyActions/{actionId}",
  "x-document-id-field": "actionId",
  "x-owner": "Admin account safety callables and the severe-report restriction",
  "required": ["schemaVersion", "actionId", "uid", "kind", "reasonCode", "messageToUser", "durationDays", "startsAt", "endsAt",
    "status", "caseTargetPaths", "decidedByUid", "decidedByRole", "automatic", "appealable", "appeal", "bookings", "lifted",
    "retainUntil", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "actionId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$"},
    "uid": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"type": "string", "enum": ["warn", "restrict", "suspend", "ban"]},
    "reasonCode": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "messageToUser": {"type": "string", "minLength": 1, "maxLength": 1000},
    "durationDays": {"type": ["integer", "null"], "enum": [7, 30, null]},
    "startsAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "endsAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "status": {"type": "string", "enum": ["active", "expired", "lifted", "replaced"]},
    "caseTargetPaths": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 3, "maxLength": 260}},
    "decidedByUid": {"type": "string", "minLength": 1, "maxLength": 128},
    "decidedByRole": {"type": "string", "enum": ["owner", "ops", "system"]},
    "automatic": {"type": "boolean"},
    "appealable": {"type": "boolean"},
    "appeal": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "text", "submittedAt", "reviewerUid", "decidedAt", "decisionNote", "replacementActionId"],
          "properties": {
            "status": {"type": "string", "enum": ["open", "kept", "reduced", "lifted"]},
            "text": {"type": "string", "minLength": 1, "maxLength": 2000},
            "submittedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
            "reviewerUid": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
            "decidedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
            "decisionNote": {"type": ["string", "null"], "maxLength": 1000},
            "replacementActionId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{8,128}$"}
          }
        }
      ]
    },
    "bookings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cancelledEventIds", "needsOrganizerEventIds", "failedEventIds"],
      "properties": {
        "cancelledEventIds": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "needsOrganizerEventIds": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "failedEventIds": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "lifted": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["at", "byUid", "note"],
          "properties": {
            "at": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
            "byUid": {"type": "string", "minLength": 1, "maxLength": 128},
            "note": {"type": "string", "minLength": 1, "maxLength": 1000}
          }
        }
      ]
    },
    "retainUntil": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "createdAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "updatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"}
  }
}
