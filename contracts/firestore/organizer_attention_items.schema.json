{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/organizer_attention_items.schema.json",
  "title": "OrganizerAttentionItemDocument",
  "description": "Server-owned evaluated Host Today attention projection. Executable trigger, resolution, permission, deadline, and dedupe policy remains versioned in the Host attention catalog rather than embedded as prose in each document.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "organizerAttentionItems",
  "x-firestore-path": "organizerAttentionItems/{attentionId}",
  "x-document-id-field": "attentionId",
  "x-owner": "Host Today attention evaluator (hostReadModels attention triggers and sweepOrganizerAttention)",
  "required": [
    "schemaVersion",
    "attentionId",
    "organizerId",
    "kind",
    "scope",
    "sourceOwner",
    "sourceId",
    "sourceRevision",
    "eventId",
    "status",
    "consequence",
    "blocking",
    "urgency",
    "destination",
    "context",
    "dedupeKey",
    "policyVersion",
    "resolutionVersion",
    "assignedHostUid",
    "openedAt",
    "dueAt",
    "actionExpiresAt",
    "sourceUpdatedAt",
    "createdAt",
    "updatedAt",
    "resolvedAt",
    "purgeAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1, "x-catch-ownership": "server-only"},
    "attentionId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId", "x-catch-ownership": "server-only"},
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId", "x-catch-ownership": "server-only"},
    "kind": {"$ref": "../shared/host_attention_common.schema.json#/definitions/kind", "x-catch-ownership": "server-only"},
    "scope": {"$ref": "../shared/host_attention_common.schema.json#/definitions/scope", "x-catch-ownership": "server-only"},
    "sourceOwner": {"$ref": "../shared/host_attention_common.schema.json#/definitions/sourceOwner", "x-catch-ownership": "server-only"},
    "sourceId": {"type": "string", "minLength": 1, "maxLength": 180, "x-catch-ownership": "server-only"},
    "sourceRevision": {"type": "string", "minLength": 1, "maxLength": 180, "x-catch-ownership": "server-only"},
    "eventId": {"type": ["string", "null"], "maxLength": 180, "x-catch-ownership": "server-only"},
    "status": {"$ref": "../shared/host_attention_common.schema.json#/definitions/status", "x-catch-ownership": "server-only"},
    "consequence": {"$ref": "../shared/host_attention_common.schema.json#/definitions/consequence", "x-catch-ownership": "server-only"},
    "blocking": {"type": "boolean", "x-catch-ownership": "server-only"},
    "urgency": {"$ref": "../shared/host_attention_common.schema.json#/definitions/urgency", "x-catch-ownership": "server-only"},
    "destination": {"$ref": "../shared/host_attention_common.schema.json#/definitions/destination", "x-catch-ownership": "server-only"},
    "context": {"$ref": "../shared/host_attention_common.schema.json#/definitions/context", "x-catch-ownership": "server-only"},
    "dedupeKey": {"type": "string", "minLength": 1, "maxLength": 240, "x-catch-ownership": "server-only"},
    "policyVersion": {"type": "integer", "minimum": 1, "maximum": 1000000, "x-catch-ownership": "server-only"},
    "resolutionVersion": {"type": "integer", "minimum": 1, "maximum": 1000000, "x-catch-ownership": "server-only"},
    "assignedHostUid": {"type": ["string", "null"], "maxLength": 180, "x-catch-ownership": "server-only"},
    "openedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp", "x-catch-ownership": "server-only"},
    "dueAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp", "x-catch-ownership": "server-only"},
    "actionExpiresAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp", "x-catch-ownership": "server-only"},
    "sourceUpdatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp", "x-catch-ownership": "server-only"},
    "createdAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp", "x-catch-ownership": "server-only"},
    "updatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp", "x-catch-ownership": "server-only"},
    "resolvedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp", "x-catch-ownership": "server-only"},
    "purgeAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp", "x-firestore-ttl": true, "x-catch-ownership": "server-only"}
  }
}
