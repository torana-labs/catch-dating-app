{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/event_seat_migration_fences.schema.json",
  "title": "EventSeatMigrationFenceDocument",
  "description": "Lock that marks an event's seat ledger as owned by one migration revision. Locked while a bootstrap runs, ready once it finishes or when a host's terms create an empty ledger.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "eventSeatMigrationFences",
  "x-firestore-path": "eventSeatMigrationFences/{eventId}",
  "x-document-id-field": "id",
  "x-owner": "Seat migration bootstrap (functions/src/events/seatMigrationPaged.ts)",
  "required": [
    "eventId",
    "organizerId",
    "migrationRevision",
    "token",
    "state"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "x-catch-ownership": "server-only"
    },
    "organizerId": {
      "type": "string",
      "minLength": 1,
      "x-catch-ownership": "server-only"
    },
    "migrationRevision": {
      "type": "integer",
      "minimum": 1,
      "x-catch-ownership": "server-only"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "x-catch-ownership": "server-only"
    },
    "state": {
      "type": "string",
      "enum": [
        "locked",
        "ready"
      ],
      "x-catch-ownership": "server-only"
    }
  }
}
