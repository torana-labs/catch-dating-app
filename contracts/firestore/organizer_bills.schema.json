{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/organizer_bills.schema.json",
  "title": "OrganizerBillDocument",
  "description": "Catch's monthly bill to one organizer, made from the bookings paid into the organizer's own account (hostCollected) in one calendar month, India time. Commission uses each payment's frozen terms (or the organizer's current terms when a payment has none), the free trial, and the monthly cap from the organizer's current terms. GST is added only while Settings → Payments says Catch is GST registered. An invoice number is taken from the financial year's unbroken sequence when the bill is sent. Server-only; Admin reads and acts on it through adminManageOrganizerBills.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "organizerBills",
  "x-firestore-path": "organizerBills/{billId}",
  "x-document-id-field": "billId",
  "x-owner": "Functions organizer billing (monthly generation, adminManageOrganizerBills, Razorpay payment link webhook)",
  "required": ["schemaVersion", "billId", "organizerId", "organizerName", "month", "periodStartMillis", "periodEndMillis",
    "revision", "status", "sales", "commission", "trialEndsAtMillis", "terms", "gst", "totalMinor", "invoiceNumber",
    "dueAtMillis", "paymentLink", "sentAtMillis", "reminders", "paidAtMillis", "paidMinor", "paidVia",
    "writtenOffAtMillis", "history", "generatedAtMillis", "updatedAtMillis"],
  "definitions": {
    "millis": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "nullableMillis": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "minor": {"type": "integer", "minimum": 0, "maximum": 100000000000},
    "status": {
      "description": "toSend: made, not sent. sent: sent with its invoice number and due date; overdue is sent past its due date. paid, writtenOff: closed. free: nothing due because every sale fell in the free trial.",
      "enum": ["toSend", "sent", "paid", "writtenOff", "free"]
    },
    "historyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atMillis", "action", "byUid", "note"],
      "properties": {
        "atMillis": {"$ref": "#/definitions/millis"},
        "action": {"enum": ["generated", "regenerated", "sent", "reminded", "paid", "writtenOff"]},
        "byUid": {"type": ["string", "null"], "maxLength": 128},
        "note": {"type": ["string", "null"], "maxLength": 500}
      }
    }
  },
  "properties": {
    "schemaVersion": {"const": 1},
    "billId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,179}_[0-9]{4}-[0-9]{2}$"},
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "organizerName": {"type": "string", "maxLength": 160},
    "month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "periodStartMillis": {"$ref": "#/definitions/millis"},
    "periodEndMillis": {"$ref": "#/definitions/millis"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"$ref": "#/definitions/status"},
    "sales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paymentCount", "eventCount", "grossMinor", "refundedMinor", "baseMinor", "providerFeeMinor",
        "providerTaxMinor", "unsnapshottedCount"],
      "properties": {
        "paymentCount": {"type": "integer", "minimum": 0},
        "eventCount": {"type": "integer", "minimum": 0},
        "grossMinor": {"$ref": "#/definitions/minor"},
        "refundedMinor": {"$ref": "#/definitions/minor"},
        "baseMinor": {"$ref": "#/definitions/minor", "description": "What commission is charged on: gross or net of refunds, per the terms."},
        "providerFeeMinor": {"$ref": "#/definitions/minor", "description": "Razorpay's fees on these sales, taken from the organizer's account; shown for their records."},
        "providerTaxMinor": {"$ref": "#/definitions/minor"},
        "unsnapshottedCount": {"type": "integer", "minimum": 0, "description": "Payments that froze no terms and were charged on the organizer's current terms."}
      }
    },
    "commission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rateBasisPoints", "uncappedMinor", "capMinor", "capped", "trialWaivedMinor", "amountMinor"],
      "properties": {
        "rateBasisPoints": {"type": "integer", "minimum": 0, "maximum": 10000, "description": "The organizer's current rate; individual payments may have frozen another."},
        "uncappedMinor": {"$ref": "#/definitions/minor"},
        "capMinor": {"anyOf": [{"$ref": "#/definitions/minor"}, {"type": "null"}]},
        "capped": {"type": "boolean"},
        "trialWaivedMinor": {"$ref": "#/definitions/minor"},
        "amountMinor": {"$ref": "#/definitions/minor"}
      }
    },
    "trialEndsAtMillis": {"$ref": "#/definitions/nullableMillis"},
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformRevision", "organizerRevision", "ownTerms"],
      "properties": {
        "platformRevision": {"type": "integer", "minimum": 0},
        "organizerRevision": {"type": "integer", "minimum": 0},
        "ownTerms": {"type": "boolean"}
      }
    },
    "gst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registered", "rateBasisPoints", "amountMinor"],
      "properties": {
        "registered": {"type": "boolean"},
        "rateBasisPoints": {"type": "integer", "minimum": 0, "maximum": 10000},
        "amountMinor": {"$ref": "#/definitions/minor"}
      }
    },
    "totalMinor": {"$ref": "#/definitions/minor"},
    "invoiceNumber": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}/[0-9]{3,}$"},
    "dueAtMillis": {"$ref": "#/definitions/nullableMillis"},
    "paymentLink": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["linkId", "url"],
          "properties": {
            "linkId": {"type": "string", "pattern": "^plink_[A-Za-z0-9]{1,40}$"},
            "url": {"type": "string", "pattern": "^https://", "maxLength": 300}
          }
        }
      ]
    },
    "sentAtMillis": {"$ref": "#/definitions/nullableMillis"},
    "reminders": {"type": "array", "maxItems": 24, "items": {"$ref": "#/definitions/millis"}},
    "paidAtMillis": {"$ref": "#/definitions/nullableMillis"},
    "paidMinor": {"anyOf": [{"$ref": "#/definitions/minor"}, {"type": "null"}]},
    "paidVia": {"enum": ["paymentLink", "manual", null]},
    "writtenOffAtMillis": {"$ref": "#/definitions/nullableMillis"},
    "history": {"type": "array", "maxItems": 60, "items": {"$ref": "#/definitions/historyEntry"}},
    "generatedAtMillis": {"$ref": "#/definitions/millis"},
    "updatedAtMillis": {"$ref": "#/definitions/millis"}
  }
}
