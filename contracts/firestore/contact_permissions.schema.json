{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/contact_permissions.schema.json",
  "title": "ContactPermissionDocument",
  "description": "Server-owned answer to whether one sender may message this person, stored at users/{uid}/contactPermissions/{senderKey}: senderKey is catch, organizer_{organizerId} or event_{eventId}. grants holds one explicit answer per channel:purpose, each bound to the receipt in contactPermissionReceipts that proves it and, for an opt-in, to the phone number it was given for. granted lists the keys that are effective now. No document, or no key, means no consent. Every consent decision rewrites it in the transaction that records the decision's receipt (issue #2460). An event document (issue #2494) holds the event-day sms, rcs and whatsapp grants, one per channel and bound to one roster row, one sender identity and one number until it expires, plus the approval-notification choices; its expiresAt, the latest grant expiry, is the field a TTL policy deletes it by.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "contactPermissions",
  "x-firestore-path": "users/{uid}/contactPermissions/{senderKey}",
  "x-document-id-field": "senderKey",
  "x-owner": "messaging contact permission writers (functions/src/messaging/contactPermissions.ts and eventContactPermissions.ts), called by every consent writer",
  "required": ["senderKind", "senderId", "grants", "granted", "updatedAt"],
  "properties": {
    "senderKind": {
      "type": "string",
      "enum": ["catch", "organizer", "event"],
      "x-catch-ownership": "server-only"
    },
    "senderId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "description": "catch for Catch itself, the organizer id for an organiser, or the event id for an event. Organiser audiences query the contactPermissions collection group by senderId and granted, which never matches an event document.",
      "x-catch-ownership": "server-only"
    },
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "description": "Event documents only: the organiser running the event.",
      "x-catch-ownership": "server-only"
    },
    "grants": {
      "type": "object",
      "description": "One explicit answer per channel:purpose. An opted-in answer the send gate does not honour yet (for example a form opt-in awaiting provider review, or one with no known phone number) stays here but is left out of granted. Event documents hold only the event keys, the others only the sender keys.",
      "propertyNames": {"$ref": "#/definitions/grantKey"},
      "additionalProperties": false,
      "x-catch-ownership": "server-only",
      "properties": {
        "whatsapp:eventOperations": {"$ref": "#/definitions/grant"},
        "whatsapp:marketing": {"$ref": "#/definitions/grant"},
        "whatsapp:followerUpdates": {"$ref": "#/definitions/grant"},
        "sms:marketing": {"$ref": "#/definitions/grant"},
        "sms:eventService": {"$ref": "#/definitions/eventServiceGrant"},
        "rcs:eventService": {"$ref": "#/definitions/eventServiceGrant"},
        "whatsapp:eventService": {"$ref": "#/definitions/eventServiceGrant"},
        "phone:bookingUpdates": {"$ref": "#/definitions/phoneBookingUpdatesGrant"},
        "email:bookingUpdates": {"$ref": "#/definitions/emailBookingUpdatesGrant"}
      }
    },
    "granted": {
      "type": "array",
      "description": "The grants keys that are effective now, sorted.",
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/grantKey"},
      "x-catch-ownership": "server-only"
    },
    "updatedAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp",
      "x-catch-ownership": "server-only"
    },
    "expiresAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp",
      "description": "Event documents only: the latest event-day grant expiry. A TTL policy on the contactPermissions collection group deletes the document after it; catch and organiser documents have no expiresAt.",
      "x-catch-ownership": "server-only"
    }
  },
  "definitions": {
    "grantKey": {
      "type": "string",
      "enum": [
        "whatsapp:eventOperations",
        "whatsapp:marketing",
        "whatsapp:followerUpdates",
        "sms:marketing",
        "sms:eventService",
        "rcs:eventService",
        "whatsapp:eventService",
        "phone:bookingUpdates",
        "email:bookingUpdates"
      ]
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "endpointE164", "receiptId", "termsVersion", "source", "updatedAt"],
      "properties": {
        "status": {"type": "string", "enum": ["optedIn", "optedOut"]},
        "endpointE164": {
          "description": "The phone number an opt-in covers; it covers no other number. Null on a withdrawal, which covers every number, and on an older opt-in recorded without a number, which is never effective.",
          "anyOf": [{"type": "string", "pattern": "^\\+[1-9][0-9]{6,14}$"}, {"type": "null"}]
        },
        "receiptId": {
          "description": "The contactPermissionReceipts document that proves this answer. Only an older withdrawal can lack one.",
          "anyOf": [
            {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
            {"type": "null"}
          ]
        },
        "termsVersion": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
        "source": {
          "type": ["string", "null"],
          "enum": [
            null,
            "publicEventRegistration",
            "hostFormResponse",
            "participantSettings",
            "unsubscribeLink",
            "inboundStop",
            "providerWebhook",
            "legacyIncomplete",
            "organizerFollowByPhone"
          ]
        },
        "updatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "optedIn"}}, "required": ["status"]},
          "then": {
            "properties": {
              "receiptId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
              "source": {"type": "string"}
            }
          }
        }
      ]
    },
    "eventServiceGrant": {
      "type": "object",
      "additionalProperties": false,
      "description": "One event-day channel grant (issue #2494): it covers one roster row (attendeeId and attendeeGeneration), one sender identity and one number until expiresAt. A grant for a new sender replaces the old one, so a sender change needs fresh consent. revision continues the per-channel revision callers send back as expectedRevision.",
      "required": [
        "status",
        "endpointE164",
        "receiptId",
        "termsVersion",
        "source",
        "updatedAt",
        "expiresAt",
        "revision",
        "senderId",
        "senderIdentityHash",
        "attendeeId",
        "attendeeGeneration",
        "recipientEndpointId",
        "evidence"
      ],
      "properties": {
        "status": {"type": "string", "enum": ["optedIn", "optedOut"]},
        "endpointE164": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{6,14}$",
          "description": "The number the grant covers; a withdrawal keeps the number it withdrew."
        },
        "receiptId": {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId",
          "description": "The contactPermissionReceipts document for the latest decision."
        },
        "termsVersion": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 80,
          "description": "The consent copy version of the opt-in in evidence, or null."
        },
        "source": {
          "type": "string",
          "enum": ["participantSettings", "unsubscribeLink"],
          "description": "participantSettings: the verified guest's own preference screen. unsubscribeLink: a withdrawal link in a message."
        },
        "updatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
        "expiresAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "senderId": {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId",
          "description": "The sender the guest saw: the SMS sender id, the organiser's WhatsApp sender connection or the RCS sender."
        },
        "senderIdentityHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash of the displayed sender identity, never of credentials. WhatsApp and RCS use their existing sender hashes; SMS hashes its route and sender id."
        },
        "attendeeId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "attendeeGeneration": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "recipientEndpointId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "recipientBinding": {
          "$ref": "../shared/event_assistance_message_recipient.schema.json#/definitions/RecipientBinding"
        },
        "evidence": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "description": "The last opt-in this grant rests on. A withdrawal keeps it; it is null only for a withdrawal with no earlier opt-in.",
              "required": ["receiptId", "termsVersion", "acceptedAt", "phoneVerifiedAt"],
              "properties": {
                "receiptId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
                "termsVersion": {"type": "string", "minLength": 1, "maxLength": 80},
                "acceptedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
                "phoneVerifiedAt": {
                  "$ref": "../shared/event_common.schema.json#/definitions/timestamp",
                  "description": "When the server checked the signed phone claim, not when a code was sent."
                },
                "senderHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "WhatsApp and RCS: the sender identity hash the guest accepted."
                },
                "reviewHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "RCS: the review the guest accepted."
                },
                "reviewedStopHash": {
                  "anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}],
                  "description": "RCS: the conversation STOP the guest reviewed, if any."
                }
              }
            }
          ]
        },
        "rcs": {
          "type": "object",
          "additionalProperties": false,
          "description": "RCS grants only.",
          "required": ["sourceGeneration", "subscriptionId", "sender"],
          "properties": {
            "sourceGeneration": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "subscriptionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "sender": {
              "$ref": "../shared/event_assistance_rcs_consent.schema.json#/definitions/Sender"
            }
          }
        },
        "whatsapp": {
          "type": "object",
          "additionalProperties": false,
          "description": "WhatsApp grants only.",
          "required": ["sender"],
          "properties": {
            "sender": {
              "$ref": "../shared/event_assistance_whatsapp_consent.schema.json#/definitions/Sender"
            }
          }
        }
      }
    },
    "phoneBookingUpdatesGrant": {
      "type": "object",
      "additionalProperties": false,
      "description": "Approval updates by WhatsApp or SMS to the account's verified phone, for one event (one choice covers both, as before).",
      "required": [
        "status",
        "endpointE164",
        "receiptId",
        "termsVersion",
        "source",
        "updatedAt",
        "revision"
      ],
      "properties": {
        "status": {"type": "string", "enum": ["optedIn", "optedOut"]},
        "endpointE164": {
          "anyOf": [{"type": "string", "pattern": "^\\+[1-9][0-9]{6,14}$"}, {"type": "null"}],
          "description": "The verified account contact the choice covers; null when not chosen."
        },
        "receiptId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "termsVersion": {"type": "string", "const": "event-approval-v1"},
        "source": {"type": "string", "enum": ["participantSettings"]},
        "updatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The approval-notification choice revision; both booking-update grants share it."
        }
      }
    },
    "emailBookingUpdatesGrant": {
      "type": "object",
      "additionalProperties": false,
      "description": "Approval updates by email to the account's verified email, for one event.",
      "required": [
        "status",
        "email",
        "receiptId",
        "termsVersion",
        "source",
        "updatedAt",
        "revision"
      ],
      "properties": {
        "status": {"type": "string", "enum": ["optedIn", "optedOut"]},
        "email": {
          "anyOf": [{"type": "string", "format": "email", "maxLength": 254}, {"type": "null"}],
          "description": "The verified account contact the choice covers; null when not chosen."
        },
        "receiptId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "termsVersion": {"type": "string", "const": "event-approval-v1"},
        "source": {"type": "string", "enum": ["participantSettings"]},
        "updatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The approval-notification choice revision; both booking-update grants share it."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"senderKind": {"const": "event"}}, "required": ["senderKind"]},
      "then": {
        "required": ["organizerId"],
        "properties": {
          "grants": {
            "propertyNames": {
              "enum": [
                "sms:eventService",
                "rcs:eventService",
                "whatsapp:eventService",
                "phone:bookingUpdates",
                "email:bookingUpdates"
              ]
            }
          },
          "granted": {
            "items": {
              "enum": [
                "sms:eventService",
                "rcs:eventService",
                "whatsapp:eventService",
                "phone:bookingUpdates",
                "email:bookingUpdates"
              ]
            }
          }
        }
      },
      "else": {
        "not": {"anyOf": [{"required": ["organizerId"]}, {"required": ["expiresAt"]}]},
        "properties": {
          "grants": {
            "propertyNames": {
              "enum": [
                "whatsapp:eventOperations",
                "whatsapp:marketing",
                "whatsapp:followerUpdates",
                "sms:marketing"
              ]
            }
          },
          "granted": {
            "items": {
              "enum": [
                "whatsapp:eventOperations",
                "whatsapp:marketing",
                "whatsapp:followerUpdates",
                "sms:marketing"
              ]
            }
          }
        }
      }
    }
  ]
}
