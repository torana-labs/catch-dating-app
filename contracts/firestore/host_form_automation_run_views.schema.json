{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/host_form_automation_run_views.schema.json",
  "title": "HostFormAutomationRunViewDocument",
  "description": "Server-maintained manager read view of one automation run for the Host automation history, with exactly the run row listOrganizerFormAutomationRuns returns and the name of its rule joined in. The view id is the run id. Written by triggers on organizerFormAutomationRuns and on rule renames. Never the lease, the error code or the source occurrence, and never identity, permission or mutation authority.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "hostFormAutomationRunViews",
  "x-firestore-path": "hostFormAutomationRunViews/{runId}",
  "x-document-id-field": "runId",
  "x-owner": "Host read model projector (hostReadModels form automation view triggers)",
  "required": [
    "organizerId",
    "runId",
    "ruleId",
    "formId",
    "createdAtMillis",
    "ruleName",
    "row",
    "version"
  ],
  "properties": {
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "runId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "ruleId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId",
      "x-catch-ownership": "server-only"
    },
    "formId": {
      "anyOf": [
        {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        {"type": "null"}
      ],
      "x-catch-ownership": "server-only"
    },
    "createdAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-catch-ownership": "server-only"
    },
    "ruleName": {
      "type": ["string", "null"],
      "maxLength": 120,
      "description": "The rule's current name, or null when the rule is missing or belongs to another organizer.",
      "x-catch-ownership": "server-only"
    },
    "row": {
      "$ref": "../shared/organizer_form_operations_common.schema.json#/definitions/automationRunProjection",
      "x-catch-ownership": "server-only"
    },
    "version": {
      "const": 1,
      "x-catch-ownership": "server-only"
    }
  }
}
