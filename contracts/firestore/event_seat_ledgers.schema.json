{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/event_seat_ledgers.schema.json",
  "title": "EventSeatLedgerDocument",
  "description": "Server-only seat count for one private event: capacity, occupied seats, checkout and temporary holds, and the revisions and policy hash that every seat change is checked against. Held seats are never counted in bookedCount.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "eventSeatLedgers",
  "x-firestore-path": "eventSeatLedgers/{eventId}",
  "x-document-id-field": "id",
  "x-owner": "Seat authority (functions/src/events/seatAuthority, seatIdentityAuthority, seatMigrationPaged)",
  "required": [
    "eventId",
    "capacity",
    "occupied",
    "revision",
    "capacityRevision",
    "policyVersion",
    "policyHash",
    "migrationRevision",
    "state"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "x-catch-ownership": "server-only"
    },
    "capacity": {
      "type": "integer",
      "minimum": 0,
      "x-catch-ownership": "server-only"
    },
    "occupied": {
      "type": "integer",
      "minimum": 0,
      "x-catch-ownership": "server-only"
    },
    "checkoutHeld": {
      "type": "integer",
      "minimum": 0,
      "description": "Seats held by payment attempts. Missing means zero.",
      "x-catch-ownership": "server-only"
    },
    "temporaryHeld": {
      "type": "integer",
      "minimum": 0,
      "description": "Policy-expiring holds (Cross Paths pairs). Missing means zero.",
      "x-catch-ownership": "server-only"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "x-catch-ownership": "server-only"
    },
    "capacityRevision": {
      "type": "integer",
      "minimum": 1,
      "x-catch-ownership": "server-only"
    },
    "policyVersion": {
      "type": "string",
      "enum": [
        "legacy",
        "v1",
        "v2"
      ],
      "x-catch-ownership": "server-only"
    },
    "policyHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "x-catch-ownership": "server-only"
    },
    "migrationRevision": {
      "type": "integer",
      "minimum": 1,
      "x-catch-ownership": "server-only"
    },
    "state": {
      "type": "string",
      "enum": [
        "ready",
        "unreconciled",
        "revoked"
      ],
      "x-catch-ownership": "server-only"
    }
  }
}
