{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/host_membership_programs.schema.json",
  "title": "HostMembershipProgramDocument",
  "description": "Server-owned per-organizer paid membership program: the payment binding snapshot taken when the program was enabled (its money flow, account and connection), the host-wide billing pause and member counts.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "hostMembershipPrograms",
  "x-firestore-path": "hostMembershipPrograms/{organizerId}",
  "x-owner": "manageHostMembershipProgram callable and processHostMembershipBillingPause schedule",
  "required": ["schemaVersion", "organizerId", "state", "payment", "billingPause", "memberCount", "revision", "createdAtMillis", "updatedAtMillis"],
  "properties": {
    "schemaVersion": {"const": 1, "x-catch-ownership": "server-only"},
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId", "x-catch-ownership": "server-only"},
    "state": {"enum": ["enabled", "disabled"], "x-catch-ownership": "server-only"},
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "providerAccountId", "bindingId", "mode"],
      "properties": {
        "provider": {"$ref": "../shared/host_membership_common.schema.json#/definitions/provider"},
        "providerAccountId": {"type": "string", "pattern": "^acc_[A-Za-z0-9]{4,40}$"},
        "bindingId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "mode": {"$ref": "../shared/host_membership_common.schema.json#/definitions/providerMode"},
        "moneyFlow": {"description": "Absent on programs enabled under the original platform-account model, which is platformSplit.", "$ref": "../shared/host_membership_common.schema.json#/definitions/moneyFlow"},
        "webhookId": {"description": "hostCollected only: the membership webhook Catch registered on the organizer's merchant account.", "type": "string", "minLength": 1, "maxLength": 128}
      },
      "x-catch-ownership": "server-only"
    },
    "billingPause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "requestedAtMillis", "requestedBy", "processedCount", "cursor"],
      "properties": {
        "state": {"enum": ["active", "pausing", "paused", "resuming"]},
        "requestedAtMillis": {"$ref": "../shared/host_membership_common.schema.json#/definitions/nullableMillis"},
        "requestedBy": {"type": ["string", "null"], "maxLength": 128},
        "processedCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "cursor": {"type": ["string", "null"], "maxLength": 180}
      },
      "x-catch-ownership": "server-only"
    },
    "memberCount": {"type": "integer", "minimum": 0, "maximum": 10000000, "x-catch-ownership": "server-only"},
    "revision": {"$ref": "../shared/host_membership_common.schema.json#/definitions/revision", "x-catch-ownership": "server-only"},
    "createdAtMillis": {"$ref": "../shared/host_membership_common.schema.json#/definitions/positiveMillis", "x-catch-ownership": "server-only"},
    "updatedAtMillis": {"$ref": "../shared/host_membership_common.schema.json#/definitions/positiveMillis", "x-catch-ownership": "server-only"}
  }
}
