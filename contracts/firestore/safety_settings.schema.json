{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/safety_settings.schema.json",
  "title": "SafetySettingsDocument",
  "description": "Catch's safety rules, edited by the owner in Settings → Safety: the report reasons (and which are severe), whether a severe report restricts at once, and whether organizers may keep block lists and report guests. Absent means the defaults in code.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "safetySettings",
  "x-firestore-path": "safetySettings/{settingsId}",
  "x-document-id-field": "settingsId",
  "x-owner": "Admin safety settings callables",
  "required": ["schemaVersion", "reasons", "restrictOnSevereReport", "organizerBlockLists", "organizerReports", "updatedAt", "updatedByUid"],
  "properties": {
    "schemaVersion": {"const": 1},
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "label", "severe", "takedown", "active"],
        "properties": {
          "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 80},
          "severe": {"type": "boolean"},
          "takedown": {"type": "boolean"},
          "active": {"type": "boolean"}
        }
      }
    },
    "restrictOnSevereReport": {"type": "boolean"},
    "organizerBlockLists": {"type": "boolean"},
    "organizerReports": {"type": "boolean"},
    "updatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "updatedByUid": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
