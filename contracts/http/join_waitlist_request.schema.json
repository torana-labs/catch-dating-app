{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/http/join_waitlist_request.schema.json",
  "title": "Join Waitlist HTTP Request",
  "description": "Version 1 request body for member waitlist, optional Host operating-application and programme (weddings pilot) submissions. A member may instead ask for one WhatsApp message when Catch opens in their city: that path carries `whatsapp` and needs no name or email. Outside that path a name and at least one of email or phone are required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "city",
    "role"
  ],
  "properties": {
    "hostMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "clientId"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "clientId": {
          "type": "string",
          "pattern": "^[0-9]{1,10}\\.[0-9]{10}$"
        },
        "fbclid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{10,512}$"
        },
        "clickCapturedAt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fullName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 320
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{7,14}$",
      "description": "Optional E.164 mobile number. A phone-only applicant (no email) is reviewed and answered on WhatsApp."
    },
    "city": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "role": {
      "type": "string",
      "enum": [
        "member",
        "runner",
        "host",
        "both"
      ]
    },
    "instagram": {
      "type": "string",
      "maxLength": 240
    },
    "website": {
      "type": "string",
      "maxLength": 512
    },
    "hostApplication": {
      "$ref": "#/definitions/hostApplication"
    },
    "programme": {
      "type": "string",
      "enum": [
        "weddings"
      ],
      "description": "The programme product this application is for. Absent for the events Host application."
    },
    "programmeApplication": {
      "$ref": "#/definitions/programmeApplication"
    },
    "attribution": {
      "anyOf": [
        {
          "$ref": "#/definitions/attribution"
        },
        {
          "type": "null"
        }
      ]
    },
    "analytics": {
      "$ref": "#/definitions/analytics"
    },
    "whatsapp": {
      "$ref": "#/definitions/whatsappLaunchNotice"
    }
  },
  "definitions": {
    "hostApplication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizationName": {
          "type": "string",
          "maxLength": 140
        },
        "organizationType": {
          "type": "string",
          "maxLength": 80
        },
        "operatingCity": {
          "type": "string",
          "maxLength": 80
        },
        "communityLink": {
          "type": "string",
          "maxLength": 512
        },
        "formats": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "eventCadence": {
          "type": "string",
          "maxLength": 80
        },
        "nextEventName": {
          "type": "string",
          "maxLength": 160
        },
        "nextEventDate": {
          "type": "string",
          "maxLength": 80
        },
        "eventLocation": {
          "type": "string",
          "maxLength": 180
        },
        "expectedCapacity": {
          "type": "string",
          "maxLength": 40
        },
        "bookingPlatform": {
          "type": "string",
          "maxLength": 120
        },
        "guestListFormat": {
          "type": "string",
          "maxLength": 120
        },
        "priceRange": {
          "type": "string",
          "maxLength": 80
        },
        "admissionModel": {
          "type": "string",
          "maxLength": 80
        },
        "waitlistPlan": {
          "type": "string",
          "maxLength": 80
        },
        "paymentReadiness": {
          "type": "string",
          "maxLength": 120
        },
        "eventSuccessModules": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "hostGoals": {
          "type": "string",
          "maxLength": 1000
        },
        "operatingNotes": {
          "type": "string",
          "maxLength": 1000
        },
        "eventPricing": {
          "type": "string",
          "enum": [
            "paid",
            "free",
            "mixed",
            "undecided"
          ]
        }
      }
    },
    "programmeApplication": {
      "type": "object",
      "additionalProperties": false,
      "description": "The weddings pilot application from /weddings/apply/. Every field is optional; the page sends what the planner answered.",
      "properties": {
        "planningCompany": {
          "type": "string",
          "maxLength": 140
        },
        "city": {
          "type": "string",
          "maxLength": 80
        },
        "weddingDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "First day of the next wedding, yyyy-mm-dd."
        },
        "headcount": {
          "type": "string",
          "maxLength": 40
        },
        "tools": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "functions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "hotels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "teamSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "flyingInShare": {
          "type": "string",
          "maxLength": 40
        },
        "wants": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "freeText": {
          "type": "string",
          "maxLength": 1000
        },
        "source": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstTouch",
        "lastTouch"
      ],
      "properties": {
        "firstTouch": {
          "$ref": "#/definitions/attributionTouch"
        },
        "lastTouch": {
          "$ref": "#/definitions/attributionTouch"
        }
      }
    },
    "attributionTouch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturedAt",
        "landingPath",
        "landingUrl",
        "referrer",
        "values"
      ],
      "properties": {
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 80
        },
        "landingPath": {
          "type": "string",
          "maxLength": 512
        },
        "landingUrl": {
          "type": "string",
          "maxLength": 1024
        },
        "referrer": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "utm_source": {
              "type": "string",
              "maxLength": 240
            },
            "utm_medium": {
              "type": "string",
              "maxLength": 240
            },
            "utm_campaign": {
              "type": "string",
              "maxLength": 240
            },
            "utm_content": {
              "type": "string",
              "maxLength": 240
            },
            "utm_term": {
              "type": "string",
              "maxLength": 240
            },
            "gclid": {
              "type": "string",
              "maxLength": 240
            },
            "gbraid": {
              "type": "string",
              "maxLength": 240
            },
            "wbraid": {
              "type": "string",
              "maxLength": 240
            },
            "fbclid": {
              "type": "string",
              "maxLength": 240
            },
            "ttclid": {
              "type": "string",
              "maxLength": 240
            },
            "msclkid": {
              "type": "string",
              "maxLength": 240
            },
            "li_fat_id": {
              "type": "string",
              "maxLength": 240
            },
            "rdt_cid": {
              "type": "string",
              "maxLength": 240
            }
          }
        }
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consent",
        "eventId",
        "formVariant",
        "pagePath",
        "pageTitle",
        "submittedAt"
      ],
      "properties": {
        "consent": {
          "anyOf": [
            {
              "$ref": "#/definitions/consent"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "formVariant": {
          "type": "string",
          "enum": [
            "member",
            "host"
          ]
        },
        "pagePath": {
          "type": "string",
          "maxLength": 512
        },
        "pageTitle": {
          "type": "string",
          "maxLength": 240
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 80
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choice",
        "analytics",
        "marketing",
        "updatedAt"
      ],
      "properties": {
        "choice": {
          "type": "string",
          "enum": [
            "accepted",
            "analytics",
            "essential"
          ]
        },
        "analytics": {
          "type": "boolean"
        },
        "marketing": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 80
        }
      }
    },
    "whatsappLaunchNotice": {
      "type": "object",
      "additionalProperties": false,
      "description": "A member's request for one WhatsApp message on the day Catch opens in their city. The launch notice is the explicit purpose of the form; marketing permission is a separate choice that is off unless the person chose it (CAT-72). consentVersion names the wording they saw.",
      "required": [
        "phone",
        "launchNotice",
        "marketing",
        "consentVersion"
      ],
      "properties": {
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{7,14}$",
          "description": "E.164 mobile number."
        },
        "launchNotice": {
          "const": true
        },
        "marketing": {
          "type": "boolean"
        },
        "consentVersion": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$"
        }
      }
    }
  },
  "if": {
    "required": [
      "whatsapp"
    ]
  },
  "then": {
    "description": "The WhatsApp launch notice is for members only and carries no programme application.",
    "properties": {
      "role": {
        "const": "member"
      }
    },
    "not": {
      "anyOf": [
        {
          "required": [
            "programme"
          ]
        },
        {
          "required": [
            "programmeApplication"
          ]
        }
      ]
    }
  },
  "else": {
    "description": "The email waitlist, Host and programme applications need a name and a way to reply: an email, a phone, or both.",
    "required": [
      "fullName"
    ],
    "anyOf": [
      {
        "required": [
          "email"
        ]
      },
      {
        "required": [
          "phone"
        ]
      }
    ],
    "if": {
      "required": [
        "programme"
      ]
    },
    "then": {
      "description": "A programme application is a Host application with its programme answers.",
      "required": [
        "programmeApplication"
      ],
      "properties": {
        "role": {
          "const": "host"
        }
      }
    },
    "else": {
      "not": {
        "required": [
          "programmeApplication"
        ]
      }
    }
  }
}
