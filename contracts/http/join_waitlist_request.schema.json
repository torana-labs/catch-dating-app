{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/http/join_waitlist_request.schema.json",
  "title": "Join Waitlist HTTP Request",
  "description": "Version 1 request body for member waitlist, optional Host operating-application and programme (weddings pilot) submissions, and typed website leads. A member may instead ask for one WhatsApp message when Catch opens in their city: that path carries `whatsapp` and needs no name or email. A website lead (the short forms on the redesigned pages) carries `requestKind` and `lead`: a WhatsApp number, the consent it was given under, the page and form it came from, and a small payload for its kind; staff reply on WhatsApp and nothing is sent automatically. Outside those paths a name and at least one of email or phone are required.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fullName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 320
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{7,14}$",
      "description": "Optional E.164 mobile number. A phone-only applicant (no email) is reviewed and answered on WhatsApp."
    },
    "city": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "description": "The city as shown to the person. Kept for older clients and for reading old submissions; cityId is the city of record when present."
    },
    "cityId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z]{2}-[a-z0-9]{1,3}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "The market catalog id (contracts/catalogs/markets.json), such as in-mh-pune, or null for a city the catalog does not have (then cityOther names it). Functions reject an id the catalog does not know."
    },
    "countryIsoCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 country. Functions take it from the catalog when cityId is set and reject a different one."
    },
    "citySource": {
      "type": "string",
      "enum": [
        "picked",
        "network_guess",
        "precise",
        "typed"
      ],
      "description": "How the website reached the city: picked from the list, guessed from network location, from the browser's location after the person tapped Use my location, or typed."
    },
    "cityOther": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "description": "The city the person typed when cityId is null."
    },
    "role": {
      "type": "string",
      "enum": [
        "member",
        "runner",
        "host",
        "both"
      ]
    },
    "instagram": {
      "type": "string",
      "maxLength": 240
    },
    "website": {
      "type": "string",
      "maxLength": 512
    },
    "hostApplication": {
      "$ref": "#/definitions/hostApplication"
    },
    "programme": {
      "type": "string",
      "enum": [
        "weddings"
      ],
      "description": "The programme product this application is for. Absent for the events Host application."
    },
    "programmeApplication": {
      "$ref": "#/definitions/programmeApplication"
    },
    "attribution": {
      "anyOf": [
        {
          "$ref": "#/definitions/attribution"
        },
        {
          "type": "null"
        }
      ]
    },
    "analytics": {
      "$ref": "#/definitions/analytics"
    },
    "whatsapp": {
      "$ref": "#/definitions/whatsappLaunchNotice"
    },
    "requestKind": {
      "type": "string",
      "enum": [
        "guide",
        "walkthrough",
        "demo",
        "venue",
        "story",
        "referral",
        "org_contact",
        "city_alerts",
        "app_link"
      ],
      "description": "Marks a website lead and names its form: guide (send me the setup guide), walkthrough (book a walkthrough), demo (get a demo link), venue (list your space), story (put me forward for a story), referral (refer a host), org_contact (a college, team or brand), city_alerts (new plans in my city), app_link (text me the app link). Absent on waitlist, Host and programme submissions."
    },
    "lead": {
      "$ref": "#/definitions/lead"
    }
  },
  "definitions": {
    "hostApplication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizationName": {
          "type": "string",
          "maxLength": 140
        },
        "organizationType": {
          "type": "string",
          "maxLength": 80
        },
        "operatingCity": {
          "type": "string",
          "maxLength": 80
        },
        "communityLink": {
          "type": "string",
          "maxLength": 512
        },
        "formats": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "eventCadence": {
          "type": "string",
          "maxLength": 80
        },
        "nextEventName": {
          "type": "string",
          "maxLength": 160
        },
        "nextEventDate": {
          "type": "string",
          "maxLength": 80
        },
        "eventLocation": {
          "type": "string",
          "maxLength": 180
        },
        "expectedCapacity": {
          "type": "string",
          "maxLength": 40
        },
        "bookingPlatform": {
          "type": "string",
          "maxLength": 120
        },
        "guestListFormat": {
          "type": "string",
          "maxLength": 120
        },
        "priceRange": {
          "type": "string",
          "maxLength": 80
        },
        "admissionModel": {
          "type": "string",
          "maxLength": 80
        },
        "waitlistPlan": {
          "type": "string",
          "maxLength": 80
        },
        "paymentReadiness": {
          "type": "string",
          "maxLength": 120
        },
        "eventSuccessModules": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "hostGoals": {
          "type": "string",
          "maxLength": 1000
        },
        "operatingNotes": {
          "type": "string",
          "maxLength": 1000
        },
        "eventPricing": {
          "type": "string",
          "enum": [
            "paid",
            "free",
            "mixed",
            "undecided"
          ]
        }
      }
    },
    "programmeApplication": {
      "type": "object",
      "additionalProperties": false,
      "description": "The weddings pilot application from /weddings/apply/. Every field is optional; the page sends what the planner answered.",
      "properties": {
        "applicantRole": {
          "type": "string",
          "maxLength": 80,
          "description": "Who is applying: a wedding planner, or the couple or family."
        },
        "programmeKind": {
          "type": "string",
          "maxLength": 80,
          "description": "What they are running: a wedding, or another multi-day programme."
        },
        "planningCompany": {
          "type": "string",
          "maxLength": 140
        },
        "city": {
          "type": "string",
          "maxLength": 80
        },
        "weddingDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "First day of the next wedding, yyyy-mm-dd."
        },
        "headcount": {
          "type": "string",
          "maxLength": 40
        },
        "tools": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "functions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "hotels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "teamSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "flyingInShare": {
          "type": "string",
          "maxLength": 40
        },
        "wants": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "freeText": {
          "type": "string",
          "maxLength": 1000
        },
        "source": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstTouch",
        "lastTouch"
      ],
      "properties": {
        "firstTouch": {
          "$ref": "#/definitions/attributionTouch"
        },
        "lastTouch": {
          "$ref": "#/definitions/attributionTouch"
        }
      }
    },
    "attributionTouch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturedAt",
        "landingPath",
        "landingUrl",
        "referrer",
        "values"
      ],
      "properties": {
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 80
        },
        "landingPath": {
          "type": "string",
          "maxLength": 512
        },
        "landingUrl": {
          "type": "string",
          "maxLength": 1024
        },
        "referrer": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "utm_source": {
              "type": "string",
              "maxLength": 240
            },
            "utm_medium": {
              "type": "string",
              "maxLength": 240
            },
            "utm_campaign": {
              "type": "string",
              "maxLength": 240
            },
            "utm_content": {
              "type": "string",
              "maxLength": 240
            },
            "utm_term": {
              "type": "string",
              "maxLength": 240
            },
            "gclid": {
              "type": "string",
              "maxLength": 240
            },
            "gbraid": {
              "type": "string",
              "maxLength": 240
            },
            "wbraid": {
              "type": "string",
              "maxLength": 240
            },
            "fbclid": {
              "type": "string",
              "maxLength": 240
            },
            "ttclid": {
              "type": "string",
              "maxLength": 240
            },
            "msclkid": {
              "type": "string",
              "maxLength": 240
            },
            "li_fat_id": {
              "type": "string",
              "maxLength": 240
            },
            "rdt_cid": {
              "type": "string",
              "maxLength": 240
            }
          }
        }
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consent",
        "eventId",
        "formVariant",
        "pagePath",
        "pageTitle",
        "submittedAt"
      ],
      "properties": {
        "consent": {
          "anyOf": [
            {
              "$ref": "#/definitions/consent"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "formVariant": {
          "type": "string",
          "enum": [
            "member",
            "host"
          ]
        },
        "pagePath": {
          "type": "string",
          "maxLength": 512
        },
        "pageTitle": {
          "type": "string",
          "maxLength": 240
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 80
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choice",
        "analytics",
        "marketing",
        "updatedAt"
      ],
      "properties": {
        "choice": {
          "type": "string",
          "enum": [
            "accepted",
            "analytics",
            "essential"
          ]
        },
        "analytics": {
          "type": "boolean"
        },
        "marketing": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 80
        }
      }
    },
    "whatsappLaunchNotice": {
      "type": "object",
      "additionalProperties": false,
      "description": "A member's request for one WhatsApp message: on the day Catch opens in their city (notice cityLaunch, the default), or on the day the Catch app is on the stores (notice appLaunch). The notice is the explicit purpose of the form; marketing permission is a separate choice that is off unless the person chose it (CAT-72). An app-launch request may also opt in to new plans in their city on WhatsApp (newPlans), a separate choice that is off unless ticked. consentVersion names the wording they saw.",
      "required": [
        "phone",
        "launchNotice",
        "marketing",
        "consentVersion"
      ],
      "properties": {
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{7,14}$",
          "description": "E.164 mobile number."
        },
        "launchNotice": {
          "const": true
        },
        "notice": {
          "type": "string",
          "enum": [
            "cityLaunch",
            "appLaunch"
          ],
          "description": "What the one message announces: Catch opening in the person's city (cityLaunch, the default when absent) or the Catch app arriving on the stores (appLaunch)."
        },
        "marketing": {
          "type": "boolean"
        },
        "consentVersion": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$"
        },
        "newPlans": {
          "type": "boolean",
          "description": "App-launch requests only: also send new plans in the person's city on WhatsApp. Off unless the person ticked it."
        }
      },
      "if": {
        "properties": {
          "newPlans": {
            "const": true
          }
        },
        "required": [
          "newPlans"
        ]
      },
      "then": {
        "required": [
          "notice"
        ],
        "properties": {
          "notice": {
            "const": "appLaunch"
          }
        }
      }
    },
    "lead": {
      "type": "object",
      "additionalProperties": false,
      "description": "The fields every website lead carries, plus exactly one payload named for its requestKind (orgContact for org_contact, cityAlerts for city_alerts, appLink for app_link).",
      "required": [
        "requestId",
        "phone",
        "consent",
        "sourcePage",
        "entry"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,80}$",
          "description": "Client request id, made once per form submission (a UUID is fine) and reused on retries. The same id and number return the same lead; the same id with changed answers is refused."
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{7,14}$",
          "description": "The person's WhatsApp number, E.164. Staff reply here."
        },
        "consent": {
          "$ref": "#/definitions/leadConsent"
        },
        "newPlansConsent": {
          "$ref": "#/definitions/leadNewPlansConsent"
        },
        "sourcePage": {
          "type": "string",
          "pattern": "^/[^\\s?#]*$",
          "maxLength": 512,
          "description": "The page path the form is on, without query or fragment, such as /run-clubs/."
        },
        "entry": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$",
          "description": "Which form on the page, such as the design's form id (rc-wa) or band name (final)."
        },
        "guide": {
          "$ref": "#/definitions/leadGuide"
        },
        "walkthrough": {
          "$ref": "#/definitions/leadWalkthrough"
        },
        "demo": {
          "$ref": "#/definitions/leadDemo"
        },
        "venue": {
          "$ref": "#/definitions/leadVenue"
        },
        "story": {
          "$ref": "#/definitions/leadStory"
        },
        "referral": {
          "$ref": "#/definitions/leadReferral"
        },
        "orgContact": {
          "$ref": "#/definitions/leadOrgContact"
        },
        "cityAlerts": {
          "$ref": "#/definitions/leadCityAlerts"
        },
        "appLink": {
          "$ref": "#/definitions/leadAppLink"
        }
      }
    },
    "leadConsent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "version"
      ],
      "description": "What the person agreed to when they sent the form. leadFollowUp: Catch staff may message them on WhatsApp about this request. cityNewPlans: new plans in their city on WhatsApp, a standalone purpose used only by city_alerts. version names the wording they saw.",
      "properties": {
        "purpose": {
          "type": "string",
          "enum": [
            "leadFollowUp",
            "cityNewPlans"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$"
        }
      }
    },
    "leadNewPlansConsent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "version"
      ],
      "description": "An optional second consent a lead form may ask for with an unticked box: new plans in the lead's city on WhatsApp, recorded apart from the form's own consent. Sent only when the box is ticked; city_alerts never sends it, since its own consent is already cityNewPlans. version names the box's wording.",
      "properties": {
        "purpose": {
          "type": "string",
          "enum": [
            "cityNewPlans"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$"
        }
      }
    },
    "leadGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,39}$",
          "description": "Which setup guide, as a slug: run_club, supper_club, quiz_night, social_night, racket_social, outdoor_group, studio, workshop, facility, venue, community, creator, society or team_social."
        }
      }
    },
    "leadWalkthrough": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferredTime"
      ],
      "properties": {
        "preferredTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "The time the person asked for, as shown to them (Tue 18 · 16:00 IST). A request, not a booking: staff confirm on WhatsApp."
        },
        "organisation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "whatYouRun": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "leadDemo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "whatYouHost"
      ],
      "properties": {
        "whatYouHost": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "currentQuestions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "What they ask guests now: pasted questions or a link to their form."
        }
      }
    },
    "leadVenue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceName",
        "capacity",
        "nights"
      ],
      "properties": {
        "spaceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Area and city, as typed (Lower Parel, Mumbai)."
        },
        "capacity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "How many people fit, as typed (60 standing, 30 seated)."
        },
        "nights": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Nights they'd like to fill, as typed (Tuesdays and Wednesdays)."
        }
      }
    },
    "leadStory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "communityName",
        "cadence"
      ],
      "properties": {
        "communityName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "cadence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "What they host, and how often (A monthly supper club for 24)."
        }
      }
    },
    "leadReferral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostName",
        "hostLink",
        "relationship"
      ],
      "properties": {
        "hostName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "The host or club being referred."
        },
        "hostLink": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Their Instagram handle or website, as typed (@lanternlanesocial, lanternlane.in or a full URL)."
        },
        "relationship": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "How the referrer knows them."
        }
      }
    },
    "leadOrgContact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orgType",
        "orgName"
      ],
      "properties": {
        "orgType": {
          "type": "string",
          "enum": [
            "college",
            "team",
            "brand"
          ]
        },
        "orgName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "The society, college, company or brand."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "leadCityAlerts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interests"
      ],
      "properties": {
        "interests": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "description": "The format chips they picked; may be empty when the form has none.",
          "items": {
            "type": "string",
            "enum": [
              "runs",
              "courts",
              "dinners",
              "quizzes",
              "nights_out",
              "fitness",
              "workshops",
              "books"
            ]
          }
        }
      }
    },
    "leadAppLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app"
      ],
      "description": "A request for an app's download link (Text me the link): staff send it on WhatsApp.",
      "properties": {
        "app": {
          "type": "string",
          "enum": [
            "host"
          ],
          "description": "Which app's link: host (the host app)."
        }
      }
    }
  },
  "anyOf": [
    {
      "description": "Waitlist, Host, programme and launch-notice submissions name a city and a role, and carry no lead block.",
      "type": "object",
      "required": [
        "city",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "fullName": {},
        "email": {},
        "phone": {},
        "city": {},
        "cityId": {},
        "countryIsoCode": {},
        "citySource": {},
        "cityOther": {},
        "role": {},
        "instagram": {},
        "website": {},
        "hostApplication": {},
        "programme": {},
        "programmeApplication": {},
        "attribution": {},
        "analytics": {},
        "whatsapp": {}
      }
    },
    {
      "description": "A website lead names its kind and carries its lead block instead, with no role, email, Host or programme application or launch notice.",
      "type": "object",
      "required": [
        "requestKind",
        "lead"
      ],
      "additionalProperties": false,
      "properties": {
        "fullName": {},
        "city": {},
