{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/http/join_waitlist_response.schema.json",
  "title": "Join Waitlist HTTP Response",
  "description": "Version 1 JSON response returned by the member waitlist, Host operating-application and website lead endpoint.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "alreadyJoined"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "alreadyJoined": {
          "type": "boolean"
        },
        "hostLead": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eventId",
            "isNew"
          ],
          "properties": {
            "eventId": {
              "type": "string",
              "pattern": "^host_lead_[0-9]{13}_[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "isNew": {
              "type": "boolean"
            }
          }
        },
        "lead": {
          "type": "object",
          "additionalProperties": false,
          "description": "The receipt for a website lead (requestKind requests only). leadId is stable for the request id and number, so a retry returns the same one; isNew is false on a retry. Staff reply on WhatsApp; an app_link lead may get the Host app link, and a guide, demo or venue lead the host lead welcome, automatically.",
          "required": [
            "leadId",
            "requestKind",
            "isNew"
          ],
          "properties": {
            "leadId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "requestKind": {
              "type": "string",
              "enum": [
                "guide",
                "walkthrough",
                "demo",
                "venue",
                "story",
                "referral",
                "org_contact",
                "city_alerts",
                "app_link"
              ]
            },
            "isNew": {
              "type": "boolean"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    }
  ]
}
