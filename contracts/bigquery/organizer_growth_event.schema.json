{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/bigquery/organizer_growth_event.schema.json",
  "title": "OrganizerGrowthEvent",
  "description": "One dated fact about an organizer, streamed to catch_analytics.organizer_growth_events so cohorts, channels and ticket sales can be counted. Steps (listed, claim_requested, claimed, first_event, first_paid_booking) mirror organizerGrowthFacts and appear once per organizer; paid_booking and refund appear once per payment. The insert id is the growth event id, and readers count distinct ids, so a retried insert never counts twice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "growth_event_id",
    "organizer_id",
    "event_name",
    "occurred_at",
    "event_date",
    "channel",
    "market_id",
    "ingested_at"
  ],
  "properties": {
    "growth_event_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "organizer_id": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "event_name": {
      "type": "string",
      "enum": ["listed", "claim_requested", "claimed", "first_event", "first_paid_booking", "paid_booking", "refund"]
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "event_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "channel": {"$ref": "../firestore/organizer_growth_facts.schema.json#/definitions/channel"},
    "market_id": {"type": ["string", "null"], "maxLength": 50},
    "nominator_role": {"type": ["string", "null"], "enum": ["associate", "partner", "guest", "organizer", null]},
    "booking_event_id": {"type": ["string", "null"], "maxLength": 180},
    "payment_source": {
      "description": "The payment record collection a paid_booking or refund came from.",
      "type": ["string", "null"],
      "enum": ["payments", "publicEventPayments", "organizerEventOfferPayments", null]
    },
    "payment_id": {"type": ["string", "null"], "maxLength": 180},
    "currency": {"type": ["string", "null"], "maxLength": 3},
    "amount_minor": {"type": ["integer", "null"], "minimum": 0},
    "provider_fee_minor": {"type": ["integer", "null"], "minimum": 0},
    "provider_tax_minor": {"type": ["integer", "null"], "minimum": 0},
    "ingested_at": {"type": "string", "format": "date-time"}
  }
}
