    "Record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "settingId",
        "context",
        "groupId",
        "workflowKind",
        "revision",
        "preference",
        "sourceHash",
        "updatedBy",
        "createdAt",
        "updatedAt"
