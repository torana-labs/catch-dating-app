      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "settingId": {
          "type": "string",
          "pattern": "^setting:[a-f0-9]{64}$"
        },
        "context": {
          "$ref": "event_assistance_guest.schema.json#/definitions/liveContext"
        },
        "groupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "workflowKind": {
