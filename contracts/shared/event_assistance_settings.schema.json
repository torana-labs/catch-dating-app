            "disabled",
            "sourceChanged",
            "configured"
          ]
        },
        "origin": {
          "enum": [
            "none",
            "event",
            "group"
          ]
        },
        "effective": {
          "anyOf": [
            {
              "$ref": "#/definitions/Template"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested": {
          "anyOf": [
            {
              "$ref": "#/definitions/Template"
            },
            {
              "type": "null"
            }
          ]
        },
        "setup": {
          "$ref": "#/definitions/Setup",
          "description": "Current event timing and joining destinations from this review source. Omitted by older API versions; absence is not an empty setup."
        }
      }
