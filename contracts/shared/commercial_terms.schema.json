{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/shared/commercial_terms.schema.json",
  "title": "Commercial terms",
  "description": "What Catch charges an organizer, independent of who collects the money. Money flow (who is merchant of record) is the payment routing policy's route for each purpose; terms hold the economics. Platform defaults are complete; an organizer override is sparse, and an absent key inherits. Effective terms are frozen onto each payment or charge as a snapshot, so later edits never rewrite history.",
  "definitions": {
    "basisPoints": {"type": "integer", "minimum": 0, "maximum": 10000},
    "atSourceBasisPoints": {"type": "integer", "minimum": 0, "maximum": 9999},
    "minorAmount": {"type": "integer", "minimum": 0, "maximum": 100000000000},
    "purpose": {"enum": ["eventAdmission", "formFee", "hostMembership"]},
    "moneyFlow": {
      "description": "hostCollected: the guest pays the organizer's own merchant account and the organizer is merchant of record; Catch bills its commission afterwards. platformSplit: Catch's platform account collects and transfers the organizer's share (Razorpay Route), deducting any at-source fee.",
      "enum": ["hostCollected", "platformSplit"]
    },
    "commission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rateBasisPoints", "capMinor", "cycleDays", "cycleAnchor", "base", "taxTreatment"],
      "properties": {
        "rateBasisPoints": {"$ref": "#/definitions/basisPoints"},
        "capMinor": {"description": "Cap per cycle in minor units; null means uncapped.", "anyOf": [{"$ref": "#/definitions/minorAmount"}, {"type": "null"}]},
        "cycleDays": {"type": "integer", "minimum": 1, "maximum": 366},
        "cycleAnchor": {"enum": ["trialEnd"]},
        "base": {"enum": ["netOfRefunds", "gross"]},
        "taxTreatment": {"description": "exclusive: amounts are before GST, which is added on top.", "enum": ["exclusive", "inclusive"]}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "anchor"],
      "properties": {
        "days": {"type": "integer", "minimum": 0, "maximum": 366},
        "anchor": {"enum": ["firstEvent"]}
      }
    },
    "toolsOnly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feeMinor"],
      "properties": {
        "feeMinor": {"description": "Flat tools-only fee per commission cycle, in minor units, on the same tax treatment as the commission.", "$ref": "#/definitions/minorAmount"}
      }
    },
    "purposeTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countsTowardCommission", "atSourceFeeBasisPoints"],
      "properties": {
        "countsTowardCommission": {"type": "boolean"},
        "atSourceFeeBasisPoints": {"description": "Fee deducted from each payment before the organizer's transfer. Applies only when the purpose's money flow is platformSplit.", "$ref": "#/definitions/atSourceBasisPoints"}
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "commission", "trial", "toolsOnly", "gatewayFeeBearer", "purposes"],
      "properties": {
        "currency": {"const": "INR"},
        "commission": {"$ref": "#/definitions/commission"},
        "trial": {"$ref": "#/definitions/trial"},
        "toolsOnly": {"$ref": "#/definitions/toolsOnly"},
        "gatewayFeeBearer": {"enum": ["host", "platform"]},
        "purposes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eventAdmission", "formFee", "hostMembership"],
          "properties": {
            "eventAdmission": {"$ref": "#/definitions/purposeTerms"},
            "formFee": {"$ref": "#/definitions/purposeTerms"},
            "hostMembership": {"$ref": "#/definitions/purposeTerms"}
          }
        }
      }
    },
    "purposeTermsOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "countsTowardCommission": {"type": "boolean"},
        "atSourceFeeBasisPoints": {"$ref": "#/definitions/atSourceBasisPoints"}
      }
    },
    "termsOverride": {
      "description": "Sparse organizer override. Every key is optional and an absent key inherits the platform default; commission.capMinor may be set to null to remove the cap.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commission": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rateBasisPoints": {"$ref": "#/definitions/basisPoints"},
            "capMinor": {"anyOf": [{"$ref": "#/definitions/minorAmount"}, {"type": "null"}]},
            "cycleDays": {"type": "integer", "minimum": 1, "maximum": 366},
            "cycleAnchor": {"enum": ["trialEnd"]},
            "base": {"enum": ["netOfRefunds", "gross"]},
            "taxTreatment": {"enum": ["exclusive", "inclusive"]}
          }
        },
        "trial": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "days": {"type": "integer", "minimum": 0, "maximum": 366},
            "anchor": {"enum": ["firstEvent"]}
          }
        },
        "toolsOnly": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "feeMinor": {"$ref": "#/definitions/minorAmount"}
          }
        },
        "gatewayFeeBearer": {"enum": ["host", "platform"]},
        "purposes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eventAdmission": {"$ref": "#/definitions/purposeTermsOverride"},
            "formFee": {"$ref": "#/definitions/purposeTermsOverride"},
            "hostMembership": {"$ref": "#/definitions/purposeTermsOverride"}
          }
        }
      }
    },
    "snapshot": {
      "description": "Effective terms for one purpose and organizer at the moment a payment or charge was created.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "purpose", "organizerId", "platformRevision", "organizerRevision", "moneyFlow", "merchantOfRecord", "currency", "commission", "trial", "toolsOnly", "gatewayFeeBearer", "purposeTerms", "resolvedAtMillis"],
      "properties": {
        "version": {"const": 1},
        "purpose": {"$ref": "#/definitions/purpose"},
        "organizerId": {"$ref": "event_common.schema.json#/definitions/documentId"},
        "platformRevision": {"type": "integer", "minimum": 1},
        "organizerRevision": {"type": "integer", "minimum": 0},
        "moneyFlow": {"$ref": "#/definitions/moneyFlow"},
        "merchantOfRecord": {"enum": ["host", "platform"]},
        "currency": {"const": "INR"},
        "commission": {"$ref": "#/definitions/commission"},
        "trial": {"$ref": "#/definitions/trial"},
        "toolsOnly": {"$ref": "#/definitions/toolsOnly"},
        "gatewayFeeBearer": {"enum": ["host", "platform"]},
        "purposeTerms": {"$ref": "#/definitions/purposeTerms"},
        "resolvedAtMillis": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    }
  }
}
