{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/shared/market_catalog.schema.json",
  "title": "Market Catalog",
  "description": "Shape of contracts/catalogs/markets.json, the one source of truth for the countries and cities Catch serves. tool/contracts/generate_market_catalog.mjs validates the catalog against this schema, checks the cross-record rules a schema cannot express, and generates every consumer copy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "description",
    "configCitiesVersion",
    "defaultCountryIsoCode",
    "countries",
    "cities"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "marketCatalog"},
    "description": {"type": "string", "minLength": 1},
    "configCitiesVersion": {
      "description": "The version written to Firestore config/cities. Raise it when the config/cities shape changes.",
      "type": "integer",
      "minimum": 1
    },
    "defaultCountryIsoCode": {"$ref": "#/definitions/isoCountryCode"},
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/country"}
    },
    "cities": {
      "description": "Cities in display order.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/city"}
    }
  },
  "definitions": {
    "isoCountryCode": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "marketKey": {
      "description": "Lowercase country-region-city key, such as in-mh-mumbai.",
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z0-9]{1,3}-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "timeZone": {"type": "string", "pattern": "^[A-Za-z]+(/[A-Za-z_]+)+$"},
    "country": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isoCode",
        "name",
        "currencyCode",
        "currencySymbol",
        "dialCode",
        "locale",
        "timeZone",
        "appStoreCountryCodes",
        "defaultMarketId"
      ],
      "properties": {
        "isoCode": {"$ref": "#/definitions/isoCountryCode"},
        "name": {"type": "string", "minLength": 1},
        "currencyCode": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "currencySymbol": {"type": "string", "minLength": 1},
        "dialCode": {"type": "string", "pattern": "^\\+[1-9][0-9]{0,3}$"},
        "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"},
        "timeZone": {"$ref": "#/definitions/timeZone"},
        "appStoreCountryCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/isoCountryCode"}
        },
        "defaultMarketId": {"$ref": "#/definitions/marketKey"}
      }
    },
    "lifecycle": {
      "description": "hidden: not public. waitlist: public, collecting interest. launching: public, launch planned (optional launchDate). live: open. paused: was live, temporarily closed.",
      "enum": ["hidden", "waitlist", "launching", "live", "paused"]
    },
    "surfaces": {
      "description": "Per-surface switches. App surfaces may be on only for live cities; websiteListed may not be on for hidden cities.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileSelectable",
        "hostCreatable",
        "eventCreatable",
        "exploreVisible",
        "websiteListed"
      ],
      "properties": {
        "profileSelectable": {"type": "boolean"},
        "hostCreatable": {"type": "boolean"},
        "eventCreatable": {"type": "boolean"},
        "exploreVisible": {"type": "boolean"},
        "websiteListed": {"type": "boolean"}
      }
    },
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marketId",
        "cityId",
        "slug",
        "label",
        "cityLabel",
        "regionCode",
        "regionName",
        "countryIsoCode",
        "timeZone",
        "latitude",
        "longitude",
        "aliases",
        "lifecycle",
        "surfaces"
      ],
      "properties": {
        "marketId": {"$ref": "#/definitions/marketKey"},
        "cityId": {"$ref": "#/definitions/marketKey"},
        "slug": {
          "description": "The public URL slug, such as mumbai for /mumbai/.",
          "$ref": "#/definitions/slug"
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 40},
        "cityLabel": {"type": "string", "minLength": 1, "maxLength": 40},
        "regionCode": {"type": "string", "pattern": "^[A-Z0-9]{1,3}$"},
        "regionName": {"type": "string", "minLength": 1},
        "countryIsoCode": {"$ref": "#/definitions/isoCountryCode"},
        "timeZone": {"$ref": "#/definitions/timeZone"},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "aliases": {
          "description": "Slugified names that resolve to this city, such as bombay. Must be unique across the catalog.",
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/slug"}
        },
        "lifecycle": {"$ref": "#/definitions/lifecycle"},
        "launchDate": {
          "description": "Planned launch day for a launching city, as YYYY-MM-DD.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "surfaces": {"$ref": "#/definitions/surfaces"},
        "legacyIds": {
          "description": "Retired ids that still resolve to this city, such as the website's old in-mumbai.",
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/slug"}
        }
      }
    }
  }
}
