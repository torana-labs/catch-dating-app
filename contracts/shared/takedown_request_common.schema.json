{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/shared/takedown_request_common.schema.json",
  "title": "TakedownRequestCommon",
  "description": "Shapes shared by structured listing requests (claim, correct, remove and don't list, trademark, copyright, privacy, impersonation, court or government order): fixed request types, fixed verification fields per type, fixed declarations, fixed outcomes and decline reasons, and the deadlines that drive the Admin Inbox. There is no free-text demand: at most a short capped context line.",
  "definitions": {
    "requestType": {
      "type": "string",
      "enum": [
        "claim",
        "correctFact",
        "removeAndDoNotList",
        "trademark",
        "copyright",
        "privacy",
        "impersonation",
        "legalOrder"
      ],
      "description": "One request type per submission. Each has fixed fields, a fixed remedy and a fixed timeline (docs/data_contracts.md, Listing Requests)."
    },
    "clientRequestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$",
      "description": "Made once per submission by the website and reused on retries, so a retry is the same request."
    },
    "requestId": {
      "type": "string",
      "pattern": "^lr-[a-f0-9]{40}$",
      "description": "Deterministic per requester email and client request id."
    },
    "reference": {
      "type": "string",
      "pattern": "^LR-[A-Z2-9]{8}$",
      "description": "The short reference the requester quotes in correspondence."
    },
    "caseId": {
      "type": "string",
      "pattern": "^TD-[0-9]{4,6}$",
      "description": "The opaque takedown case id the organiser takedown tool runs under. Never a name or slug."
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "A UTC instant as Date.toISOString() writes it."
    },
    "nullableInstant": {
      "oneOf": [
        {
          "$ref": "#/definitions/instant"
        },
        {
          "type": "null"
        }
      ]
    },
    "localDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "url": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^https?://[^\\s]+$"
    },
    "targetRequest": {
      "description": "The listing the request is about: an organiser page, an event page, or a public URL on Catch's own website.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "organizerId"
          ],
          "properties": {
            "kind": {
              "const": "organizer"
            },
            "organizerId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "eventId"
          ],
          "properties": {
            "kind": {
              "const": "event"
            },
            "eventId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,160}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "url"
            },
            "url": {
              "type": "string",
              "minLength": 8,
              "maxLength": 512,
              "pattern": "^https?://[^\\s]+$",
              "description": "A page on Catch's website; other hosts are refused."
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "path"
      ],
      "description": "The stored target: the organiser or event id when one was named, and the page path on Catch's website when a URL was given.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "organizer",
            "event",
            "url"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^/"
        }
      }
    },
    "requesterRole": {
      "type": "string",
      "enum": [
        "owner",
        "staff",
        "authorisedAgent",
        "rightsHolder",
        "affectedIndividual",
        "nominee",
        "authority",
        "memberOfPublic"
      ]
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "email"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "role": {
          "$ref": "#/definitions/requesterRole"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 320,
          "description": "Where Catch replies. A domain-email proof needs it at the official domain."
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{7,14}$"
        },
        "organisation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "storedRequester": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "email",
        "phone",
        "organisation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "role": {
          "$ref": "#/definitions/requesterRole"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 320
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\+[1-9][0-9]{7,14}$"
        },
        "organisation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "claimVerification": {
      "type": "object",
      "additionalProperties": false,
      "description": "Claim this page: proof of control of an official channel, as the claim flow takes it.",
      "required": [
        "proofMethod"
      ],
      "properties": {
        "proofMethod": {
          "type": "string",
          "enum": [
            "instagramCode",
            "domainEmail"
          ],
          "description": "instagramCode: staff send a one-time code to post or DM from the official handle (the claim flow's proof). domainEmail: a reply from the requester's email at the official domain. letterhead: a signed letter on the organisation's letterhead, for businesses without either."
        },
        "officialHandle": {
          "type": "string",
          "pattern": "^@?[A-Za-z0-9._]{1,30}$",
          "description": "The official Instagram handle, with or without @."
        },
        "officialDomain": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
          "description": "The official website's domain, lowercase, without scheme or path."
        }
      }
    },
    "removeVerification": {
      "type": "object",
      "additionalProperties": false,
      "description": "Remove and don't list again: proof that the requester speaks for the organisation.",
      "required": [
        "proofMethod"
      ],
      "properties": {
        "proofMethod": {
          "type": "string",
          "enum": [
            "instagramCode",
            "domainEmail",
            "letterhead"
          ],
          "description": "instagramCode: staff send a one-time code to post or DM from the official handle (the claim flow's proof). domainEmail: a reply from the requester's email at the official domain. letterhead: a signed letter on the organisation's letterhead, for businesses without either."
        },
        "officialHandle": {
          "type": "string",
          "pattern": "^@?[A-Za-z0-9._]{1,30}$",
          "description": "The official Instagram handle, with or without @."
        },
        "officialDomain": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
          "description": "The official website's domain, lowercase, without scheme or path."
        }
      }
    },
    "impersonationVerification": {
      "type": "object",
      "additionalProperties": false,
      "description": "Impersonation: proof that the requester is the real organiser.",
      "required": [
        "proofMethod"
      ],
      "properties": {
        "proofMethod": {
          "type": "string",
          "enum": [
            "instagramCode",
            "domainEmail"
          ],
          "description": "instagramCode: staff send a one-time code to post or DM from the official handle (the claim flow's proof). domainEmail: a reply from the requester's email at the official domain. letterhead: a signed letter on the organisation's letterhead, for businesses without either."
        },
        "officialHandle": {
          "type": "string",
          "pattern": "^@?[A-Za-z0-9._]{1,30}$",
          "description": "The official Instagram handle, with or without @."
        },
        "officialDomain": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
          "description": "The official website's domain, lowercase, without scheme or path."
        }
      }
    },
    "correctFactVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "correction",
        "evidenceUrl"
      ],
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "name",
            "city",
            "activity",
            "schedule",
            "venue",
            "links",
            "other"
          ]
        },
        "correction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "What the fact should say."
        },
        "evidenceUrl": {
          "type": "string",
          "minLength": 8,
          "maxLength": 512,
          "pattern": "^https?://[^\\s]+$",
          "description": "A public page that shows the correct fact."
        }
      }
    },
    "trademarkVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "preferredRemedy"
      ],
      "description": "A registered mark needs its number, class and jurisdiction; an unregistered one needs the year of first use and evidence of use.",
      "properties": {
        "basis": {
          "type": "string",
          "enum": [
            "registered",
            "unregistered"
          ]
        },
        "registrationNumber": {
          "type": "string",
          "pattern": "^[A-Za-z0-9/-]{3,20}$"
        },
        "registrationClass": {
          "type": "integer",
          "minimum": 1,
          "maximum": 45
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO country code of the register."
        },
        "firstUseYear": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "evidenceUrl": {
          "type": "string",
          "minLength": 8,
          "maxLength": 512,
          "pattern": "^https?://[^\\s]+$"
        },
        "preferredRemedy": {
          "type": "string",
          "enum": [
            "removeMark",
            "relabel",
            "unpublish"
          ]
        }
      }
    },
    "copyrightVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workKind",
        "originalWorkUrl",
        "ownershipBasis"
      ],
      "description": "Modelled on Copyright Rules 2013, Rule 75: the work, where the original is, and the basis of ownership. The page is the target.",
      "properties": {
        "workKind": {
          "type": "string",
          "enum": [
            "photo",
            "text",
            "artwork",
            "other"
          ]
        },
        "originalWorkUrl": {
          "type": "string",
          "minLength": 8,
          "maxLength": 512,
          "pattern": "^https?://[^\\s]+$"
        },
        "ownershipBasis": {
          "type": "string",
          "enum": [
            "creator",
            "employer",
            "exclusiveLicensee",
            "agent"
          ]
        }
      }
    },
    "privacyVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship",
        "dataKinds",
        "identityMatch",
        "preferredRemedy"
      ],
      "description": "No identity documents: the person is matched to what the listing shows, or by a one-time code.",
      "properties": {
        "relationship": {
          "type": "string",
          "enum": [
            "self",
            "nominee"
          ]
        },
        "dataKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "name",
              "photo",
              "handle",
              "phone",
              "email",
              "other"
            ]
          }
        },
        "identityMatch": {
          "type": "string",
          "enum": [
            "emailOnListing",
            "handleOnListing",
            "oneTimeCode"
          ]
        },
        "preferredRemedy": {
          "type": "string",
          "enum": [
            "remove",
            "redact",
            "correct"
          ]
        }
      }
    },
    "legalOrderVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuingBody",
        "orderReference",
        "orderDate"
      ],
      "description": "Staff verify the order with its issuer before acting.",
      "properties": {
        "issuingBody": {
          "type": "string",
          "enum": [
            "court",
            "government",
            "lawEnforcement"
          ]
        },
        "orderReference": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "orderDate": {
          "$ref": "#/definitions/localDate"
        },
        "orderUrl": {
          "type": "string",
          "minLength": 8,
          "maxLength": 512,
          "pattern": "^https?://[^\\s]+$"
        }
      }
    },
    "verification": {
      "description": "One of the per-type verification shapes; the stored requestType says which (the three channel proofs share a shape).",
      "anyOf": [
        {
          "$ref": "#/definitions/claimVerification"
        },
        {
          "$ref": "#/definitions/correctFactVerification"
        },
        {
          "$ref": "#/definitions/removeVerification"
        },
        {
          "$ref": "#/definitions/trademarkVerification"
        },
        {
          "$ref": "#/definitions/copyrightVerification"
        },
        {
          "$ref": "#/definitions/privacyVerification"
        },
        {
          "$ref": "#/definitions/impersonationVerification"
        },
        {
          "$ref": "#/definitions/legalOrderVerification"
        }
      ]
    },
    "declarations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accurate",
        "authorised",
        "contactConsent"
      ],
      "description": "Fixed declarations. Trademark, copyright and impersonation requests also need goodFaith; copyright also needs notLicensed.",
      "properties": {
        "accurate": {
          "const": true,
          "description": "The information is accurate and complete."
        },
        "authorised": {
          "const": true,
          "description": "The requester is the person named or is authorised to act for the organisation or rights holder, and understands false requests may be refused and may create liability."
        },
        "contactConsent": {
          "const": true,
          "description": "Catch may contact the requester about this request."
        },
        "goodFaith": {
          "const": true,
          "description": "A good-faith belief that the use complained of is not authorised by the rights holder, its agent or the law."
        },
        "notLicensed": {
          "const": true,
          "description": "The use is not licensed and, to the requester's knowledge, not permitted by law (Copyright Act s.52)."
        }
      }
    },
    "context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "description": "An optional short line of context. Never a demand box."
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "version"
      ],
      "properties": {
        "purpose": {
          "const": "listingRequest"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "sourcePage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^/"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "acknowledged",
        "verifying",
        "actioned",
        "declined",
        "appealed",
        "closed"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "claimGranted",
        "factCorrected",
        "factFlagged",
        "removedAndSuppressed",
        "removed",
        "relabelled",
        "materialRemoved",
        "personalDataRemoved",
        "personalDataRedacted",
        "pageSuspended",
        "orderComplied"
      ],
      "description": "The fixed remedies an actioned request records."
    },
    "declineReason": {
      "type": "string",
      "enum": [
        "couldNotVerify",
        "noAuthority",
        "insufficientBasis",
        "notOurListing",
        "duplicate",
        "abusive",
        "noResponse"
      ]
    },
    "infoTemplate": {
      "type": "string",
      "enum": [
        "postInstagramCode",
        "replyFromDomainEmail",
        "sendLetterhead",
        "registrationCertificate",
        "evidenceOfUse",
        "identityMatch",
        "orderCopy",
        "clarifyTarget"
      ],
      "description": "The fixed messages staff send when they need more."
    },
    "appealDecision": {
      "type": "string",
      "enum": [
        "upheld",
        "overturned"
      ]
    },
    "historyAction": {
      "type": "string",
      "enum": [
        "received",
        "acknowledged",
        "infoRequested",
        "actioned",
        "declined",
        "appealRecorded",
        "appealDecided",
        "closed",
        "organizerSuspended"
      ]
    },
    "adminHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "action",
        "byUid",
        "status",
        "detail"
      ],
      "properties": {
        "at": {
          "$ref": "#/definitions/instant"
        },
        "action": {
          "$ref": "#/definitions/historyAction"
        },
        "byUid": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "status": {
          "$ref": "#/definitions/status"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    },
    "adminAppeal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recordedAt",
            "recordedByUid",
            "dueAt",
            "decision",
            "decidedAt",
            "decidedByUid"
          ],
          "properties": {
            "recordedAt": {
              "$ref": "#/definitions/instant"
            },
            "recordedByUid": {
              "type": "string",
              "maxLength": 128
            },
            "dueAt": {
              "$ref": "#/definitions/instant"
            },
            "decision": {
              "oneOf": [
                {
                  "$ref": "#/definitions/appealDecision"
                },
                {
                  "type": "null"
                }
              ]
            },
            "decidedAt": {
              "$ref": "#/definitions/nullableInstant"
            },
            "decidedByUid": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            }
          }
        }
      ]
    },
    "adminRequestRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "reference",
        "requestType",
        "status",
        "target",
        "requester",
        "verification",
        "declarations",
        "context",
        "outcome",
        "declineReason",
        "caseId",
        "infoRequests",
        "appeal",
        "deciderUid",
        "ackDueAt",
        "actionDueAt",
        "resolveDueAt",
        "acknowledgedAt",
        "decidedAt",
        "closedAt",
        "createdAt",
        "history"
      ],
      "description": "One request as Admin reads it, with ISO instants.",
      "properties": {
        "requestId": {
          "$ref": "#/definitions/requestId"
        },
        "reference": {
          "$ref": "#/definitions/reference"
        },
        "requestType": {
          "$ref": "#/definitions/requestType"
        },
        "status": {
          "$ref": "#/definitions/status"
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "requester": {
          "$ref": "#/definitions/storedRequester"
        },
        "verification": {
          "$ref": "#/definitions/verification"
        },
        "declarations": {
          "$ref": "#/definitions/declarations"
        },
        "context": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 280
        },
        "outcome": {
          "oneOf": [
            {
              "$ref": "#/definitions/outcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "declineReason": {
          "oneOf": [
            {
              "$ref": "#/definitions/declineReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "caseId": {
          "oneOf": [
            {
              "$ref": "#/definitions/caseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "infoRequests": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "template",
              "at",
              "byUid"
            ],
            "properties": {
              "template": {
                "$ref": "#/definitions/infoTemplate"
              },
              "at": {
                "$ref": "#/definitions/instant"
              },
              "byUid": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "appeal": {
          "$ref": "#/definitions/adminAppeal"
        },
        "deciderUid": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "ackDueAt": {
          "$ref": "#/definitions/instant"
        },
        "actionDueAt": {
          "$ref": "#/definitions/nullableInstant"
        },
        "resolveDueAt": {
          "$ref": "#/definitions/instant"
        },
        "acknowledgedAt": {
          "$ref": "#/definitions/nullableInstant"
        },
        "decidedAt": {
          "$ref": "#/definitions/nullableInstant"
        },
        "closedAt": {
          "$ref": "#/definitions/nullableInstant"
        },
        "createdAt": {
          "$ref": "#/definitions/instant"
        },
        "history": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "$ref": "#/definitions/adminHistoryEntry"
          }
        }
      }
    }
  }
}
