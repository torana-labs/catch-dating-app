    "Response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "serverTime",
        "outcome",
        "operationRevision",
        "view"
      ],
      "properties": {
        "context": {
          "$ref": "event_assistance_guest.schema.json#/definitions/liveContext"
        },
        "serverTime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outcome": {
          "enum": [
            "applied",
            "replayed"
          ]
        },
        "operationRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "view": {
          "$ref": "#/definitions/View"
        }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "context",
        "messageId",
        "intentHash",
        "requestHash",
        "actorUid",
        "operationId",
        "messageRevision",
        "createdAt"
      ],
      "properties": {
        "receiptId": {
          "type": "string",
          "pattern": "^delivery-repair:[a-f0-9]{64}$"
        },
        "context": {
          "$ref": "event_assistance_guest.schema.json#/definitions/liveContext"
        },
        "messageId": {
          "type": "string",
          "pattern": "^outbox:[a-f0-9]{64}$"
