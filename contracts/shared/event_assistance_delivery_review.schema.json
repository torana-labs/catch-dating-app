                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "authority": {
                      "enum": [
                        "current",
                        "revoked"
                      ]
                    }
                  }
                }
              ]
            },
            "availability": {
              "const": "sourceChanged"
            },
            "attendeeId": {
              "type": "null"
