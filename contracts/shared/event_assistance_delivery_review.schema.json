                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              }
            },
            "coordination": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "untracked"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "phase",
                    "reason",
                    "dueAt"
                  ],
                  "properties": {
                    "kind": {
                      "const": "tracked"
                    },
                    "phase": {
                      "enum": [
                        "queued",
                        "retry",
                        "receipt",
                        "review",
                        "complete"
                      ]
                    },
                    "reason": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "dueAt": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "handling": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "automatic"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "actorUid",
                    "at",
                    "authority"
                  ],
                  "properties": {
                    "kind": {
                      "const": "manual"
