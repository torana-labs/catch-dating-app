            "actions": {
              "type": "array",
              "maxItems": 0,
              "items": {
                "const": "manualHandoff"
              }
            },
            "purpose": {
              "enum": [
                "joiningUpdate",
                "joiningInstructions",
                "planChanged",
                "guestRequirement",
                "assignmentChanged",
                "participationCheck",
                "eventCancelled",
                "eventFinished",
                "followUp"
              ]
            },
            "displayName": {
              "type": "null"
            }
          }
        }
