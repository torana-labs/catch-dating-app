              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lifecycle": {
              "enum": [
                "active",
                "cancelled",
                "superseded",
                "responded"
              ]
            },
            "deliveryStatus": {
              "enum": [
                "notSubmitted",
                "reserved",
                "unknown",
                "accepted",
                "delivered",
                "read",
                "failed",
                "notDispatched",
                "conflictingEvidence",
                "revoked"
              ]
            },
            "attempts": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "channel",
                  "state",
                  "at"
                ],
                "properties": {
                  "channel": {
                    "enum": [
                      "sms",
                      "whatsapp",
                      "rcs"
                    ]
                  },
                  "state": {
                    "enum": [
                      "reserved",
                      "unknown",
                      "accepted",
                      "delivered",
                      "read",
                      "failed",
                      "notDispatched",
                      "revoked"
                    ]
                  },
