{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/shared/event_assistance_delivery_review.schema.json",
  "title": "EventAssistanceDeliveryReviewContracts",
  "definitions": {
    "Handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actorUid",
        "at",
        "operationId"
      ],
      "properties": {
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      }
    },
    "WriteInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "expectedMessageRevision",
        "expectedReviewHash"
      ],
      "properties": {
        "command": {
          "$ref": "event_assistance_common.schema.json#/definitions/RepairDeliveryCommand"
        },
        "expectedMessageRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedReviewHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "properties": {
            "command": {
              "properties": {
                "context": {
                  "properties": {
                    "mode": {
                      "const": "live"
                    }
                  }
                },
                "payload": {
                  "properties": {
                    "deliveryId": {
                      "type": "string",
                      "pattern": "^outbox:[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "View": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "messageId",
            "revision",
            "reviewHash",
            "createdAt",
            "expiresAt",
            "lifecycle",
            "deliveryStatus",
            "attempts",
            "coordination",
            "handling",
            "availability",
            "attendeeId",
            "actions",
            "purpose"
          ],
          "properties": {
            "messageId": {
              "type": "string",
              "pattern": "^outbox:[a-f0-9]{64}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
