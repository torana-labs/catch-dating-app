{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/shared/walkthrough_common.schema.json",
  "title": "WalkthroughCommon",
  "description": "Shapes shared by walkthrough booking: one staff calendar of weekly windows in India time (Asia/Kolkata, a fixed UTC+05:30 with no daylight saving), the slots it offers and the bookings that hold them.",
  "definitions": {
    "bookingId": {
      "type": "string",
      "pattern": "^wt-[a-f0-9]{40}$",
      "description": "Deterministic per verified phone and client request id, so a retried booking finds the same document."
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{15,79}$",
      "description": "Client request id, made once per booking attempt (a UUID is fine) and reused on retries."
    },
    "manageToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "32 random bytes, base64url without padding, made by the website. Only its SHA-256 is stored; it opens the booking's manage link."
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{7,14}$",
      "description": "E.164 WhatsApp number."
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "A UTC instant as Date.toISOString() writes it."
    },
    "slotStart": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00\\.000Z$",
      "description": "A slot's start as a UTC instant on a whole minute, exactly as getWalkthroughSlots returns it."
    },
    "localDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$",
      "description": "A calendar date in India time."
    },
    "weeklyWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weekday",
        "start",
        "end"
      ],
      "description": "One window of the week, in India time. Slots start at start and every slotMinutes after, while a whole slot still ends by end. Windows on one weekday must not overlap.",
      "properties": {
        "weekday": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "description": "ISO weekday: 1 Monday to 7 Sunday."
        },
        "start": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$",
          "description": "Later than start; 24:00 is the end of the day."
        }
      }
    },
    "availabilitySettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "slotMinutes",
        "leadTimeMinutes",
        "horizonDays",
        "weeklyWindows",
        "closedDates"
      ],
      "description": "What staff set. Booking is open only while enabled and at least one window exists.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "slotMinutes": {
          "type": "integer",
          "enum": [
            15,
            20,
            30,
            45,
            60,
            90
          ]
        },
        "leadTimeMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080,
          "description": "No slot starting sooner than this after now is offered or booked."
        },
        "horizonDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 28,
          "description": "How many India-time days, today first, are ever offered."
        },
        "weeklyWindows": {
          "type": "array",
          "maxItems": 28,
          "items": {
            "$ref": "#/definitions/weeklyWindow"
          }
        },
        "closedDates": {
          "type": "array",
          "maxItems": 120,
          "uniqueItems": true,
          "description": "India-time dates with no slots (holidays, team days).",
          "items": {
            "$ref": "#/definitions/localDate"
          }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startAt",
        "endAt",
        "label"
      ],
      "properties": {
        "startAt": {
          "$ref": "#/definitions/slotStart"
        },
        "endAt": {
          "$ref": "#/definitions/slotStart"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "The slot in India time as people read it: Wed 18 Nov, 16:00 IST."
        }
      }
    },
    "followUp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "mode"
      ],
      "description": "A person on the Catch team confirms on WhatsApp. While CATCH_WHATSAPP_WALKTHROUGH_BOOKED_ENABLED is on, Catch's number also sends the approved booking message for each slot booked or moved to; it does not stand in for that confirmation.",
      "properties": {
        "channel": {
          "const": "whatsapp"
        },
        "mode": {
          "const": "staff_reply"
        }
      }
    },
    "consentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "version"
      ],
      "description": "The website lead consent: Catch staff may message the number on WhatsApp about this request. version names the wording shown.",
      "properties": {
        "purpose": {
          "const": "leadFollowUp"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$"
        }
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "description": "The optional answers the walkthrough lead form also asks (website lead intake leadWalkthrough, without preferredTime).",
      "properties": {
        "organisation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "whatYouRun": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "bookingStatus": {
      "type": "string",
      "enum": [
        "booked",
        "cancelled"
      ]
    },
    "changeActor": {
      "type": "string",
      "enum": [
        "booker_token",
        "booker_phone",
        "staff"
      ],
      "description": "Who changed a booking: the booker through the manage link, the booker signed in with the verified number, or staff in Admin."
    },
    "availabilityView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings",
        "revision",
        "updatedAt",
        "updatedByUid"
      ],
      "description": "The saved staff calendar, for Admin.",
      "properties": {
        "settings": {
          "$ref": "#/definitions/availabilitySettings"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "updatedAt": {
          "$ref": "#/definitions/instant"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "adminBookingRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bookingId",
        "status",
        "slot",
        "phone",
        "name",
        "details",
        "cityId",
        "confirmed",
        "staffConfirmation",
        "cancellation",
        "rescheduleCount",
        "createdAt",
        "updatedAt",
        "managePath",
        "inboxItemId"
      ],
      "description": "One booking as staff see it in Admin: the verified number to reply to on WhatsApp and where the booking stands.",
      "properties": {
        "bookingId": {
          "$ref": "#/definitions/bookingId"
        },
        "status": {
          "$ref": "#/definitions/bookingStatus"
        },
        "slot": {
          "$ref": "#/definitions/slot"
        },
        "phone": {
          "$ref": "#/definitions/phone"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "details": {
          "$ref": "#/definitions/details"
        },
        "cityId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "confirmed": {
          "type": "boolean",
          "description": "A person confirmed the slot it holds now."
        },
        "staffConfirmation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "byUid",
                "at",
                "slotStartAt",
                "note"
              ],
              "properties": {
                "byUid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "at": {
                  "$ref": "#/definitions/instant"
                },
                "slotStartAt": {
                  "$ref": "#/definitions/slotStart"
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 500
                }
              }
            }
          ]
        },
        "cancellation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "at",
                "by",
                "reason"
              ],
              "properties": {
                "at": {
                  "$ref": "#/definitions/instant"
                },
                "by": {
                  "$ref": "#/definitions/changeActor"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 500
                }
              }
            }
          ]
        },
        "rescheduleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "createdAt": {
          "$ref": "#/definitions/instant"
        },
        "updatedAt": {
          "$ref": "#/definitions/instant"
        },
        "managePath": {
          "type": "string",
          "pattern": "^/start/walkthrough/manage\\?booking=wt-[a-f0-9]{40}$",
          "description": "The manage page without a token: the booker signs in with the verified phone. Staff may paste it in the WhatsApp confirmation."
        },
        "inboxItemId": {
          "type": "string",
          "pattern": "^walkthrough-wt-[a-f0-9]{40}$"
        }
      }
    }
  }
}
