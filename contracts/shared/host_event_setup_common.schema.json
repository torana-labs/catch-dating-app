{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/shared/host_event_setup_common.schema.json",
  "title": "HostEventSetupCommon",
  "description": "Shared shapes for the Host event setup read models: the manager projection of one event (hostEventSetupViews) and of one organizer's setup defaults (hostEventSetupDefaultViews), and the defaults update command's response.",
  "type": "object",
  "definitions": {
    "setupCity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cityId", "marketId"],
      "properties": {
        "cityId": {"$ref": "event_common.schema.json#/definitions/documentId"},
        "marketId": {"$ref": "event_common.schema.json#/definitions/documentId"}
      }
    },
    "eventPreferences": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "preferences", "paymentTerms"],
          "properties": {
            "revision": {"type": "integer", "minimum": 1, "maximum": 1000000000},
            "preferences": {"$ref": "../embedded/resolved_event_preferences.schema.json"},
            "paymentTerms": {"$ref": "../embedded/event_payment_terms.schema.json"}
          }
        },
        {"type": "null"}
      ]
    },
    "eventDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endTimeMillis", "venueName", "sourceVenueId", "eventFormat"],
      "properties": {
        "endTimeMillis": {"type": ["integer", "null"]},
        "venueName": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
        "sourceVenueId": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "event_common.schema.json#/definitions/documentId"}
          ]
        },
        "eventFormat": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "event_common.schema.json#/definitions/eventFormatSnapshot"}
          ]
        },
        "meetingLocation": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "event_common.schema.json#/definitions/eventMeetingLocation"}
          ]
        },
        "description": {"type": ["string", "null"], "maxLength": 2000},
        "admissionTerms": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "../callables/update_private_event_details_payload.schema.json#/properties/details/properties/admissionTerms"}
          ]
        },
        "distanceKm": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "pace": {
          "anyOf": [
            {"$ref": "event_common.schema.json#/definitions/paceLevel"},
            {"type": "null"}
          ]
        },
        "itinerary": {
          "type": "array",
          "maxItems": 40,
          "items": {"$ref": "event_common.schema.json#/definitions/eventItineraryItem"}
        },
        "eventPhotos": {
          "type": "array",
          "items": {"$ref": "../embedded/uploaded_photo.schema.json"}
        }
      }
    },
    "eventSettings": {
      "description": "Who can see and book the event and how guests experience it, with each field's read-time default applied (listing listed, showGuestList true, priceHiddenUntilBookingOpens false, planVisibleToGuests true).",
      "type": "object",
      "additionalProperties": false,
      "required": ["listing", "showGuestList", "priceHiddenUntilBookingOpens", "planVisibleToGuests", "externalBooking"],
      "properties": {
        "listing": {"type": "string", "enum": ["listed", "link"]},
        "showGuestList": {"type": "boolean"},
        "priceHiddenUntilBookingOpens": {"type": "boolean"},
        "planVisibleToGuests": {"type": "boolean"},
        "externalBooking": {
          "anyOf": [
            {"$ref": "../embedded/event_external_booking.schema.json"},
            {"type": "null"}
          ]
        }
      }
    },
    "publicationReadinessWhenFuture": {
      "description": "Publication readiness with every requirement checked except time. The server evaluates it as if the event started one millisecond from now; the phone applies time: futureActive is status active and startTimeMillis after the app clock's now, canPublish is canPublishWhenFuture and futureActive, and missing gains futureActive (first) when futureActive is false. A published event carries canPublishWhenFuture false and no missing requirements.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["canPublishWhenFuture", "missing"],
          "properties": {
            "canPublishWhenFuture": {"type": "boolean"},
            "missing": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 8,
              "items": {
                "type": "string",
                "enum": [
                  "organizerVisibility",
                  "duration",
                  "venue",
                  "format",
                  "description",
                  "admissionTerms",
                  "distancePace",
                  "contract"
                ]
              }
            }
          }
        },
        {"type": "null"}
      ]
    },
    "privateEventSetupSummary": {
      "description": "The manager projection of one event as the progressive setup steps show it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "organizerId",
        "setupRevision",
        "name",
        "city",
        "localDate",
        "localStartTime",
        "timezone",
        "startTimeMillis",
        "publicationState",
        "status",
        "setupDefaults",
        "detailsConfigured",
        "eventPreferences",
        "eventDetails",
        "canEditBasics",
        "canChangeCity",
        "publicationReadiness"
      ],
      "properties": {
        "eventId": {"$ref": "event_common.schema.json#/definitions/documentId"},
        "organizerId": {"$ref": "event_common.schema.json#/definitions/documentId"},
        "setupRevision": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "city": {"$ref": "#/definitions/setupCity"},
        "localDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "localStartTime": {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$"},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 100},
        "startTimeMillis": {"type": "integer"},
        "publicationState": {"type": "string", "enum": ["private", "published"]},
        "status": {"type": "string", "enum": ["active", "cancelled"]},
        "setupDefaults": {"$ref": "../embedded/event_setup_defaults.schema.json"},
        "detailsConfigured": {"type": "boolean"},
        "eventPreferences": {"$ref": "#/definitions/eventPreferences"},
        "eventDetails": {"$ref": "#/definitions/eventDetails"},
        "canEditBasics": {"type": "boolean"},
        "canChangeCity": {"type": "boolean"},
        "publicationReadiness": {"$ref": "#/definitions/publicationReadinessWhenFuture"},
        "eventSettings": {"$ref": "#/definitions/eventSettings", "description": "Optional: views written before it existed leave it out."}
      }
    },
    "managerEventSetupDefaults": {
      "description": "The manager projection of one organizer's event setup defaults, with the hashes the defaults update command and the first-save basics are fenced by.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organizerId",
        "city",
        "timezone",
        "organizerDefaultsRevision",
        "basicsReviewedHash",
        "preferencesRevision",
        "preferences",
        "preferencesHash",
        "reviewedDefaultsHash"
      ],
      "properties": {
        "organizerId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"},
        "city": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["cityId", "marketId"],
              "properties": {
                "cityId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"},
                "marketId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"}
              }
            },
            {"type": "null"}
          ]
        },
        "timezone": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "organizerDefaultsRevision": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000},
        "basicsReviewedHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "preferencesRevision": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "preferences": {"$ref": "../embedded/organizer_event_setup_preferences.schema.json"},
        "preferencesHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reviewedDefaultsHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
