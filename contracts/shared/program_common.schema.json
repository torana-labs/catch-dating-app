{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/shared/program_common.schema.json",
  "title": "Program and transport common contract definitions",
  "description": "Shared enum, scalar, and embedded definitions for private wedding/corporate program and transport contracts.",
  "definitions": {
    "programKind": {
      "type": "string",
      "enum": [
        "wedding",
        "corporate",
        "social",
        "other"
      ]
    },
    "programStatus": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "completed",
        "archived"
      ]
    },
    "programCapability": {
      "type": "string",
      "enum": [
        "arrivalsTransport",
        "accommodation",
        "forms",
        "messaging"
      ]
    },
    "programStaffDuty": {
      "type": "string",
      "enum": [
        "programAdmin",
        "programCoordinator",
        "guestRelations",
        "communications",
        "functionCheckIn",
        "functionLead",
        "airportGreeter",
        "hotelDesk",
        "transportDispatcher",
        "reconciliationViewer",
        "stakeholderViewer"
      ]
    },
    "programStaffDutyAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duty",
        "pickupPointIds",
        "hotelIds"
      ],
      "properties": {
        "duty": {
          "$ref": "#/definitions/programStaffDuty"
        },
        "pickupPointIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "event_common.schema.json#/definitions/documentId"
          },
          "description": "Pickup restriction; empty means all program pickup points. Both resource restrictions must be met by the same assignment."
        },
        "hotelIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "event_common.schema.json#/definitions/documentId"
          },
          "description": "Destination restriction; empty means all program hotels. Restrictions from different assignments never combine into new routes."
        },
        "functionIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "event_common.schema.json#/definitions/documentId"
          },
          "description": "Function restriction for functionCheckIn and functionLead duties; absent or empty means all program functions. Optional on documents written before function-scoped duties existed."
        }
      }
    },
    "programVehicleClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "passengerCapacity",
        "luggageCapacity",
        "capabilities",
        "sortOrder"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,59}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "passengerCapacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "luggageCapacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "capabilities": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/vehicleCapability"
          }
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "vehicleCapability": {
      "type": "string",
      "enum": [
        "wheelchairAccessible",
        "extraLuggage",
        "childSeat"
      ]
    },
    "programTransportSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bandWindowMillis",
        "maxReadyWaitMillis",
        "domesticExitLagMillis",
        "internationalExitLagMillis",
        "vehicleClasses"
      ],
      "properties": {
        "bandWindowMillis": {
          "type": "integer",
          "minimum": 300000,
          "maximum": 7200000,
          "description": "Anchored curb-time window used by grouping suggestions. Default 30 minutes."
        },
        "maxReadyWaitMillis": {
          "type": "integer",
          "minimum": 60000,
          "maximum": 3600000,
          "description": "Ceiling on how long a physically ready party waits before a group is flagged overdue. Default 10 minutes for premium events."
        },
        "domesticExitLagMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7200000,
          "description": "Default landing-to-curb lag for domestic arrivals."
        },
        "internationalExitLagMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14400000,
          "description": "Default landing-to-curb lag for international arrivals."
        },
        "vehicleClasses": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/programVehicleClass"
          },
          "description": "Program-scoped vehicle catalog consumed by grouping suggestions; ids are unique per program."
        }
      }
    },
    "programGuestSource": {
      "type": "string",
      "enum": [
        "manual",
        "import",
        "formResponse"
      ]
    },
    "programRsvpStatus": {
      "type": "string",
      "enum": [
        "pending",
        "attending",
        "declined",
        "maybe"
      ]
    },
    "programInvitationStatus": {
      "type": "string",
      "enum": [
        "notInvited",
        "invited",
        "delivered",
        "responded"
      ]
    },
    "programFunctionInvitationMode": {
      "type": "string",
      "enum": [
        "allGuests",
        "selectedGuests"
      ],
      "description": "Whether the function invites every program guest or only the programFunctionGuests rows marked invited."
    },
    "programFunctionAttendanceStatus": {
      "type": "string",
      "enum": [
        "expected",
        "checkedIn",
        "noShow"
      ],
      "description": "Door/arrival state for one guest at one function. expected is the default for invited guests; noShow is marked after the function ends."
    },
    "programHouseholdSide": {
      "type": "string",
      "enum": [
        "partnerA",
        "partnerB",
        "mutual"
      ],
      "description": "Which side of the couple or family a household belongs to; display labels live on organizerPrograms.householdSideLabels."
    },
    "programEntitlementSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "limits",
        "capabilitiesAllowed",
        "grantedAtMillis",
        "receiptRef"
      ],
      "description": "Immutable copy of the organizer entitlement terms captured when the program was created; later plan changes do not rewrite program history.",
      "properties": {
        "sku": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,60}$",
          "description": "Catalog key from contracts/catalogs/organizer_entitlement_skus.json at grant time."
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "guests",
            "functions",
            "staffAssignments",
            "momentsPerFunction"
          ],
          "properties": {
            "guests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "functions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "staffAssignments": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "momentsPerFunction": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50
            }
          }
        },
        "capabilitiesAllowed": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/programCapability"
          },
          "description": "Ceiling on organizerPrograms.capabilities; an enabled capability must also appear here."
        },
        "grantedAtMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "receiptRef": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 180,
          "description": "Manual invoice or checkout reference recorded by the granting admin."
        }
      }
    },
    "travelLegKind": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound",
        "ground"
      ]
    },
    "travelLegFlightStatus": {
      "type": "string",
      "enum": [
        "scheduled",
        "enroute",
        "landed",
        "delayed",
        "cancelled",
        "diverted",
        "unknown"
      ]
    },
    "travelLegReadiness": {
      "type": "string",
      "enum": [
        "expected",
        "ready",
        "dispatched",
        "arrived",
        "disrupted",
        "noShow"
      ]
    },
    "transportTripStatus": {
      "type": "string",
      "enum": [
        "enRoute",
        "arrived",
        "cancelled",
        "voided"
      ]
    },
    "transportTripKind": {
      "type": "string",
      "enum": [
        "guestTransfer",
        "repositioning"
      ]
    },
    "transportOperationKind": {
      "type": "string",
      "enum": [
        "markReady",
        "claim",
        "unclaim",
        "markDisrupted",
        "dispatch",
        "markArrived",
        "voidTrip",
        "manifestImport"
      ]
    },
    "pickupPointKind": {
      "type": "string",
      "enum": [
        "airport",
        "railway",
        "venue",
        "other"
      ]
    },
    "iataCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "flightDesignator": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,3}-?[0-9]{1,4}[A-Z]?$"
    },
    "vehiclePlate": {
      "type": "string",
      "minLength": 4,
      "maxLength": 16
    },
    "clientOperationId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "travelLegObservationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientOperationId",
        "action"
      ],
      "description": "A preceding observation by the same actor on the same journey. Its receipt result revision must still equal the current leg revision.",
      "properties": {
        "clientOperationId": {
          "$ref": "#/definitions/clientOperationId"
        },
        "action": {
          "type": "string",
          "enum": [
            "claim",
            "unclaim",
            "markReady",
            "markDisrupted"
          ]
        }
      }
    },
    "programStaffGrantedDuty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duty",
        "pickupPointIds",
        "hotelIds",
        "expiresAtMillis"
      ],
      "properties": {
        "duty": {
          "$ref": "#/definitions/programStaffDutyAssignment/properties/duty"
        },
        "pickupPointIds": {
          "$ref": "#/definitions/programStaffDutyAssignment/properties/pickupPointIds"
        },
        "hotelIds": {
          "$ref": "#/definitions/programStaffDutyAssignment/properties/hotelIds"
        },
        "functionIds": {
          "$ref": "#/definitions/programStaffDutyAssignment/properties/functionIds"
        },
        "expiresAtMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Exclusive expiry of this exact duty and resource scope. Independent of other assignments."
        }
      }
    },
    "programProjectionExpiry": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Exclusive deadline for retaining this scoped projection. Earliest contributing duty expiry; null only for the program creator. Refresh after expiry even if another narrower duty remains active."
    },
    "transportManifestSource": {
      "type": "string",
      "enum": [
        "dispatchSnapshot",
        "currentRecords"
      ],
      "description": "Whether displayed guest names were captured with dispatch or resolved from current records for a legacy trip."
    },
    "programAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "description": "Server-owned proof that this exact program owner approved access, directly or through a current programAdmin. The inherited deadline bounds every delegated renewal. Optional only for legacy creator-issued records.",
      "required": [
        "ownerUid",
        "approvedByUid",
        "approvedAtMillis",
        "authorizedUntilMillis"
      ],
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "approvedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "approvedAtMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authorizedUntilMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "programGuestBranding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "coverImagePath",
        "creditLine"
      ],
      "properties": {
        "color": {
          "type": "string",
          "enum": [
            "rani",
            "marigold",
            "mehendi",
            "rose",
            "haldi"
          ],
          "description": "The guest pages accent colour."
        },
        "coverImagePath": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300,
          "pattern": "^programs/[A-Za-z0-9_-]{1,180}/branding/[A-Za-z0-9._-]{1,100}$",
          "description": "Storage path of the cover photo under the programme branding folder, or null for none."
        },
        "creditLine": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "The planner credit on guest pages, or null to hide it."
        }
      },
      "description": "How the programme's web links look, as the planner set it on Branding. Optional on every guest, vendor and family read: absent when the programme has none, which reads as rani with no cover and no credit."
    }
  }
}
