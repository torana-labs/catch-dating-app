{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_search_people_response.schema.json",
  "title": "AdminSearchPeopleCallableResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "rows"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "uid",
        "phone",
        "name"
      ]
    },
    "rows": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uid",
          "name",
          "phone",
          "city",
          "deleted"
        ],
        "properties": {
          "uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "city": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "deleted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
