{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_list_supply_intake_policies_response.schema.json",
  "title": "AdminListSupplyIntakePoliciesCallableResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["policies"],
  "properties": {
    "policies": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gapId", "label", "enables", "configPath", "decisionId", "decision", "enabled",
          "configCitesDecision", "limits"],
        "properties": {
          "gapId": {"type": "string", "minLength": 1, "maxLength": 160},
          "label": {"type": "string", "minLength": 1, "maxLength": 160},
          "enables": {"type": "string", "maxLength": 1000},
          "configPath": {"type": "string", "maxLength": 240},
          "decisionId": {"type": "string", "minLength": 1, "maxLength": 160},
          "decision": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["decision", "decisionStatus", "note", "reviewedAt"],
                "properties": {
                  "decision": {"enum": ["accept", "hold", "reject"]},
                  "decisionStatus": {"enum": ["accepted", "held", "rejected"]},
                  "note": {"type": "string", "maxLength": 1000},
                  "reviewedAt": {"type": ["string", "null"], "maxLength": 40}
                }
              }
            ]
          },
          "enabled": {"type": "boolean", "description": "Whether the policy file switches the capability on."},
          "configCitesDecision": {"type": "boolean", "description": "Whether the policy file cites this decision, as switching it on requires."},
          "limits": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value"],
              "properties": {
                "label": {"type": "string", "minLength": 1, "maxLength": 80},
                "value": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
