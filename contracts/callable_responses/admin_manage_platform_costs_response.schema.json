{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_manage_platform_costs_response.schema.json",
  "title": "AdminManagePlatformCostsCallableResponse",
  "description": "One month's costs: what is stored, the WhatsApp estimate used while no WhatsApp invoice total is stored, messages sent, and the month's total.",
  "type": "object",
  "additionalProperties": false,
  "required": ["month", "costs", "whatsapp", "totalMinor", "adSpend"],
  "properties": {
    "month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "costs": {"type": "array", "maxItems": 20, "items": {"$ref": "../firestore/platform_costs.schema.json"}},
    "whatsapp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimateMinor", "messageCount", "usesEstimate"],
      "properties": {
        "estimateMinor": {"type": "integer", "minimum": 0},
        "messageCount": {"type": "integer", "minimum": 0},
        "usesEstimate": {"type": "boolean"}
      }
    },
    "totalMinor": {"type": "integer", "minimum": 0},
    "adSpend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metaConnected", "googleConnected"],
      "properties": {
        "metaConnected": {"type": "boolean"},
        "googleConnected": {"type": "boolean"}
      }
    }
  }
}
