{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_approve_organizer_listing_response.schema.json",
  "title": "AdminApproveOrganizerListingCallableResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approvalId",
    "organizerId",
    "organizerPath",
    "created",
    "publishStatus",
    "indexStatus",
    "appVisibility",
    "claimState",
    "salesOwnerUid"
  ],
  "properties": {
    "approvalId": {
      "type": "string",
      "pattern": "^listing-[a-f0-9]{40}$"
    },
    "organizerId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "organizerPath": {
      "type": "string",
      "pattern": "^organizers/[^/]+$"
    },
    "created": {
      "type": "boolean",
      "description": "False when this exact approval had already been applied."
    },
    "publishStatus": {"enum": ["published", "draft"], "description": "draft when the listing came from the website's instant draft tool: it becomes a private, unpublished, claimable organizer draft that goes live only after its organizer claims and publishes it."},
    "indexStatus": {"const": "noindex"},
    "appVisibility": {"const": "hidden"},
    "claimState": {"const": "unclaimed"},
    "salesOwnerUid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
