{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/event_staff_presence_heartbeat_response.schema.json",
  "title": "HeartbeatEventStaffPresenceCallableResponse",
  "description": "When the caller's door presence was recorded and when it lapses without another heartbeat.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "lastSeenAtMillis", "expiresAtMillis"],
  "properties": {
    "eventId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "lastSeenAtMillis": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "expiresAtMillis": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
