{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_get_finance_month_response.schema.json",
  "title": "AdminGetFinanceMonthCallableResponse",
  "description": "One month of Finance from organizer bills (ticket sales paid into organizers' own accounts and Catch's commission), costs and nominator credit paid. leftOverMinor is earned less costs, before salaries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["month", "sales", "earned", "costs", "notCatch", "leftOverMinor", "series"],
  "definitions": {"minor": {"type": "integer"}, "count": {"type": "integer", "minimum": 0}},
  "properties": {
    "month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "sales": {
      "type": "object", "additionalProperties": false,
      "required": ["grossMinor", "refundedMinor", "netMinor", "events", "organizers", "payments"],
      "properties": {
        "grossMinor": {"$ref": "#/definitions/minor"}, "refundedMinor": {"$ref": "#/definitions/minor"},
        "netMinor": {"$ref": "#/definitions/minor"}, "events": {"$ref": "#/definitions/count"},
        "organizers": {"$ref": "#/definitions/count"}, "payments": {"$ref": "#/definitions/count"}
      }
    },
    "earned": {
      "type": "object", "additionalProperties": false,
      "required": ["uncappedMinor", "capsAndTermsMinor", "trialWaivedMinor", "billedMinor", "billedOrganizers", "cappedOrganizers", "ownTermsOrganizers", "freeOrganizers", "paidMinor", "writtenOffMinor"],
      "properties": {
        "uncappedMinor": {"$ref": "#/definitions/minor", "description": "Commission before caps, for organizers past their free trial."},
        "capsAndTermsMinor": {"$ref": "#/definitions/minor", "description": "What caps took off (a positive number)."},
        "trialWaivedMinor": {"$ref": "#/definitions/minor"},
        "billedMinor": {"$ref": "#/definitions/minor"},
        "billedOrganizers": {"$ref": "#/definitions/count"},
        "cappedOrganizers": {"$ref": "#/definitions/count"},
        "ownTermsOrganizers": {"$ref": "#/definitions/count"},
        "freeOrganizers": {"$ref": "#/definitions/count"},
        "paidMinor": {"$ref": "#/definitions/minor"},
        "writtenOffMinor": {"$ref": "#/definitions/minor"}
      }
    },
    "costs": {
      "type": "object", "additionalProperties": false,
      "required": ["lines", "nominatorCreditPaidMinor", "totalMinor", "whatsappIsEstimate", "whatsappMessages"],
      "properties": {
        "lines": {
          "type": "array", "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["category", "amountMinor", "source", "note"],
            "properties": {
              "category": {"$ref": "../firestore/platform_costs.schema.json#/definitions/category"},
              "amountMinor": {"$ref": "#/definitions/minor"},
              "source": {"enum": ["manual", "meta_api", "google_ads_api", "estimate"]},
              "note": {"type": ["string", "null"], "maxLength": 500}
            }
          }
        },
        "nominatorCreditPaidMinor": {"$ref": "#/definitions/minor"},
        "totalMinor": {"$ref": "#/definitions/minor"},
        "whatsappIsEstimate": {"type": "boolean"},
        "whatsappMessages": {"$ref": "#/definitions/count"}
      }
    },
    "notCatch": {
      "type": "object", "additionalProperties": false,
      "required": ["providerFeeMinor", "providerTaxMinor", "gstRegistered", "gstMinor"],
      "properties": {
        "providerFeeMinor": {"$ref": "#/definitions/minor"},
        "providerTaxMinor": {"$ref": "#/definitions/minor"},
        "gstRegistered": {"type": "boolean"},
        "gstMinor": {"$ref": "#/definitions/minor"}
      }
    },
    "leftOverMinor": {"$ref": "#/definitions/minor"},
    "series": {
      "type": "array", "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["month", "salesMinor", "earnedMinor", "partial"],
        "properties": {
          "month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
          "salesMinor": {"$ref": "#/definitions/minor"},
          "earnedMinor": {"$ref": "#/definitions/minor"},
          "partial": {"type": "boolean"}
        }
      }
    }
  }
}
