{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/list_organizer_bills_response.schema.json",
  "title": "ListOrganizerBillsCallableResponse",
  "description": "Catch's bills to one organizer as its owner sees them, newest period first: bills sent or closed and free months. A bill not yet sent is left out, and so are its reminders, history, terms revisions and who acted on it, which stay with Catch's staff.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bills"],
  "definitions": {
    "minor": {"type": "integer", "minimum": 0, "maximum": 100000000000},
    "nullableMillis": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "bill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["billId", "month", "periodKind", "periodStartMillis", "periodEndMillis", "plan", "status", "sales", "commission", "gst", "totalMinor", "invoiceNumber", "dueAtMillis", "paymentUrl", "paidAtMillis", "paidMinor"],
      "properties": {
        "billId": {"type": "string", "minLength": 1, "maxLength": 200},
        "month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
        "periodKind": {"description": "calendarMonth for bills made before rolling cycles; cycle for a rolling billing cycle.", "enum": ["calendarMonth", "cycle"]},
        "periodStartMillis": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "periodEndMillis": {"type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "Exclusive."},
        "plan": {"description": "What the period was billed on: ticketing commission, or the tools-only plan (never both).", "enum": ["ticketing", "toolsOnly"]},
        "status": {"enum": ["sent", "paid", "writtenOff", "free"]},
        "sales": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paymentCount", "eventCount", "grossMinor", "refundedMinor", "providerFeeMinor"],
          "properties": {
            "paymentCount": {"type": "integer", "minimum": 0},
            "eventCount": {"type": "integer", "minimum": 0},
            "grossMinor": {"$ref": "#/definitions/minor"},
            "refundedMinor": {"$ref": "#/definitions/minor"},
            "providerFeeMinor": {"$ref": "#/definitions/minor", "description": "Razorpay's fees on these sales including their tax, taken from the organizer's account."}
          }
        },
        "commission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amountMinor", "capMinor", "capped", "trialWaivedMinor"],
          "properties": {
            "amountMinor": {"$ref": "#/definitions/minor"},
            "capMinor": {"anyOf": [{"$ref": "#/definitions/minor"}, {"type": "null"}]},
            "capped": {"type": "boolean"},
            "trialWaivedMinor": {"$ref": "#/definitions/minor"}
          }
        },
        "gst": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registered", "amountMinor"],
          "properties": {
            "registered": {"type": "boolean"},
            "amountMinor": {"$ref": "#/definitions/minor"}
          }
        },
        "totalMinor": {"$ref": "#/definitions/minor"},
        "refundCredit": {
          "description": "Credit for refunds recorded after earlier bills were sent: appliedMinor came off this bill before GST, carriedForwardMinor goes to the next bill. Null or absent when there is none. The native Host app shows only that a credit applies, never the amounts.",
          "anyOf": [
            {"type": "object", "additionalProperties": false, "required": ["appliedMinor", "carriedForwardMinor"],
              "properties": {"appliedMinor": {"$ref": "#/definitions/minor"}, "carriedForwardMinor": {"$ref": "#/definitions/minor"}}},
            {"type": "null"}
          ]
        },
        "invoiceNumber": {"type": ["string", "null"], "maxLength": 40},
        "dueAtMillis": {"$ref": "#/definitions/nullableMillis"},
        "paymentUrl": {"type": ["string", "null"], "pattern": "^https://", "maxLength": 300, "description": "The Razorpay payment link, only while the bill is unpaid."},
        "paidAtMillis": {"$ref": "#/definitions/nullableMillis"},
        "paidMinor": {"anyOf": [{"$ref": "#/definitions/minor"}, {"type": "null"}]}
      }
    }
  },
  "properties": {
    "bills": {"type": "array", "maxItems": 240, "items": {"$ref": "#/definitions/bill"}}
  }
}
