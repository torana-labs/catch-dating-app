{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/private_seat_reconciliation_response.schema.json",
  "title": "PrivateSeatReconciliationCallableResponse",
  "description": "Result of the retained reconcilePrivateEventSeats passthrough: the ordinary details receipt, or a discard that applied nothing.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "receipt"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "complete"
        },
        "receipt": {
          "$ref": "private_event_setup_mutation_response.schema.json"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "eventId",
        "requestId"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "discarded"
        },
        "eventId": {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        }
      }
    }
  ]
}
