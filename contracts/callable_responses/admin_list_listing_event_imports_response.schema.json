{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_list_listing_event_imports_response.schema.json",
  "title": "AdminListListingEventImportsCallableResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy", "rows", "nextCursor", "unavailableCount"],
  "properties": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "policyVersion"],
      "properties": {
        "mode": {"enum": ["staff_review", "auto_publish_approved_organizers"]},
        "policyVersion": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "rows": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intakeRequestId", "listingId", "approvedAt", "organizer", "events"],
        "properties": {
          "intakeRequestId": {"type": "string", "minLength": 1, "maxLength": 240},
          "listingId": {"type": "string", "minLength": 1, "maxLength": 240},
          "approvedAt": {"type": "string", "minLength": 10, "maxLength": 40},
          "organizer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["organizerId", "name", "canonicalPath", "appVisibility", "pagePublished"],
            "properties": {
              "organizerId": {"type": "string", "minLength": 1, "maxLength": 180},
              "name": {"type": ["string", "null"], "maxLength": 240},
              "canonicalPath": {"type": ["string", "null"], "maxLength": 240},
              "appVisibility": {"enum": ["hidden", "discoverable"]},
              "pagePublished": {"type": "boolean"}
            }
          },
          "events": {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["eventWorkItemId", "eventId", "title", "startAt", "endAt", "venue", "address", "platform",
                "sourceUrl", "priceLabel", "state", "publishedBy", "blockers", "resolvableBlockers",
                "automatedFindings"],
              "properties": {
                "eventWorkItemId": {"type": "string", "minLength": 1, "maxLength": 180},
                "eventId": {"type": ["string", "null"], "maxLength": 180},
                "title": {"type": ["string", "null"], "maxLength": 500},
                "startAt": {"type": "string", "minLength": 10, "maxLength": 40},
                "endAt": {"type": ["string", "null"], "maxLength": 40},
                "venue": {"type": ["string", "null"], "maxLength": 500},
                "address": {"type": ["string", "null"], "maxLength": 500},
                "platform": {"type": "string", "minLength": 1, "maxLength": 80},
                "sourceUrl": {"type": "string", "minLength": 1, "maxLength": 2000},
                "priceLabel": {"type": ["string", "null"], "maxLength": 120},
                "state": {
                  "enum": ["published", "withdrawn", "ready", "needs_resolution", "blocked"],
                  "description": "published: live on the website. withdrawn: staff took it down. ready: a staff member can publish it with the checklist. needs_resolution: a staff member must resolve or waive resolvableBlockers first. blocked: it cannot publish (ended, cancelled, platform not supported, organizer page unpublished)."
                },
                "publishedBy": {"enum": ["policy", "staff", null]},
                "blockers": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
                "resolvableBlockers": {
                  "type": "array",
                  "maxItems": 6,
                  "items": {"enum": ["missing_exact_coordinates", "missing_end_time", "missing_location_detail",
                    "requires_event_defaults_policy", "requires_owner_safe_copy_review",
                    "duplicate_normalized_event_key"]}
                },
                "automatedFindings": {
                  "type": "array",
                  "maxItems": 20,
                  "description": "Why the publication policy left this event for staff, if it did.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["check", "field", "match"],
                    "properties": {
                      "check": {"enum": ["dating_framing", "organizer_attribution", "price_missing"]},
                      "field": {"type": "string", "minLength": 1, "maxLength": 80},
                      "match": {"type": "string", "minLength": 1, "maxLength": 500}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "nextCursor": {"type": ["string", "null"], "maxLength": 400},
    "unavailableCount": {"type": "integer", "minimum": 0}
  }
}
