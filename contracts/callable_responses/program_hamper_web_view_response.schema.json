{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/program_hamper_web_view_response.schema.json",
  "title": "ProgramHamperWebViewCallableResponse",
  "description": "One hotel's rooms with their hamper state, in room order. Rooms come from the programme's live stays at the hotel; stayId is the stay to pass to upsertProgramHamper. Room labels and guest counts only, no guest names. Photo URLs are signed for a few minutes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programId",
    "hotelId",
    "hotelName",
    "programTitle",
    "counts",
    "rooms",
    "urlsExpireAtMillis",
    "expiresAtMillis"
  ],
  "properties": {
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "hotelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "hotelName": {
      "type": "string",
      "maxLength": 200
    },
    "programTitle": {
      "type": "string",
      "maxLength": 200
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rooms",
        "placed"
      ],
      "properties": {
        "rooms": {
          "type": "integer",
          "minimum": 0
        },
        "placed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rooms": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "roomKey",
          "roomLabel",
          "stayId",
          "guestCount",
          "status",
          "placedAtMillis",
          "photoUrl",
          "revision"
        ],
        "properties": {
          "roomKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-z0-9-]+$"
          },
          "roomLabel": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "stayId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "guestCount": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "placed"
            ]
          },
          "placedAtMillis": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "photoUrl": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "urlsExpireAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "branding": {
      "$ref": "../shared/program_common.schema.json#/definitions/programGuestBranding"
    }
  }
}
