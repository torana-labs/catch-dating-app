{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_get_organizer_overview_response.schema.json",
  "title": "AdminGetOrganizerOverviewCallableResponse",
  "description": "The Overview tab of an Admin organizer page: its facts, who owns it in Sales, its terms and payments, its journey from nomination to claim, and its next events from Catch and from the platforms Catch imports. The journey is read from the records each step left (the intake request, the approval, claim requests, ownership and events), oldest first; nextStep names what the organizer is waiting on.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "organizer", "salesOwner", "nextAction", "nextTask", "terms", "payments", "pendingClaim", "journey", "nextStep", "upcomingEvents", "upcomingEventCount"],
  "definitions": {
    "instant": {"type": ["string", "null"], "format": "date-time"},
    "name": {"type": ["string", "null"], "maxLength": 200},
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "name"],
      "properties": {
        "uid": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "name": {"$ref": "#/definitions/name"}
      }
    },
    "journeyStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "at", "actorName", "detail"],
      "properties": {
        "kind": {
          "description": "nominated (a person or a run sent Catch a link; detail is the first link), listingBuilt (Catch read the pages; detail is how many events it found), approved (staff approved the listing), listed (the organizer record was made), claimRequested (detail is the requester's role), claimApproved, claimRejected, claimed, firstEvent (detail is its title).",
          "type": "string",
          "enum": ["nominated", "listingBuilt", "approved", "listed", "claimRequested", "claimApproved", "claimRejected", "claimed", "firstEvent"]
        },
        "at": {"$ref": "#/definitions/instant"},
        "actorName": {"$ref": "#/definitions/name"},
        "detail": {"type": ["string", "null"], "maxLength": 2000}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "eventId", "source", "platform", "title", "startTime", "status"],
      "properties": {
        "key": {"type": "string", "pattern": "^(catch|imported):.{1,180}$"},
        "eventId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "source": {"type": "string", "enum": ["catch", "imported"]},
        "platform": {"type": ["string", "null"], "enum": ["bookMyShow", "district", "luma", "partiful", "sortMyScene", null]},
        "title": {"type": "string", "maxLength": 300},
        "startTime": {"$ref": "#/definitions/instant"},
        "status": {"type": "string", "enum": ["live", "full", "draft", "needsCheck", "cancelled", "removed"]}
      }
    }
  },
  "properties": {
    "generatedAt": {"type": "string", "format": "date-time"},
    "organizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizerId", "name", "kindLabel", "citySlug", "cityLabel", "area", "pageState", "publishStatus", "indexStatus", "canonicalPath", "appVisibility", "claimState", "claimedByName", "listedAt", "hasImage", "origin"],
      "properties": {
        "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "name": {"type": "string", "maxLength": 200},
        "kindLabel": {"type": ["string", "null"], "maxLength": 120},
        "citySlug": {"type": ["string", "null"], "maxLength": 120},
        "cityLabel": {"type": ["string", "null"], "maxLength": 120},
        "area": {"type": ["string", "null"], "maxLength": 200},
        "pageState": {"type": "string", "enum": ["live", "hiddenFromSearch", "hiddenInApp", "draft", "suppressed", "removed"]},
        "publishStatus": {"type": ["string", "null"], "enum": ["draft", "qa", "published", "suppressed", "removed", null]},
        "indexStatus": {"type": ["string", "null"], "enum": ["noindex", "indexReady", "indexed", null]},
        "canonicalPath": {"type": ["string", "null"], "maxLength": 240},
        "appVisibility": {"type": ["string", "null"], "enum": ["discoverable", "hidden", null]},
        "claimState": {"type": "string", "enum": ["unclaimed", "claimPending", "claimed", "verified", "suppressed"]},
        "claimedByName": {"$ref": "#/definitions/name"},
        "listedAt": {"$ref": "#/definitions/instant"},
        "hasImage": {"description": "Whether the page has a cover or profile image; without one it shows a lettermark.", "type": "boolean"},
        "origin": {"type": ["string", "null"], "enum": ["userCreated", "scraper", "adminSeed", "import", null]}
      }
    },
    "salesOwner": {"anyOf": [{"$ref": "#/definitions/person"}, {"type": "null"}]},
    "nextAction": {"type": ["string", "null"], "maxLength": 320},
    "nextTask": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["taskId", "title", "dueAt", "ownerName"],
          "properties": {
            "taskId": {"type": "string", "minLength": 1, "maxLength": 180},
            "title": {"type": "string", "maxLength": 300},
            "dueAt": {"$ref": "#/definitions/instant"},
            "ownerName": {"$ref": "#/definitions/name"}
          }
        }
      ]
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "rateBasisPoints", "capMinor"],
      "properties": {
        "source": {"description": "organizer when the organizer has its own terms, platform when it follows Catch's, unset while Catch's are not configured.", "type": "string", "enum": ["platform", "organizer", "unset"]},
        "rateBasisPoints": {"type": ["integer", "null"], "minimum": 0},
        "capMinor": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "payments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "webhookVerified"],
      "properties": {
        "state": {"type": "string", "enum": ["notConnected", "connected", "needsAttention"]},
        "webhookVerified": {"type": "boolean"}
      }
    },
    "pendingClaim": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestId", "requesterName", "requesterRole", "createdAt"],
          "properties": {
            "requestId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
            "requesterName": {"$ref": "#/definitions/name"},
            "requesterRole": {"type": ["string", "null"], "maxLength": 120},
            "createdAt": {"$ref": "#/definitions/instant"}
          }
        }
      ]
    },
    "journey": {"type": "array", "maxItems": 40, "items": {"$ref": "#/definitions/journeyStep"}},
    "nextStep": {
      "description": "What the organizer is waiting on: the organizer claiming it, staff deciding a claim, or its first event. Null once it has run one.",
      "type": ["string", "null"],
      "enum": ["claim", "decideClaim", "firstEvent", null]
    },
    "upcomingEvents": {"type": "array", "maxItems": 10, "items": {"$ref": "#/definitions/event"}},
    "upcomingEventCount": {"type": "integer", "minimum": 0}
  }
}
