{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/private_event_series_response.schema.json",
  "title": "PrivateEventSeriesCallableResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seriesId",
    "eventIds",
    "replayed"
  ],
  "properties": {
    "seriesId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "eventIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "$ref": "../shared/event_common.schema.json#/definitions/documentId"
      }
    },
    "replayed": {
      "type": "boolean",
      "description": "True when every event in the series already existed."
    }
  }
}
