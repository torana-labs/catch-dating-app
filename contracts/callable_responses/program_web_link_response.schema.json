{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/program_web_link_response.schema.json",
  "title": "ProgramWebLinkCallableResponse",
  "description": "A signed web link token and when it stops working.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "token",
    "expiresAtMillis"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "driverTrip",
        "vendorRunSheet",
        "hotelHandover",
        "hamperPorter",
        "family"
      ]
    },
    "token": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "expiresAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
