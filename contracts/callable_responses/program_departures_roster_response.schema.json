{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/program_departures_roster_response.schema.json",
  "title": "ProgramDeparturesRosterCallableResponse",
  "description": "The hotel desk's departures, mirroring the arrivals roster: one row per outbound journey from this hotel, soonest first, with the stay's room and check-out state. Contact data never leaves the server.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programId",
    "hotelId",
    "hotelName",
    "generatedAtMillis",
    "accessExpiresAtMillis",
    "rows",
    "checkedOut",
    "leavingSoon",
    "lateCheckouts"
  ],
  "properties": {
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "hotelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "hotelName": {
      "type": "string",
      "maxLength": 200
    },
    "generatedAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "accessExpiresAtMillis": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rows": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "legId",
          "guestId",
          "guestDisplayName",
          "partyLabel",
          "passengers",
          "luggageUnits",
          "flightNumber",
          "flightAtMillis",
          "leaveByMillis",
          "roomLabel",
          "state",
          "revision"
        ],
        "properties": {
          "legId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "guestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "guestDisplayName": {
            "type": "string",
            "maxLength": 200
          },
          "partyLabel": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "passengers": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "luggageUnits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "flightNumber": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20
          },
          "flightAtMillis": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "The outbound flight's scheduled time."
          },
          "leaveByMillis": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "When the car leaves: the reviewed manual curb time, else three hours before the flight."
          },
          "roomLabel": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "state": {
            "type": "string",
            "enum": [
              "inRoom",
              "checkedOut",
              "left",
              "carNotNeeded"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "checkedOut": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "leavingSoon": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000,
      "description": "Still here with a car leaving in the next three hours."
    },
    "lateCheckouts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000,
      "description": "Still in their room after their car should have left."
    }
  }
}
