{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/preview_event_assignment_features_response.schema.json",
  "title": "PreviewEventAssignmentFeaturesCallableResponse",
  "description": "No answer values or participant identities: current roster coverage for an unsaved mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "revision", "rosterCount", "coverageBasis", "rows", "sources", "savedRules"],
  "properties": {
    "eventId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "rosterCount": {"type": "integer", "minimum": 0, "maximum": 1000},
    "coverageBasis": {"const": "currentEventRoster"},
    "savedRules": {"type": "array", "maxItems": 8, "items": {"$ref": "../shared/assignment_feature_common.schema.json#/definitions/featureRule"}},
    "sources": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["formId", "formTitle", "versionId", "isActiveVersion", "questions"],
        "properties": {
          "formId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
          "formTitle": {"type": "string", "minLength": 1, "maxLength": 160},
          "versionId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
          "isActiveVersion": {"type": "boolean"},
          "questions": {
            "type": "array", "maxItems": 100,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["questionId", "label", "kind", "options", "minNumber", "maxNumber"],
              "properties": {
                "questionId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
                "label": {"type": "string", "minLength": 1, "maxLength": 240},
                "kind": {"enum": ["singleChoice", "multiChoice", "number"]},
                "minNumber": {"type": ["number", "null"]},
                "maxNumber": {"type": ["number", "null"]},
                "options": {"type": "array", "maxItems": 40, "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["optionId", "label"],
                  "properties": {
                    "optionId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
                    "label": {"type": "string", "minLength": 1, "maxLength": 160}
                  }
                }}
              }
            }
          }
        }
      }
    },
    "rows": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["featureId", "kind", "mode", "weight", "grantedCount", "usableCount", "missingCount"],
        "properties": {
          "featureId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
          "kind": {"enum": ["category", "set", "number", "ordinal"]},
          "mode": {"enum": ["preferSimilar", "preferDifferent", "balanceAcrossGroups", "coverAcrossGroups"]},
          "weight": {"type": "number", "minimum": 0, "maximum": 100},
          "grantedCount": {"type": "integer", "minimum": 0, "maximum": 1000},
          "usableCount": {"type": "integer", "minimum": 0, "maximum": 1000},
          "missingCount": {"type": "integer", "minimum": 0, "maximum": 1000}
        }
      }
    }
  }
}
