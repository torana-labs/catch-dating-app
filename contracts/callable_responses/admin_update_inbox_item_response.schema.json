{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_update_inbox_item_response.schema.json",
  "title": "AdminUpdateInboxItemCallableResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item"
  ],
  "properties": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "type",
        "sourceKind",
        "sourceId",
        "sourcePath",
        "title",
        "subtitle",
        "cameFrom",
        "nominatorUid",
        "city",
        "state",
        "status",
        "waitingSince",
        "doneAt",
        "assigneeUid",
        "snoozedUntil",
        "recommendation"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 220,
          "pattern": "^[a-z]+-[A-Za-z0-9._:-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "listing",
            "event",
            "claim",
            "enquiry",
            "access",
            "stuck"
          ]
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "supplyIntakeRequest",
            "organizerClaimRequest",
            "salesInboundIntent",
            "accessApplication",
            "externalEvent"
          ]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "cameFrom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "nominatorUid": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "city": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "label",
            "tone"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "tone": {
              "type": "string",
              "enum": [
                "neutral",
                "info",
                "success",
                "warning",
                "danger"
              ]
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "working",
            "waiting",
            "snoozed",
            "done"
          ]
        },
        "waitingSince": {
          "type": "string",
          "format": "date-time"
        },
        "doneAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "assigneeUid": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "snoozedUntil": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "recommendation": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision",
                "byUid",
                "at",
                "note"
              ],
              "properties": {
                "decision": {
                  "type": "string",
                  "enum": [
                    "approve",
                    "reject"
                  ]
                },
                "byUid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "note": {
                  "type": "string",
                  "maxLength": 1000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
