{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/program_asset_upload_response.schema.json",
  "title": "ProgramAssetUploadCallableResponse",
  "description": "A signed POST policy for one programme file. POST the file as multipart form data to uploadUrl with every uploadFields entry, then pass assetId to the command that uses it before expiresAtMillis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programId",
    "kind",
    "assetId",
    "storagePath",
    "uploadUrl",
    "uploadFields",
    "expiresAtMillis"
  ],
  "properties": {
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "kind": {
      "type": "string",
      "enum": [
        "guestId",
        "hamper",
        "photo",
        "cover"
      ]
    },
    "assetId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z]+_[a-f0-9]{40}$"
    },
    "storagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^programs/[^/]+/[A-Za-z]+/[A-Za-z0-9_-]+$"
    },
    "uploadUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "uploadFields": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "expiresAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
