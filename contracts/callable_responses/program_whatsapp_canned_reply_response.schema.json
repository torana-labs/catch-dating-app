{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/program_whatsapp_canned_reply_response.schema.json",
  "title": "ProgramWhatsappCannedReplyCallableResponse",
  "description": "A saved reply after an add or a change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programId",
    "cannedReply"
  ],
  "properties": {
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "cannedReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cannedReplyId",
        "label",
        "variants",
        "sortOrder",
        "archived",
        "revision"
      ],
      "properties": {
        "cannedReplyId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "language",
              "text"
            ],
            "properties": {
              "language": {
                "type": "string",
                "enum": [
                  "en",
                  "hi",
                  "gu",
                  "mr",
                  "ta"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "archived": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
