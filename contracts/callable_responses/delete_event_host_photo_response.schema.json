{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/delete_event_host_photo_response.schema.json",
  "title": "DeleteEventHostPhotoCallableResponse",
  "description": "Confirms the host photo and its files are gone; deleted is false when it was already absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "photoId",
    "deleted"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "photoId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,64}$"
    },
    "deleted": {
      "type": "boolean"
    }
  }
}
