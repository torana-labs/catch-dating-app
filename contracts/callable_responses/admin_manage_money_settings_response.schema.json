{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_manage_money_settings_response.schema.json",
  "title": "AdminManageMoneySettingsCallableResponse",
  "description": "The money settings in force (the defaults when none are stored, with revision 0) and the invoice number the next sent bill will take.",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "settings", "updatedAtMillis", "updatedByUid", "nextInvoiceNumber"],
  "properties": {
    "revision": {"type": "integer", "minimum": 0},
    "settings": {"$ref": "../firestore/money_settings.schema.json#/definitions/settings"},
    "updatedAtMillis": {"type": ["integer", "null"], "minimum": 1},
    "updatedByUid": {"type": ["string", "null"], "maxLength": 128},
    "nextInvoiceNumber": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}/[0-9]{3,}$"}
  }
}
