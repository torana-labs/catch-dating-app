{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_get_city_interest_response.schema.json",
  "title": "AdminGetCityInterestCallableResponse",
  "description": "Waitlist interest by city from cityInterest: different people who asked to hear when each city opens, in all and in the last 7 and 30 UTC days against the 7 and 30 days before.",
  "type": "object",
  "additionalProperties": false,
  "x-owner": "Catch operators (Admin)",
  "required": ["generatedAtMillis", "today", "totals", "cities"],
  "definitions": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "last7", "previous7", "last30", "previous30"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "last7": {"type": "integer", "minimum": 0},
        "previous7": {"type": "integer", "minimum": 0},
        "last30": {"type": "integer", "minimum": 0},
        "previous30": {"type": "integer", "minimum": 0}
      }
    }
  },
  "properties": {
    "generatedAtMillis": {"type": "integer", "minimum": 0},
    "today": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "The UTC day the windows end on, included."},
    "totals": {"$ref": "#/definitions/window"},
    "cities": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cityKey", "cityId", "label", "countryIsoCode", "lifecycle", "interest"],
        "properties": {
          "cityKey": {"type": "string", "minLength": 1, "maxLength": 80},
          "cityId": {"type": ["string", "null"]},
          "label": {"type": "string", "minLength": 1, "maxLength": 120},
          "countryIsoCode": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
          "lifecycle": {"type": ["string", "null"], "enum": ["hidden", "waitlist", "launching", "live", "paused", null]},
          "interest": {"$ref": "#/definitions/window"}
        }
      }
    }
  }
}
