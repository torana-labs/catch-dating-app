{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/manage_payment_routing_policy_response.schema.json",
  "title": "ManagePaymentRoutingPolicyCallableResponse",
  "type": "object", "additionalProperties": false,
  "required": ["policyId", "organizerId", "revision", "formFee", "eventAdmission", "hostMembership", "updatedAtMillis"],
  "properties": {
    "policyId": {"type": "string", "pattern": "^(app|org_[a-f0-9]{64})$"},
    "organizerId": {"anyOf": [{"$ref": "../shared/event_common.schema.json#/definitions/documentId"}, {"type": "null"}]},
    "revision": {"type": "integer", "minimum": 0},
    "formFee": {"anyOf": [{"$ref": "../shared/payment_routing.schema.json#/definitions/selection"}, {"type": "null"}]},
    "eventAdmission": {"anyOf": [{"$ref": "../shared/payment_routing.schema.json#/definitions/selection"}, {"type": "null"}]},
    "hostMembership": {"anyOf": [{"$ref": "../shared/payment_routing.schema.json#/definitions/selection"}, {"type": "null"}]},
    "updatedAtMillis": {"type": ["integer", "null"], "minimum": 0}
  }
}
