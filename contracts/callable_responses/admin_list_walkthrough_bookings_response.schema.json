{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_list_walkthrough_bookings_response.schema.json",
  "title": "AdminListWalkthroughBookingsCallableResponse",
  "description": "The saved calendar (null when none is saved), how many slots are open from now, and the bookings in the range, earliest slot first.",
  "type": "object",
  "additionalProperties": false,
  "x-owner": "adminListWalkthroughBookings",
  "required": ["generatedAt", "timeZone", "fromDate", "toDate", "availability", "openSlotCount", "bookings", "truncated"],
  "properties": {
    "generatedAt": {"$ref": "../shared/walkthrough_common.schema.json#/definitions/instant"},
    "timeZone": {"const": "Asia/Kolkata"},
    "fromDate": {"$ref": "../shared/walkthrough_common.schema.json#/definitions/localDate"},
    "toDate": {"$ref": "../shared/walkthrough_common.schema.json#/definitions/localDate", "description": "Last India-time day of the range, included."},
    "availability": {"anyOf": [{"type": "null"}, {"$ref": "../shared/walkthrough_common.schema.json#/definitions/availabilityView"}]},
    "openSlotCount": {"type": "integer", "minimum": 0, "description": "Slots the website offers now, across the calendar's horizon."},
    "bookings": {"type": "array", "maxItems": 500, "items": {"$ref": "../shared/walkthrough_common.schema.json#/definitions/adminBookingRow"}},
    "truncated": {"type": "boolean", "description": "True when more than 500 bookings fall in the range."}
  }
}
