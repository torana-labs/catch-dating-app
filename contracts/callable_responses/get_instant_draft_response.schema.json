{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/get_instant_draft_response.schema.json",
  "title": "GetInstantDraftCallableResponse",
  "description": "Callable response returned by getInstantDraft. building: still reading the link, poll again after pollAfterMs. draft_ready: a private, unpublished organizer draft exists; the page shows it and offers the organizer claim (requestOrganizerClaim and the Instagram or Luma verification) for draft.organizerId. staff_follow_up: a person follows up on WhatsApp; reasons say why. A wrong id or token answers not-found.",
  "type": "object",
  "additionalProperties": false,
  "required": ["draftId", "status", "requestKind", "link", "draft", "reasons", "followUp", "pollAfterMs"],
  "properties": {
    "draftId": {"type": "string", "pattern": "^draft-[a-f0-9]{40}$"},
    "status": {"type": "string", "enum": ["building", "draft_ready", "staff_follow_up"]},
    "requestKind": {"type": "string", "enum": ["event_link", "form_link"]},
    "link": {"$ref": "request_instant_draft_response.schema.json#/definitions/linkSupport"},
    "draft": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["organizerId", "name", "description", "visibility", "claimState", "eventCount", "events"],
          "properties": {
            "organizerId": {"type": "string", "minLength": 1, "maxLength": 128},
            "name": {"type": "string", "minLength": 1, "maxLength": 160},
            "description": {"type": ["string", "null"], "maxLength": 2000},
            "visibility": {
              "type": "string",
              "enum": ["private_until_claimed", "claimed_unpublished", "published"],
              "description": "private_until_claimed: only this link shows it. claimed_unpublished: claimed; the owner publishes it from Catch for Hosts."
            },
            "claimState": {"type": "string", "enum": ["unclaimed", "claimPending", "claimed", "unavailable"]},
            "eventCount": {"type": "integer", "minimum": 0, "maximum": 60},
            "events": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "startAt", "endAt", "venue", "sourceUrl"],
                "properties": {
                  "title": {"type": ["string", "null"], "maxLength": 300},
                  "startAt": {"type": "string", "minLength": 1, "maxLength": 40},
                  "endAt": {"type": ["string", "null"], "maxLength": 40},
                  "venue": {"type": ["string", "null"], "maxLength": 300},
                  "sourceUrl": {"type": "string", "minLength": 1, "maxLength": 2000}
                }
              }
            }
          }
        }
      ]
    },
    "reasons": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]{0,79}$"}
    },
    "followUp": {"$ref": "request_instant_draft_response.schema.json#/definitions/followUp"},
    "pollAfterMs": {"type": ["integer", "null"], "minimum": 500, "maximum": 60000}
  }
}
