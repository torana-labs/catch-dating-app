{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/manage_website_account_response.schema.json",
  "title": "ManageWebsiteAccountCallableResponse",
  "description": "Private account identity, optional own organizer-follow state and, when requested, the account page's messaging permissions (organizerCommunicationPreferences stays server-only). The page's plans, follows and reviews come from Firestore listeners on the guest's own rows (guestEventStatuses, organizerFollows, reviews).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uid",
    "accountReady",
    "displayName",
    "phoneNumber",
    "dateOfBirth",
    "profileRevision",
    "following",
    "eventAge"
  ],
  "properties": {
    "uid": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "accountReady": {
      "type": "boolean"
    },
    "displayName": {
      "type": "string",
      "maxLength": 120
    },
    "phoneNumber": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 32
    },
    "dateOfBirth": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "profileRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "following": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Null unless an organizer was requested. Reflects only the authenticated UID relationship."
    },
    "eventAge": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum",
            "eligible",
            "needsDateOfBirth"
          ],
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120
            },
            "maximum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120
            },
            "eligible": {
              "type": "boolean"
            },
            "needsDateOfBirth": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "messages": {
      "type": "array",
      "maxItems": 50,
      "description": "Own per-organizer channel permissions. A channel reads optedIn only with complete evidence. whatsappReceiptId fences withdrawParticipantMessagingPermission.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organizerId",
          "organizerName",
          "whatsapp",
          "sms",
          "whatsappReceiptId"
        ],
        "properties": {
          "organizerId": {
            "$ref": "../shared/event_common.schema.json#/definitions/documentId"
          },
          "organizerName": {
            "type": "string",
            "maxLength": 240
          },
          "whatsapp": {
            "type": "string",
            "enum": [
              "unknown",
              "optedIn",
              "optedOut"
            ]
          },
          "sms": {
            "type": "string",
            "enum": [
              "unknown",
              "optedIn",
              "optedOut"
            ]
          },
          "whatsappReceiptId": {
            "anyOf": [
              {
                "$ref": "../shared/event_common.schema.json#/definitions/documentId"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
