{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_manage_organizer_bills_response.schema.json",
  "title": "AdminManageOrganizerBillsCallableResponse",
  "description": "A month's bills, or one organizer's bills across months (month null, organizerId set), newest activity first, with totals and counts per state. overdue counts sent bills past their due date.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "month",
    "organizerId",
    "bills",
    "totals",
    "counts",
    "nextInvoiceNumber",
    "gstRegistered",
    "trial",
    "billingPlan",
    "billReview",
    "heldOrganizerIds"
  ],
  "properties": {
    "month": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "organizerId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180
    },
    "bills": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "../firestore/organizer_bills.schema.json"
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "salesMinor",
        "billedMinor",
        "paidMinor"
      ],
      "properties": {
        "salesMinor": {
          "type": "integer",
          "minimum": 0
        },
        "billedMinor": {
          "type": "integer",
          "minimum": 0
        },
        "paidMinor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all",
        "toSend",
        "sent",
        "overdue",
        "paid",
        "writtenOff",
        "free"
      ],
      "properties": {
        "all": {
          "type": "integer",
          "minimum": 0
        },
        "toSend": {
          "type": "integer",
          "minimum": 0
        },
        "sent": {
          "type": "integer",
          "minimum": 0
        },
        "overdue": {
          "type": "integer",
          "minimum": 0
        },
        "paid": {
          "type": "integer",
          "minimum": 0
        },
        "writtenOff": {
          "type": "integer",
          "minimum": 0
        },
        "free": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nextInvoiceNumber": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}/[0-9]{3,}$"
    },
    "gstRegistered": {
      "type": "boolean"
    },
    "trial": {
      "description": "The organizer's free trial when the list is one organizer's bills; null for a month.",
      "anyOf": [
        {
          "$ref": "../embedded/organizer_trial_status.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "billingPlan": {
      "description": "The organizer's Catch plan when the list is one organizer's bills; null for a month.",
      "anyOf": [
        {
          "$ref": "../firestore/organizer_billing_plans.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "billReview": {
      "description": "How one organizer's cycle bills are sent, when the list is one organizer's bills; null for a month. reviewedCycles counts its cycle bills staff have sent (free bills and prepaid tools-only bills are never sent and do not count); while it is under reviewRequiredCycles every new cycle bill waits for staff. hold is the organizer's hold on automatic sending; canHold is false until the organizer has been billed for a cycle.",
      "anyOf": [
        {"type": "object", "additionalProperties": false, "required": ["reviewedCycles", "reviewRequiredCycles", "hold", "canHold"],
          "properties": {
            "reviewedCycles": {"type": "integer", "minimum": 0},
            "reviewRequiredCycles": {"type": "integer", "minimum": 0},
            "hold": {"anyOf": [{"type": "object", "additionalProperties": false, "required": ["atMillis", "byUid", "note"], "properties": {"atMillis": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "byUid": {"type": ["string", "null"], "maxLength": 128}, "note": {"type": ["string", "null"], "maxLength": 500}}}, {"type": "null"}]},
            "canHold": {"type": "boolean"}
          }},
        {"type": "null"}
      ]
    },
    "heldOrganizerIds": {
      "description": "Organizers among the listed bills whose automatic sending is on hold.",
      "type": "array",
      "maxItems": 1000,
      "items": {"type": "string", "maxLength": 180}
    }
  }
}
