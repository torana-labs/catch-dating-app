{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_manage_organizer_bills_response.schema.json",
  "title": "AdminManageOrganizerBillsCallableResponse",
  "description": "A month's bills, or one organizer's bills across months (month null, organizerId set), newest activity first, with totals and counts per state. overdue counts sent bills past their due date.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "month",
    "organizerId",
    "bills",
    "totals",
    "counts",
    "nextInvoiceNumber",
    "gstRegistered"
  ],
  "properties": {
    "month": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "organizerId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180
    },
    "bills": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "../firestore/organizer_bills.schema.json"
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "salesMinor",
        "billedMinor",
        "paidMinor"
      ],
      "properties": {
        "salesMinor": {
          "type": "integer",
          "minimum": 0
        },
        "billedMinor": {
          "type": "integer",
          "minimum": 0
        },
        "paidMinor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all",
        "toSend",
        "sent",
        "overdue",
        "paid",
        "writtenOff",
        "free"
      ],
      "properties": {
        "all": {
          "type": "integer",
          "minimum": 0
        },
        "toSend": {
          "type": "integer",
          "minimum": 0
        },
        "sent": {
          "type": "integer",
          "minimum": 0
        },
        "overdue": {
          "type": "integer",
          "minimum": 0
        },
        "paid": {
          "type": "integer",
          "minimum": 0
        },
        "writtenOff": {
          "type": "integer",
          "minimum": 0
        },
        "free": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nextInvoiceNumber": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}/[0-9]{3,}$"
    },
    "gstRegistered": {
      "type": "boolean"
    }
  }
}
