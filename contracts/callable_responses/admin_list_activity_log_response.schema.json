{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_list_activity_log_response.schema.json",
  "title": "AdminListActivityLogCallableResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generatedAt",
    "filter",
    "entries",
    "nextCursor"
  ],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "filter": {
      "type": "string",
      "enum": [
        "all",
        "problems",
        "decisions",
        "agents"
      ]
    },
    "entries": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entryId",
          "kind",
          "at",
          "actorUid",
          "actorRoles",
          "action",
          "target",
          "outcome",
          "detail",
          "problem"
        ],
        "properties": {
          "entryId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "kind": {
            "type": "string",
            "enum": [
              "decision",
              "agent"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actorUid": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "actorRoles": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "done",
              "started",
              "failed",
              "indeterminate"
            ]
          },
          "detail": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "problem": {
            "type": "boolean"
          }
        }
      }
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
