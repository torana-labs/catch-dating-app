{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/manage_host_membership_program_response.schema.json",
  "title": "ManageHostMembershipProgramCallableResponse",
  "description": "Bounded program projection plus readiness facts the host settings screen needs before enabling memberships. routeAccountReady means the payment account the effective money flow needs is ready (a connected Razorpay account for hostCollected, the Route linked account for platformSplit); feeConfigured means Catch's commercial terms resolve. unavailableReason names the first blocker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizerId",
    "program",
    "routeAccountReady",
    "feeConfigured"
  ],
  "properties": {
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "program": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "provider",
            "mode",
            "billingPauseState",
            "memberCount",
            "revision"
          ],
          "properties": {
            "state": {
              "enum": [
                "enabled",
                "disabled"
              ]
            },
            "provider": {
              "$ref": "../shared/host_membership_common.schema.json#/definitions/provider"
            },
            "mode": {
              "$ref": "../shared/host_membership_common.schema.json#/definitions/providerMode"
            },
            "billingPauseState": {
              "enum": [
                "active",
                "pausing",
                "paused",
                "resuming"
              ]
            },
            "memberCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "revision": {
              "$ref": "../shared/host_membership_common.schema.json#/definitions/revision"
            }
          }
        }
      ]
    },
    "routeAccountReady": {
      "type": "boolean"
    },
    "feeConfigured": {
      "type": "boolean"
    },
    "paymentMode": {
      "description": "The organizer's effective membership money flow, or null when Catch has not offered memberships to this organizer.",
      "anyOf": [
        {
          "$ref": "../shared/host_membership_common.schema.json#/definitions/moneyFlow"
        },
        {
          "type": "null"
        }
      ]
    },
    "unavailableReason": {
      "anyOf": [
        {
          "enum": [
            "notOffered",
            "termsNotConfigured",
            "razorpayNotConnected",
            "razorpayNeedsAttention",
            "subscriptionsNotEnabled",
            "payoutAccountNotReady",
            "providerUnavailable"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
