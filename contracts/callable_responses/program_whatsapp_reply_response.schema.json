{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/program_whatsapp_reply_response.schema.json",
  "title": "ProgramWhatsappReplyCallableResponse",
  "description": "The stored reply after a send or a replay of the same idempotency key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programId",
    "threadId",
    "messageId",
    "providerMessageId",
    "sentAtMillis",
    "replayed"
  ],
  "properties": {
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "threadId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 260,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "messageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "providerMessageId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "sentAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "replayed": {
      "type": "boolean"
    }
  }
}
