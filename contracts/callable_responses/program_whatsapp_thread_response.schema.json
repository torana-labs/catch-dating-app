{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/program_whatsapp_thread_response.schema.json",
  "title": "ProgramWhatsappThreadCallableResponse",
  "description": "One programme WhatsApp thread: the summary, the household row and the retained messages, oldest first.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programId",
    "thread",
    "household",
    "messages",
    "messagesTruncated"
  ],
  "properties": {
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "householdId",
        "guestId",
        "displayName",
        "sideLabel",
        "unknownSender",
        "handledBy",
        "state",
        "language",
        "escalationReason",
        "lastMessagePreview",
        "lastMessageDirection",
        "lastMessageAuthor",
        "lastMessageAtMillis",
        "lastInboundAtMillis",
        "serviceWindowExpiresAtMillis",
        "serviceWindowOpen",
        "unreadCount",
        "revision"
      ],
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 260,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "householdId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 180
        },
        "guestId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 180
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "The household label, or the guest's name, or 'Unknown number'."
        },
        "sideLabel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "unknownSender": {
          "type": "boolean"
        },
        "handledBy": {
          "type": "string",
          "enum": [
            "assistant",
            "planner"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "needsYou",
            "handled"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "en",
            "hi",
            "ta",
            "te",
            "bn",
            "mr",
            "gu",
            "kn",
            "ml",
            "pa",
            "ur",
            null
          ]
        },
        "escalationReason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "notInFacts",
            "askedForPerson",
            "sentMedia",
            "distressed",
            "unknownSender",
            "assistantOff",
            "budgetReached",
            "other",
            null
          ]
        },
        "lastMessagePreview": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "lastMessageDirection": {
          "type": "string",
          "enum": [
            "inbound",
            "outbound"
          ]
        },
        "lastMessageAuthor": {
          "type": "string",
          "enum": [
            "guest",
            "assistant",
            "planner",
            "system"
          ]
        },
        "lastMessageAtMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lastInboundAtMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "serviceWindowExpiresAtMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "serviceWindowOpen": {
          "type": "boolean"
        },
        "unreadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "household": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "householdId",
        "label",
        "primaryContactName",
        "guestCount",
        "rsvpStatus"
      ],
      "properties": {
        "householdId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "primaryContactName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "guestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "rsvpStatus": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        }
      }
    },
    "messages": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "messageId",
          "direction",
          "kind",
          "text",
          "author",
          "authorName",
          "status",
          "createdAtMillis"
        ],
        "properties": {
          "messageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "direction": {
            "type": "string",
            "enum": [
              "inbound",
              "outbound"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "template",
              "mediaRef",
              "system"
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "author": {
            "type": "string",
            "enum": [
              "guest",
              "assistant",
              "planner",
              "system"
            ]
          },
          "authorName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120,
            "description": "The staff member's name for planner replies."
          },
          "status": {
            "type": "string",
            "enum": [
              "received",
              "pending",
              "sent",
              "delivered",
              "read",
              "failed",
              "unknown"
            ]
          },
          "createdAtMillis": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "messagesTruncated": {
      "type": "boolean"
    }
  }
}
