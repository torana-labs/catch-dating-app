{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/import_form_from_link_response.schema.json",
  "title": "ImportFormFromLinkCallableResponse",
  "description": "Response of form.import-from-link. needs_input: the caller must set up a try-it workspace first (result.reasons no_workspace). previewed: result.form outlines the private draft form apply would create, and result.flags lists what the host rebuilds by hand. refused: nothing can be imported (result.reasons). Refusal reasons include not_a_form_link, form_provider_not_supported, link_unreadable, form_not_public, form_empty, listing_suppressed and, with the AI fallback on, form_unreadable, ai_cap_reached and ai_daily_limit. applied or replayed: result.formId names the private draft form in the workspace. Nothing here publishes a form or collects responses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["commandId", "status", "previewHash", "summary", "effects", "result", "next", "receiptId"],
  "properties": {
    "commandId": {"const": "form.import-from-link"},
    "status": {"type": "string", "enum": ["previewed", "applied", "replayed", "needs_input", "refused"]},
    "previewHash": {"$ref": "../shared/command_envelope.schema.json#/definitions/previewHash"},
    "summary": {"$ref": "../shared/command_envelope.schema.json#/definitions/summary"},
    "effects": {"type": "array", "maxItems": 12, "items": {"$ref": "../shared/command_envelope.schema.json#/definitions/effect"}},
    "next": {"type": "array", "maxItems": 8, "items": {"$ref": "../shared/command_envelope.schema.json#/definitions/next"}},
    "receiptId": {"type": ["string", "null"], "pattern": "^[a-z][A-Za-z0-9]{0,63}_[a-f0-9]{64}$"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizerId", "link", "form", "flags", "formId", "reasons"],
      "properties": {
        "organizerId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9]{20}$"},
        "link": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "support", "reason"],
          "properties": {
            "provider": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,59}$"},
            "support": {"type": "string", "enum": ["instant", "best_effort", "staff_follow_up"]},
            "reason": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,79}$"}
          }
        },
        "form": {
          "description": "The draft form apply would create (or created): its sections and questions in order.",
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "description", "questionCount", "ruleCount", "sections"],
              "properties": {
                "title": {"type": "string", "minLength": 1, "maxLength": 160},
                "description": {"type": ["string", "null"], "maxLength": 1000},
                "questionCount": {"type": "integer", "minimum": 0, "maximum": 200},
                "ruleCount": {"type": "integer", "minimum": 0, "maximum": 100},
                "sections": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 40,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["title", "questions"],
                    "properties": {
                      "title": {"type": "string", "minLength": 1, "maxLength": 160},
                      "questions": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["label", "kind", "required", "optionCount"],
                          "properties": {
                            "label": {"type": "string", "minLength": 1, "maxLength": 240},
                            "kind": {"$ref": "../shared/organizer_form_common.schema.json#/definitions/questionKind"},
                            "required": {"type": "boolean"},
                            "optionCount": {"type": "integer", "minimum": 0, "maximum": 100}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "flags": {
          "description": "What the host rebuilds by hand, with the source question or section it came from.",
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "item"],
            "properties": {
              "code": {"type": "string", "enum": ["grid_not_supported", "time_as_text", "file_upload_skipped", "media_skipped",
                "unknown_item_skipped", "other_option_dropped", "branching_review", "navigation_not_supported",
                "extra_finish_dropped", "options_trimmed", "text_trimmed", "sections_limit", "questions_limit", "logic_limit"]},
              "item": {"type": ["string", "null"], "maxLength": 120}
            }
          }
        },
        "formId": {"type": ["string", "null"], "pattern": "^form_[a-f0-9]{32}$"},
        "reasons": {"type": "array", "maxItems": 4, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$"}},
        "aiRead": {"type": "boolean", "description": "True when the AI fallback read the page's visible text because the form parser could not (#2062); the website marks every question for review. Optional: absent means false. Off until go-live."},
        "reviewFields": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "pattern": "^q[0-9]+(_[a-z0-9_]+)?$", "maxLength": 80}, "description": "Question keys the AI fallback read, for the host to check; empty unless aiRead."}
      }
    }
  }
}
