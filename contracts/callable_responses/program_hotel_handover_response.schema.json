{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/program_hotel_handover_response.schema.json",
  "title": "ProgramHotelHandoverCallableResponse",
  "description": "One hotel's rooming list with ID status. Image URLs are given for accepted IDs only, signed for a few minutes; each look is recorded on the ID. No phone numbers or emails.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programId",
    "hotelId",
    "hotelName",
    "programTitle",
    "organizerName",
    "counts",
    "rooms",
    "urlsExpireAtMillis",
    "expiresAtMillis"
  ],
  "properties": {
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "hotelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "hotelName": {
      "type": "string",
      "maxLength": 200
    },
    "programTitle": {
      "type": "string",
      "maxLength": 200
    },
    "organizerName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rooms",
        "guests",
        "idsAccepted",
        "idsMissing"
      ],
      "properties": {
        "rooms": {
          "type": "integer",
          "minimum": 0
        },
        "guests": {
          "type": "integer",
          "minimum": 0
        },
        "idsAccepted": {
          "type": "integer",
          "minimum": 0
        },
        "idsMissing": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rooms": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "roomLabel",
          "arrivesAtMillis",
          "departsAtMillis",
          "guests"
        ],
        "properties": {
          "roomLabel": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "arrivesAtMillis": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "departsAtMillis": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "guests": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "guestId",
                "displayName",
                "idStatus",
                "idKind",
                "numberLast4",
                "frontUrl",
                "backUrl",
                "visaUrl"
              ],
              "properties": {
                "guestId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "displayName": {
                  "type": "string",
                  "maxLength": 200
                },
                "idStatus": {
                  "type": "string",
                  "enum": [
                    "accepted",
                    "pending",
                    "missing"
                  ]
                },
                "idKind": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "aadhaar",
                    "passport",
                    "licence",
                    "voterId",
                    null
                  ]
                },
                "numberLast4": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9A-Z]{4}$"
                },
                "frontUrl": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4096
                },
                "backUrl": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4096
                },
                "visaUrl": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4096
                }
              }
            }
          }
        }
      }
    },
    "urlsExpireAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "branding": {
      "$ref": "../shared/program_common.schema.json#/definitions/programGuestBranding"
    }
  }
}
