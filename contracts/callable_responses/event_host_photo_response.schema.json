{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/event_host_photo_response.schema.json",
  "title": "EventHostPhotoCallableResponse",
  "description": "The shared host photo with short-lived signed image URLs that expire at urlsExpireAtMillis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "photo",
    "urlsExpireAtMillis"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "photoId",
        "thumbnailUrl",
        "displayUrl",
        "width",
        "height",
        "uploadedByUid",
        "createdAtMillis"
      ],
      "properties": {
        "photoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,64}$"
        },
        "thumbnailUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "displayUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "uploadedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "createdAtMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "urlsExpireAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
