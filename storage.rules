rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 8 * 1024 * 1024;
    }

    function isStoredImage() {
      return resource != null && resource.contentType.matches('image/.*');
    }

    function isNewImageUpload() {
      return resource == null && isImage();
    }

    function isStoredImageDelete() {
      return request.resource == null && isStoredImage();
    }

    function isStableMediaId(mediaId) {
      return mediaId.matches('[A-Za-z0-9_-]{16,64}');
    }

    function isOriginalMediaFileName(fileName) {
      return fileName.matches('original\\.(jpg|jpeg|png)');
    }

    function isV2MediaFileName(fileName) {
      return isOriginalMediaFileName(fileName) || fileName == 'thumbnail.jpg';
    }

    function isGalleryPhotoFileName(fileName) {
      return fileName.matches('[0-5]_[0-9]+\\.(jpg|jpeg|png)');
    }

    function isTimestampImageFileName(fileName) {
      return fileName.matches('[0-9]+\\.(jpg|jpeg|png)');
    }

    function isChatImageFileName(fileName) {
      return fileName.matches('[A-Za-z0-9_-]{1,180}_[0-9]+\\.(jpg|jpeg|png)');
    }

    function isOwnedChatImageUpload() {
      return request.resource != null
        && request.resource.metadata.keys().hasAll(['uploaderUid'])
        && request.resource.metadata.uploaderUid is string
        && request.resource.metadata.uploaderUid == request.auth.uid;
    }

    function isOwnedStoredChatImage() {
      return resource != null
        && resource.contentType.matches('image/.*')
        && resource.metadata.keys().hasAll(['uploaderUid'])
        && resource.metadata.uploaderUid is string
        && resource.metadata.uploaderUid == request.auth.uid;
    }

    function canAccessMatch(matchId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/matches/$(matchId))
        && firestore.get(
          /databases/(default)/documents/matches/$(matchId)
        ).data.status != 'blocked'
        && (
          (
            firestore.get(
              /databases/(default)/documents/matches/$(matchId)
            ).data.keys().hasAny(['user1Id'])
            &&
            firestore.get(
              /databases/(default)/documents/matches/$(matchId)
            ).data.user1Id == request.auth.uid
          )
          || (
            firestore.get(
              /databases/(default)/documents/matches/$(matchId)
            ).data.keys().hasAny(['user2Id'])
            &&
            firestore.get(
              /databases/(default)/documents/matches/$(matchId)
            ).data.user2Id == request.auth.uid
          )
        || (
            firestore.get(
              /databases/(default)/documents/matches/$(matchId)
            ).data.keys().hasAny(['participantIds'])
          &&
            firestore.get(
              /databases/(default)/documents/matches/$(matchId)
            ).data.participantIds is list
            && firestore.get(
              /databases/(default)/documents/matches/$(matchId)
            ).data.participantIds.hasAny([request.auth.uid])
          )
        );
    }

    function canWriteMatchImage(matchId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/matches/$(matchId))
        && firestore.get(
          /databases/(default)/documents/matches/$(matchId)
        ).data.status == 'active'
        && (
          (
            firestore.get(
              /databases/(default)/documents/matches/$(matchId)
            ).data.keys().hasAny(['user1Id'])
            &&
            firestore.get(
              /databases/(default)/documents/matches/$(matchId)
            ).data.user1Id == request.auth.uid
          )
          || (
            firestore.get(
              /databases/(default)/documents/matches/$(matchId)
            ).data.keys().hasAny(['user2Id'])
            &&
            firestore.get(
              /databases/(default)/documents/matches/$(matchId)
            ).data.user2Id == request.auth.uid
          )
          || (
            firestore.get(
              /databases/(default)/documents/matches/$(matchId)
            ).data.keys().hasAny(['participantIds'])
            &&
            firestore.get(
              /databases/(default)/documents/matches/$(matchId)
            ).data.participantIds is list
            && firestore.get(
              /databases/(default)/documents/matches/$(matchId)
            ).data.participantIds.hasAny([request.auth.uid])
          )
        );
    }

    function canWriteOrganizerMedia(organizerId) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/organizers/$(organizerId)
        )
        && (
          (
            firestore.get(
              /databases/(default)/documents/organizers/$(organizerId)
            ).data.keys().hasAny(['hostUserId'])
            && firestore.get(
              /databases/(default)/documents/organizers/$(organizerId)
            ).data.hostUserId == request.auth.uid
          )
          || (
            firestore.get(
              /databases/(default)/documents/organizers/$(organizerId)
            ).data.keys().hasAny(['ownerUserId'])
            && firestore.get(
              /databases/(default)/documents/organizers/$(organizerId)
            ).data.ownerUserId == request.auth.uid
          )
          || (
            firestore.get(
              /databases/(default)/documents/organizers/$(organizerId)
            ).data.keys().hasAny(['hostUserIds'])
            &&
            firestore.get(
              /databases/(default)/documents/organizers/$(organizerId)
            ).data.hostUserIds is list
            && firestore.get(
              /databases/(default)/documents/organizers/$(organizerId)
            ).data.hostUserIds.hasAny([request.auth.uid])
          )
          || hasActiveOrganizerTeamMembership(organizerId)
        );
    }

    function hasActiveOrganizerTeamMembership(organizerId) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/organizerTeamMemberships/$(
            organizerId + '_' + request.auth.uid
          )
        )
        && firestore.get(
          /databases/(default)/documents/organizerTeamMemberships/$(
            organizerId + '_' + request.auth.uid
          )
        ).data.organizerId == organizerId
        && firestore.get(
          /databases/(default)/documents/organizerTeamMemberships/$(
            organizerId + '_' + request.auth.uid
          )
        ).data.uid == request.auth.uid
        && firestore.get(
          /databases/(default)/documents/organizerTeamMemberships/$(
            organizerId + '_' + request.auth.uid
          )
        ).data.status == 'active'
        && (
          firestore.get(
            /databases/(default)/documents/organizerTeamMemberships/$(
              organizerId + '_' + request.auth.uid
            )
          ).data.role == 'owner'
          || firestore.get(
            /databases/(default)/documents/organizerTeamMemberships/$(
              organizerId + '_' + request.auth.uid
            )
          ).data.role == 'manager'
        );
    }

    function canWriteEventMedia(eventId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/events/$(eventId))
        && (
          (
            firestore.get(
              /databases/(default)/documents/events/$(eventId)
            ).data.keys().hasAny(['organizerId'])
            && canWriteOrganizerMedia(
              firestore.get(
                /databases/(default)/documents/events/$(eventId)
              ).data.organizerId
            )
          )
          || (
            !firestore.get(
              /databases/(default)/documents/events/$(eventId)
            ).data.keys().hasAny(['organizerId'])
            && canWriteOrganizerMedia(
              firestore.get(
                /databases/(default)/documents/events/$(eventId)
              ).data.organizerId
            )
          )
        );
    }

    match /users/{uid}/photos/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && isGalleryPhotoFileName(fileName)
        && (isNewImageUpload() || isStoredImageDelete());
    }

    match /users/{uid}/photoThumbnails/{fileName} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{uid}/hostedMedia/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /organizers/{organizerId}/photos/{fileName} {
      allow read: if true;
      allow write: if canWriteOrganizerMedia(organizerId)
        && isGalleryPhotoFileName(fileName)
        && (isNewImageUpload() || isStoredImageDelete());
    }

    match /organizers/{organizerId}/logo/{fileName} {
      allow read: if true;
      allow write: if canWriteOrganizerMedia(organizerId)
        && isTimestampImageFileName(fileName)
        && (isNewImageUpload() || isStoredImageDelete());
    }

    match /organizers/{organizerId}/media/{mediaId}/{fileName} {
      allow read: if isStableMediaId(mediaId)
        && isV2MediaFileName(fileName);
      allow write: if canWriteOrganizerMedia(organizerId)
        && isStableMediaId(mediaId)
        && isOriginalMediaFileName(fileName)
        && (isNewImageUpload() || isStoredImageDelete());
    }

    match /organizers/{organizerId}/logo/{mediaId}/{fileName} {
      allow read: if isStableMediaId(mediaId)
        && isV2MediaFileName(fileName);
      allow write: if canWriteOrganizerMedia(organizerId)
        && isStableMediaId(mediaId)
        && isOriginalMediaFileName(fileName)
        && (isNewImageUpload() || isStoredImageDelete());
    }

    match /organizers/{organizerId}/logoThumbnails/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Respondent form uploads use one short-lived backend-signed POST policy.
    // Direct Firebase Storage SDK access and public byte reads stay denied.
    match /organizerForms/{formId}/{draftId}/{assetId} {
      allow read, write: if false;
    }

    // Response exports are private backend objects surfaced only through
    // short-lived manager-authorized signed URLs.
    match /organizer-form-exports/{organizerId}/{fileName} {
      allow read, write: if false;
    }

    match /events/{eventId}/photos/{fileName} {
      allow read: if true;
      allow write: if canWriteEventMedia(eventId)
        && isGalleryPhotoFileName(fileName)
        && (isNewImageUpload() || isStoredImageDelete());
    }

    match /events/{eventId}/media/{mediaId}/{fileName} {
      allow read: if isStableMediaId(mediaId)
        && isV2MediaFileName(fileName);
      allow write: if canWriteEventMedia(eventId)
        && isStableMediaId(mediaId)
        && isOriginalMediaFileName(fileName)
        && (isNewImageUpload() || isStoredImageDelete());
    }

    match /matches/{matchId}/images/{fileName} {
      allow read: if canAccessMatch(matchId);
      allow write: if (
          resource == null
          && request.resource != null
          && isSignedIn()
          && isImage()
          && isChatImageFileName(fileName)
          && isOwnedChatImageUpload()
          && canWriteMatchImage(matchId)
        ) || (
          resource != null
          && request.resource == null
          && isSignedIn()
          && isChatImageFileName(fileName)
          && isOwnedStoredChatImage()
          && canWriteMatchImage(matchId)
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
