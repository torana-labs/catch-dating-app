{
  "version": 1,
  "owner": "app_architecture",
  "doc": "docs/app_architecture.md#bounded-context-contract",
  "description": "Bounded contexts of the Flutter app, in dependency order. A context may import only contexts declared before it. Legacy entries place today's folders until each moves under the target roots; the longest matching path prefix wins.",
  "roots": {
    "contexts": "lib/contexts/",
    "pages": "lib/pages/",
    "kernel": "lib/kernel/",
    "platform": "lib/platform/"
  },
  "contexts": [
    {"id": "account", "owns": "Sign-in, session, app role, launch access and forced updates."},
    {"id": "profiles", "owns": "A person's private profile, public projection, photos and saved answers."},
    {"id": "safety", "owns": "Blocking, reporting and account deletion."},
    {"id": "organizers", "owns": "Organisers, their team and roles, organiser pages, follows and claims."},
    {"id": "events", "owns": "Events, schedules, venues, formats and event policies."},
    {"id": "payments", "owns": "Guest payments, refunds, an organiser's Razorpay connection and the Catch bill."},
    {"id": "forms", "owns": "Questions, applications, responses and offers."},
    {"id": "bookings", "owns": "Bookings, waitlists, tickets, the door, attendance and guest lists."},
    {"id": "reviews", "owns": "Ratings after an event."},
    {"id": "audience", "owns": "The people a host knows: groups, tags, notes and imports."},
    {"id": "discovery", "owns": "Search, recommendations, maps, saved events and cities."},
    {"id": "connections", "owns": "Staying in touch after an event: picks, mutual connections and cross paths."},
    {"id": "messaging", "owns": "Chats, group chats, the inbox, broadcasts, scheduled messages and channels."},
    {"id": "live", "owns": "The live formats engine: rotations, pods, teams, grouping, assistance, the guest companion and rehearsal."},
    {"id": "programmes", "owns": "Multi-day programmes: functions, households, travel, stays, transport and crew."},
    {"id": "insights", "owns": "Reports, stats and the alerts that need a host's attention."}
  ],
