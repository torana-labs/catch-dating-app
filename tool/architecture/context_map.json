{
  "version": 1,
  "owner": "app_architecture",
  "doc": "docs/app_architecture.md#bounded-context-contract",
  "description": "Bounded contexts of the Flutter app, in dependency order. A context may import only contexts declared before it. Legacy entries place today's folders until each moves under the target roots; the longest matching path prefix wins.",
  "forbidLegacyContextFiles": true,
  "roots": {
    "contexts": "lib/contexts/",
    "pages": "lib/pages/",
    "kernel": "lib/kernel/",
    "platform": "lib/platform/"
  },
  "contexts": [
    {"id": "account", "owns": "Sign-in, session, app role, launch access and forced updates."},
    {"id": "profiles", "owns": "A person's private profile, public projection, photos and saved answers."},
    {"id": "safety", "owns": "Blocking, reporting and account deletion."},
    {"id": "formats", "owns": "What each format is and how it is set up: playbooks, modules, structures, questionnaires, activity profiles and the default settings an organiser or event picks."},
    {"id": "events", "owns": "Events, schedules, venues and event policies."},
    {"id": "organizers", "owns": "Organisers, their team and roles, organiser pages, follows and claims."},
    {"id": "payments", "owns": "Guest payments, refunds, an organiser's Razorpay connection and the Catch bill."},
    {"id": "bookings", "owns": "Bookings, waitlists, tickets, the door, attendance and guest lists."},
    {"id": "reviews", "owns": "Ratings after an event."},
    {"id": "audience", "owns": "The people a host knows: groups, tags, notes and imports."},
    {"id": "forms", "owns": "Questions, applications, responses and offers."},
    {"id": "discovery", "owns": "Search, recommendations, maps, saved events and cities."},
    {"id": "connections", "owns": "Staying in touch after an event: picks, mutual connections and cross paths."},
    {"id": "messaging", "owns": "Chats, group chats, the inbox, broadcasts, scheduled messages and channels."},
    {"id": "live", "owns": "The live formats engine at runtime: rotations, pods, teams, grouping, assistance, the guest companion and rehearsal."},
    {"id": "programmes", "owns": "Multi-day programmes: functions, households, travel, stays, transport and crew."},
    {"id": "insights", "owns": "Reports, stats and the alerts that need a host's attention."}
  ],
  "legacy": [
    {"path": "lib/app.dart", "layer": "app"},
    {"path": "lib/app_bootstrap.dart", "layer": "app"},
    {"path": "lib/consumer_bootstrap.dart", "layer": "app"},
    {"path": "lib/core/presentation/app_shell.dart", "layer": "app"},
    {"path": "lib/core/presentation/host_app_shell.dart", "layer": "app"},
    {"path": "lib/core/widgets/event_thumbnail.dart", "layer": "app"},
    {"path": "lib/dashboard/", "layer": "app"},
    {"path": "lib/event_success/event_success_companion_launcher.dart", "layer": "app"},
    {"path": "lib/design_fixtures/", "layer": "app"},
    {"path": "lib/hosts/hosts.dart", "layer": "app"},
    {"path": "lib/hosts/presentation/", "layer": "app"},
    {"path": "lib/routing/", "layer": "app"},

    {"path": "lib/contracts.dart", "layer": "platform"},
    {"path": "lib/core/", "layer": "platform"},
    {"path": "lib/exceptions/", "layer": "platform"},
    {"path": "lib/firebase_options", "layer": "platform"},
    {"path": "lib/hosts/data/read_models/host_summary_reader.dart", "layer": "platform"},
    {"path": "lib/l10n/", "layer": "platform"},
    {"path": "lib/routing/route_contract.dart", "layer": "platform"},

    {"path": "lib/activity/", "layer": "kernel"},
    {"path": "lib/core/labelled.dart", "layer": "kernel"},
    {"path": "lib/organizers/domain/organizer_supply_capabilities.dart", "layer": "kernel"},
    {"path": "lib/locations/domain/location_coordinate.dart", "layer": "kernel"},

    {"path": "lib/auth/", "context": "account"},
    {"path": "lib/force_update/", "context": "account"},
    {"path": "lib/launch_access/", "context": "account"},

    {"path": "lib/image_uploads/", "context": "profiles"},
    {"path": "lib/onboarding/", "context": "profiles"},
    {"path": "lib/public_profile/", "context": "profiles"},
    {"path": "lib/user_profile/", "context": "profiles"},

    {"path": "lib/safety/", "context": "safety"},

    {"path": "lib/clubs/", "context": "organizers"},
    {"path": "lib/organizers/", "context": "organizers"},

    {"path": "lib/event_policies/", "context": "events"},
    {"path": "lib/events/", "context": "events"},
    {"path": "lib/hosts/events/", "context": "events"},
    {"path": "lib/locations/", "context": "events"},

    {"path": "lib/payments/", "context": "payments"},

    {"path": "lib/reviews/", "context": "reviews"},

    {"path": "lib/hosts/audience/", "context": "audience"},

    {"path": "lib/explore/", "context": "discovery"},

    {"path": "lib/cross_paths/", "context": "connections"},
    {"path": "lib/matches/", "context": "connections"},
    {"path": "lib/swipes/", "context": "connections"},

    {"path": "lib/chats/", "context": "messaging"},
    {"path": "lib/notifications/", "context": "messaging"},

    {"path": "lib/event_rehearsal/", "context": "live"},
    {"path": "lib/event_success/", "context": "live"},

    {"path": "lib/hosts/audience/phone_import/", "context": "programmes"},
    {"path": "lib/hosts/work/", "context": "programmes"},
    {"path": "lib/programs/", "context": "programmes"},

    {"path": "lib/hosts/today/", "context": "insights"},
    {"path": "lib/user_analytics/", "context": "insights"}
  ]
}
