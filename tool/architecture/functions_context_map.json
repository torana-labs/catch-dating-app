  "doc": "docs/app_architecture.md#backend-contexts",
  "description": "Where each handwritten functions/src module sits (issue #1350). Contexts reuse the app's vocabulary from context_map.json, in its order, plus backend-only contexts. Platform imports only platform; a domain context imports platform and contexts declared before it; a surface imports platform, any domain context and its own files; only index.ts imports a surface. Target roots win; otherwise the longest legacy path decides (a path ending in / is a folder, any other path one file). Code moved before the scripted move goes under its target root.",
  "roots": {
    "domain": "functions/src/domain/",
    "surfaces": "functions/src/surfaces/",
    "platform": "functions/src/platform/"
  },
  "entry": ["functions/src/index.ts"],
  "contexts": [
    "profiles",
    "safety",
    "formats",
    "events",
    "organizers",
    "payments",
    "bookings",
    "reviews",
    "audience",
    "forms",
    "discovery",
    "connections",
    "messaging",
    "live",
    "programmes",
    "insights",
    {"id": "supply", "owns": "External events, listing intake and nominations, listing approval, publication and visibility policy, suppressions and takedowns."},
    {"id": "sales", "owns": "Catch's own sales pipeline: leads, partners, demos and walkthroughs, the sales assistant, city interest and the launch waitlist."}
  ],
  "surfaces": [
    {"id": "admin", "owns": "The Admin console's endpoints and read models, including the staff inbox."},
    {"id": "host", "owns": "Catch Host's read models, alerts and work views."},
    {"id": "website", "owns": "The website's public page and city read models and its try-it commands."},
    {"id": "ops", "owns": "Demo, seed and maintenance callables."}
  ],
  "contextOrderViolationCeiling": 255,
  "crossContextWriteCeiling": 126,
