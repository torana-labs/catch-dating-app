{
  "$schema": "catch.app-targets/v1",
  "schemaVersion": 1,
  "logicalName": "catch-installable-app-targets",
  "reason": "Catch ships Consumer and Host as independent store products. Their runtime composition, native identity, Firebase registration, capabilities, links, force-update policy, and release ownership must resolve from one checked contract.",
  "appleNativeDependencies": {
    "firebaseCoreFlutterVersion": "4.15.2",
    "cloudFirestoreFlutterVersion": "6.10.2",
    "firebaseAppleSdkVersion": "12.19.3",
    "podProjects": [
      {
        "podfile": "apps/consumer/ios/Podfile",
        "lockfile": "apps/consumer/ios/Podfile.lock"
      },
      {
        "podfile": "apps/host/ios/Podfile",
        "lockfile": "apps/host/ios/Podfile.lock"
      },
      {
        "podfile": "apps/consumer/macos/Podfile",
        "lockfile": "apps/consumer/macos/Podfile.lock"
      }
    ]
  },
  "releasePolicy": {
    "owner": "github-actions",
    "workflow": ".github/workflows/mobile-internal-release.yml",
    "promotionWorkflow": ".github/workflows/mobile-internal-promote.yml",
    "trigger": "successful-main-ci-exact-artifact-authority",
    "environment": "prod-mobile",
    "approvalMode": "automatic-ios-exact-artifact-internal-promotion",
    "branchPolicy": "main-only",
    "roles": [
      "consumer",
      "host"
    ],
    "ios": {
      "channel": "testflight",
      "artifactMode": "automatic-role-impacted-main",
      "uploadMode": "separate-promotion-workflow",
      "automaticRoles": [
        "consumer",
        "host"
      ],
      "distributionPolicy": "all-existing-internal-groups-with-testers",
      "signingStyle": "automatic",
      "developmentIdentitySource": "reusable-ci-p12",
      "distributionSigningStage": "export",
      "uploadArtifact": "verified-ipa",
      "uploadTool": "altool"
    },
    "android": {
      "channel": "play-internal",
      "track": "qa",
      "artifactMode": "automatic-role-impacted-main",
      "uploadMode": "separate-promotion-workflow",
      "publisherAuth": "github-oidc",
      "publisherServiceAccount": "github-actions-play-publisher@catch-dating-app-64e51.iam.gserviceaccount.com",
      "uploadCertificateSha256": "3088F763A60FD9F7CA99204D6A68EF93A30263A697E563EF883B29DBBC7AE23E"
    }
  },
  "roles": {
    "consumer": {
      "projectRoot": "apps/consumer",
      "entrypoint": "apps/consumer/lib/main.dart",
      "packageEntrypoint": "lib/main.dart",
      "appRoot": "apps/consumer/lib/consumer_platform_app.dart",
      "appWidget": "ConsumerPlatformApp",
      "routerProvider": "consumerGoRouterProvider",
      "shell": "AppShell",
      "initialRoute": "/",
      "iosEntitlements": "ios/Runner/RunnerConsumer.entitlements",
      "androidManifestOverlay": "android/app/src/consumer/AndroidManifest.xml",
      "deepLinks": {
        "policy": "public-event-links",
        "host": "catchdates.com",
        "paths": [
          "/clubs/run-clubs/*"
        ]
      },
      "remoteConfigPrefix": "consumer",
      "storeProduct": {
        "displayName": "Catch",
        "appStoreConnectAppId": "6765646860",
        "testFlightDistributionPolicy": "all-existing-internal-groups-with-testers"
      }
    },
    "host": {
      "projectRoot": "apps/host",
      "entrypoint": "apps/host/lib/main.dart",
      "packageEntrypoint": "lib/main.dart",
      "appRoot": "apps/host/lib/host_platform_app.dart",
      "appWidget": "HostPlatformApp",
      "routerProvider": "hostGoRouterProvider",
      "shell": "HostAppShell",
      "initialRoute": "/host",
      "iosEntitlements": "ios/Runner/RunnerHost.entitlements",
      "androidManifestOverlay": "android/app/src/host/AndroidManifest.xml",
      "deepLinks": {
        "policy": "disabled-until-host-url-contract",
        "host": null,
        "paths": []
      },
      "remoteConfigPrefix": "host",
      "storeProduct": {
        "displayName": "Catch Host",
        "appStoreConnectAppId": "6778927317",
        "testFlightDistributionPolicy": "all-existing-internal-groups-with-testers"
      }
    }
  },
  "environments": {
    "dev": {
      "firebaseProjectId": "catchdates-dev",
      "firebaseProjectNumber": "619661127800"
    },
    "staging": {
      "firebaseProjectId": "catchdates-staging",
      "firebaseProjectNumber": "822303414140"
    },
    "prod": {
      "firebaseProjectId": "catch-dating-app-64e51",
      "firebaseProjectNumber": "574779808785"
    }
  },
