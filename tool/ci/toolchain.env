# Public CI/toolchain version pins. This file is safe to commit; do not put
# secrets or deployment credentials here.
FLUTTER_VERSION=3.47.8
NODE_VERSION=24
JAVA_VERSION=21
FIREBASE_TOOLS_VERSION=15.20.0
COCOAPODS_VERSION=1.16.2
APPLE_CI_RUNNER=macos-26
XCODE_MIN_VERSION=26.2.0
# Terraform CLI for infra/. Equal to required_version in infra/firebase/versions.tf;
# the infra workflows install it, so a mismatch fails terraform init.
TERRAFORM_VERSION=1.16.6
