// Knip finds unused files, exports, types and dependencies, and imports of
// packages a workspace does not declare. tool/audit/check_unused_code.mjs runs
// it as a shrink-only ratchet against tool/audit/unused_code_baseline.json.
// Ignore only what Knip cannot see; real findings belong in the baseline.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        "tool/**/*.{mjs,cjs,js}",
        "operations/**/*.{mjs,cjs,js}",
        "integration_test/**/*.mjs"
      ],
      "project": [
        "tool/**/*.{mjs,cjs,js}",
        "operations/**/*.{mjs,cjs,js}"
      ],
      // The workspaces' Vitest coverage (provider "v8") loads it from the root
      // install; only a whole-repository run can see those workspace configs.
      "ignoreDependencies": ["@vitest/coverage-v8"]
    },
    "admin": {},
    "website": {
      "entry": [
        // Loaded by their HTML document or an embed script tag, not an ESM import.
        "measurement-runtime/catch-acquisition-runtime.js",
        "public/form-embed-resize.js",
        "public/organizer-tracking-runtime.js",
        // Invoked by the Hosting workflow and registered tooling command.
        "scripts/verifyHosting404.mjs",
        // Webpack/Vite replacement modules in next.config.mjs/buildPrivateShell.mjs.
        "scripts/next/publicValidators.mjs",
        "src/features/organizers/emptyData.ts",
        // Included by tsconfig.json to exercise negative compile-time contracts.
        "src/content/interpolate.typecheck.ts"
      ]
    },
    "packages/web-ui": {},
    "packages/web-config": {},
    "functions": {
      "entry": [
        "src/index.ts",
        "src/**/*.test.ts",
        "test/**/*.cjs",
        "scripts/**/*.{cjs,mjs}"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.cjs",
        "scripts/**/*.{cjs,mjs}"
      ],
      "ignoreDependencies": [
        // eslint.config.cjs loads these through FlatCompat's string extends
        // ("plugin:import/...", "google", "plugin:@typescript-eslint/...").
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "eslint-config-google",
        "eslint-plugin-import",
        // tool/contracts/generate_schema_contracts.mjs requires it from
        // functions/node_modules through createRequire.
        "json-schema-to-typescript"
      ]
    }
  },
  "ignore": [
    "**/generated/**",
    "design/**",
    "tool/contracts/generated/**"
  ],
  "ignoreIssues": {
    // Loads firebase-admin, google-auth-library and compiled functions/lib
    // modules through createFunctionsRequire(), rooted at functions/.
    "tool/firebase/form_domain_operator.mjs": ["unlisted", "unresolved"],
    // The Tools lane installs Playwright through its "playwright" setup step.
    "tool/web/check_storybook_visuals.mjs": ["unlisted"]
  },
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "bq",
    "dart",
    "firebase",
    "flutter",
    "gcloud",
    "jar",
    "jarsigner",
    "jq",
    "keytool",
    "mkfifo"
  ],
  // Functions tests require compiled output (../lib/...) built by `npm run build`.
  "ignoreUnresolved": [
    "^(\\.\\./)+lib/"
  ]
}
