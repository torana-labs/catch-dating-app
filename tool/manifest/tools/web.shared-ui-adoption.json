{
  "id": "web:shared-ui-adoption",
  "category": "lint",
  "path": "tool/web/check_shared_web_ui_adoption.mjs",
  "command": "node tool/web/check_shared_web_ui_adoption.mjs --check",
  "surface": "local-writes-repo",
  "status": "active",
  "description": "Validates the cross-React primitive adoption tracker, classifies every exact-name website/admin primitive overlap, and rejects untracked @catch/web-ui exports.",
  "checks": [
    "node --check tool/web/check_shared_web_ui_adoption.mjs",
    "node tool/web/check_shared_web_ui_adoption.mjs --self-test",
    "node tool/web/check_shared_web_ui_adoption.mjs --check"
  ],
  "impactPaths": [
    "tool/web/lib/react_component_graph.mjs",
    "tool/web/lib/react_component_inventory.mjs",
    "tool/web/lib/react_component_inventory_probes.mjs",
    "packages/web-config/**",
    "contracts/**/*.json",
    "tool/contracts/generate_schema_contracts.mjs"
  ],
  "role": "gate",
  "alsoEnforces": [
    "WEB-UI-COMPONENT-001"
  ],
  "ciRequirements": {
    "repositoryView": "full",
    "setup": [
      "node",
      "root-npm"
    ]
