{
  "id": "ci:selection-miss-report",
  "category": "ci",
  "path": "tool/ci/selection_miss_report.mjs",
  "command": "node tool/ci/selection_miss_report.mjs",
  "surface": "remote-write",
  "guard": "none",
  "guardReason": "Opens or comments on the test-selection-miss issue with gh; meant to run only from main-red-alert.yml.",
  "status": "active",
  "ciRequirements": {
    "repositoryView": "full",
    "setup": [
      "node"
    ]
  },
  "impactPaths": [
    ".github/workflows/functions-ci.yml",
    ".github/workflows/main-red-alert.yml",
    "functions/scripts/run-tests.cjs",
    "tool/ci/selection_miss_report.mjs",
    "tool/ci/selection_miss_report.test.mjs",
    "tool/lib/functions_module_graph.mjs",
    "tool/lib/functions_test_selection.mjs",
    "tool/lib/github_issues.mjs",
    "tool/lib/github_issues.test.mjs"
  ],
  "description": "After a failed nightly, checks each failing Functions unit and emulator test against the pull request selection of every commit since the last green nightly, and opens or comments on one 'Test selection missed a failing test' issue for any test none selected. Report-only.",
  "checks": [
    "node --check tool/ci/selection_miss_report.mjs",
    "node --test tool/ci/selection_miss_report.test.mjs"
  ],
  "role": "finder",
  "runbook": "docs/release_operations.md#test-selection-miss-report"
}
