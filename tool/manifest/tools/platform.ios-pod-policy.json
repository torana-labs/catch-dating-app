{
  "id": "platform:ios-pod-policy",
  "category": "platform",
  "path": "tool/platform/sync_ios_pod_policy.mjs",
  "command": "node tool/platform/sync_ios_pod_policy.mjs --write",
  "surface": "local-writes-repo",
  "status": "active",
  "ciRequirements": {
    "repositoryView": "full",
    "setup": [
      "node"
    ]
  },
  "impactPaths": [
    "tool/platform/sync_ios_pod_policy.test.mjs",
    "tool/platform/ios/**",
    "apps/consumer/ios/**",
    "apps/host/ios/**"
  ],
  "description": "Generates self-contained iOS Podfiles and Runner settings from one authored policy while retaining Flutter and CocoaPods freshness detection.",
  "alsoCheckIds": [
    "git:pre-commit-generated-artifacts"
  ],
  "checks": [
    "node --check tool/platform/sync_ios_pod_policy.mjs",
    "node tool/platform/sync_ios_pod_policy.mjs --check",
    "node --test tool/platform/sync_ios_pod_policy.test.mjs"
  ],
  "role": "generator"
}
