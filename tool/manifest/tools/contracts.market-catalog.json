{
  "id": "contracts:market-catalog",
  "category": "contracts",
  "path": "tool/contracts/generate_market_catalog.mjs",
  "command": "node tool/contracts/generate_market_catalog.mjs --check",
  "surface": "local-writes-repo",
  "status": "active",
  "ciRequirements": {
    "repositoryView": "full",
    "setup": [
      "node",
      "functions-npm"
    ]
  },
  "impactPaths": [
    "contracts/catalogs/markets.json",
    "contracts/shared/market_catalog.schema.json",
    "tool/contracts/market_list_allowlist.json",
    "tool/contracts/generate_market_catalog.test.mjs",
    "tool/lib/market_catalog.mjs",
    "tool/lib/location_markets.mjs",
    "functions/src/shared/generated/marketCatalog.ts",
    "packages/kernel/lib/market_catalog.dart",
    "admin/src/shared/config/generated/marketCatalog.ts",
    "firestore.rules",
    "tool/contracts/generate_market_catalog.mjs",
    "website/src/app/routeRegistry.ts"
  ],
  "role": "gate",
  "description": "Keeps contracts/catalogs/markets.json the one source of countries and cities: validates it against contracts/shared/market_catalog.schema.json and its cross-record lifecycle rules, fails when a generated copy (Functions, kernel Dart, admin launch markets, the Firestore rules launch-market block) is stale, and fails when tracked source names three or more catalog cities outside the shrink-only market_list_allowlist.json.",
  "checks": [
    "node --check tool/contracts/generate_market_catalog.mjs",
    "node --test tool/contracts/generate_market_catalog.test.mjs",
    "node tool/contracts/generate_market_catalog.mjs --check"
  ]
}
