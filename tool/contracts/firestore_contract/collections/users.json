{
  "id": "users",
  "path": "users/{uid}",
  "rulesMatch": "/users/{uid}",
  "typescriptInterface": "UserProfileDocument",
  "dartModel": "lib/contexts/profiles/domain/user_profile.dart",
  "rulesTestFile": "functions/test/rules/users.rules.test.cjs",
  "owner": "document id must equal Firebase Auth uid for client writes",
  "writerContext": "profiles",
  "read": "owner only; app-facing user discovery reads publicProfiles",
  "write": "owner initial create; profile edits via updateUserProfile; narrow runtime direct updates only",
  "exportedFunctions": [
    "updateUserProfile",
    "manageWebsiteAccount",
    "requestAccountDeletion",
    "claimParticipantFormProfile"
  ],
  "operations": [
    {
      "id": "owner_initial_create",
      "type": "directCreate",
      "owner": "authenticated owner",
      "allowedFields": [
        "name",
        "firstName",
        "lastName",
        "displayName",
        "dateOfBirth",
        "gender",
        "phoneNumber",
        "profileComplete",
        "email",
        "instagramHandle",
        "profilePrompts",
        "profilePhotos",
        "city",
        "latitude",
        "longitude",
        "interestedInGenders",
        "minAgePreference",
        "maxAgePreference",
        "height",
        "occupation",
        "company",
        "education",
        "religion",
        "languages",
        "relationshipGoal",
        "drinking",
        "smoking",
        "workout",
        "diet",
        "children",
        "activityPreferences",
        "prefsNewCatches",
        "prefsMessages",
        "prefsEventReminders",
        "prefsRunStatusUpdates",
        "prefsOrganizerUpdates",
        "prefsWeeklyDigest",
        "prefsShowOnMap"
      ],
      "deniedFields": [
        "deleted",
        "deletedAt"
      ],
      "rulesTestNames": [
        "allows owners to create the current UserProfile schema without legacy sexualOrientation"
      ]
    },
    {
      "id": "owner_profile_patch",
      "type": "callable",
      "owner": "authenticated owner",
      "function": "updateUserProfile",
      "payloadSchemaRef": "contracts/patches/update_user_profile.schema.json",
      "strictAllowedFieldsMatch": true,
      "allowedFields": [
        "name",
        "displayName",
        "dateOfBirth",
        "gender",
        "profileComplete",
        "email",
        "instagramHandle",
        "profilePrompts",
        "profilePhotos",
        "city",
        "latitude",
        "longitude",
        "interestedInGenders",
        "minAgePreference",
        "maxAgePreference",
        "height",
        "occupation",
        "company",
        "education",
        "religion",
        "languages",
        "relationshipGoal",
        "drinking",
        "smoking",
        "workout",
        "diet",
        "children",
        "activityPreferences",
        "prefsNewCatches",
        "prefsMessages",
        "prefsEventReminders",
        "prefsRunStatusUpdates",
        "prefsOrganizerUpdates",
        "prefsWeeklyDigest",
        "prefsShowOnMap"
      ]
    }
  ],
  "migrationNotes": [
    "Rules, Functions profile updates, and the generated Dart/TypeScript contract no longer allow new sexualOrientation writes.",
    "firstName and lastName are private identity fields initialized during onboarding; displayName is the editable public name written by the updateUserProfile callable.",
    "Global notification category preferences live on users/{uid}; per-organizer push opt-in lives on organizerFollows/{organizerId_uid}.",
    "Event-club membership and saved-event state live in edge collections, not profile arrays."
  ]
}
