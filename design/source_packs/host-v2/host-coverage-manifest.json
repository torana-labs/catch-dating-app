{
  "$schema": "catch.host-shell-coverage/v2",
  "title": "Catch Host shell coverage",
  "updated": "2026-11-07",
  "purpose": "Advisory design and capture coverage for the four persistent Host destinations. Runtime route identity is generated by tool/ui_capture/check_route_inventory.mjs; this manifest does not replace the router, capture catalog, or screen registry.",
  "authority": {
    "routes": "tool/ui_capture/route_inventory.json",
    "captures": "tool/ui_capture/capture_coverage.json",
    "screenRegistry": "design/screens/catch.screens.json",
    "audit": "docs/design_parity/host_shell_route_ui_audit.md",
    "check": "node tool/design/check_host_shell_coverage.mjs"
  },
  "responsiveContract": {
    "compact": "<600: bottom navigation; icon-only with semantic labels at large text",
    "medium": "600-839: 96 px rail with New event and the organizer identity",
    "expanded": ">=840: 240 px sidebar with New event, the organizer identity and the signed-in person; People may compose master-detail panes",
    "masterDetailIndexPaneWidth": 360
  },
  "informationArchitectureDecision": {
    "selectedOption": "today-events-people-organizer",
    "primaryLabels": [
      "Today",
      "Events",
      "People",
      "Organizer"
    ],
    "todayOwnerRouteId": "hostTodayScreen",
    "formsOwnerRouteId": "hostAudienceScreen",
    "audiencesOwnerRouteId": "hostAudienceScreen",
    "inboxWorkspaceOwnerRouteId": "hostInboxScreen",
    "rationaleOwner": "docs/app_architecture.md"
  },
  "primaryRoutes": [
    {
      "destination": "hostToday",
      "routeId": "hostTodayScreen",
      "path": "/host/today",
      "label": "Today",
      "widget": "HostTodayScreen",
      "source": "lib/hosts/today/presentation/host_today_screen.dart",
      "captureId": "host_home_dashboard"
    },
    {
      "destination": "hostEvents",
      "routeId": "hostEventsScreen",
      "path": "/host/events",
      "label": "Events",
      "widget": "HostEventsScreen",
      "source": "lib/hosts/events/presentation/host_events_screen.dart",
      "captureId": "host_home_events_list"
    },
    {
      "destination": "hostPeople",
      "routeId": "hostAudienceScreen",
      "path": "/host/audience",
      "label": "People",
      "widget": "HostCustomersScreen + HostFormsScreen",
      "source": "lib/hosts/presentation/host_audience_view.dart",
      "captureId": "host_customers_populated",
      "otherIndexRouteIds": [
        "hostInboxScreen"
      ]
    },
    {
      "destination": "hostOrganizer",
      "routeId": "hostOrganizerScreen",
      "path": "/host/organizer",
      "label": "Organizer",
      "widget": "HostClubsScreen",
      "source": "lib/hosts/presentation/host_operations/host_organizers_screen.dart",
      "captureId": "host_clubs_management"
    }
  ],
  "legacyRoutes": [
    {
      "routeId": "hostHomeScreen",
      "path": "/host",
      "status": "redirect",
      "canonicalRouteId": "hostTodayScreen"
    },
    {
      "routeId": "hostCustomersLegacyScreen",
      "path": "/host/customers",
      "status": "redirect",
      "canonicalRouteId": "hostAudienceScreen"
    },
    {
      "routeId": "hostFormsLegacyScreen",
      "path": "/host/forms",
      "status": "redirect",
      "canonicalRouteId": "hostAudienceScreen"
    }
  ],
  "notes": [
    "Utility and nested Host routes remain covered by the generated route inventory and capture coverage rather than being duplicated here.",
    "A green shell contract proves ordered destination, route, source, and canonical capture ownership. It does not claim visual parity for uncaptured states."
  ]
}
