              {
                "l": "Prepare template draft"
              }
            ]
          },
          {
            "title": "Claim your organizer first",
            "sub": "Claim your organizer and confirm management access before a draft can be prepared.",
            "btns": [
              {
                "l": "Open organizer claim",
