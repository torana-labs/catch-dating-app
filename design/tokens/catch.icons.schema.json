{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchdates.com/schemas/design/catch.icons.schema.json",
  "title": "Catch icon role catalog",
  "description": "Semantic icon roles shared by Flutter and React. Features name a role; this file maps each role to one glyph of the active icon family.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "updated", "family", "groups", "roles"],
  "properties": {
    "$schema": {"const": "./catch.icons.schema.json"},
    "version": {"const": 1},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "license", "homepage", "strokeWidth", "flutter", "react"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "license": {"type": "string", "minLength": 1},
        "homepage": {"type": "string", "pattern": "^https://"},
        "strokeWidth": {"type": "number", "exclusiveMinimum": 0},
        "flutter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fontFamily", "fontPackage", "fontAsset", "fontSha256", "codepoints"],
          "properties": {
            "fontFamily": {"type": "string", "minLength": 1},
            "fontPackage": {"type": "string", "minLength": 1},
            "fontAsset": {"type": "string", "minLength": 1},
            "fontSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "codepoints": {"type": "string", "minLength": 1}
          }
        },
        "react": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package"],
          "properties": {
            "package": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ui", "activity", "playbook"],
      "properties": {
        "ui": {"type": "string", "minLength": 1},
        "activity": {"type": "string", "minLength": 1},
        "playbook": {"type": "string", "minLength": 1}
      }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][A-Za-z0-9]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "glyph", "description"],
        "properties": {
          "group": {"enum": ["ui", "activity", "playbook"]},
          "glyph": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "platformGlyphs": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "ios": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
            }
          },
          "mirrorInRtl": {"const": true},
          "activityKind": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
