{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "admin.component-fragment.schema.json",
  "title": "Catch Admin Components, one feature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "components"
  ],
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "owner",
          "source",
          "exportName",
          "css",
          "preview",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "route",
              "workspace",
              "shared-primitive",
              "feature-component",
              "provider"
            ]
          },
          "owner": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "exportName": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9_]*$"
          },
          "componentId": {
            "type": "string",
            "pattern": "^catch\\.[a-z0-9_.-]+$",
            "description": "The design/components/catch.components.json contract this export implements as an admin adapter."
          },
          "comparedWith": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^catch\\.[a-z0-9_.-]+$"
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Contracts the React component inventory matched by name or rendering and that this export does not implement."
          },
          "comparisonReason": {
            "type": "string",
            "minLength": 20,
            "description": "The responsibility that differs from every comparedWith contract."
          },
          "interactionContract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "concept",
              "mode"
            ],
            "properties": {
              "concept": {
                "const": "field_row"
              },
              "mode": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]*$"
              }
            }
          },
          "css": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "preview": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "states"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "ready",
                  "planned",
                  "not-required"
                ]
              },
              "story": {
                "type": "string"
              },
              "exportName": {
                "type": "string"
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
