{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "admin.components.schema.json",
  "title": "Catch Admin Component Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "owner",
    "sourceOfTruth",
    "coverage",
    "interactionContractAdoptions"
  ],
  "properties": {
    "$schema": {
      "const": "./admin.components.schema.json"
    },
    "owner": {
      "const": "admin_dashboard"
    },
    "sourceOfTruth": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "previewKinds"
      ],
      "properties": {
        "strategy": {
          "const": "route-workspace-plus-shared-primitives"
        },
        "previewKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "route",
              "workspace",
              "shared-primitive",
              "feature-component",
              "provider"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "interactionContractAdoptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "concept",
          "source",
          "components"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "concept": {
            "const": "field_row"
          },
          "source": {
            "type": "string",
            "pattern": "^admin/src/.+\\.tsx$"
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9_]*$"
            }
          }
        }
      }
    }
  },
  "description": "The registry index. Components live in one file per feature under design/admin/components/; see admin.component-fragment.schema.json."
}
