{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catch.local/design/components/catch.components.schema.json",
  "title": "Catch Component Contract Registry",
  "type": "object",
  "required": ["version", "updated", "sourceOfTruth", "interactionContracts", "roleNounRedirects", "components"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceOfTruth": {
      "type": "object",
      "required": ["behavior", "tokens", "designTools", "handoff"],
      "additionalProperties": false,
      "properties": {
        "behavior": {
          "type": "string"
        },
        "tokens": {
          "type": "string"
        },
        "designTools": {
          "type": "string"
        },
        "handoff": {
          "type": "string"
        }
      }
    },
    "interactionContracts": {
      "type": "object",
      "required": ["field_row", "field_section"],
      "additionalProperties": false,
      "properties": {
        "field_row": {
          "type": "object",
          "required": ["owner", "source", "modes", "slots", "saveStates", "rules"],
          "additionalProperties": false,
          "properties": {
            "owner": {"const": "CatchField"},
            "source": {"const": "packages/catch_ui/lib/src/components/catch_field.dart"},
            "modes": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
              "uniqueItems": true
            },
            "slots": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "uniqueItems": true
            },
            "saveStates": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "uniqueItems": true
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        },
        "field_section": {
          "type": "object",
          "required": ["owner", "source", "variants", "slots", "rules"],
          "additionalProperties": false,
          "properties": {
            "owner": {"const": "CatchSection"},
            "source": {"const": "packages/catch_ui/lib/src/components/catch_section.dart"},
            "variants": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
              "uniqueItems": true
            },
            "slots": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "uniqueItems": true
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        }
      }
    },
    "roleNounRedirects": {
      "type": "object",
      "description": "Nouns agents commonly write that are synonyms of existing role nouns. Naming checks name these targets instead of only rejecting the noun (docs/app_architecture.md Naming Grammar).",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Z][A-Za-z0-9]*$"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/roleNoun"}
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "componentAliases": {
      "type": "array",
      "description": "Other names an agent unaware of this component would plausibly write. The catalog indexes them and the new-widget gate rejects a new widget whose name matches one.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:[A-Z][a-z0-9]*)+$"}
    },
    "componentLevel": {
      "enum": ["L0", "L1", "L2", "L3", "L4", "L4a", "L5", "L6"]
    },
    "roleNoun": {
      "enum": [
        "Button", "Icon", "IconAction", "Field", "FieldLanes", "Section", "SectionList",
        "Tile", "Row", "Chip", "Badge", "Banner", "Sheet", "Dialog",
        "Notice", "EmptyState", "ErrorState", "Skeleton", "Indicator", "TopBar",
        "Header", "HeaderTitle", "Scaffold", "PageBody", "ScrollView", "TabBar",
        "TabScaffold", "Poster", "Polaroid", "Ticket", "Gap", "Inset", "Divider",
        "Avatar", "Photo", "Cover", "Stepper", "StepFlow", "Accordion", "Drawer",
        "Overlay", "Viewport", "Layout", "Action", "Menu", "Surface", "Input", "Text", "Image", "Scope", "AsyncBoundary",
        "Table", "Card", "Body", "List", "Step", "Editor", "Rail", "Picker", "Grid", "Preview", "Dock", "Map", "Pin", "Thumbnail", "Bubble", "Form", "Listener", "Transition"
      ]
    },
    "widgetNaming": {
      "type": "object",
      "required": ["useCase"],
      "additionalProperties": false,
      "properties": {
        "useCase": {
          "type": "string",
          "pattern": "^(?:[A-Z][a-z0-9]*)*$",
          "description": "Reviewed responsibility before the role noun; empty for the base role. The name is derived, never an independent escape from concept identity."
        },
        "comparedWith": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^catch\\.[a-z0-9_.-]+$"}
        },
        "reason": {
          "type": "string",
          "pattern": "\\S",
          "description": "Concrete behavioral, input/output, or anatomy distinction established by source and use-case review. A different implementation or registry id is not a distinction."
        }
      },
      "if": {"properties": {"useCase": {"minLength": 1}}},
      "then": {"required": ["comparedWith", "reason"]}
    },
    "component": {
      "type": "object",
      "oneOf": [
        {
          "required": ["enforcement"],
          "not": {"anyOf": [{"required": ["verification"]}, {"required": ["waiver"]}]}
        },
        {
          "required": ["verification"],
          "not": {"anyOf": [{"required": ["enforcement"]}, {"required": ["waiver"]}]}
        },
        {
          "required": ["waiver"],
          "not": {"anyOf": [{"required": ["enforcement"]}, {"required": ["verification"]}]}
        }
      ],
      "required": [
        "id",
        "name",
        "status",
        "kind",
        "tier",
        "summary",
        "dart",
        "design",
        "contract",
        "governance",
        "handoff"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^catch\\.[a-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["active", "planned", "deprecated"]
        },
        "kind": {
          "enum": ["primitive", "composite", "pattern", "screen-contract"]
        },
        "tier": {
          "enum": ["T1", "T2", "T3", "T4"],
          "description": "Cross-framework parity tier (see design/components/README.md). T1 universal: Flutter and @catch/web-ui now. T2 product: React built in @catch/web-ui on first web need. T3 native-only: Flutter only. T4 surface-specific: one surface owns it."
        },
        "level": {"$ref": "#/$defs/componentLevel"},
        "roleNoun": {"$ref": "#/$defs/roleNoun"},
        "naming": {"$ref": "#/$defs/widgetNaming"},
        "aliases": {"$ref": "#/$defs/componentAliases"},
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "dart": {
          "type": "object",
          "required": ["symbol", "file"],
          "additionalProperties": false,
          "properties": {
            "symbol": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "pattern": "^(?:lib|packages/catch_ui/lib)/.+\\.dart$"
            },
            "constructors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "react": {"$ref": "#/$defs/reactImplementation"},
        "design": {
          "type": "object",
          "required": ["figma", "codeConnect", "claude"],
          "additionalProperties": false,
          "properties": {
            "figma": {
              "type": "object",
              "required": ["status", "componentName", "componentUrl"],
              "additionalProperties": false,
              "properties": {
                "status": {
                  "enum": ["unmapped", "mapped", "planned"]
                },
                "componentName": {
                  "type": "string"
                },
                "componentUrl": {
                  "type": ["string", "null"]
                },
                "propertyProjection": {
                  "type": "object",
                  "required": ["mode", "reviewStates", "properties"],
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "const": "explicit"
                    },
                    "reviewStates": {
                      "enum": ["evidence", "variant"]
                    },
                    "properties": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": ["name", "type", "sourceProps"],
                        "additionalProperties": false,
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "type": {
                            "enum": ["TEXT", "BOOLEAN", "VARIANT", "INSTANCE_SWAP", "SLOT"]
                          },
                          "defaultValue": {
                            "type": ["string", "number", "boolean", "null"]
                          },
                          "variantOptions": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "uniqueItems": true
                          },
                          "sourceProps": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "uniqueItems": true
                          },
                          "notes": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "codeConnect": {
              "type": "object",
              "required": ["status", "snippetLanguage", "template"],
              "additionalProperties": false,
              "properties": {
                "status": {
                  "enum": ["planned", "mapped", "not-applicable"]
                },
                "snippetLanguage": {
                  "type": "string"
                },
                "template": {
                  "type": ["string", "null"]
                }
              }
            },
            "claude": {
              "type": "object",
              "required": ["handoffName", "allowed"],
              "additionalProperties": false,
              "properties": {
                "handoffName": {
                  "type": "string"
                },
                "allowed": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "contract": {
          "type": "object",
          "required": [
            "props",
            "states",
            "slots",
            "tokens",
            "dartRoles",
            "goldens",
            "accessibility"
          ],
          "additionalProperties": false,
          "properties": {
            "props": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/prop"
              }
            },
            "states": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "slots": {
              "type": "array",
              "items": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"$ref": "#/$defs/slot"}
                ]
              }
            },
            "constructorProps": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              }
            },
            "tokens": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]+(?:[A-Za-z0-9_-]*)(\\.[A-Za-z0-9]+(?:[A-Za-z0-9_-]*))*$"
              },
              "uniqueItems": true
            },
            "dartRoles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "goldens": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "accessibility": {
              "$ref": "#/$defs/accessibilityAcceptance"
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/contractMember"
              },
              "uniqueItems": true
            }
          }
        },
        "governance": {
          "type": "object",
          "required": [
            "role",
            "canonicalFamily",
            "conceptRole",
            "publicApi",
            "stateOwnership",
            "asyncOwnership",
            "layoutOwnership",
            "actionOwnership",
            "allowedDependencyLevel",
            "reviewPolicy"
          ],
          "additionalProperties": false,
          "properties": {
            "role": {
              "enum": ["atom", "composition", "pattern", "screen_contract"]
            },
            "canonicalFamily": {
              "type": "string",
              "pattern": "^catch\\.[a-z0-9_.-]+$"
            },
            "conceptRole": {
              "enum": ["concept", "member", "composition", "screen"]
            },
            "conceptId": {
              "type": "string",
              "pattern": "^catch\\.[a-z0-9_.-]+$"
            },
            "parentConceptId": {
              "type": "string",
              "pattern": "^catch\\.[a-z0-9_.-]+$"
            },
            "qualifier": {
              "enum": ["variant", "anatomy", "adapter", "recipe", "layout"]
            },
            "decisionRef": {
              "type": "string",
              "minLength": 1
            },
            "publicApi": {
              "type": "boolean"
            },
            "stateOwnership": {
              "enum": [
                "none",
                "local-ui-only",
                "slot-state-only",
                "display-state-only",
                "screen-owned"
              ]
            },
            "asyncOwnership": {
              "enum": ["none", "display-state-only", "screen-owned"]
            },
            "layoutOwnership": {
              "enum": ["internal-only", "slot-layout", "screen-layout"]
            },
            "actionOwnership": {
              "enum": ["none", "callbacks-only", "route-owned"]
            },
            "allowedDependencyLevel": {
              "enum": [
                "tokens-and-primitives",
                "primitives-and-slots",
                "feature-display-models",
                "route-boundary"
              ]
            },
            "reviewPolicy": {
              "enum": [
                "contract-page-canonical",
                "screen-contract-canonical"
              ]
            }
          }
        },
        "handoff": {
          "type": "object",
          "required": ["allowedChildren", "notes"],
          "additionalProperties": false,
          "properties": {
            "allowedChildren": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "enforcement": {
          "$ref": "#/$defs/enforcement"
        },
        "verification": {
          "$ref": "#/$defs/componentVerification"
        },
        "waiver": {
          "$ref": "#/$defs/enforcementWaiver"
        }
      }
    },
    "accessibilityAcceptance": {
      "type": "object",
      "required": ["largeText", "reducedMotion", "themes"],
      "additionalProperties": false,
      "properties": {
        "largeText": {
          "type": "object",
          "required": ["minimumScale", "policy"],
          "additionalProperties": false,
          "properties": {
            "minimumScale": {
              "type": "number",
              "minimum": 2
            },
            "policy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "reducedMotion": {
          "type": "object",
          "required": ["policy"],
          "additionalProperties": false,
          "properties": {
            "policy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "enum": ["light", "dark"]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "allOf": [
            {"contains": {"const": "light"}},
            {"contains": {"const": "dark"}}
          ]
        }
      }
    },
    "enforcement": {
      "type": "object",
      "required": ["code", "vehicle"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^catch_[a-z0-9_]+$"
        },
        "codes": {
          "type": "array",
          "items": {"type": "string", "pattern": "^catch_[a-z0-9_]+$"},
          "uniqueItems": true
        },
        "vehicle": {
          "enum": ["plugin", "checker", "api"],
          "description": "Implementation vehicle for the primary code. Supplemental codes may map the same component to additional plugin, checker, or API enforcement."
        },
        "replaces": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "replacement": {
          "type": "string",
          "minLength": 1
        },
        "replacementMap": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "steeringGroup": {
          "enum": ["control", "button"]
        },
        "steeringCode": {
          "type": "string",
          "pattern": "^catch_[a-z0-9_]+$"
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedParents": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "slot": {"type": "string", "minLength": 1}
          }
        },
        "states": {
          "type": "array",
          "items": {"enum": ["loading", "error", "empty", "data"]},
          "uniqueItems": true
        },
        "probeSeed": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "enforcementWaiver": {
      "type": "object",
      "required": ["reason", "owner", "expires"],
      "additionalProperties": false,
      "properties": {
        "reason": {"type": "string", "minLength": 12},
        "owner": {"type": "string", "minLength": 1},
        "expires": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "componentVerification": {
      "type": "object",
      "required": ["vehicle", "reason"],
      "additionalProperties": false,
      "properties": {
        "vehicle": {
          "const": "widgetbook-contract",
          "description": "The component's canonical Dart symbol must have a generated Widgetbook contract entry."
        },
        "reason": {"type": "string", "minLength": 12}
      }
    },
    "reactImplementation": {
      "type": "object",
      "description": "The @catch/web-ui implementation of this contract. Surface adapters are recorded in the admin and website registries by componentId.",
      "required": ["symbol", "file", "api"],
      "additionalProperties": false,
      "properties": {
        "symbol": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
        "file": {"type": "string", "pattern": "^packages/web-ui/src/.+\\.tsx$"},
        "api": {
          "enum": ["headless-control", "styled"],
          "description": "headless-control: native semantics only, styled by surface adapters (pre-D10). styled: the D10 Catch* component, whose symbol equals dart.symbol (D9)."
        },
        "additionalSymbols": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "storybook": {
          "type": "object",
          "required": ["status", "story", "exportName", "states"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["ready", "planned"]},
            "story": {"type": "string", "pattern": "^packages/web-ui/src/.+\\.stories\\.tsx$"},
            "exportName": {"type": "string"},
            "states": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
          }
        },
        "notes": {"type": "string"}
      }
    },
    "prop": {
      "type": "object",
      "required": ["name", "type", "required"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "string",
            "bool",
            "enum",
            "callback",
            "widget",
            "color",
            "number",
            "list",
            "generic-list",
            "object"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "type": ["string", "number", "boolean", "null"]
        },
        "dartType": {
          "type": "string"
        },
        "tsType": {
          "type": ["string", "null"],
          "description": "TypeScript type of the prop in the React implementation (blueprint D9). Required on T1 and T2 contracts at L2-L4 and absent elsewhere; null marks a Flutter framework mechanism with no React prop."
        },
        "token": {
          "enum": ["gap", "inset", "space"],
          "description": "The token family whose constant Flutter callers pass (CatchGaps, CatchInsets, CatchSpacing). React takes that token's name instead of a raw length, so tsType is CatchGapSize, CatchInsetPadding or CatchSpacingStep."
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "slot": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "allowedComponents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "contractMember": {
      "type": "object",
      "required": ["id", "symbol", "summary", "states", "governance"],
      "additionalProperties": false,
      "properties": {
        "level": {"$ref": "#/$defs/componentLevel"},
        "roleNoun": {"$ref": "#/$defs/roleNoun"},
        "naming": {"$ref": "#/$defs/widgetNaming"},
        "aliases": {"$ref": "#/$defs/componentAliases"},
        "id": {
          "type": "string",
          "pattern": "^catch\\.[a-z0-9_.-]+$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^(?:lib|packages/catch_ui/lib)/.+\\.dart$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "governance": {
          "$ref": "#/$defs/conceptGovernance"
        }
      }
    },
    "conceptGovernance": {
      "type": "object",
      "required": ["conceptRole", "decisionRef"],
      "additionalProperties": false,
      "properties": {
        "conceptRole": {
          "enum": ["member", "composition", "screen"]
        },
        "conceptId": {
          "type": "string",
          "pattern": "^catch\\.[a-z0-9_.-]+$"
        },
        "parentConceptId": {
          "type": "string",
          "pattern": "^catch\\.[a-z0-9_.-]+$"
        },
        "qualifier": {
          "enum": ["variant", "anatomy", "adapter", "recipe", "layout"]
        },
        "decisionRef": {
