{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catch.app/design/screens/catch.screens.schema.json",
  "title": "Catch screen composition registry",
  "type": "object",
  "required": ["$schema", "version", "updated", "sourceOfTruth", "layoutContracts", "layoutOnlyRoutes", "imperativePageContracts", "screens"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceOfTruth": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "layoutContracts": {
      "description": "Typed layout ownership for registered design screens. Every rendered route in a screen contract must have at least one owner declaration.",
      "type": "object",
      "propertyNames": {
        "pattern": "^screen\\.[a-z0-9_.-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/layoutContract"
      }
    },
    "layoutOnlyRoutes": {
      "description": "Typed layout ownership for rendered routes excluded from baseline design parity. Layout-only routes remain fully governed by the composition gate.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/layoutContract"
      }
    },
    "imperativePageContracts": {
      "description": "Typed layout ownership for full-screen MaterialPageRoute presentation targets outside the named GoRouter graph. Every analyzer-resolved production construction site must name one of these targets.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_$][A-Za-z0-9_$.]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/imperativePageContract"
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/screen"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "layoutExpression": {
      "description": "Canonical layout expressions understood by the executable UI composition checker.",
      "enum": [
        "CatchRootScreenScaffold.standard",
        "CatchRootScreenScaffold.sections",
        "CatchRootScreenScaffold.fullBleed",
        "CatchRootScreenScaffold.withPrimaryRail",
        "CatchRootScreenScrollView.standard",
        "CatchRootScreenScrollView.sections",
        "CatchRootScreenScrollView.fullBleed",
        "CatchRootScreenScrollView.withPrimaryRail",
        "CatchNavigationViewport",
        "CatchRouteScaffold",
        "CatchScaffold.standalone",
        "CatchScaffold.stepFlow",
        "CatchScaffold.workspace",
        "CatchScreen"
      ]
    },
    "layoutContract": {
      "description": "A rendered screen or route declares layout owners; a redirect-only historical screen instead declares canonical alias metadata.",
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["owners"],
          "not": {"required": ["redirectTo"]}
        },
        {
          "required": ["redirectTo"],
          "not": {"required": ["owners"]}
        }
      ],
      "properties": {
        "owners": {
          "description": "Registered layout-bearing declarations. Each owner must be statically reachable from every listed GoRoute presentation target.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/layoutOwner"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "redirectTo": {
          "description": "Canonical-route metadata for a redirect-only alias. The composition gate validates typed target membership; focused router tests prove the actual redirect result.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layoutOwner": {
      "description": "A layout-bearing declaration and expression for one or more rendered routes. Rows may represent state-specific, responsive, adapter, or shared-wrapper alternatives; they identify registered declarations but do not label or exhaust runtime states. Reachability is conservative static analysis, not runtime branch execution.",
      "type": "object",
      "required": [
        "routes",
        "file",
        "symbol",
        "family",
        "expression",
        "bodyGeometry",
        "topEdge"
      ],
      "additionalProperties": false,
      "properties": {
        "routes": {
          "description": "Rendered route IDs whose analyzer-resolved presentation must statically reach this declaration.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "file": {
          "description": "Hand-authored production Dart source containing the named declaration.",
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "description": "Named declaration that contains the registered layout expression.",
          "type": "string",
          "minLength": 1
        },
        "family": {
          "description": "Semantic screen-layout family. Every owner registered for one route must use the same family.",
          "enum": [
            "root",
            "pushed-route",
            "media-hero",
            "immersive",
            "adaptive-workspace",
            "standalone",
            "step-flow"
          ]
        },
        "expression": {
          "description": "Allowed canonical layout expression that must occur in the named declaration.",
          "$ref": "#/$defs/layoutExpression"
        },
        "bodyGeometry": {
          "description": "Declared body geometry. Explicit standard/full-bleed owner arguments are checked where the owner API exposes them; mixed, intrinsic, and unrepresented arguments remain review metadata.",
          "enum": ["standard", "full-bleed", "mixed", "intrinsic"]
        },
        "topEdge": {
          "description": "Declared top-edge ownership. Explicit header-owned arguments are checked where the owner API exposes them; other unrepresented policies remain review metadata.",
          "enum": ["safe-area", "header-owned", "route-chrome", "body-owned"]
        }
      }
    },
    "imperativePageContract": {
      "description": "A full-screen imperative presentation target and every layout-bearing declaration conservatively reachable from each of its MaterialPageRoute builders.",
      "type": "object",
      "required": ["owners", "reason"],
      "additionalProperties": false,
      "properties": {
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/imperativePageOwner"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "imperativePageOwner": {
      "description": "A typed layout-bearing declaration for one imperative page target. Unlike a named-route owner, its binding is supplied by the enclosing target key rather than a routes array.",
      "type": "object",
      "required": [
        "file",
        "symbol",
        "family",
        "expression",
        "bodyGeometry",
        "topEdge"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "Hand-authored production Dart source containing the named declaration.",
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "description": "Named declaration that contains the registered layout expression.",
          "type": "string",
          "minLength": 1
        },
        "family": {
          "description": "Semantic screen-layout family shared by every owner for this presentation target.",
          "enum": [
            "root",
            "pushed-route",
            "media-hero",
            "immersive",
            "adaptive-workspace",
            "standalone",
            "step-flow"
          ]
        },
        "expression": {
          "description": "Allowed canonical layout expression that must occur in the named declaration.",
          "$ref": "#/$defs/layoutExpression"
        },
        "bodyGeometry": {
          "enum": ["standard", "full-bleed", "mixed", "intrinsic"]
        },
        "topEdge": {
          "enum": ["safe-area", "header-owned", "route-chrome", "body-owned"]
        }
      }
    },
    "screen": {
      "type": "object",
      "required": [
        "id",
        "name",
        "owner",
        "priority",
        "status",
        "routes",
        "source",
        "shell",
        "topBar",
        "statePolicy",
        "stateController",
        "designRefs",
        "captures",
        "states",
        "composition",
        "openGaps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^screen\\.[a-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": ["P1", "P2", "P3", "P4"]
        },
        "status": {
          "enum": ["planned", "in_progress", "ready", "blocked"]
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "source": {
          "$ref": "#/$defs/dartBinding"
        },
        "shell": {
          "$ref": "#/$defs/shellPolicy"
        },
        "topBar": {
          "$ref": "#/$defs/topBarPolicy"
        },
        "statePolicy": {
          "$ref": "#/$defs/screenStatePolicy"
        },
        "stateController": {
          "$ref": "#/$defs/stateController"
        },
        "captureIds": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {
                "type": "object",
                "required": ["id", "notes"],
                "additionalProperties": false,
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "notes": {"type": "string", "minLength": 1}
                }
              }
            ]
          }
        },
        "designRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/designRef"
          }
        },
        "captures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/captureRef"
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "composition": {
          "$ref": "#/$defs/composition"
        },
        "openGaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": ["id", "path", "role"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": ["primary", "alias", "host"]
        }
      },
      "additionalProperties": false
    },
    "shellPolicy": {
      "type": "object",
      "required": ["owner", "nestedScaffoldAllowed", "reason"],
      "additionalProperties": false,
      "properties": {
        "owner": {"enum": ["consumer", "host", "standalone"]},
        "nestedScaffoldAllowed": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "topBarPolicy": {
      "type": "object",
      "required": ["role", "expression", "owner", "reason"],
      "additionalProperties": false,
      "properties": {
        "role": {"enum": ["screen", "compact", "identity", "media-hero", "step-flow", "inline", "shell", "none"]},
        "expression": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "screenStatePolicy": {
      "type": "object",
      "required": ["requiredStates", "owner"],
      "additionalProperties": false,
      "properties": {
        "requiredStates": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["loading", "error", "empty", "data", "offline", "permission", "mutation"]},
          "uniqueItems": true
        },
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "dartBinding": {
      "type": "object",
      "required": ["file", "symbol"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "stateController": {
      "type": "object",
      "required": ["primary", "files", "mutationOwners"],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dartBinding"
          }
        },
        "mutationOwners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dartBinding"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "designRef": {
      "type": "object",
      "required": ["id", "kind", "status", "notes"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "kind": {
          "enum": ["claude", "figma", "repo", "external", "generated"]
        },
        "status": {
          "enum": ["available", "needs_export", "planned", "blocked"]
        },
        "path": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "captureRef": {
      "type": "object",
      "required": ["id", "status", "notes"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "status": {
          "enum": ["planned", "captured", "ready", "blocked"]
        },
        "capturedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["id", "kind", "status", "source", "nextAction"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "kind": {
          "enum": [
            "loading",
            "populated",
            "empty",
            "error",
            "offline",
            "permission",
            "mutation",
            "theme",
            "accessibility"
          ]
        },
        "status": {
          "enum": ["planned", "implemented", "captured", "tested", "ready", "blocked"]
        },
        "source": {
          "type": "string"
        },
        "captureIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "previewIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "widgetbook": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "nextAction": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "required": ["currentLayout", "targetLayout", "sections"],
      "properties": {
        "currentLayout": {
          "type": "string"
        },
        "targetLayout": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "layer",
        "claudeComponents",
        "flutter",
        "currentOwner",
        "targetOwner",
        "dependencies",
        "states",
        "migration"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^section\\.[a-z0-9_.-]+$"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "enum": ["registered", "implemented_local", "candidate", "planned", "blocked"]
        },
        "layer": {
          "enum": ["compound", "section", "screen-adapter"]
        },
        "claudeComponents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flutter": {
          "$ref": "#/$defs/dartBinding"
        },
        "currentOwner": {
          "type": "string"
        },
        "targetOwner": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "previewIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "migration": {
          "type": "string"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "required": ["id", "status", "nextAction"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "status": {
          "enum": ["open", "in_progress", "blocked", "closed"]
        },
        "nextAction": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
