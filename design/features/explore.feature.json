{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-10-29",
  "id": "feature.explore",
  "name": "Explore",
  "owner": "explore",
  "status": "pilot",
  "description": "Orchestrates event-first discovery with consent-safe people and organizer interleaves across Flutter, without duplicating owning screen, route, component, data, or preview registries. Marketing web organiser discovery is Explore's organisers view, owned by the Marketing Home visitor discovery surface.",
  "surfaces": [
    {
      "id": "consumer_flutter",
      "runtime": "flutter",
      "authority": {
        "registry": "flutter_screens",
        "id": "screen.explore.discovery"
      },
      "actionScope": {
        "included": "Empty-result recovery actions represented by ExploreDiscoveryEmptyAction plus consent-safe Cross Paths profile-preview, associated-event navigation, and post-booking invitation send.",
        "excluded": [
          "Search entry, city and filter editing, organizer follow/sign-in, map interaction, ordinary event or organizer navigation, and membership mutations retain their existing owners and verification paths."
        ]
      },
      "bindings": {
        "previewSources": [
          "widgetbook/lib/explore/catalog/activity.dart",
          "widgetbook/lib/explore/catalog/cover.dart",
          "widgetbook/lib/explore/catalog/cross_paths.dart",
          "widgetbook/lib/explore/catalog/empty.dart",
          "widgetbook/lib/explore/catalog/feed.dart",
          "widgetbook/lib/explore/catalog/filters.dart",
          "widgetbook/lib/explore/catalog/map.dart",
          "widgetbook/lib/explore/catalog/screen.dart",
          "widgetbook/lib/primitives/catalog/celebration.dart",
          "widgetbook/lib/primitives/catalog/chrome.dart",
          "widgetbook/lib/primitives/catalog/docks.dart",
          "widgetbook/lib/primitives/catalog/event_hero.dart",
          "widgetbook/lib/primitives/catalog/event_information.dart",
          "widgetbook/lib/primitives/catalog/feedback.dart",
          "widgetbook/lib/primitives/catalog/inputs.dart",
          "widgetbook/lib/primitives/catalog/layout.dart",
          "widgetbook/lib/primitives/catalog/loading.dart",
          "widgetbook/lib/primitives/catalog/media.dart",
          "widgetbook/lib/primitives/catalog/menus.dart",
          "widgetbook/lib/primitives/catalog/sections.dart",
          "widgetbook/lib/primitives/catalog/typography.dart"
        ],
        "actionOwners": [
          {
            "id": "empty_recovery",
            "language": "dart",
            "file": "lib/explore/presentation/explore_screen_state.dart",
            "symbol": "ExploreDiscoveryEmptyAction"
          },
          {
            "id": "cross_paths_discovery",
            "language": "dart",
            "file": "lib/cross_paths/presentation/cross_paths_explore_card.dart",
            "symbol": "CrossPathsExploreCard"
          },
          {
            "id": "cross_paths_invitation",
            "language": "dart",
            "file": "lib/cross_paths/presentation/cross_paths_invitation_controller.dart",
            "symbol": "CrossPathsInvitationController"
          }
        ],
        "componentContracts": [
          "catch.button",
          "catch.chip",
          "catch.cover_story",
          "catch.event_card",
          "catch.field",
          "catch.icon_button",
          "catch.person_polaroid",
          "catch.surface",
          "catch.top_bar"
        ],
        "dataContracts": [
          "contracts/firestore/club_memberships.schema.json",
          "contracts/firestore/clubs.schema.json",
          "contracts/firestore/events.schema.json",
          "contracts/firestore/external_events.schema.json",
          "contracts/firestore/organizers.schema.json",
          "contracts/callables/get_cross_paths_suggestions_payload.schema.json",
          "contracts/callable_responses/get_cross_paths_suggestions_response.schema.json",
          "contracts/firestore/cross_paths_invitations.schema.json",
          "contracts/callables/send_cross_paths_invitation_payload.schema.json",
          "contracts/callable_responses/send_cross_paths_invitation_response.schema.json"
        ]
      },
      "dimensions": {
        "surface": {
          "default": "discovery",
          "values": [
            "discovery",
            "map"
          ]
        },
        "load": {
          "default": "ready",
          "values": [
            "ready",
            "loading",
            "error",
            "offline"
          ]
        },
        "content": {
          "default": "populated",
          "values": [
            "populated",
            "empty"
          ]
        },
        "viewer": {
          "default": "member",
          "values": [
            "guest",
            "member"
          ]
        },
        "search": {
          "default": "inactive",
          "values": [
            "inactive",
            "active"
          ]
        },
        "filters": {
          "default": "inactive",
          "values": [
            "inactive",
            "active"
          ]
        },
        "selection": {
          "default": "none",
          "values": [
            "none",
            "pin"
          ]
        },
        "people": {
          "default": "hidden",
          "values": [
            "hidden",
            "suggested"
          ]
        },
        "accessibility": {
          "default": "standard",
          "values": [
            "standard",
            "text_scale_2",
            "reduced_motion"
          ]
        }
      },
      "actions": [
        {
          "id": "clear_search",
          "owner": "empty_recovery",
          "codeValue": "clearSearch",
          "cardinality": "singleton",
          "scopeKeys": [
            "routeInstanceId",
            "queryStateVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "discovery_feed",
                "no_search_results",
                "empty_city"
              ]
            }
          ],
          "description": "Clears the active search term once for the current Explore query state."
        },
        {
          "id": "clear_filters",
          "owner": "empty_recovery",
          "codeValue": "clearFilters",
          "cardinality": "singleton",
          "scopeKeys": [
            "routeInstanceId",
            "filterStateVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "discovery_feed",
                "no_search_results",
                "empty_city"
              ]
            }
          ],
          "description": "Clears active Explore filters once for the current filter state."
        },
        {
          "id": "clear_search_and_filters",
          "owner": "empty_recovery",
          "codeValue": "clearSearchAndFilters",
          "cardinality": "singleton",
          "scopeKeys": [
            "routeInstanceId",
            "queryStateVersion",
            "filterStateVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "discovery_feed",
                "empty_city"
              ]
            }
          ],
          "description": "Clears both search and filters as one recovery transition for the current Explore state."
        },
        {
          "id": "view_cross_paths_profile",
          "owner": "cross_paths_discovery",
          "codeValue": "onProfileSelected",
          "cardinality": "unbounded",
          "scopeKeys": [
            "routeInstanceId",
            "candidateId",
            "eventId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "cross_paths_profile_preview"
              ]
            }
          ],
          "description": "Opens the server-sanitized Cross Paths profile preview for one suggested person without exposing the event roster."
        },
        {
          "id": "open_cross_paths_event",
          "owner": "cross_paths_discovery",
          "codeValue": "onEventSelected",
          "cardinality": "unbounded",
          "scopeKeys": [
            "routeInstanceId",
            "eventId"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.event.detail"
              }
            }
          ],
          "description": "Opens the exact first-party event associated with a consent-safe Cross Paths suggestion."
        },
        {
          "id": "send_cross_paths_invitation",
          "owner": "cross_paths_invitation",
          "codeValue": "send",
          "cardinality": "domain_bounded",
          "scopeKeys": [
            "senderUid",
            "eventId",
            "suggestionTokenVersion"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.cross_paths.invitation"
              }
            }
          ],
          "description": "After a confirmed booking and final confirmation, sends the sender's one event-scoped invitation through the revalidating callable."
        }
      ],
      "scenarios": [
        {
          "id": "loading",
          "stateId": "loading",
          "dimensions": {
            "load": "loading"
          },
          "actionCases": [
            {
              "id": "default"
            }
          ]
        },
        {
          "id": "club_source_error",
          "stateId": "club_source_error",
          "dimensions": {
            "load": "error"
          },
          "actionCases": [
            {
              "id": "default"
            }
          ]
        },
        {
          "id": "event_feed_error",
          "stateId": "event_feed_error",
          "dimensions": {
            "load": "error"
          },
          "actionCases": [
            {
              "id": "default"
            }
          ]
        },
        {
          "id": "empty_city",
          "stateId": "empty_city",
          "dimensions": {
            "content": "empty"
          },
          "actionCases": [
            {
              "id": "default"
            }
          ]
        },
        {
          "id": "no_search_results",
          "stateId": "no_search_results",
          "dimensions": {
            "content": "empty"
          },
          "actionCases": [
            {
              "id": "search_only",
              "dimensions": {
                "search": "active"
              },
              "enabledActions": [
                "clear_search"
              ]
            },
            {
              "id": "filters_only",
              "dimensions": {
                "filters": "active"
              },
              "enabledActions": [
                "clear_filters"
              ]
            },
            {
              "id": "search_and_filters",
              "dimensions": {
                "search": "active",
                "filters": "active"
              },
              "enabledActions": [
                "clear_search_and_filters"
              ]
            }
          ]
        },
        {
          "id": "discovery_feed",
          "stateId": "discovery_feed",
          "dimensions": {},
          "actionCases": [
            {
              "id": "default"
            }
          ]
        },
        {
          "id": "cross_paths_suggestion",
          "stateId": "cross_paths_suggestion",
          "dimensions": {
            "people": "suggested"
          },
          "actionCases": [
            {
              "id": "bookable_event",
              "enabledActions": [
                "view_cross_paths_profile",
                "open_cross_paths_event"
              ]
            }
          ]
        },
        {
          "id": "cross_paths_profile_preview",
          "stateId": "cross_paths_profile_preview",
          "dimensions": {
            "people": "suggested"
          },
          "actionCases": [
            {
              "id": "associated_event",
              "enabledActions": [
                "open_cross_paths_event"
              ]
            },
            {
              "id": "booked_invitation_ready",
              "enabledActions": [
                "open_cross_paths_event",
                "send_cross_paths_invitation"
              ]
            }
          ]
        },
        {
          "id": "search_query",
          "stateId": "search_query",
          "dimensions": {
            "search": "active"
          },
          "actionCases": [
            {
              "id": "default"
            }
          ]
        },
        {
