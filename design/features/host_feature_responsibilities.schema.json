{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catch.app/design/features/host_feature_responsibilities.schema.json",
  "title": "Host top-level feature responsibility contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "updated",
    "owner",
    "sourceOfTruth",
    "features"
  ],
  "properties": {
    "$schema": {
      "const": "./host_feature_responsibilities.schema.json"
    },
    "version": {
      "const": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "owner": {
      "const": "hosts"
    },
    "sourceOfTruth": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "updated",
        "sections",
        "facts"
      ],
      "properties": {
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/guideSection"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guideFact"
          }
        }
      }
    },
    "guidePath": {
      "type": "string",
      "pattern": "^(lib|functions|contracts|test|tool|design)/[^\\s]+$"
    },
    "guideSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "aliases",
        "answer",
        "sourcePaths",
        "examples"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "sourcePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/guidePath"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "testName"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/guidePath"
              },
              "testName": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "guideFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path",
        "pointer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/guidePath"
        },
        "pointer": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repoPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(lib|test|contracts|design)/.+"
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "destination",
        "primaryRouteId",
        "ownedRouteIds",
        "handoffRouteIds",
        "targetRoot",
        "migrationStatus",
        "purpose",
        "responsibilities",
        "doesNotOwn",
        "currentRoots",
        "additionalCodeOwners",
        "additionalDataContracts",
        "sharedDependencies",
        "testFiles"
      ],
      "properties": {
        "id": {
          "enum": [
            "today",
            "events",
            "audience",
            "inbox",
            "organizer"
          ]
        },
        "destination": {
          "pattern": "^host[A-Z][A-Za-z0-9]+$"
        },
        "primaryRouteId": {
          "pattern": "^host[A-Z][A-Za-z0-9]+Screen$"
        },
        "ownedRouteIds": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "handoffRouteIds": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "targetRoot": {
          "pattern": "^lib/hosts/(today|events|audience|inbox|organizer)$"
        },
        "migrationStatus": {
          "enum": [
            "verticalSlice",
            "targetDefinedLegacyImplementation"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "responsibilities": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "doesNotOwn": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "currentRoots": {
          "$ref": "#/$defs/repoPaths"
        },
        "additionalCodeOwners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/codeOwner"
          }
        },
        "additionalDataContracts": {
          "$ref": "#/$defs/repoPaths"
        },
        "sharedDependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sharedDependency"
          }
        },
        "testFiles": {
          "$ref": "#/$defs/repoPaths"
        },
        "guide": {
          "$ref": "#/$defs/guide"
        }
      }
    },
    "codeOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "symbol",
        "role"
      ],
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "file": {
          "pattern": "^lib/.+\\.dart$"
        },
        "symbol": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sharedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "pattern": "^(lib|contracts|design)/.+"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
