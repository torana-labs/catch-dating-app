{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-09-14",
  "id": "feature.account_settings",
  "name": "Account Settings",
  "owner": "safety",
  "status": "pilot",
  "description": "Orchestrates account identity display, history navigation, notification and visibility preferences, blocked-account recovery and mutation, legal/support links, account deletion, and sign out.",
  "surfaces": [
    {
      "id": "consumer_flutter",
      "runtime": "flutter",
      "authority": {
        "registry": "flutter_screens",
        "id": "screen.settings.account"
      },
      "actionScope": {
        "included": "Profile and blocked-account recovery; review/payment history and host-app navigation; bounded preference changes; unblock, delete-account, and sign-out mutations; and configured privacy, support, and terms links.",
        "excluded": [
          "Phone, email, version, visibility-copy, blocked-count, profile formatting, and blocked-profile enrichment are display projections rather than user actions."
        ]
      },
      "bindings": {
        "previewSources": [
          "widgetbook/lib/utility/settings.dart",
          "widgetbook/lib/primitives/contracts/buttons.dart",
          "widgetbook/lib/primitives/contracts/chrome.dart",
          "widgetbook/lib/primitives/contracts/dialogs.dart",
          "widgetbook/lib/primitives/contracts/feedback.dart",
          "widgetbook/lib/primitives/contracts/field.dart",
          "widgetbook/lib/primitives/contracts/inputs.dart",
          "widgetbook/lib/primitives/contracts/messages.dart",
          "widgetbook/lib/primitives/contracts/surfaces.dart"
        ],
        "actionOwners": [
          {
            "id": "settings_screen",
            "language": "dart",
            "file": "lib/safety/presentation/settings_screen.dart",
            "symbol": "SettingsScreen"
          },
          {
            "id": "settings_controller",
            "language": "dart",
            "file": "lib/safety/presentation/settings_controller.dart",
            "symbol": "SettingsController"
          },
          {
            "id": "auth_session",
            "language": "dart",
            "file": "lib/auth/presentation/auth_session_controller.dart",
            "symbol": "AuthSessionController"
          },
          {
            "id": "external_links",
            "language": "dart",
            "file": "lib/platform/device/external_links.dart",
            "symbol": "ExternalLinkController"
          }
        ],
        "componentContracts": [
          "catch.button",
          "catch.confirm_dialog",
          "catch.empty_state",
          "catch.error_state",
          "catch.field",
          "catch.surface",
          "catch.toggle",
          "catch.top_bar"
        ],
        "dataContracts": [
          "contracts/firestore/blocks.schema.json",
          "contracts/firestore/deleted_users.schema.json",
          "contracts/firestore/public_profiles.schema.json",
          "contracts/firestore/users.schema.json",
          "contracts/patches/update_user_profile.schema.json"
        ]
      },
      "dimensions": {
        "profile": {
          "default": "ready",
          "values": [
            "loading",
            "error",
            "missing",
            "ready"
          ]
        },
        "blocked_accounts": {
          "default": "empty",
          "values": [
            "loading",
            "error",
            "empty",
            "content"
          ]
        },
        "mutation": {
          "default": "idle",
          "values": [
            "idle",
            "preference_pending",
            "preference_error",
            "unblock_pending",
            "unblock_error",
            "delete_confirm",
            "delete_pending",
            "delete_error",
            "sign_out_pending",
            "sign_out_error"
          ]
        },
        "external_link": {
          "default": "idle",
          "values": [
            "idle",
            "pending",
            "failure"
          ]
        },
        "connectivity": {
          "default": "online",
          "values": [
            "online",
            "offline"
          ]
        },
        "accessibility": {
          "default": "standard",
          "values": [
            "standard",
            "text_scale_2",
            "reduced_motion"
          ]
        },
        "theme": {
          "default": "standard",
          "values": [
            "standard",
            "light_dark"
          ]
        }
      },
      "actions": [
        {
          "id": "close_settings",
          "owner": "settings_screen",
          "codeValue": "back",
          "cardinality": "singleton",
          "scopeKeys": [
            "routeInstanceId"
          ],
          "outcomes": [
            {
              "kind": "side_effect",
              "id": "navigation.route_popped"
            }
          ],
          "description": "Closes Account Settings through its canonical top-bar back control."
        },
        {
          "id": "retry_profile",
          "owner": "settings_screen",
          "codeValue": "watchUserProfileProvider",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "profileLoadGeneration"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "profile_loading",
                "profile_error",
                "profile_missing",
                "profile_backed_account"
              ]
            }
          ],
          "description": "Invalidates the current profile provider from the inline account-status recovery surface."
        },
        {
          "id": "open_review_history",
          "owner": "settings_screen",
          "codeValue": "reviewsHistoryScreen",
          "cardinality": "unbounded",
          "scopeKeys": [
            "routeInstanceId"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.reviews.history"
              }
            }
          ],
          "description": "Opens the current member's Review History."
        },
        {
          "id": "open_payment_history",
          "owner": "settings_screen",
          "codeValue": "paymentHistoryScreen",
          "cardinality": "unbounded",
          "scopeKeys": [
            "routeInstanceId"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.payments.history"
              }
            }
          ],
          "description": "Opens the current member's Payment History."
        },
        {
          "id": "open_host_app",
          "owner": "external_links",
          "codeValue": "openHostApp",
          "cardinality": "singleton",
          "scopeKeys": [
            "routeInstanceId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "external_link_outcomes"
              ]
            },
            {
              "kind": "side_effect",
              "id": "external_links.open_host_app"
            }
          ],
          "description": "Requests the configured external Catch Host handoff with whole-surface pending exclusivity and visible false/error feedback."
        },
        {
          "id": "set_preference",
          "owner": "settings_controller",
          "codeValue": "savePreference",
          "cardinality": "domain_bounded",
          "scopeKeys": [
            "viewerUid",
            "preference",
            "value",
            "preferenceVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "notification_preferences",
                "preference_save_error",
                "privacy_safety_defaults"
              ]
            },
            {
              "kind": "side_effect",
              "id": "user_profile.update_preference"
            }
          ],
          "description": "Optimistically changes one supported notification, map-visibility, or feature-gated global Cross Paths preference and rolls back on failure."
        },
        {
          "id": "retry_blocked_accounts",
          "owner": "settings_screen",
          "codeValue": "watchBlockedUsersProvider",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "blockedAccountLoadGeneration"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "blocked_accounts_loading_error",
                "blocked_accounts_empty",
                "blocked_accounts_list"
              ]
            }
          ],
          "description": "Invalidates the blocked-account provider after a list or profile-enrichment failure."
        },
        {
          "id": "unblock_account",
          "owner": "settings_controller",
          "codeValue": "unblockUser",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "targetUserId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "blocked_accounts_list",
                "blocked_accounts_empty",
                "unblock_mutation"
              ]
            },
            {
              "kind": "side_effect",
              "id": "safety.unblock_user"
            }
          ],
          "description": "Removes one selected account from the current member's block list."
        },
        {
          "id": "open_privacy_policy",
          "owner": "external_links",
          "codeValue": "openExternal",
          "cardinality": "singleton",
          "scopeKeys": [
            "routeInstanceId",
            "privacyPolicyUri"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "external_link_outcomes"
              ]
            },
            {
              "kind": "side_effect",
              "id": "external_links.open_privacy_policy"
            }
          ],
          "description": "Requests the configured privacy-policy URL when present with whole-surface pending exclusivity and visible false/error feedback."
        },
        {
          "id": "request_account_deletion",
          "owner": "settings_controller",
          "codeValue": "requestAccountDeletion",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "accountVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "delete_account_flow"
              ]
            },
            {
              "kind": "side_effect",
              "id": "safety.request_account_deletion"
            }
          ],
          "description": "Opens the destructive confirmation and requests deletion after explicit confirmation."
        },
        {
          "id": "open_help_support",
          "owner": "external_links",
          "codeValue": "openExternal",
          "cardinality": "singleton",
          "scopeKeys": [
            "routeInstanceId",
            "helpUri"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "external_link_outcomes"
              ]
            },
            {
              "kind": "side_effect",
              "id": "external_links.open_help"
            }
          ],
          "description": "Requests the configured help and support URL when present with whole-surface pending exclusivity and visible false/error feedback."
        },
        {
          "id": "open_terms",
          "owner": "external_links",
          "codeValue": "openExternal",
          "cardinality": "singleton",
          "scopeKeys": [
            "routeInstanceId",
            "termsUri"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "external_link_outcomes"
              ]
            },
            {
              "kind": "side_effect",
              "id": "external_links.open_terms"
            }
          ],
          "description": "Requests the configured terms URL when present with whole-surface pending exclusivity and visible false/error feedback."
        },
        {
          "id": "sign_out",
          "owner": "auth_session",
          "codeValue": "signOut",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "authSessionVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "sign_out_action"
              ]
            },
            {
              "kind": "side_effect",
              "id": "auth.sign_out"
            }
          ],
          "description": "Signs out the current account through the shared auth-session mutation."
        }
      ],
