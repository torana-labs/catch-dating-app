            "admin/src/app/App.mutationSession.test.tsx"
          ],
          "route-lazy-boundary": [
            "admin/src/features/settings/controllers/useTeamController.test.tsx",
            "admin/src/app/App.mutationSession.test.tsx"
          ]
        }
      },
      "dimensions": {
        "boundary": {
          "default": "resolved",
          "values": [
            "resolved",
            "loading"
          ]
        }
      },
      "actions": [
        {
          "id": "render_live_route",
          "owner": "route",
          "codeValue": "SettingsRouteScreen",
          "cardinality": "unbounded",
          "scopeKeys": [
            "adminSessionId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "live-query-wrapper"
              ]
            }
          ],
          "description": "Renders the prop-driven screen from its live controller."
        }
      ],
      "scenarios": [
        {
          "id": "live_query_wrapper",
          "stateId": "live-query-wrapper",
          "dimensions": {},
          "actionCases": [
