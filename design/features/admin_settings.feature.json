          "dimensions": {
            "boundary": "loading"
          },
          "actionCases": [
            {
              "id": "lazy_loading"
            }
          ]
        }
      ],
      "requiredEvidence": {
        "captures": false,
        "previews": false,
        "tests": true
      }
    },
