{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-11-01",
  "id": "feature.admin_settings",
  "name": "Admin Settings",
  "owner": "admin_console",
  "status": "pilot",
  "description": "Lists the settings pages and opens one beside them: Team and roles (three jobs, invite by user id, audited role changes) and Settings → Safety (rules, reasons, deadlines; owner edits).",
  "surfaces": [
    {
      "id": "admin_settings",
      "runtime": "react_admin",
      "authority": {
        "registry": "admin_routes",
        "id": "route_settings"
      },
      "actionScope": {
        "included": "Opening a settings page, opening a team member or inviting by user id, choosing their job and saving it with a review note.",
        "excluded": [
          "Other areas' settings pages are drawn by those areas."
        ]
      },
      "bindings": {
        "previewSources": [
          "admin/src/stories/AdminRoutes.stories.tsx"
        ],
        "actionOwners": [
          {
            "id": "team",
            "language": "typescript",
            "file": "admin/src/features/settings/controllers/useTeamController.ts",
            "symbol": "useTeamController"
          },
          {
            "id": "screen",
            "language": "typescript",
            "file": "admin/src/features/settings/ui/SettingsScreen.tsx",
            "symbol": "SettingsScreen"
          },
          {
            "id": "workspace",
            "language": "typescript",
            "file": "admin/src/features/settings/ui/TeamSettingsWorkspace.tsx",
            "symbol": "TeamSettingsWorkspace"
          }
        ],
        "componentContracts": [
          "route_settings",
          "workspace_team_settings"
        ],
        "dataContracts": [],
        "runtimeContracts": [
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminListAdminRoleAssignments",
            "requestValidation": "strict_schema",
            "responseValidation": "structural_object"
          },
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminGetAdminUserRoles",
            "requestValidation": "strict_schema",
            "responseValidation": "structural_object"
          },
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminSetAdminUserRoles",
            "requestValidation": "strict_schema",
            "responseValidation": "strict_schema"
          }
        ],
        "testEvidence": {
          "team": [
            "admin/src/features/settings/controllers/useTeamController.test.tsx"
          ],
          "role-change": [
            "admin/src/features/settings/controllers/useTeamController.test.tsx",
            "admin/src/app/App.mutationSession.test.tsx"
          ]
        }
      },
      "dimensions": {
        "save": {
          "default": "idle",
          "values": [
            "idle",
            "pending"
          ]
        }
      },
      "actions": [
        {
          "id": "open_settings_page",
          "owner": "screen",
          "codeValue": "onSelectPage",
          "cardinality": "unbounded",
          "scopeKeys": [
            "adminSessionId",
            "page"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "team"
              ]
            }
          ],
          "description": "Opens a settings page beside the list."
        },
        {
          "id": "open_team_member",
          "owner": "workspace",
          "codeValue": "onOpenPerson",
          "cardinality": "unbounded",
          "scopeKeys": [
            "adminSessionId",
            "uid"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "role-change"
              ]
            }
          ],
          "description": "Opens someone's job, or invites them by user id."
        },
        {
          "id": "save_role_change",
          "owner": "team",
          "codeValue": "save",
          "cardinality": "singleton",
          "scopeKeys": [
            "adminSessionId",
            "targetUid"
          ],
          "outcomes": [
            {
              "kind": "side_effect",
              "id": "admin.role_change_saved"
            }
          ],
          "description": "Saves the chosen job with a review note."
        }
      ],
      "scenarios": [
        {
          "id": "team",
          "stateId": "team",
          "dimensions": {},
          "actionCases": [
            {
              "id": "ready",
              "enabledActions": [
                "open_settings_page",
                "open_team_member"
              ]
            }
          ]
        },
        {
          "id": "role_change",
          "stateId": "role-change",
          "dimensions": {},
          "actionCases": [
            {
              "id": "ready",
              "enabledActions": [
                "save_role_change"
              ]
            },
            {
              "id": "save_pending_frozen_workspace",
              "dimensions": {
                "save": "pending"
              },
              "disabledActions": [
                "save_role_change",
                "open_team_member"
              ]
            }
          ]
        }
      ],
      "requiredEvidence": {
        "captures": false,
        "previews": true,
        "tests": true
      }
    },
    {
