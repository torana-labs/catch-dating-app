{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-09-04",
  "id": "feature.host_home",
  "name": "Host Today and Events",
  "owner": "hosts",
  "status": "pilot",
  "description": "Contract covering the independently routed Host Today command centre and Host Events inventory. Today owns operational spotlight, attention policy, and Dress Rehearsal entry through its bounded feed controller; Events owns sticky Upcoming/Past navigation, day-grouped upcoming and month-grouped past records, independently paginated lanes, create and repeat entry, and lifecycle-aware manage navigation.",
  "surfaces": [
    {
      "id": "host_flutter",
      "runtime": "flutter",
      "authority": {
        "registry": "flutter_screens",
        "id": "screen.host.home"
      },
      "actionScope": {
        "included": "Host Today authentication recovery, operational spotlight, attention work, and Dress Rehearsal entry; Host Events paginated schedule and history loading and retry; shared organizer switching; and typed create, repeat, manage, and task navigation.",
        "excluded": [
          "Organizer editing, event creation internals, event management mutations, booking policy, analytics, payouts, and host-team administration retain their owning feature contracts or controllers."
        ]
      },
      "bindings": {
        "previewSources": [
          "widgetbook/lib/hosts/operations/home_routes.dart"
        ],
