      "actions": [
        {
          "id": "sign_in",
          "owner": "today_route",
          "codeValue": "go",
          "cardinality": "singleton",
          "scopeKeys": [
            "routeInstanceId",
            "authSessionId"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.auth.phone_entry"
              }
            }
          ],
          "description": "Leaves the signed-out host state for the shared phone authentication route."
        },
        {
          "id": "retry_host_home",
          "owner": "events_route",
          "codeValue": "invalidate",
          "cardinality": "singleton",
          "scopeKeys": [
            "routeInstanceId",
            "retryTarget",
            "failureStateVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "host_clubs_loading",
                "one_owned_club",
                "multiple_clubs_switcher",
                "no_host_clubs"
              ]
            }
          ],
          "description": "Invalidates only the failed authentication or hosted-organizer provider for the current route failure."
        },
        {
          "id": "retry_host_events",
          "owner": "events_list",
          "codeValue": "invalidate",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "clubId",
            "failureStateVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "club_events_loading",
                "upcoming_events",
                "empty_events"
              ]
            }
          ],
          "description": "Invalidates the selected organizer's paginated event timeline after its initial load fails."
        },
        {
          "id": "create_organizer",
          "owner": "workspace",
          "codeValue": "hostCreateOrganizerScreen",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "routeInstanceId",
            "emptyStateVersion"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.host.club.create"
              }
            }
          ],
          "description": "Opens Host Create Organizer from the no-organizers state."
        },
        {
          "id": "switch_organizer",
          "owner": "host_shell",
          "codeValue": "_openOrganizerSwitcher",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "routeInstanceId",
            "clubId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "multiple_clubs_switcher",
                "cohost_role",
                "upcoming_events",
                "empty_events"
              ]
            }
          ],
          "description": "Long-presses the Organizer navigation avatar, provides haptic feedback, and switches the global Host scope to another organizer the viewer hosts."
        },
        {
          "id": "load_more_schedule",
          "owner": "events_timeline",
          "codeValue": "loadMoreActive",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "clubId",
            "sessionBoundary",
            "activeCursor"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "upcoming_events",
                "event_schedule_paginating"
              ]
            }
          ],
          "description": "Loads and event-id de-duplicates the next live-or-future schedule page without replacing the current timeline."
        },
        {
          "id": "load_more_history",
          "owner": "events_timeline",
          "codeValue": "loadMorePast",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "clubId",
            "sessionBoundary",
            "pastCursor"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "upcoming_events",
                "event_history_paginating",
                "event_history_error"
              ]
            }
          ],
          "description": "Loads and event-id de-duplicates the next completed-event history page without replacing the visible schedule."
        },
        {
          "id": "retry_event_history",
          "owner": "events_timeline",
          "codeValue": "retryPast",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "clubId",
            "sessionBoundary",
            "failureStateVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "upcoming_events",
                "event_history_error"
              ]
            }
          ],
          "description": "Retries the failed completed-event history cursor, or the initial page if no history has loaded, while preserving both lanes and concurrent schedule progress."
        },
        {
          "id": "create_event",
          "owner": "event_entry_flow",
          "codeValue": "_openCreateEvent",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "clubId",
            "tapAttemptId"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.host.event.create"
              }
            }
          ],
          "description": "After the event-entry choice, opens Host Event Create with the selected organizer and its booking mode."
        },
        {
          "id": "repeat_event",
          "owner": "event_entry_flow",
          "codeValue": "_openRepeatEvent",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "clubId",
            "eventId",
            "tapAttemptId"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.host.event.create"
              }
            }
          ],
          "description": "After the event-entry choice, opens Host Event Create with a policy-gated repeat prefill from the latest eligible event."
        },
        {
          "id": "manage_event",
          "owner": "workspace",
          "codeValue": "_openEvent",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "clubId",
            "eventId",
            "tapAttemptId"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.host.event.manage"
              }
            }
          ],
          "description": "Opens Host Event Manage for a selected lifecycle-list event."
        },
        {
          "id": "open_operational_event",
          "owner": "today_route",
          "codeValue": "_openEvent",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "clubId",
            "eventId",
            "eventClockState"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.host.event.manage"
              }
            }
          ],
          "description": "Opens the operational spotlight in its live, setup, or report Host Manage section based on the current event clock."
        },
        {
          "id": "open_attention_task",
          "owner": "today_route",
          "codeValue": "_openAttention",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "clubId",
            "eventId",
            "taskDestination"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.host.event.manage"
              }
            },
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.host.applications"
              }
            },
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.host.clubs"
              }
            },
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.host.customers"
              }
            },
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.host.inbox"
              }
            },
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.host.event.rehearsal"
              }
            },
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.host.home"
              }
            }
          ],
          "description": "Routes an authoritative attention item through its typed destination to Event Manage, Applications, Payouts, Audience, Inbox, Dress Rehearsal, or Events."
        },
        {
          "id": "start_dress_rehearsal",
          "owner": "today_route",
          "codeValue": "_startRehearsal",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "clubId",
            "tapAttemptId"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.host.event.rehearsal"
              }
            }
          ],
          "description": "Starts the isolated Dress Rehearsal flow from Today as an operational-preparation action, not as an event-creation choice."
        },
        {
          "id": "open_program",
          "owner": "events_list",
          "codeValue": "onOpenProgram",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "clubId",
            "tapAttemptId"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.programs.workspace"
              }
            }
          ],
          "description": "Opens the existing program workspace from one identifiable date-range/count row in Events."
        }
