{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-11-01",
  "id": "feature.admin_event_publishing",
  "name": "Admin Event Publishing",
  "owner": "admin_console",
  "status": "pilot",
  "description": "The editors the event page hosts: canonical event editing on its Page tab and external-event inspection and takedown on its Takedown tab. The Events directory lists events.",
  "surfaces": [
    {
      "id": "admin_web",
      "runtime": "react_admin",
      "authority": {"registry": "admin_routes", "id": "route_event_publishing"},
      "actionScope": {
        "included": "Loading a canonical event or external evidence, returning to the Events directory, refreshing the external source, saving canonical edits, and freezing the complete Admin workspace during the write.",
        "excluded": [
          "Search, filter, editor field, checklist, and review-note changes remain query or form data."
        ]
      },
      "bindings": {
        "previewSources": ["admin/src/stories/AdminRoutes.stories.tsx"],
        "actionOwners": [
          {"id": "controller", "language": "typescript", "file": "admin/src/features/events/controllers/useEventPublishingController.ts", "symbol": "useEventPublishingController"},
          {"id": "screen", "language": "typescript", "file": "admin/src/features/events/ui/EventPublishingScreen.tsx", "symbol": "EventPublishingWorkspace"}
        ],
        "componentContracts": ["route_event_publishing"],
        "dataContracts": [
          "contracts/callables/admin_list_event_details_payload.schema.json",
          "contracts/callables/admin_get_event_details_payload.schema.json",
          "contracts/callables/admin_update_event_details_payload.schema.json",
          "contracts/callables/admin_list_external_event_details_payload.schema.json",
          "contracts/firestore/events.schema.json",
          "contracts/firestore/external_events.schema.json"
        ],
        "runtimeContracts": [
          {"kind": "admin_callable", "registry": "admin/src/generated/validators/adminCallableValidators.ts", "callable": "adminListEventDetails", "requestValidation": "strict_schema", "responseValidation": "structural_object"},
          {"kind": "admin_callable", "registry": "admin/src/generated/validators/adminCallableValidators.ts", "callable": "adminGetEventDetails", "requestValidation": "strict_schema", "responseValidation": "structural_object"},
          {"kind": "admin_callable", "registry": "admin/src/generated/validators/adminCallableValidators.ts", "callable": "adminUpdateEventDetails", "requestValidation": "strict_schema", "responseValidation": "structural_object"},
          {"kind": "admin_callable", "registry": "admin/src/generated/validators/adminCallableValidators.ts", "callable": "adminListExternalEventDetails", "requestValidation": "strict_schema", "responseValidation": "structural_object"}
        ],
        "testEvidence": {
          "canonical-detail": [
            "admin/src/features/events/controllers/useEventPublishingController.test.tsx",
            "admin/src/shared/pendingOperation.test.tsx"
          ]
        }
      },
      "dimensions": {
        "workspace": {"default": "canonical_detail", "values": ["canonical_detail", "external_detail"]},
        "source": {"default": "ready", "values": ["ready", "loading", "failed", "unavailable"]},
        "mutation": {"default": "idle", "values": ["idle", "pending", "failed", "success"]}
      },
      "actions": [
        {"id": "select_canonical_event", "owner": "controller", "codeValue": "selectEvent", "cardinality": "unbounded", "scopeKeys": ["adminSessionId", "eventId"], "outcomes": [{"kind": "surface_state", "stateIds": ["canonical-detail"]}], "description": "Loads one exact canonical event for detail and governed editing."},
        {"id": "back_to_event_list", "owner": "controller", "codeValue": "backToList", "cardinality": "unbounded", "scopeKeys": ["adminSessionId", "eventId"], "outcomes": [{"kind": "surface_state", "stateIds": ["canonical-detail"]}], "description": "Returns from the canonical editor to the Events directory."},
        {"id": "save_canonical_event", "owner": "controller", "codeValue": "save", "cardinality": "singleton", "scopeKeys": ["reviewerUid", "eventId", "editorDraftVersion"], "outcomes": [{"kind": "surface_state", "stateIds": ["canonical-detail"]}, {"kind": "side_effect", "id": "admin.event_details_saved"}], "description": "Validates and persists the canonical event diff."},
        {"id": "select_external_event", "owner": "controller", "codeValue": "selectExternalEvent", "cardinality": "unbounded", "scopeKeys": ["adminSessionId", "externalEventId"], "outcomes": [{"kind": "surface_state", "stateIds": ["canonical-detail"]}], "description": "Closes the source-backed external event and returns to the Events directory."},
        {"id": "refresh_external_events", "owner": "controller", "codeValue": "refreshExternalList", "cardinality": "singleton", "scopeKeys": ["adminSessionId", "externalSnapshotVersion"], "outcomes": [{"kind": "surface_state", "stateIds": ["canonical-detail"]}], "description": "Refetches the external-event source after a failed read."}
      ],
      "scenarios": [
        {
          "id": "canonical_detail",
          "stateId": "canonical-detail",
          "dimensions": {},
          "actionCases": [
            {"id": "canonical_detail", "enabledActions": ["select_canonical_event", "back_to_event_list", "save_canonical_event"]},
            {"id": "canonical_save_pending_frozen_workspace", "dimensions": {"mutation": "pending"}, "disabledActions": ["back_to_event_list", "save_canonical_event"]},
            {"id": "external_detail", "dimensions": {"workspace": "external_detail"}, "enabledActions": ["select_external_event"]},
            {"id": "external_source_failed", "dimensions": {"workspace": "external_detail", "source": "failed"}, "enabledActions": ["select_external_event", "refresh_external_events"]}
          ]
        }
      ],
      "requiredEvidence": {"captures": false, "previews": true, "tests": true}
    }
  ]
}
