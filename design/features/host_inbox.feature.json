            {
              "kind": "surface_state",
              "stateIds": [
                "manual_handoff_queue"
              ]
            }
          ],
          "description": "Records an explicit Host sent assertion or skip without manufacturing delivered or read receipts."
        },
        {
          "id": "replan_manual_send_tasks",
          "owner": "manual_send_queue",
          "codeValue": "_replan",
          "cardinality": "unbounded",
          "scopeKeys": [
