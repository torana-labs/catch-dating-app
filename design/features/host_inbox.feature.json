          "owner": "broadcast_composer",
          "codeValue": "_selectAudience",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "eventId",
            "audience",
            "requestId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "broadcast_composer_lifecycle"
              ]
            }
          ],
          "description": "Selects Booked, Prospective, or Everyone and rotates the idempotency request id."
        },
        {
          "id": "select_broadcast_template",
          "owner": "broadcast_composer",
          "codeValue": "_selectTemplate",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "eventId",
            "template",
            "requestId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "broadcast_composer_lifecycle"
              ]
            }
          ],
          "description": "Seeds one reviewed broadcast template and rotates the idempotency request id."
        },
        {
          "id": "send_broadcast",
          "owner": "broadcast_controller",
          "codeValue": "send",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "eventId",
            "audience",
            "requestId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "broadcast_composer_lifecycle",
                "offline"
              ]
            },
            {
              "kind": "side_effect",
              "id": "host_inbox.event_broadcast_sent"
            }
          ],
          "description": "Sends one idempotent event broadcast to the selected roster-derived audience and reports partial push delivery honestly."
        },
        {
          "id": "select_communication_intent",
          "owner": "send_intent_menu",
          "codeValue": "HostSendIntentMenu",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "organizerId",
            "intent",
            "readiness"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "communication_intent_picker",
                "broadcast_composer_lifecycle",
                "customer_campaign_draft",
                "follower_update_composer"
              ]
            },
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.host.inbox"
              }
            }
          ],
          "description": "Chooses the host's communication intent without exposing provider routing policy: continue an existing conversation in Inbox, compose a saved-audience campaign, compose an event announcement, or post a follower update. Sender and provider details remain in setup and diagnostics."
        },
        {
          "id": "open_manual_send_task",
          "owner": "manual_send_queue",
          "codeValue": "_openTask",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "organizerId",
            "taskId",
            "revision"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "manual_handoff_queue",
                "manual_handoff_opened_unconfirmed"
              ]
            }
          ],
          "description": "Opens one durable by-hand task without claiming provider delivery."
        },
        {
          "id": "open_manual_handoff",
          "owner": "manual_send_queue",
          "codeValue": "_openWhatsapp",
          "cardinality": "unbounded",
          "scopeKeys": [
