            "organizerId",
            "taskIds",
            "requestId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "manual_handoff_replan_advisory"
              ]
            }
          ],
          "description": "Checks current route advice without mutating, dispatching, completing, removing, or superseding manual work."
        },
        {
          "id": "send_follower_update",
          "owner": "follower_update_composer",
          "codeValue": "showHostFollowerUpdateComposer",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "organizerId",
            "text",
            "submitAttemptId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "follower_update_composer"
              ]
            },
            {
              "kind": "side_effect",
              "id": "host_messaging.follower_update_created"
            }
          ],
          "description": "Creates one organizer update for active followers, freezes submission while pending, and returns to refreshed Sends history only after the callable accepts the post."
        },
        {
          "id": "manage_whatsapp_sender",
          "owner": "whatsapp_setup",
          "codeValue": "HostWhatsappSetupSection",
          "cardinality": "singleton",
          "scopeKeys": [
