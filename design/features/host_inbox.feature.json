            {
              "kind": "side_effect",
              "id": "host_inbox.whatsapp_reply_sent"
            }
          ],
          "description": "Sends free-form text only while the latest inbound message keeps the server-verified customer-service window open; the closed state disables the composer before submit."
        },
        {
          "id": "open_event_announcement_composer",
          "owner": "sends_workspace",
