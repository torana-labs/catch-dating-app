{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-09-15",
  "id": "feature.host_inbox",
  "name": "Host Inbox",
  "owner": "hosts",
  "status": "pilot",
  "description": "Orchestrates organizer-scoped Host messaging through an inbound Inbox plus Sends for outbound intent selection, event-announcement and follower-update composition, reusable-audience campaigns, manual handoff work, and mixed outbound history.",
  "surfaces": [
    {
      "id": "host_flutter",
      "runtime": "flutter",
      "authority": {
        "registry": "flutter_screens",
        "id": "screen.host.inbox"
      },
      "actionScope": {
        "included": "Inbox workspace switching; Inbox retry, search, event/general scope, booked/prospective inquiry classification, explicit Catch chat routing, and organizer-scoped inbound WhatsApp thread facets with 12-month retention and service-window-aware replies; Sends-owned outbound intent selection for existing conversations, saved-audience campaigns, event announcements, and follower updates; reverse-chronological managed-send history; durable manual handoff work; dedicated sender setup; and deep-linked campaign create, schedule, preview, approve, dispatch, cancel, and report controls.",
        "excluded": [
          "Raw broadcast body edits are form data; the contract cardinalizes template/audience decisions and the send mutation instead of individual keystrokes.",
          "Conversation thread behavior and safety actions retain the shared chat-thread contract."
        ]
      },
