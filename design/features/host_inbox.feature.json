      "actions": [
        {
          "id": "select_workspace",
          "owner": "inbox_screen",
          "codeValue": "_selectWorkspace",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "organizerId",
            "workspace"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "populated_queries",
                "customer_messaging_ready"
              ]
            }
          ],
          "description": "Switches the selected organizer's Inbox destination between Inbox and Sends; the wire value remains campaigns for deep-link compatibility."
        },
        {
          "id": "retry_inbox",
          "owner": "inbox_screen",
          "codeValue": "_retry",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "organizerId",
            "routeInstanceId",
            "failureStateVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "uid_loading_or_missing",
                "matches_loading",
                "matches_error",
                "populated_queries",
                "empty_host_queries",
                "offline"
              ]
            }
          ],
          "description": "Invalidates the failed identity, conversation, and hosted-organizer sources for the current inbox."
        },
        {
