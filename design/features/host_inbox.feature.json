              }
            }
          ],
          "description": "Opens the selected host inquiry in the shared chat thread route."
        },
        {
          "id": "open_whatsapp_thread",
          "owner": "whatsapp_thread",
          "codeValue": "HostWhatsappThreadSheet",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "organizerId",
            "threadId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "whatsapp_inbound_thread",
                "whatsapp_service_window_open",
                "whatsapp_service_window_closed"
              ]
            }
          ],
          "description": "Opens one organizer-scoped WhatsApp facet with its retained inbound and outbound messages beside the existing Inbox scopes."
        },
        {
          "id": "send_whatsapp_reply",
          "owner": "whatsapp_thread",
          "codeValue": "_send",
          "cardinality": "singleton",
          "scopeKeys": [
