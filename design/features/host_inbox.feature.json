        {
          "id": "select_scope",
          "owner": "inbox_screen",
          "codeValue": "_selectScope",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "routeInstanceId",
            "eventId",
            "programId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "populated_queries",
                "prospective_queries",
                "general_queries",
                "program_queries",
                "roster_without_threads",
                "empty_host_queries"
