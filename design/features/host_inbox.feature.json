          "description": "Selects an event-scoped inbox, a program-scoped guest inbox, or the explicit General inquiry scope and synchronizes it to the route."
        },
        {
          "id": "select_audience_segment",
          "owner": "inbox_screen",
          "codeValue": "HostInboxAudienceSegment",
          "cardinality": "unbounded",
          "scopeKeys": [
            "viewerUid",
            "eventId",
            "segment"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "populated_queries",
                "prospective_queries",
                "roster_without_threads"
              ]
            }
          ],
          "description": "Switches an event inbox between Booked and Prospective inquiry rows."
        },
        {
