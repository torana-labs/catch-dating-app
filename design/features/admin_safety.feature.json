{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-11-01",
  "id": "feature.admin_safety",
  "name": "Admin Safety",
  "owner": "admin_console",
  "status": "pilot",
  "description": "Lists open safety cases from every queue, launch access included, due soonest first; decides cases and launch access; acts on accounts (warn, restrict, suspend, ban) through the sheet; and shows account actions and appeals for review by someone who did not decide.",
  "surfaces": [
    {
      "id": "admin_safety",
      "runtime": "react_admin",
      "authority": {
        "registry": "admin_routes",
        "id": "route_safety"
      },
      "actionScope": {
        "included": "Filtering open cases from every queue with launch access, opening a case or application, resolving or dismissing a case, deciding launch access, acting on an account through the sheet, lifting an action and deciding an appeal.",
        "excluded": [
          "Assigning a case is not drawn yet; the existing assignment callable stays available to the controller.",
          "Changing safety rules and reasons is Settings → Safety."
        ]
      },
      "bindings": {
        "previewSources": [
          "admin/src/stories/AdminRoutes.stories.tsx"
        ],
        "actionOwners": [
          {
            "id": "triage",
            "language": "typescript",
            "file": "admin/src/features/safety/controllers/useSafetyTriageController.ts",
            "symbol": "useSafetyTriageController"
          },
          {
            "id": "access",
            "language": "typescript",
            "file": "admin/src/features/safety/controllers/useAccessReviewController.ts",
            "symbol": "useAccessReviewController"
          },
          {
            "id": "actions",
            "language": "typescript",
            "file": "admin/src/features/safety/controllers/useAccountSafetyController.ts",
            "symbol": "useAccountSafetyController"
          },
          {
            "id": "sheet",
            "language": "typescript",
            "file": "admin/src/features/safety/controllers/useSafetyActionSheetController.ts",
            "symbol": "useSafetyActionSheetController"
          },
          {
            "id": "screen",
            "language": "typescript",
            "file": "admin/src/features/safety/ui/SafetyScreen.tsx",
            "symbol": "SafetyScreen"
          }
        ],
        "componentContracts": [
          "route_safety",
          "workspace_safety_action_sheet"
        ],
        "dataContracts": [],
        "runtimeContracts": [
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminGetOverview",
            "requestValidation": "strict_schema",
            "responseValidation": "strict_schema"
          },
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminGetSafetyTriageDetails",
            "requestValidation": "strict_schema",
            "responseValidation": "structural_object"
          },
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminDecideSafetyTriageItem",
            "requestValidation": "strict_schema",
            "responseValidation": "strict_schema"
          },
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminGetAccessApplicationDetails",
            "requestValidation": "strict_schema",
            "responseValidation": "structural_object"
          },
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminDecideAccessApplication",
            "requestValidation": "strict_schema",
            "responseValidation": "strict_schema"
          },
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminTakeAccountSafetyAction",
            "requestValidation": "strict_schema",
            "responseValidation": "strict_schema"
          },
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminLiftAccountSafetyAction",
            "requestValidation": "strict_schema",
            "responseValidation": "strict_schema"
          },
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminListAccountSafetyActions",
            "requestValidation": "strict_schema",
            "responseValidation": "strict_schema"
          },
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminDecideSafetyAppeal",
            "requestValidation": "strict_schema",
            "responseValidation": "strict_schema"
          },
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminGetSafetySettings",
            "requestValidation": "strict_schema",
            "responseValidation": "strict_schema"
          }
        ],
        "testEvidence": {
          "open-cases": [
            "admin/src/features/safety/controllers/safetyCases.test.ts",
            "admin/src/features/safety/ui/SafetyScreen.test.tsx"
          ],
          "case-detail": [
            "admin/src/features/safety/controllers/useSafetyTriageController.test.tsx",
            "admin/src/features/safety/ui/SafetyScreen.test.tsx",
            "admin/src/features/safety/controllers/useSafetyActionSheetController.test.tsx"
          ],
          "launch-access": [
            "admin/src/features/safety/controllers/safetyCases.test.ts",
            "admin/src/features/safety/ui/SafetyScreen.test.tsx"
          ],
          "account-actions": [
            "admin/src/features/safety/controllers/useAccountSafetyController.test.tsx",
            "admin/src/features/safety/controllers/safetyCases.test.ts"
          ],
          "appeal": [
            "admin/src/features/safety/controllers/useAccountSafetyController.test.tsx"
          ]
        }
      },
      "dimensions": {
        "view": {
          "default": "open",
          "values": [
            "open",
            "actions",
            "appeals"
          ]
        },
        "job": {
          "default": "ops",
          "values": [
            "ops",
            "owner"
          ]
        },
        "decision": {
          "default": "idle",
          "values": [
            "idle",
            "pending"
          ]
        }
      },
      "actions": [
        {
          "id": "filter_safety_cases",
          "owner": "screen",
          "codeValue": "onCaseKind",
          "cardinality": "unbounded",
          "scopeKeys": [
            "adminSessionId",
            "caseKind"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "open-cases"
              ]
            }
          ],
          "description": "Shows one kind of case: reports, flags, events or launch access."
        },
        {
          "id": "switch_safety_view",
          "owner": "screen",
          "codeValue": "onViewChanged",
          "cardinality": "unbounded",
          "scopeKeys": [
            "adminSessionId",
            "view"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "open-cases",
                "account-actions",
                "appeal"
              ]
            }
          ],
          "description": "Switches between open cases, account actions and appeals."
        },
        {
          "id": "open_safety_case",
          "owner": "screen",
          "codeValue": "onSelectCase",
          "cardinality": "unbounded",
          "scopeKeys": [
            "adminSessionId",
            "targetPath"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "case-detail",
                "launch-access"
              ]
            }
          ],
          "description": "Opens a case or launch access application beside the queue."
        },
        {
          "id": "decide_safety_case",
          "owner": "triage",
          "codeValue": "decide",
          "cardinality": "singleton",
          "scopeKeys": [
            "adminSessionId",
            "targetPath"
          ],
          "outcomes": [
            {
              "kind": "side_effect",
              "id": "admin.safety_case_decided"
            }
          ],
          "description": "Resolves or dismisses a case; the reporter hears it was handled."
        },
        {
          "id": "decide_launch_access",
          "owner": "access",
          "codeValue": "decide",
          "cardinality": "singleton",
          "scopeKeys": [
            "adminSessionId",
            "applicationUid"
          ],
          "outcomes": [
            {
              "kind": "side_effect",
              "id": "admin.access_decided"
            }
          ],
          "description": "Lets an applicant in or turns them down."
        },
        {
          "id": "act_on_account",
          "owner": "sheet",
          "codeValue": "submit",
          "cardinality": "singleton",
          "scopeKeys": [
            "adminSessionId",
            "uid",
            "caseTargetPath"
          ],
          "outcomes": [
            {
              "kind": "side_effect",
              "id": "admin.account_action_taken"
            }
          ],
          "description": "Warns, restricts, suspends or bans an account from the sheet; suspend and ban are owner-only."
        },
        {
          "id": "lift_account_action",
          "owner": "actions",
          "codeValue": "lift",
          "cardinality": "singleton",
          "scopeKeys": [
            "adminSessionId",
            "actionId"
          ],
          "outcomes": [
            {
              "kind": "side_effect",
              "id": "admin.account_action_lifted"
            }
          ],
          "description": "Lifts an action early within the job's authority."
        },
        {
          "id": "decide_safety_appeal",
          "owner": "actions",
          "codeValue": "decide",
          "cardinality": "singleton",
          "scopeKeys": [
            "adminSessionId",
            "actionId"
          ],
          "outcomes": [
            {
              "kind": "side_effect",
              "id": "admin.safety_appeal_decided"
            }
          ],
          "description": "Keeps, reduces or lifts an appealed action; the reviewer did not decide it."
        }
      ],
      "scenarios": [
        {
          "id": "open_cases",
          "stateId": "open-cases",
          "dimensions": {},
          "actionCases": [
            {
              "id": "ready",
              "enabledActions": [
                "filter_safety_cases",
                "switch_safety_view",
                "open_safety_case"
              ]
            }
          ]
        },
        {
          "id": "case_detail",
          "stateId": "case-detail",
          "dimensions": {},
          "actionCases": [
            {
              "id": "ready",
              "enabledActions": [
                "decide_safety_case",
                "act_on_account"
              ]
            },
            {
              "id": "decision_pending_frozen_workspace",
              "dimensions": {
                "decision": "pending"
              },
              "disabledActions": [
                "decide_safety_case",
                "act_on_account"
              ]
            }
          ]
        },
        {
          "id": "launch_access",
          "stateId": "launch-access",
          "dimensions": {},
          "actionCases": [
            {
              "id": "ready",
              "enabledActions": [
                "decide_launch_access"
              ]
            },
            {
              "id": "access_pending_frozen_workspace",
              "dimensions": {
                "decision": "pending"
              },
              "disabledActions": [
                "decide_launch_access"
              ]
            }
          ]
        },
        {
          "id": "account_actions",
          "stateId": "account-actions",
          "dimensions": {
            "view": "actions"
          },
          "actionCases": [
            {
              "id": "ready",
              "enabledActions": [
                "switch_safety_view",
                "lift_account_action"
              ]
            }
          ]
        },
        {
          "id": "appeal",
          "stateId": "appeal",
          "dimensions": {
            "view": "appeals"
          },
          "actionCases": [
            {
              "id": "ready",
              "enabledActions": [
                "decide_safety_appeal"
              ]
            }
          ]
        }
      ],
      "requiredEvidence": {
        "captures": false,
        "previews": true,
        "tests": true
      }
    },
