{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-11-01",
  "id": "feature.admin_now",
  "name": "Admin Needs you",
  "owner": "admin_console",
  "status": "pilot",
  "description": "Lists every overview queue item waiting on a person, oldest first, beside counts by kind and data-source freshness, and opens each item in its role-checked owning area.",
  "surfaces": [
    {
      "id": "admin_now",
      "runtime": "react_admin",
      "authority": {
        "registry": "admin_routes",
        "id": "route_now"
      },
      "actionScope": {
        "included": "Refreshing the queue snapshot and opening the role-checked area that owns an item or a kind.",
        "excluded": [
          "Needs you is read-only: it does not resolve queue items or alter metrics.",
          "Marketplace analytics moved to the Marketplace route."
        ]
      },
      "bindings": {
        "previewSources": [
          "admin/src/stories/AdminRoutes.stories.tsx"
        ],
        "actionOwners": [
          {
            "id": "controller",
            "language": "typescript",
            "file": "admin/src/features/now/controllers/useNowController.ts",
            "symbol": "useNowController"
          },
          {
            "id": "screen",
            "language": "typescript",
            "file": "admin/src/features/now/ui/NowScreen.tsx",
            "symbol": "NowScreen"
          }
        ],
        "componentContracts": [
          "route_now"
        ],
        "dataContracts": [],
        "runtimeContracts": [
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminGetOverview",
            "requestValidation": "strict_schema",
            "responseValidation": "strict_schema"
          }
        ],
        "testEvidence": {
          "oldest-first": [
            "admin/src/features/now/controllers/useNowController.test.tsx"
          ],
          "by-kind": [
            "admin/src/features/now/controllers/useNowController.test.tsx"
          ],
          "data-sources": [
            "admin/src/features/now/controllers/useNowController.test.tsx"
          ],
          "stats": [
            "admin/src/features/now/controllers/useNowController.test.tsx"
          ]
        }
      },
      "dimensions": {
        "overview_source": {
          "default": "ready",
          "values": [
            "ready",
            "loading",
            "failed"
          ]
        }
      },
      "actions": [
        {
          "id": "refresh_needs_you",
          "owner": "controller",
          "codeValue": "refresh",
          "cardinality": "singleton",
          "scopeKeys": [
            "adminSessionId",
            "overviewVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "oldest-first",
                "by-kind",
                "data-sources",
                "stats"
              ]
            }
          ],
          "description": "Refetches the overview queue snapshot."
        },
        {
          "id": "open_needs_you_item",
          "owner": "screen",
          "codeValue": "onOpenItem",
          "cardinality": "unbounded",
          "scopeKeys": [
            "adminSessionId",
            "destination",
            "targetPath"
          ],
          "outcomes": [
            {
              "kind": "side_effect",
              "id": "admin.queue_owner_opened"
            }
          ],
          "description": "Opens an item in its role-checked owning area, at the record when the area has a record route."
        },
        {
          "id": "open_needs_you_kind",
          "owner": "screen",
          "codeValue": "onOpenKind",
          "cardinality": "unbounded",
          "scopeKeys": [
            "adminSessionId",
            "destination"
          ],
          "outcomes": [
            {
              "kind": "side_effect",
              "id": "admin.queue_owner_opened"
            }
          ],
          "description": "Opens the area that owns a kind of item."
        }
      ],
      "scenarios": [
        {
          "id": "oldest_first",
          "stateId": "oldest-first",
          "dimensions": {},
          "actionCases": [
            {
              "id": "ready",
              "enabledActions": [
                "refresh_needs_you",
                "open_needs_you_item"
              ]
            }
          ]
        },
        {
          "id": "by_kind",
          "stateId": "by-kind",
          "dimensions": {},
          "actionCases": [
            {
              "id": "ready",
              "enabledActions": [
                "open_needs_you_kind"
              ]
            }
          ]
        },
        {
          "id": "data_sources",
          "stateId": "data-sources",
          "dimensions": {},
          "actionCases": [
            {
              "id": "ready",
              "enabledActions": [
                "refresh_needs_you"
              ]
            }
          ]
        },
        {
          "id": "stats",
          "stateId": "stats",
          "dimensions": {},
          "actionCases": [
            {
              "id": "ready",
              "enabledActions": [
                "refresh_needs_you"
              ]
            }
          ]
        }
      ],
      "requiredEvidence": {
        "captures": false,
        "previews": true,
        "tests": true
      }
    },
    {
      "id": "admin_now_live_controller",
      "runtime": "react_admin",
      "authority": {
        "registry": "admin_routes",
        "id": "route_now_live_controller"
      },
      "actionScope": {
        "included": "Owning the live query seam for the prop-driven Needs you actions.",
        "excluded": [
          "Deterministic visual state remains on route_now."
        ]
      },
      "bindings": {
        "previewSources": [],
        "actionOwners": [
          {
            "id": "controller",
            "language": "typescript",
            "file": "admin/src/features/now/controllers/useNowController.ts",
            "symbol": "useNowController"
          },
          {
            "id": "route",
            "language": "typescript",
            "file": "admin/src/features/now/ui/NowRouteScreen.tsx",
            "symbol": "NowRouteScreen"
          }
        ],
        "componentContracts": [
          "route_now_live_controller"
        ],
        "dataContracts": [],
        "runtimeContracts": [
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminGetOverview",
            "requestValidation": "strict_schema",
            "responseValidation": "strict_schema"
          }
        ],
        "testEvidence": {
          "live-query-wrapper": [
            "admin/src/features/now/controllers/useNowController.test.tsx"
          ],
          "route-lazy-boundary": [
            "admin/src/features/now/controllers/useNowController.test.tsx"
          ]
        }
      },
      "dimensions": {
        "boundary": {
          "default": "resolved",
          "values": [
            "resolved",
            "loading"
          ]
        }
      },
      "actions": [
        {
          "id": "refresh_needs_you",
          "owner": "controller",
          "codeValue": "refresh",
          "cardinality": "singleton",
          "scopeKeys": [
            "adminSessionId",
            "overviewVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "live-query-wrapper"
              ]
            }
          ],
          "description": "Refetches the live queue snapshot."
        },
        {
          "id": "open_needs_you_item",
          "owner": "route",
          "codeValue": "onOpen",
          "cardinality": "unbounded",
          "scopeKeys": [
            "adminSessionId",
            "destination",
            "targetPath"
          ],
          "outcomes": [
            {
              "kind": "side_effect",
              "id": "admin.queue_owner_opened"
            }
          ],
          "description": "Forwards item routing to the owning app route."
        }
      ],
      "scenarios": [
        {
          "id": "live_query_wrapper",
          "stateId": "live-query-wrapper",
          "dimensions": {},
          "actionCases": [
            {
              "id": "resolved",
              "enabledActions": [
                "refresh_needs_you",
                "open_needs_you_item"
              ]
            }
          ]
        },
        {
          "id": "route_lazy_boundary",
          "stateId": "route-lazy-boundary",
          "dimensions": {
            "boundary": "loading"
          },
          "actionCases": [
            {
              "id": "lazy_loading"
            }
          ]
        }
      ],
      "requiredEvidence": {
        "captures": false,
        "previews": false,
        "tests": true
      }
    }
  ]
}
