{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-11-01",
  "id": "feature.admin_organizer_publishing",
  "name": "Admin Organizer Publishing",
  "owner": "admin_console",
  "status": "pilot",
  "description": "The editor the organizer page hosts on its Page tab, with publish-readiness gating and public index publication. The Organizers directory lists organizers; the Inbox decides claims.",
  "surfaces": [
    {
      "id": "admin_web",
      "runtime": "react_admin",
      "authority": {"registry": "admin_routes", "id": "route_organizer_publishing"},
      "actionScope": {
        "included": "Loading a canonical organizer, returning to the Organizers directory, changing the publish checklist, saving canonical details, publishing index state, and freezing the complete Admin workspace during any write.",
        "excluded": [
          "Canonical editor fields remain form data.",
          "Publishing requires saved canonical data plus the full checklist."
        ]
      },
      "bindings": {
        "previewSources": ["admin/src/stories/AdminRoutesOrganizers.stories.tsx"],
        "actionOwners": [
          {"id": "publishing_controller", "language": "typescript", "file": "admin/src/features/organizers/controllers/useOrganizerPublishingController.ts", "symbol": "useOrganizerPublishingController"},
          {"id": "screen", "language": "typescript", "file": "admin/src/features/organizers/ui/OrganizerPublishingScreen.tsx", "symbol": "OrganizerPublishingWorkspace"}
        ],
        "componentContracts": ["route_organizer_publishing"],
        "dataContracts": [
          "contracts/callables/admin_list_organizer_details_payload.schema.json",
          "contracts/callables/admin_get_organizer_details_payload.schema.json",
          "contracts/callables/admin_update_organizer_details_payload.schema.json",
          "contracts/callables/admin_set_organizer_index_status_payload.schema.json",
          "contracts/firestore/organizers.schema.json"
        ],
        "runtimeContracts": [
          {"kind": "admin_callable", "registry": "admin/src/generated/validators/adminCallableValidators.ts", "callable": "adminListOrganizerDetails", "requestValidation": "strict_schema", "responseValidation": "structural_object"},
          {"kind": "admin_callable", "registry": "admin/src/generated/validators/adminCallableValidators.ts", "callable": "adminGetOrganizerDetails", "requestValidation": "strict_schema", "responseValidation": "structural_object"},
          {"kind": "admin_callable", "registry": "admin/src/generated/validators/adminCallableValidators.ts", "callable": "adminUpdateOrganizerDetails", "requestValidation": "strict_schema", "responseValidation": "structural_object"},
          {"kind": "admin_callable", "registry": "admin/src/generated/validators/adminCallableValidators.ts", "callable": "adminSetOrganizerIndexStatus", "requestValidation": "strict_schema", "responseValidation": "structural_object"}
        ],
        "testEvidence": {
          "canonical-detail": [
            "admin/src/features/organizers/controllers/useOrganizerPublishingController.test.tsx",
            "admin/src/shared/pendingOperation.test.tsx"
          ]
        }
      },
      "dimensions": {
        "workspace": {"default": "organizer_detail", "values": ["organizer_detail", "unavailable"]},
        "mutation": {"default": "idle", "values": ["idle", "saving", "publishing", "failed", "success"]}
      },
      "actions": [
        {"id": "select_organizer_profile", "owner": "publishing_controller", "codeValue": "selectOrganizer", "cardinality": "unbounded", "scopeKeys": ["adminSessionId", "organizerId"], "outcomes": [{"kind": "surface_state", "stateIds": ["canonical-detail"]}], "description": "Loads one canonical organizer profile for governed editing and publication."},
        {"id": "back_to_organizer_directory", "owner": "publishing_controller", "codeValue": "backToList", "cardinality": "unbounded", "scopeKeys": ["adminSessionId", "organizerId"], "outcomes": [{"kind": "surface_state", "stateIds": ["canonical-detail"]}], "description": "Returns from the editor to the Organizers directory."},
        {"id": "toggle_organizer_publish_checklist", "owner": "publishing_controller", "codeValue": "setChecklist", "cardinality": "domain_bounded", "scopeKeys": ["reviewerUid", "organizerId", "checklistItem", "draftVersion"], "outcomes": [{"kind": "surface_state", "stateIds": ["canonical-detail"]}], "description": "Marks one bounded publish-readiness assertion for the selected organizer."},
        {"id": "save_organizer_profile", "owner": "publishing_controller", "codeValue": "save", "cardinality": "singleton", "scopeKeys": ["reviewerUid", "organizerId", "editorDraftVersion"], "outcomes": [{"kind": "surface_state", "stateIds": ["canonical-detail"]}, {"kind": "side_effect", "id": "admin.organizer_details_saved"}], "description": "Validates and persists the canonical organizer diff."},
        {"id": "publish_organizer_profile", "owner": "publishing_controller", "codeValue": "saveAndPublish", "cardinality": "singleton", "scopeKeys": ["reviewerUid", "organizerId", "editorDraftVersion", "checklistVersion"], "outcomes": [{"kind": "surface_state", "stateIds": ["canonical-detail"]}, {"kind": "side_effect", "id": "admin.organizer_index_published"}], "description": "Saves valid canonical data and changes public index status only after every checklist assertion passes."}
      ],
      "scenarios": [
        {
          "id": "canonical_detail",
          "stateId": "canonical-detail",
          "dimensions": {},
          "actionCases": [
            {"id": "organizer_detail", "enabledActions": ["select_organizer_profile", "back_to_organizer_directory", "toggle_organizer_publish_checklist", "save_organizer_profile", "publish_organizer_profile"]},
            {"id": "organizer_save_pending_frozen_workspace", "dimensions": {"mutation": "saving"}, "disabledActions": ["back_to_organizer_directory", "toggle_organizer_publish_checklist", "save_organizer_profile", "publish_organizer_profile"]},
            {"id": "organizer_publish_pending_frozen_workspace", "dimensions": {"mutation": "publishing"}, "disabledActions": ["back_to_organizer_directory", "toggle_organizer_publish_checklist", "save_organizer_profile", "publish_organizer_profile"]},
            {"id": "selected_unavailable", "dimensions": {"workspace": "unavailable"}, "enabledActions": ["back_to_organizer_directory"]}
          ]
        }
      ],
      "requiredEvidence": {"captures": false, "previews": true, "tests": true}
    }
  ]
}
