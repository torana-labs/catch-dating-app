{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-10-30",
  "id": "feature.admin_commercial_terms",
  "name": "Admin Commercial Terms",
  "owner": "admin_console",
  "status": "pilot",
  "description": "Finance and Admin Owner review Catch's platform commercial terms and their revision history, start the first revision from the owner's recorded decision, preview every changed term before a reasoned save, and keep sparse per-organizer overrides whose unset terms inherit.",
  "surfaces": [
    {
      "id": "admin_web",
      "runtime": "react_admin",
      "authority": {"registry": "admin_routes", "id": "route_commercial_terms"},
      "actionScope": {
        "included": "Refreshing the terms, starting an edit or the owner-decision draft, editing or inheriting a term, reviewing the field-by-field preview, saving against the reviewed revision, retrying an unconfirmed save exactly, finding an organizer, and opening one organizer's override.",
        "excluded": [
          "Term values, the reason and the organizer search text are form data.",
          "Saved terms change only new payments; the route never edits a recorded payment, issues an invoice or moves money.",
          "Analytics viewers can open Finance but not this workspace; the callables admit Finance and Admin Owner only."
        ]
      },
      "bindings": {
        "previewSources": ["admin/src/stories/AdminFinanceSettings.stories.tsx"],
        "actionOwners": [
          {"id": "controller", "language": "typescript", "file": "admin/src/features/commercial-terms/controllers/useCommercialTermsController.ts", "symbol": "useCommercialTermsController"},
          {"id": "screen", "language": "typescript", "file": "admin/src/features/commercial-terms/ui/CommercialTermsScreen.tsx", "symbol": "CommercialTermsWorkspace"}
        ],
        "componentContracts": ["route_commercial_terms", "workspace_commercial_terms"],
        "dataContracts": [
          "contracts/callables/admin_list_commercial_terms_payload.schema.json",
          "contracts/callable_responses/admin_list_commercial_terms_response.schema.json",
          "contracts/callables/manage_commercial_terms_payload.schema.json",
          "contracts/callable_responses/manage_commercial_terms_response.schema.json",
          "contracts/shared/commercial_terms.schema.json"
        ],
        "runtimeContracts": [
          {"kind": "admin_callable", "registry": "admin/src/generated/validators/adminCallableValidators.ts", "callable": "adminListCommercialTerms", "requestValidation": "strict_schema", "responseValidation": "strict_schema"},
          {"kind": "admin_callable", "registry": "admin/src/generated/validators/adminCallableValidators.ts", "callable": "manageCommercialTerms", "requestValidation": "strict_schema", "responseValidation": "strict_schema"}
        ],
        "testEvidence": {
          "commercial-terms": [
            "admin/src/features/commercial-terms/controllers/useCommercialTermsController.test.tsx",
            "admin/src/features/commercial-terms/controllers/commercialTermsForm.test.ts",
            "admin/src/features/commercial-terms/ui/CommercialTermsScreen.test.tsx"
          ]
        }
      },
      "dimensions": {
        "scope": {"default": "platform", "values": ["platform", "organizer"]},
        "platform": {"default": "saved", "values": ["saved", "unsaved"]},
        "edit": {"default": "viewing", "values": ["viewing", "editing", "preview", "unconfirmed"]}
      },
      "actions": [
        {"id": "refresh_commercial_terms", "owner": "controller", "codeValue": "refresh", "cardinality": "singleton", "scopeKeys": ["adminSessionId", "termsScope"], "outcomes": [{"kind": "surface_state", "stateIds": ["commercial-terms"]}], "description": "Rereads the platform terms, the scope's newest revisions and the organizer overrides."},
        {"id": "start_terms_edit", "owner": "controller", "codeValue": "startEdit", "cardinality": "singleton", "scopeKeys": ["termsScope", "revision"], "outcomes": [{"kind": "surface_state", "stateIds": ["commercial-terms"]}], "description": "Opens a draft of the scope's current revision."},
        {"id": "start_from_owner_decision", "owner": "controller", "codeValue": "startFromOwnerDecision", "cardinality": "singleton", "scopeKeys": ["termsScope"], "outcomes": [{"kind": "surface_state", "stateIds": ["commercial-terms"]}], "description": "Opens a draft holding the owner's 30 Oct 2026 decision while platform terms are unsaved."},
        {"id": "inherit_or_set_term", "owner": "controller", "codeValue": "setInherited", "cardinality": "domain_bounded", "scopeKeys": ["organizerId", "termId", "draftVersion"], "outcomes": [{"kind": "surface_state", "stateIds": ["commercial-terms"]}], "description": "Sets one term for the organizer or returns it to the inherited platform value."},
        {"id": "review_terms_change", "owner": "controller", "codeValue": "review", "cardinality": "singleton", "scopeKeys": ["termsScope", "revision", "draftVersion"], "outcomes": [{"kind": "surface_state", "stateIds": ["commercial-terms"]}], "description": "Validates the draft and reason and shows every changed term against the current revision."},
        {"id": "save_terms_revision", "owner": "controller", "codeValue": "save", "cardinality": "singleton", "scopeKeys": ["actorUid", "termsScope", "expectedRevision", "draftVersion"], "outcomes": [{"kind": "surface_state", "stateIds": ["commercial-terms"]}, {"kind": "side_effect", "id": "finance.commercial_terms_revision_saved"}], "description": "Saves the reviewed change as the next revision with its reason; an unconfirmed save is retried exactly."},
        {"id": "cancel_terms_edit", "owner": "controller", "codeValue": "cancelEdit", "cardinality": "singleton", "scopeKeys": ["termsScope", "draftVersion"], "outcomes": [{"kind": "surface_state", "stateIds": ["commercial-terms"]}], "description": "Discards the draft."},
        {"id": "find_organizer_for_override", "owner": "controller", "codeValue": "search", "cardinality": "unbounded", "scopeKeys": ["adminSessionId", "organizerQuery"], "outcomes": [{"kind": "surface_state", "stateIds": ["commercial-terms"]}], "description": "Finds organizers by name to add or open an override."},
        {"id": "open_organizer_terms", "owner": "screen", "codeValue": "onOpenOrganizer", "cardinality": "unbounded", "scopeKeys": ["adminSessionId", "organizerId"], "outcomes": [{"kind": "surface_state", "stateIds": ["commercial-terms"]}], "description": "Opens one organizer's override at its own URL."},
        {"id": "back_to_platform_terms", "owner": "screen", "codeValue": "onOpenPlatform", "cardinality": "unbounded", "scopeKeys": ["adminSessionId", "organizerId"], "outcomes": [{"kind": "surface_state", "stateIds": ["commercial-terms"]}], "description": "Returns from an organizer to the platform terms."}
      ],
      "scenarios": [
        {
          "id": "commercial_terms",
          "stateId": "commercial-terms",
          "dimensions": {},
          "actionCases": [
            {"id": "platform_saved", "enabledActions": ["refresh_commercial_terms", "start_terms_edit", "find_organizer_for_override", "open_organizer_terms"]},
            {"id": "platform_unsaved", "dimensions": {"platform": "unsaved"}, "enabledActions": ["start_from_owner_decision", "start_terms_edit", "refresh_commercial_terms"]},
            {"id": "platform_editing", "dimensions": {"edit": "editing"}, "enabledActions": ["review_terms_change", "cancel_terms_edit"], "disabledActions": ["save_terms_revision"]},
            {"id": "platform_preview", "dimensions": {"edit": "preview"}, "enabledActions": ["save_terms_revision", "cancel_terms_edit"]},
            {"id": "save_unconfirmed_retry", "dimensions": {"edit": "unconfirmed"}, "enabledActions": ["save_terms_revision", "cancel_terms_edit"]},
            {"id": "organizer_override", "dimensions": {"scope": "organizer", "edit": "editing"}, "enabledActions": ["inherit_or_set_term", "review_terms_change", "cancel_terms_edit", "back_to_platform_terms"]},
            {"id": "organizer_without_platform", "dimensions": {"scope": "organizer", "platform": "unsaved"}, "enabledActions": ["back_to_platform_terms", "refresh_commercial_terms"], "disabledActions": ["start_terms_edit"]}
          ]
        }
      ],
      "requiredEvidence": {"captures": false, "previews": true, "tests": true}
    }
  ]
}
