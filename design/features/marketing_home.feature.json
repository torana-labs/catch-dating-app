{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-10-29",
  "id": "feature.marketing_home",
  "name": "Marketing Home",
  "owner": "marketing_website",
  "status": "pilot",
  "description": "Website v2 homepage and Explore: a city's plans and organisers from its cityPlans read model or its launching-soon state, the homepage's format filters and city picker, Explore's URL-kept search, format, date and organiser filters, and catalogue failure.",
  "surfaces": [
    {
      "id": "marketing_web",
      "runtime": "react_marketing",
      "authority": {
        "registry": "marketing_routes",
        "id": "visitor_discovery"
      },
      "actionScope": {
        "included": "Explore and city-page search, format, date and plans/organisers choices kept in the URL, clearing them, and moving to another city's page with the filters kept; launching-soon, no-result and unavailable states remain distinct.",
        "excluded": [
          "Plan, organiser, claim and live-city link navigation and the shared v2 header and footer retain their existing link and chrome owners. The /organizers/ redirect is owned by the route contract."
        ]
      },
      "bindings": {
        "previewSources": [
          "website/src/stories/ExplorePage.stories.tsx"
        ],
        "actionOwners": [
          {
            "id": "explore_controller",
