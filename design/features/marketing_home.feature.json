      "actions": [
        {
          "id": "update_filters",
          "owner": "explore_controller",
          "codeValue": "update",
          "cardinality": "unbounded",
          "scopeKeys": [
            "routeInstanceId",
            "selectionVersion"
          ],
          "outcomes": [
