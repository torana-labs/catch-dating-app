    {
      "id": "consumer_home",
      "runtime": "react_marketing",
      "authority": {
        "registry": "marketing_routes",
        "id": "home"
      },
      "actionScope": {
        "included": "Homepage format filtering and city selection; a live city, a launching-soon city, a city too thin to fill a page and an unreadable catalogue remain distinct.",
        "excluded": [
          "Plan, organiser, Explore and Host link navigation, store buttons, FAQ disclosure and the launching-soon WhatsApp signup (useLaunchNoticeController) retain their existing link, presentation and form owners."
