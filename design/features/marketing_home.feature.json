            "website/src/features/home/useExploreController.test.tsx"
          ],
          "mobile-menu": [
            "website/src/shared/site/PublicSiteChrome.test.tsx"
          ]
        }
      },
      "dimensions": {
        "content": {
          "default": "populated",
          "values": [
            "populated",
            "empty_city",
            "no_results"
          ]
        },
        "load": {
          "default": "ready",
          "values": [
            "ready",
            "unavailable"
          ]
        },
        "navigation": {
          "default": "closed",
          "values": [
            "closed",
            "mobile_menu"
          ]
        },
        "filters": {
          "default": "default",
          "values": [
            "default",
            "experience",
            "search_date"
          ]
        }
      },
      "actions": [
        {
          "id": "update_discovery_filters",
          "owner": "discovery_controller",
          "codeValue": "update",
          "cardinality": "unbounded",
          "scopeKeys": [
            "routeInstanceId",
            "selectionVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "default",
                "empty-city",
                "no-results",
                "experience-filter",
                "catalog-unavailable",
                "search-and-date"
              ]
            }
          ],
          "description": "Updates bounded city, format, search, date and Catch Experience filters through the URL-aware controller."
        },
        {
          "id": "clear_discovery_filters",
          "owner": "discovery_controller",
          "codeValue": "clear",
          "cardinality": "unbounded",
          "scopeKeys": [
            "routeInstanceId",
            "selectionVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "default",
                "empty-city",
                "catalog-unavailable"
              ]
            }
          ],
          "description": "Clears active filters while preserving the selected city."
        }
      ],
