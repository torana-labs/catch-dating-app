              "kind": "surface_state",
              "stateIds": [
                "city-plans",
                "search-and-filters",
                "organisers",
                "no-results"
              ]
            }
          ],
          "description": "Writes the search, format, date and plans/organisers choices to the URL in place, keeping other parameters such as attribution."
        },
        {
          "id": "clear_filters",
          "owner": "explore_controller",
          "codeValue": "clear",
          "cardinality": "unbounded",
          "scopeKeys": [
            "routeInstanceId",
            "selectionVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "city-plans",
                "organisers"
              ]
            }
          ],
          "description": "Clears search, format and date together, keeping the city and the plans/organisers view."
        },
        {
          "id": "select_city",
          "owner": "explore_controller",
          "codeValue": "chooseCity",
          "cardinality": "unbounded",
          "scopeKeys": [
            "routeInstanceId",
            "selectionVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "city-plans",
                "launching-soon",
                "catalog-unavailable"
              ]
            }
