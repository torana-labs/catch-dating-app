          ],
          "no-results": [
            "website/src/features/home/ExplorePage.test.tsx",
            "website/src/features/home/useExplorePageController.test.tsx"
          ],
          "catalog-unavailable": [
            "website/src/features/home/ExplorePage.test.tsx",
            "website/src/features/home/useExplorePageController.test.tsx"
          ]
