{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-10-29",
  "id": "feature.marketing_home",
  "name": "Marketing Home",
  "owner": "marketing_website",
  "status": "pilot",
  "description": "Website v2 homepage and full event discovery: a city's plans from its cityPlans read model or its launching-soon state, format filters, the city picker, catalogue failure, and Explore's public city/format filters with explicit Catch Experience participation eligibility.",
  "surfaces": [
    {
      "id": "marketing_web",
      "runtime": "react_marketing",
      "authority": {
        "registry": "marketing_routes",
        "id": "visitor_discovery"
      },
      "actionScope": {
        "included": "Public discovery filter selection and recovery; source availability, empty results and Catch Experience eligibility remain explicit.",
        "excluded": [
          "Event/profile/Host link navigation, native disclosure controls, catalogue retry and mobile-menu focus/navigation retain their existing link, presentation and shared-chrome owners."
        ]
      },
      "bindings": {
        "previewSources": [
          "website/src/stories/MarketingRoutes.stories.tsx"
        ],
        "actionOwners": [
          {
            "id": "discovery_controller",
            "language": "typescript",
            "file": "website/src/features/home/useExploreController.ts",
            "symbol": "useExploreController"
          }
        ],
        "componentContracts": [
          "route_visitor_discovery"
        ],
        "dataContracts": [
          "contracts/public/website_host_listing_projection.schema.json"
        ],
        "testEvidence": {
          "default": [
            "website/src/features/home/useExploreController.test.tsx"
          ],
          "empty-city": [
            "website/src/features/home/useExploreController.test.tsx"
          ],
          "no-results": [
            "website/src/features/home/useExploreController.test.tsx"
          ],
          "experience-filter": [
            "website/src/features/home/useExploreController.test.tsx"
          ],
