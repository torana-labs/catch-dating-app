      "runtime": "react_marketing",
      "authority": {
        "registry": "marketing_routes",
        "id": "claim"
      },
      "actionScope": {
        "included": "Finding an eligible organizer, signing in with a phone, proving ownership with an Instagram or Luma code, requesting a staff review when no code check works, and following state-specific recovery routes.",
        "excluded": [
          "Search query, account name and phone, proof link, and note edits remain validated form data rather than separate feature actions.",
          "Claim URL state is derived from canonical organizer authority and cannot be forged by query parameters."
        ]
      },
