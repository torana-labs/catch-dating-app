{
  "name": "@catch/web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node artifact/build.mjs",
    "build:storybook": "HOME=/tmp/catch-web-ui-storybook-home STORYBOOK_DISABLE_TELEMETRY=1 storybook build --disable-telemetry --quiet",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./artwork": {
      "types": "./src/artwork.ts",
      "import": "./src/artwork.ts"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "lottie-web": "5.13.0",
    "lucide-react": "^1.68.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@catch/web-ui-react18": "^0.1.0",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.2",
    "jsdom": "^28.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
